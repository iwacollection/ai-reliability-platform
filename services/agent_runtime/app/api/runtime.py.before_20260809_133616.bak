    )


@router.post(
    "/approvals/{approval_id}/resume",
    summary="Resume Approved Remediation Action",
)
async def resume_approved_action(
    approval_id: UUID,
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Resume one approved Action through the persistent execution boundary.

    The execution Idempotency-Key is independent from the key used to record
    the approval decision. Replaying the same key returns the persisted result
    without invoking the executor again.
    """

    security_context = api_security.require(
        authorization,
        ProtectedOperation.RESUME_ACTION,
    )

    request_id = str(
        approval_id
    )
    claimed_operator_id = (
        _normalize_required_header(
            x_operator_id,
            "X-Operator-ID",
        )
    )
    operator_id = api_security.operator_id(
        security_context,
        claimed_operator_id,
    )
    execution_key = _normalize_required_header(
        idempotency_key,
        "Idempotency-Key",
    )

    approval = await runtime.approval.get(
        request_id
    )

    if approval is None:
        raise HTTPException(
            status_code=404,
            detail="Approval request not found",
        )

    if (
        approval.status.value
        != "approved"
        or approval.action.approved
        is not True
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "Approval request is not "
                "approved for execution"
            ),
        )

    if approval.incident_id is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Approval request is not "
                "linked to an Incident"
            ),
        )

    incident_id = str(
        approval.incident_id
    )
    incident = await runtime.incident_store.get(
        incident_id
    )

    if incident is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Linked Incident was not "
                "found"
            ),
        )

    try:
        execution = await (
            runtime.action_runtime.resume(
                request_id,
                incident=incident,
                operator_id=operator_id,
                idempotency_key=(
                    execution_key
                ),
            )
        )

    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    except ActionExecutionConflictError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    except ValueError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    persisted_incident = (
        await runtime.incident_store.get(
            incident_id
        )
    )

    if persisted_incident is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Action execution completed but "
                "the Incident state could not "
                "be reloaded"
            ),
        )

    execution_status = (
        _action_execution_status(
            execution
        )
    )
    response_status = (
        _action_execution_http_status(
            execution
        )
    )

    verification = None
    verification_error: (
        dict[str, Any] | None
    ) = None

    if (
        execution_status == "succeeded"
        and response_status == 200
    ):
        execution_id = str(
            execution.get(
                "execution_id",
                "",
            )
        ).strip()

        if not execution_id:
            verification_error = {
                "type": (
                    "MissingActionExecutionId"
                ),
                "message": (
                    "Successful Action Execution "
                    "did not return execution_id"
                ),
            }
            response_status = 503

        else:
            try:
                (
                    verification,
                    persisted_incident,
                ) = await (
                    runtime.verification_coordinator.run(
                        incident_id=incident_id,
                        plan=approval.action,
                        namespace=(
                            approval.action.namespace
                        ),
                        cluster=(
                            approval.action.cluster
                        ),
                        action_execution_id=(
                            execution_id
                        ),
                        metadata={
                            "source": "api",
                            "trigger": (
                                "post_action_execution"
                            ),
                            "approval_id": request_id,
                        },
                    )
                )

            except VerificationIncidentSyncError as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                reloaded_incident = await (
                    runtime.incident_store.get(
                        incident_id
                    )
                )

                if reloaded_incident is not None:
                    persisted_incident = (
                        reloaded_incident
                    )

                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                    "verification_id": str(
                        exc.verification_id
                    ),
                }
                response_status = 503

            except VerificationConflictError as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 409

            except (
                VerificationProfileError,
                ValueError,
            ) as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 503

            except Exception as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 503

    verification_status = (
        _verification_status(
            verification
        )
    )

    if (
        verification_status
        in {
            "pending",
            "running",
        }
        and response_status == 200
    ):
        response_status = 202

    workflow_status = _workflow_status(
        execution_status=execution_status,
        verification_status=(
            verification_status
        ),
        verification_error=(
            verification_error
        ),
    )

    response = {
        "success": (
            response_status == 200
        ),
        "workflow_success": (
            response_status == 200
            and verification_error is None
            and verification_status == "passed"
            and persisted_incident.status.value
            == "resolved"
        ),
        "workflow_status": workflow_status,
        "approval_id": request_id,
        "incident": (
            persisted_incident.model_dump(
                mode="json"
            )
        ),
        "execution": execution,
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "verification_required": (
            execution_status == "succeeded"
        ),
        "verification_follow_up_required": (
            execution_status == "succeeded"
            and (
                verification_status != "passed"
                or verification_error is not None
            )
        ),
        "verification_error": (
            verification_error
        ),
        "manual_reconciliation_required": (
            execution_status
            == "indeterminate"
            or verification_error is not None
        ),
    }

    return JSONResponse(
        status_code=response_status,
        content=jsonable_encoder(
            response
        ),
    )


@router.post(
    "/action-executions/{execution_id}/reconcile",
    summary="Reconcile Indeterminate Action Execution",
)
async def reconcile_action_execution(
    execution_id: UUID,
    decision: (
        ActionExecutionReconciliationBody
    ) = Body(...),
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
):
    """
    Record the externally observed outcome of an INDETERMINATE Action.

    The endpoint never launches the Action again. A reconciled success enters
    the existing exactly-once VerificationCoordinator. A reconciled failure
    synchronizes the linked Incident to FAILED without running probes.

    Authorization establishes the trusted Reconciler identity.
    X-Operator-ID is retained only as a compatibility claim and must exactly
    match the authenticated principal.
    """

    security_context = api_security.require(
        authorization,
        ProtectedOperation.RECONCILE_ACTION,
    )
    normalized_execution_id = str(
        execution_id
    )
    claimed_operator_id = (
        _normalize_required_header(
            x_operator_id,
            "X-Operator-ID",
        )
    )
    operator_id = api_security.operator_id(
        security_context,
        claimed_operator_id,
    )
    reconciliation_key = (
        _normalize_required_header(
            idempotency_key,
            "Idempotency-Key",
        )
    )
    existing = await (
        runtime.action_execution_service.get(
            normalized_execution_id
        )
    )

    if existing is None:
        raise HTTPException(
            status_code=404,
            detail="Action execution not found",
        )

    if existing.incident_id is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Action execution is not linked "
                "to an Incident"
            ),
        )

    incident_id = str(
        existing.incident_id
    )
    incident = await runtime.incident_store.get(
        incident_id
    )

    if incident is None:
        raise HTTPException(
            status_code=409,
            detail="Linked Incident was not found",
        )

    if (
        existing.reconciliation is None
        and incident.status
        != IncidentStatus.HEALING
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "A new Action reconciliation requires "
                "the Incident to be healing"
            ),
        )

    reconciliation_metadata = dict(
        decision.metadata
    )
    reconciliation_metadata.update(
        {
            "source": "api",
            "trigger": (
                "manual_action_reconciliation"
            ),
            "action_execution_id": (
                normalized_execution_id
            ),
        }
    )

    try:
        reconciliation_result = await (
            runtime.action_execution_service
            .reconcile(
                normalized_execution_id,
                outcome=decision.outcome,
                operator_id=operator_id,
                idempotency_key=(
                    reconciliation_key
                ),
                reason=decision.reason,
                result=decision.result,
                error_type=decision.error_type,
                error_message=(
                    decision.error_message
                ),
                metadata=(
                    reconciliation_metadata
                ),
            )
        )

    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    except ActionExecutionConflictError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    except ValueError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    execution = reconciliation_result.execution
    execution_status = (
        _enum_text(
            execution.status
        )
        or ""
    )
    persisted_incident = await (
        runtime.incident_store.get(
            incident_id
        )
    )

    if persisted_incident is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Action reconciliation completed but "
                "the Incident state could not be reloaded"
            ),
        )

    response_status = 200
    verification = None
    verification_error: (
        dict[str, Any] | None
    ) = None
    incident_sync_error: (
        dict[str, Any] | None
    ) = None

    if execution_status == "failed":
        try:
            persisted_incident = await (
                _synchronize_reconciled_failure_incident(
                    incident=(
                        persisted_incident
                    ),
                    execution=execution,
                )
            )

        except Exception as exc:
            reloaded_incident = await (
                runtime.incident_store.get(
                    incident_id
                )
            )

            if reloaded_incident is not None:
                persisted_incident = (
                    reloaded_incident
                )

            incident_sync_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

    elif execution_status == "succeeded":
        try:
            (
                verification,
                persisted_incident,
            ) = await (
                runtime.verification_coordinator.run(
                    incident_id=incident_id,
                    plan=execution.action,
                    namespace=(
                        execution.action.namespace
                    ),
                    cluster=(
                        execution.action.cluster
                    ),
                    action_execution_id=(
                        normalized_execution_id
                    ),
                    metadata={
                        "source": "api",
                        "trigger": (
                            "post_action_reconciliation"
                        ),
                        "approval_id": (
                            execution.approval_id
                        ),
                        "reconciliation_idempotency_key": (
                            reconciliation_key
                        ),
                    },
                )
            )

        except VerificationIncidentSyncError as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            reloaded_incident = await (
                runtime.incident_store.get(
                    incident_id
                )
            )

            if reloaded_incident is not None:
                persisted_incident = (
                    reloaded_incident
                )

            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
                "verification_id": str(
                    exc.verification_id
                ),
            }
            response_status = 503

        except VerificationConflictError as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 409

        except (
            VerificationProfileError,
            ValueError,
        ) as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

        except Exception as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

    else:
        incident_sync_error = {
            "type": (
                "UnexpectedReconciliationStatus"
            ),
            "message": (
                "Reconciliation did not produce a "
                "terminal Action Execution status"
            ),
        }
        response_status = 503

    verification_status = (
        _verification_status(
            verification
        )
    )

    if (
        verification_status
        in {
            "pending",
            "running",
        }
        and response_status == 200
    ):
        response_status = 202

    if incident_sync_error is not None:
        workflow_status = (
            "incident_reconciliation_required"
        )
    else:
        workflow_status = _workflow_status(
            execution_status=execution_status,
            verification_status=(
                verification_status
            ),
            verification_error=(
                verification_error
            ),
        )

    response = {
        "success": (
            response_status == 200
        ),
        "workflow_success": (
            response_status == 200
            and execution_status == "succeeded"
            and verification_error is None
            and verification_status == "passed"
            and persisted_incident.status.value
            == "resolved"
        ),
        "workflow_status": workflow_status,
        "action_execution_id": (
            normalized_execution_id
        ),
        "approval_id": execution.approval_id,
        "incident": (
            persisted_incident.model_dump(
                mode="json"
            )
        ),
        "execution": execution.model_dump(
            mode="json"
        ),
        "reconciliation": (
            execution.reconciliation.model_dump(
                mode="json"
            )
            if execution.reconciliation
            is not None
            else None
        ),
        "reconciliation_applied": (
            reconciliation_result.applied
        ),
        "idempotent_replay": (
            reconciliation_result.is_replay
        ),
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "verification_required": (
            execution_status == "succeeded"
        ),
        "verification_follow_up_required": (
            execution_status == "succeeded"
            and (
                verification_status != "passed"
                or verification_error is not None
            )
        ),
        "verification_error": verification_error,
        "incident_sync_error": (
            incident_sync_error
        ),
        "manual_reconciliation_required": (
            incident_sync_error is not None
            or verification_error is not None
        ),
    }

    return JSONResponse(
        status_code=response_status,
        content=jsonable_encoder(
            response
        ),
    )


@router.get(
    "/verifications/{verification_id}",
    summary="Get Verification Result",
)
async def get_verification(
    verification_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """Read one persisted VerificationResult without running new probes."""

    api_security.require(
        authorization,
        ProtectedOperation.READ_VERIFICATION,
    )

    verification = await runtime.verification.get(
        verification_id
    )

    if verification is None:
        raise HTTPException(
            status_code=404,
            detail="Verification result not found",
        )

    return jsonable_encoder(
        {
            "success": True,
            "verification": (
                verification.model_dump(
                    mode="json"
                )
            ),
        }
    )
