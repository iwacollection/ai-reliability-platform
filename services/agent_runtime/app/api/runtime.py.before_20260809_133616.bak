router = APIRouter()


# One shared Runtime is required so API requests reuse the same configured
# stores, tools and workflow services. SQLite remains the source of truth for
# recovery after a process restart.
runtime = AgentRuntime()


# Authentication and RBAC must use the exact shared services owned by the
# Runtime. Every API route enforces authentication and its explicit
# ProtectedOperation before reading or mutating workflow state.
api_security = ApiSecurityAdapter(
    authentication=runtime.authentication,
    policy=runtime.security_policy,
)


class ApprovalDecisionBody(BaseModel):
    """Optional human explanation and bounded audit metadata."""

    model_config = ConfigDict(
        extra="forbid"
    )

    reason: str = Field(
        default="",
        max_length=2000,
    )

    metadata: dict[str, Any] = Field(
        default_factory=dict
    )


class ActionExecutionReconciliationBody(BaseModel):
    """Operator-confirmed outcome for one INDETERMINATE execution."""

    model_config = ConfigDict(
        extra="forbid"
    )

    outcome: (
        ActionExecutionReconciliationOutcome
    )

    reason: str = Field(
        min_length=1,
        max_length=2000,
    )

    result: dict[str, Any]

    error_type: str | None = Field(
        default=None,
        max_length=256,
    )

    error_message: str | None = Field(
        default=None,
        max_length=4000,
    )

    metadata: dict[str, Any] = Field(
        default_factory=dict
    )


def _normalize_request_id(
    value: str | None,
) -> str:
    normalized = (
        value.strip()
        if value is not None
        else ""
    )
    return normalized or str(
        uuid4()
    )


def _normalize_required_header(
    value: str | None,
    header_name: str,
) -> str:
    """Reject whitespace-only identity and idempotency headers."""

    normalized = (
        value.strip()
        if isinstance(
            value,
            str,
        )
        else ""
    )

    if not normalized:
        raise HTTPException(
            status_code=422,
            detail=(
                f"{header_name} must not "
                "be blank"
            ),
        )

    if len(normalized) > 128:
        raise HTTPException(
            status_code=422,
            detail=(
                f"{header_name} is too long"
            ),
        )

    return normalized


def _trace_matches_incident(
    trace,
    incident_id: str,
) -> bool:
    """Prevent traces from another API request leaking into the response."""

    for field_name in (
        "input_data",
        "output_data",
    ):
        data = getattr(
            trace,
            field_name,
            None,
        )

        if not isinstance(
            data,
            dict,
        ):
            continue

        if str(
            data.get(
                "incident_id",
                "",
            )
        ) == incident_id:
            return True

    return False


def _trace_summary(
    trace,
) -> dict[str, Any]:
    """
    Return bounded trace metadata.

    Raw spans and prompt input are intentionally excluded from the public API
    response. Full traces remain available through the observability store.
    """

    return {
        "trace_id": str(
            trace.trace_id
        ),
        "agent": trace.agent,
        "duration_ms": trace.duration_ms,
        "success": trace.success,
        "score": trace.score,
        "message": trace.message,
    }


def _current_trace_summaries(
    incident_id: UUID,
) -> list[dict[str, Any]]:
    normalized_id = str(
        incident_id
    )

    return [
        _trace_summary(
            trace
        )
        for trace in runtime.tracer.list()
        if _trace_matches_incident(
            trace,
            normalized_id,
        )
    ]


def _action_execution_status(
    execution: dict[str, Any],
) -> str:
    """Read the persisted execution status from either response shape."""

    value = (
        execution.get(
            "execution_status"
        )
        or execution.get(
            "status"
        )
        or ""
    )

    return str(
        value
    ).strip().lower()


def _action_execution_http_status(
    execution: dict[str, Any],
) -> int:
    """Map Action Execution state without treating uncertainty as success."""

    boundary_status = str(
        execution.get(
            "status",
            "",
        )
    ).strip().lower()

    if boundary_status in {
        "preflight_contract_expired",
        "preflight_clock_invalid",
        "preflight_binding_invalid",
        "preflight_guard_rejected",
        "preflight_guard_unavailable",
    }:
        return 409

    status = _action_execution_status(
        execution
    )

    if status == "succeeded":
        return 200

    if status == "running":
        return 202

    if status == "failed":
        return 502

    if status == "indeterminate":
        return 503

    if (
        execution.get("success")
        is True
        and execution.get(
            "execution_id"
        )
    ):
        return 200

    return 409


def _verification_status(
    verification,
) -> str | None:
    """Normalize a persisted Verification status for the API response."""

    if verification is None:
        return None

    value = getattr(
        verification,
        "status",
        None,
    )

    if value is None:
        return None

    return str(
        getattr(
            value,
            "value",
            value,
        )
    ).strip().lower()


def _workflow_status(
    *,
    execution_status: str,
    verification_status: str | None,
    verification_error: dict[str, Any] | None,
) -> str:
    """Expose the whole remediation outcome without hiding partial states."""

    if execution_status != "succeeded":
        return (
            f"action_{execution_status}"
            if execution_status
            else "action_unknown"
        )

    if verification_error is not None:
        return "verification_reconciliation_required"

    if verification_status is None:
        return "verification_not_started"

    return {
        "pending": "verification_pending",
        "running": "verification_running",
        "passed": "resolved",
        "failed": "verification_failed",
        "inconclusive": (
            "verification_inconclusive"
        ),
        "timed_out": "verification_timed_out",
    }.get(
        verification_status,
        "verification_unknown",
    )


def _enum_text(
    value: Any,
) -> str | None:
    """Normalize Enum-backed persisted fields without mutating the models."""

    if value is None:
        return None

    return str(
        getattr(
            value,
            "value",
            value,
        )
    ).strip().lower()


def _bounded_audit_text(
    value: Any,
    *,
    maximum_length: int,
) -> str | None:
    """Return one bounded persisted audit value or omit it."""

    if not isinstance(
        value,
        str,
    ):
        return None

    normalized = value.strip()
    if (
        not normalized
        or normalized != value
        or len(normalized) > maximum_length
    ):
        return None

    return normalized


def _action_execution_audit_snapshot(
    execution,
) -> dict[str, Any] | None:
    """
    Expose bounded execution provenance without internal write material.

    The snapshot deliberately omits the canonical patch, workload UID,
    resourceVersion, request headers, and credentials. It is derived only
    from the durable ActionExecutionRecord, so read-only workflow queries do
    not need to reopen a Preflight Artifact or contact Kubernetes.
    """

    if execution is None:
        return None

    metadata = (
        execution.metadata
        if isinstance(
            execution.metadata,
            dict,
        )
        else {}
    )
    result = (
        execution.result
        if isinstance(
            execution.result,
            dict,
        )
        else {}
    )
    metadata_mode = _bounded_audit_text(
        metadata.get(
            "execution_mode"
        ),
        maximum_length=64,
    )
    result_mode = _bounded_audit_text(
        result.get(
            "mode"
        ),
        maximum_length=64,
    )
    production = (
        metadata_mode
        == "kubernetes_production"
        or result_mode
        == "kubernetes_production"
    )
    status = _enum_text(
        execution.status
    )
    reconciled = (
        getattr(
            execution,
            "reconciliation",
            None,
        )
        is not None
    )

    if production:
        real_write_attempted = (
            status
            in {
                "succeeded",
                "indeterminate",
            }
            or reconciled
            or result.get(
                "real_write_attempted"
            )
            is True
        )
        mode = "kubernetes_production"
    else:
        real_write_attempted = False
        mode = result_mode or "legacy"

    return {
        "mode": mode,
        "production": production,
        "status": status,
        "operator_id": execution.operator_id,
        "preflight_artifact_id": (
            _bounded_audit_text(
                metadata.get(
                    "preflight_artifact_id"
                ),
                maximum_length=128,
            )
            if production
            else None
        ),
        "safety_contract_id": (
            _bounded_audit_text(
                metadata.get(
                    "safety_contract_id"
                ),
                maximum_length=128,
            )
            if production
            else None
        ),
        "safety_policy_version": (
            _bounded_audit_text(
                metadata.get(
                    "safety_policy_version"
                ),
                maximum_length=64,
            )
            if production
            else None
        ),
        "safety_patch_sha256": (
            _bounded_audit_text(
                metadata.get(
                    "safety_patch_sha256"
                ),
                maximum_length=64,
            )
            if production
            else None
        ),
        "real_write_attempted": (
            real_write_attempted
        ),
        "requires_reconciliation": (
            status == "indeterminate"
        ),
        "reconciled": reconciled,
        "automatic_replay_allowed": False,
    }


def _workflow_reconciliation_snapshot(
    *,
    execution,
    verification,
) -> dict[str, Any]:
    """Expose bounded manual reconciliation audit and follow-up state."""

    if execution is None:
        return {
            "required": False,
            "performed": False,
            "outcome": None,
            "operator_id": None,
            "idempotency_key": None,
            "reason": None,
            "reconciled_at": None,
            "result": None,
            "error_type": None,
            "error_message": None,
            "metadata": {},
            "verification_expected": False,
            "verification_present": False,
            "verification_rule_satisfied": True,
        }

    execution_status = _enum_text(
        execution.status
    )
    decision = getattr(
        execution,
        "reconciliation",
        None,
    )

    if decision is None:
        return {
            "required": (
                execution_status
                == "indeterminate"
            ),
            "performed": False,
            "outcome": None,
            "operator_id": None,
            "idempotency_key": None,
            "reason": None,
            "reconciled_at": None,
            "result": None,
            "error_type": None,
            "error_message": None,
            "metadata": {},
            "verification_expected": False,
            "verification_present": (
                verification is not None
            ),
            "verification_rule_satisfied": True,
        }

    outcome = _enum_text(
        decision.outcome
    )
    verification_expected = (
        outcome == "succeeded"
    )
    verification_present = (
        verification is not None
    )

    return {
        "required": False,
        "performed": True,
        "outcome": outcome,
        "operator_id": decision.operator_id,
        "idempotency_key": (
            decision.idempotency_key
        ),
        "reason": decision.reason,
        "reconciled_at": (
            decision.reconciled_at
        ),
        "result": dict(
            decision.result
        ),
        "error_type": decision.error_type,
        "error_message": (
            decision.error_message
        ),
        "metadata": dict(
            decision.metadata
        ),
        "verification_expected": (
            verification_expected
        ),
        "verification_present": (
            verification_present
        ),
        "verification_rule_satisfied": (
            verification_present
            if verification_expected
            else not verification_present
        ),
    }


def _workflow_consistency_issues(
    *,
    approval,
    execution,
    verification,
    incident,
    validate_incident_status: bool = True,
) -> list[str]:
    """Validate links and terminal state synchronization across stores."""

    issues: list[str] = []
    approval_status = _enum_text(
        approval.status
    )
    approval_incident_id = (
        str(approval.incident_id)
        if approval.incident_id is not None
        else None
    )

    if approval_incident_id is None:
        issues.append(
            "approval_missing_incident_link"
        )
    elif incident is None:
        issues.append(
            "linked_incident_not_found"
        )
    elif str(
        incident.id
    ) != approval_incident_id:
        issues.append(
            "linked_incident_id_mismatch"
        )

    if (
        approval_status == "approved"
    ) != (
        approval.action.approved is True
    ):
        issues.append(
            "approval_action_flag_mismatch"
        )

    if execution is not None:
        if execution.approval_id != approval.id:
            issues.append(
                "execution_approval_link_mismatch"
            )

        execution_incident_id = (
            str(execution.incident_id)
            if execution.incident_id is not None
            else None
        )

        if (
            execution_incident_id
            != approval_incident_id
        ):
            issues.append(
                "execution_incident_link_mismatch"
            )

        if approval_status != "approved":
            issues.append(
                "execution_exists_without_approved_request"
            )

        scope_fields = (
            "type",
            "target",
            "namespace",
            "cluster",
        )

        if any(
            getattr(
                execution.action,
                field_name,
            )
            != getattr(
                approval.action,
                field_name,
            )
            for field_name in scope_fields
        ):
            issues.append(
                "execution_action_scope_mismatch"
            )

    if verification is not None:
        if execution is None:
            issues.append(
                "verification_missing_action_execution"
            )
        elif str(
            verification.action_execution_id
        ) != str(
            execution.id
        ):
            issues.append(
                "verification_execution_link_mismatch"
            )

        verification_incident_id = str(
            verification.incident_id
        )

        if (
            verification_incident_id
            != approval_incident_id
        ):
            issues.append(
                "verification_incident_link_mismatch"
            )

        if (
            execution is not None
            and _enum_text(
                execution.status
            ) != "succeeded"
        ):
            issues.append(
                "verification_exists_before_action_success"
            )

    if execution is not None:
        reconciliation = getattr(
            execution,
            "reconciliation",
            None,
        )

        if reconciliation is not None:
            reconciliation_outcome = (
                _enum_text(
                    reconciliation.outcome
                )
            )
            execution_status = _enum_text(
                execution.status
            )

            if (
                reconciliation_outcome
                != execution_status
            ):
                issues.append(
                    "reconciliation_execution_status_mismatch"
                )

            if (
                reconciliation_outcome
                == "failed"
                and verification is not None
            ):
                issues.append(
                    "verification_exists_after_failed_reconciliation"
                )

    if (
        incident is not None
        and validate_incident_status
    ):
        incident_status = _enum_text(
            incident.status
        )
        verification_status = (
            _verification_status(
                verification
            )
        )

        expected_incident_status = {
            "passed": "resolved",
            "failed": "failed",
            "timed_out": "failed",
            "inconclusive": "healing",
            "pending": "healing",
            "running": "healing",
        }.get(
            verification_status
        )

        if (
            expected_incident_status is not None
            and incident_status
            != expected_incident_status
        ):
            issues.append(
                "verification_incident_status_mismatch"
            )

        if (
            verification is None
            and execution is not None
        ):
            expected_action_incident_status = {
                "succeeded": "healing",
                "failed": "failed",
                "indeterminate": "healing",
            }.get(
                _enum_text(
                    execution.status
                )
            )

            if (
                expected_action_incident_status
                is not None
                and incident_status
                != expected_action_incident_status
            ):
                issues.append(
                    "action_incident_status_mismatch"
                )

    return issues


def _persisted_workflow_status(
    *,
    approval,
    execution,
    verification,
    consistency_issues: list[str],
) -> str:
    """Derive one stable public status from the persisted workflow graph."""

    if consistency_issues:
        return "inconsistent"

    approval_status = _enum_text(
        approval.status
    )

    if approval_status == "pending":
        return "pending_approval"

    if approval_status in {
        "rejected",
        "expired",
    }:
        return approval_status

    if approval_status != "approved":
        return "approval_unknown"

    if execution is None:
        return "approved_awaiting_execution"

    execution_status = _enum_text(
        execution.status
    )

    if execution_status == "running":
        return "action_running"

    if execution_status == "failed":
        return "action_failed"

    if execution_status == "indeterminate":
        return "action_indeterminate"

    if execution_status != "succeeded":
        return "action_unknown"

    if verification is None:
        return "awaiting_verification"

    return {
        "pending": "verification_pending",
        "running": "verification_running",
        "passed": "resolved",
        "failed": "verification_failed",
        "inconclusive": (
            "verification_inconclusive"
        ),
        "timed_out": "verification_timed_out",
    }.get(
        _verification_status(
            verification
        ),
        "verification_unknown",
    )


def _workflow_flags(
    workflow_status: str,
) -> dict[str, bool]:
    """Separate terminality, success and operator follow-up semantics."""

    terminal = workflow_status in {
        "resolved",
        "rejected",
        "expired",
        "action_failed",
        "verification_failed",
        "verification_timed_out",
    }

    manual_reconciliation_required = (
        workflow_status
        in {
            "inconsistent",
            "action_indeterminate",
            "verification_timed_out",
        }
    )

    follow_up_required = (
        workflow_status
        not in {
            "resolved",
            "rejected",
            "expired",
        }
    )

    return {
        "workflow_success": (
            workflow_status == "resolved"
        ),
        "terminal": terminal,
        "follow_up_required": (
            follow_up_required
        ),
        "manual_reconciliation_required": (
            manual_reconciliation_required
        ),
    }


def _workflow_snapshot(
    *,
    approval,
    execution,
    verification,
    incident,
    validate_incident_status: bool = True,
) -> dict[str, Any]:
    """Build one read-only Approval-centered Workflow snapshot."""

    consistency_issues = (
        _workflow_consistency_issues(
            approval=approval,
            execution=execution,
            verification=verification,
            incident=incident,
            validate_incident_status=(
                validate_incident_status
            ),
        )
    )
    workflow_status = (
        _persisted_workflow_status(
            approval=approval,
            execution=execution,
            verification=verification,
            consistency_issues=(
                consistency_issues
            ),
        )
    )
    reconciliation_snapshot = (
        _workflow_reconciliation_snapshot(
            execution=execution,
            verification=verification,
        )
    )

    return {
        "success": True,
        "approval_id": approval.id,
        "workflow_status": workflow_status,
        **_workflow_flags(
            workflow_status
        ),
        "consistency": {
            "passed": not consistency_issues,
            "issues": consistency_issues,
        },
        "reconciliation": (
            reconciliation_snapshot
        ),
        "action_execution_audit": (
            _action_execution_audit_snapshot(
                execution
            )
        ),
        "links": {
            "approval_incident_id": (
                str(approval.incident_id)
                if approval.incident_id
                is not None
                else None
            ),
            "execution_id": (
                str(execution.id)
                if execution is not None
                else None
            ),
            "execution_incident_id": (
                str(execution.incident_id)
                if execution is not None
                and execution.incident_id
                is not None
                else None
            ),
            "verification_id": (
                str(verification.id)
                if verification is not None
                else None
            ),
            "verification_incident_id": (
                str(verification.incident_id)
                if verification is not None
                else None
            ),
            "verification_action_execution_id": (
                str(
                    verification
                    .action_execution_id
                )
                if verification is not None
                and verification
                .action_execution_id
                is not None
                else None
            ),
        },
        "approval": approval.model_dump(
            mode="json"
        ),
        "action_execution": (
            execution.model_dump(
                mode="json"
            )
            if execution is not None
            else None
        ),
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "incident": (
            incident.model_dump(
                mode="json"
            )
            if incident is not None
            else None
        ),
    }


async def _synchronize_reconciled_failure_incident(
    *,
    incident,
    execution,
):
    """Persist the Incident failure caused by a reconciled Action failure."""

    if (
        incident.status
        == IncidentStatus.FAILED
    ):
        return incident

    if (
        incident.status
        != IncidentStatus.HEALING
    ):
        raise ValueError(
            "Reconciled Action failure cannot change "
            "Incident from "
            f"{_enum_text(incident.status)}"
        )

    updated = incident.model_copy(
        deep=True
    )
    reconciliation = execution.reconciliation
    decision_reason = (
        reconciliation.reason
        if reconciliation is not None
        else "Operator confirmed Action failure"
    )
    updated.update(
        IncidentStatus.FAILED,
        reason=(
            "Action Execution was reconciled as failed: "
            f"{decision_reason}"
        ),
    )

    try:
        return await runtime.incident_store.update(
            updated
        )

    except Exception:
        refreshed = await runtime.incident_store.get(
            str(
                incident.id
            )
        )

        if (
            refreshed is not None
            and refreshed.status
            == IncidentStatus.FAILED
        ):
            return refreshed

        raise


@router.post(
    "/execute",
    summary="Execute Agent Runtime",
)
async def execute_runtime(
    payload: dict = Body(...),
    x_request_id: str | None = Header(
        default=None,
        max_length=128,
    ),
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Validate one StandardEvent and execute the shared Agent Runtime pipeline.

    This endpoint performs analysis only. It does not approve or execute a
    remediation action automatically.
    """

    api_security.require(
        authorization,
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS,
    )

    try:
        event = StandardEvent.model_validate(
            payload
        )
    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    request_id = _normalize_request_id(
        x_request_id
    )

    context = AgentContext(
        request_id=request_id,
        event=event,
        memory=runtime.memory,
        tools=runtime.tools,
        skills=runtime.skills,
        mcp=runtime.mcp,
        approval=runtime.approval,
    )

    results = await runtime.pipeline.execute(
        context
    )

    incident = context.incident
    trace_summaries = (
        _current_trace_summaries(
            incident.id
        )
    )

    response = {
        "success": True,
        "request_id": request_id,
        "incident": incident.model_dump(
            mode="json"
        ),
        "results": [
            result.model_dump(
                mode="json"
            )
            for result in results
        ],
        "executions": [
            execution.model_dump(
                mode="json"
            )
            for execution in context.executions
        ],
        "evaluations": [
            evaluation.model_dump(
                mode="json"
            )
            for evaluation in context.evaluations
        ],
        "traces": trace_summaries,
        "trace_count": len(
            trace_summaries
        ),
    }

    return jsonable_encoder(
        response
    )


@router.get(
    "/production-actions/pilot-readiness",
    summary="Get Production Pilot Readiness",
)
async def get_production_pilot_readiness(
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Return one bounded, read-only production pilot go/no-go snapshot.

    The response never includes credentials, kill-switch paths or contents,
    Kubernetes resource identities, patches, or precondition values. Reading
    readiness cannot approve, claim, execute, verify, or mutate a workflow.
    """

    api_security.require(
        authorization,
        ProtectedOperation.READ_REMEDIATION_PREPARATION,
    )
    readiness_service = getattr(
        runtime,
        "production_pilot_readiness",
        None,
    )
    if readiness_service is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production pilot readiness is unavailable"
            ),
        )
    try:
        snapshot = readiness_service.get()
    except Exception as exc:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production pilot readiness could not be evaluated safely"
            ),
        ) from exc

    return jsonable_encoder(
        {
            "success": True,
            "read_only": True,
            "readiness": snapshot.model_dump(
                mode="json"
            ),
        }
    )


@router.post(
    "/production-actions/pilot-rehearsal",
    summary="Rehearse Production Pilot Enablement",
)
async def rehearse_production_pilot(
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Run a side-effect-free production Pilot enablement ceremony.

    The authenticated operator must have Resume permission and be explicitly
    listed in the Pilot manifest. The Kill Switch must remain ENGAGED. This
    route never creates a Claim, reserves the write budget, contacts
    Kubernetes, changes workflow state, or starts Verification.
    """

    security_context = api_security.require(
        authorization,
        ProtectedOperation.RESUME_ACTION,
    )
    claimed_operator_id = (
        _normalize_required_header(
            x_operator_id,
            "X-Operator-ID",
        )
    )
    operator_id = api_security.operator_id(
        security_context,
        claimed_operator_id,
    )
    rehearsal_service = getattr(
        runtime,
        "production_pilot_rehearsal",
        None,
    )
    if rehearsal_service is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production pilot rehearsal is unavailable"
            ),
        )
    try:
        result = await rehearsal_service.run(
            operator_id=operator_id
        )
    except Exception as exc:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production pilot rehearsal could not be evaluated safely"
            ),
        ) from exc

    return jsonable_encoder(
        {
            "success": True,
            "read_only": True,
            "rehearsal": result.model_dump(
                mode="json"
            ),
        }
    )


@router.post(
    "/production-actions/prepare",
    summary="Prepare Production Remediation",
)
async def prepare_production_action(
    request: Request,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
    ),
    idempotency_key: str | None = Header(
        default=None,
        alias="Idempotency-Key",
    ),
):
    """
    Persist one trusted Kubernetes dry-run Artifact and bind one Approval.

    This endpoint never approves, executes or verifies the Action. The
    authenticated principal is persisted as the preparation audit subject.
    """

    security_context = api_security.require(
        authorization,
        ProtectedOperation.PREPARE_REMEDIATION,
    )
    preparation_key = _normalize_required_header(
        idempotency_key,
        "Idempotency-Key",
    )

    try:
        payload = await request.json()
    except ValueError as exc:
        raise HTTPException(
            status_code=422,
            detail=(
                "Production preparation body must be "
                "a valid JSON object"
            ),
        ) from exc

    if not isinstance(
        payload,
        dict,
    ):
        raise HTTPException(
            status_code=422,
            detail=(
                "Production preparation body must be "
                "a valid JSON object"
            ),
        )

    if "idempotency_key" in payload:
        raise HTTPException(
            status_code=422,
            detail=(
                "Production preparation idempotency key "
                "must be supplied only by Idempotency-Key"
            ),
        )

    request_payload = dict(
        payload
    )
    request_payload[
        "idempotency_key"
    ] = preparation_key

    try:
        preparation_request = (
            ProductionActionPreparationRequest
            .model_validate(
                request_payload
            )
        )
    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    preparation_service = getattr(
        runtime,
        "production_action_preparation",
        None,
    )

    if preparation_service is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production action preparation "
                "is unavailable"
            ),
        )

    try:
        result = await preparation_service.prepare(
            preparation_request,
            operator_id=(
                security_context.principal_id
            ),
        )
    except KubernetesPreflightPolicyError as exc:
        raise HTTPException(
            status_code=403,
            detail=(
                "Production remediation target "
                "is not allowed"
            ),
        ) from exc
    except KubernetesPreflightResourceNotFoundError as exc:
        raise HTTPException(
            status_code=404,
            detail=(
                "Kubernetes preflight resource "
                "was not found"
            ),
        ) from exc
    except (
        KubernetesPreflightConflictError,
        PreflightArtifactConflictError,
        ProductionActionPreparationConflictError,
    ) as exc:
        raise HTTPException(
            status_code=409,
            detail=(
                "Production action preparation "
                "conflicts with persisted state"
            ),
        ) from exc
    except (
        KubernetesPreflightConfigurationError,
        KubernetesPreflightAuthorizationError,
    ) as exc:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production action preparation "
                "is unavailable"
            ),
        ) from exc
    except KubernetesPreflightResponseError as exc:
        raise HTTPException(
            status_code=502,
            detail=(
                "Kubernetes preflight failed"
            ),
        ) from exc
    except ProductionActionPreparationError as exc:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production action preparation "
                "could not complete safely"
            ),
        ) from exc

    record = result.record
    approval = result.approval
    contract = record.artifact.contract
    memory = contract.memory
    scope = contract.scope
    response_status = (
        201
        if (
            result.artifact_created
            or result.approval_created
        )
        else 200
    )

    response = {
        "success": True,
        "execution_started": False,
        "verification_started": False,
        "incident_id": str(
            record.incident_id
        ),
        "idempotency_key": (
            record.idempotency_key
        ),
        "idempotent_replay": (
            result.idempotent_replay
        ),
        "recovery_completed": (
            not result.artifact_created
            and result.approval_created
        ),
        "artifact": {
            "artifact_id": str(
                record.artifact_id
            ),
            "status": record.status.value,
            "created": (
                result.artifact_created
            ),
            "safety_contract_id": str(
                contract.contract_id
            ),
            "policy_version": (
                contract.policy_version
            ),
            "patch_sha256": (
                contract.dry_run.patch_sha256
            ),
            "server_dry_run": (
                contract.dry_run.server_dry_run
            ),
            "prepared_at": (
                contract.prepared_at
            ),
            "expires_at": (
                contract.expires_at
            ),
        },
        "approval": {
            "approval_id": approval.id,
            "status": approval.status.value,
            "created": (
                result.approval_created
            ),
        },
        "action": {
            "type": contract.action_type.value,
            "risk": (
                record.artifact.plan.risk.value
            ),
            "cluster": scope.cluster,
            "namespace": scope.namespace,
            "kind": scope.kind.value,
            "target": scope.name,
            "container": scope.container,
            "current_memory_limit": (
                memory.current_limit
            ),
            "desired_memory_limit": (
                memory.desired_limit
            ),
            "rollback_memory_limit": (
                memory.rollback_limit
            ),
            "increase_percent": (
                memory.increase_percent
            ),
        },
    }

    return JSONResponse(
        status_code=response_status,
        content=jsonable_encoder(
            response
        ),
    )


def _production_action_query_response(
    result,
) -> dict[str, Any]:
    """Return a bounded view without the canonical patch or preconditions."""

    record = result.record
    artifact = record.artifact
    contract = artifact.contract
    scope = contract.scope
    memory = contract.memory
    approval = result.approval
    incident = result.incident

    return {
        "success": True,
        "read_only": True,
        "phase": result.phase,
        "artifact": {
            "artifact_id": str(
                record.artifact_id
            ),
            "incident_id": str(
                record.incident_id
            ),
            "approval_id": (
                record.approval_id
            ),
            "idempotency_key": (
                record.idempotency_key
            ),
            "status": record.status.value,
            "created_at": record.created_at,
            "updated_at": record.updated_at,
        },
        "contract": {
            "safety_contract_id": str(
                contract.contract_id
            ),
            "policy_version": (
                contract.policy_version
            ),
            "server_dry_run": (
                contract.dry_run.server_dry_run
            ),
            "patch_sha256": (
                contract.dry_run.patch_sha256
            ),
            "warning_count": len(
                contract.dry_run.warnings
            ),
            "prepared_at": (
                contract.prepared_at
            ),
            "expires_at": (
                contract.expires_at
            ),
            "checked_at": (
                result.checked_at
            ),
            "clock_valid": (
                result.clock_valid
            ),
            "expired": result.expired,
            "remaining_seconds": (
                result.remaining_seconds
            ),
            "replacement_preflight_required": (
                result.replacement_preflight_required
            ),
        },
        "action": {
            "type": contract.action_type.value,
            "risk": artifact.plan.risk.value,
            "cluster": scope.cluster,
            "namespace": scope.namespace,
            "kind": scope.kind.value,
            "target": scope.name,
            "container": scope.container,
            "current_memory_limit": (
                memory.current_limit
            ),
            "desired_memory_limit": (
                memory.desired_limit
            ),
            "rollback_memory_limit": (
                memory.rollback_limit
            ),
            "increase_percent": (
                memory.increase_percent
            ),
        },
        "evidence": {
            "source_pod": (
                artifact.plan.metadata.get(
                    "source_pod"
                )
            ),
            "source_restart_count": (
                artifact.source_restart_count
            ),
            "oom_killed_confirmed": True,
        },
        "approval": (
            None
            if approval is None
            else {
                "approval_id": approval.id,
                "status": approval.status.value,
                "action_approved": (
                    approval.action.approved
                ),
                "preparation_operator_id": (
                    approval.metadata.get(
                        "preparation_operator_id"
                    )
                ),
                "decision_required": (
                    result.approval_decision_required
                ),
            }
        ),
        "incident": (
            None
            if incident is None
            else {
                "incident_id": str(
                    incident.id
                ),
                "status": incident.status.value,
                "reason": incident.reason,
                "updated_at": (
                    incident.updated_at
                ),
            }
        ),
        "consistency": {
            "passed": (
                result.consistency_passed
            ),
            "issues": list(
                result.consistency_issues
            ),
        },
        "execution_candidate": {
            "eligible": (
                result.execution_eligible
            ),
            "blockers": list(
                result.execution_blockers
            ),
        },
        "query_side_effects": {
            "kubernetes_called": False,
            "approval_changed": False,
            "incident_changed": False,
            "action_executed": False,
            "verification_started": False,
        },
    }


@router.get(
    "/production-actions/preflight-artifacts/{artifact_id}",
    summary="Get Production Preparation Artifact",
)
async def get_production_preparation(
    artifact_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """Read one preparation snapshot without running any workflow step."""

    api_security.require(
        authorization,
        ProtectedOperation.READ_REMEDIATION_PREPARATION,
    )

    query_service = getattr(
        runtime,
        "production_action_query",
        None,
    )
    if query_service is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production preparation query "
                "is unavailable"
            ),
        )

    try:
        result = await query_service.get(
            artifact_id
        )
    except Exception as exc:
        raise HTTPException(
            status_code=503,
            detail=(
                "Production preparation query "
                "is unavailable"
            ),
        ) from exc

    if result is None:
        raise HTTPException(
            status_code=404,
            detail=(
                "Preflight Artifact not found"
            ),
        )

    return jsonable_encoder(
        _production_action_query_response(
            result
        )
    )


