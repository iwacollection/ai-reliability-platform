    ToolRegistry,
)


class HistoricalEvidenceReplayError(
    RuntimeError
):
    """
    Base error for historical Incident evidence replay.
    """


class HistoricalEvidenceNotFoundError(
    HistoricalEvidenceReplayError
):
    """
    No historical observation satisfies the requested evidence contract.
    """


class HistoricalEvidenceAmbiguousError(
    HistoricalEvidenceReplayError
):
    """
    Multiple historical observations are equally valid and replay cannot
    choose safely.
    """


class HistoricalReplayOperationNotAllowedError(
    HistoricalEvidenceReplayError
):
    """
    Historical replay received an operation outside its read-only contract.
    """


class HistoricalReplayObservationError(
    HistoricalEvidenceReplayError
):
    """
    Historical observation content cannot safely satisfy a Tool contract.
    """


class HistoricalReplayClockError(
    HistoricalEvidenceReplayError
):
    """
    Historical Replay Clock received an invalid time transition.
    """


class HistoricalReplayClock:
    """
    Monotonic logical clock for one historical Incident replay session.

    The clock starts at the point where the simulated on-call SRE begins
    investigating.

    Historical observations after current_time are invisible.

    Time can move forward explicitly, but it can never move backward.

    One replay session owns one clock. Parallel Incident replays must use
    separate clocks.
    """

    __slots__ = (
        "_current_time",
    )

    def __init__(
        self,
        start_at: datetime,
    ) -> None:
        self._current_time = (
            self._aware_utc(
                start_at,
                name="start_at",
            )
        )

    @property
    def current_time(
        self,
    ) -> datetime:
        return self._current_time

    def advance_to(
        self,
        value: datetime,
    ) -> datetime:
        normalized = self._aware_utc(
            value,
            name="advance_to",
        )

        if normalized < self._current_time:
            raise HistoricalReplayClockError(
                "Historical Replay Clock cannot move backward"
            )

        self._current_time = normalized

        return self._current_time

    def advance(
        self,
        delta: timedelta,
    ) -> datetime:
        if not isinstance(
            delta,
            timedelta,
        ):
            raise HistoricalReplayClockError(
                "Historical Replay Clock delta is invalid"
            )

        if delta < timedelta(0):
            raise HistoricalReplayClockError(
                "Historical Replay Clock cannot move backward"
            )

        return self.advance_to(
            self._current_time
            + delta
        )

    @staticmethod
    def _aware_utc(
        value: datetime,
        *,
        name: str,
    ) -> datetime:
        if (
            not isinstance(
                value,
                datetime,
            )
            or value.tzinfo is None
        ):
            raise HistoricalReplayClockError(
                f"Historical Replay Clock {name} must be timezone-aware"
            )

        return value.astimezone(
            UTC
        )


@dataclass(
    frozen=True,
    slots=True,
)
class HistoricalObservationSelectionPolicy:
    """
    Bounded selection policy for causal historical observations.

    Kubernetes:
    - select the latest snapshot visible at Replay Clock;
    - reject a snapshot that is too old.

    Prometheus:
    - select the latest sample at or before query time;
    - the HistoricalReplayEvidenceTimePolicy performs a second bounded
      freshness validation before evidence crosses into Investigation.
    """

    kubernetes_max_snapshot_age: timedelta = timedelta(
        minutes=10
    )

    def __post_init__(
        self,
    ) -> None:
        if (
            self.kubernetes_max_snapshot_age
            <= timedelta(0)
        ):
            raise ValueError(
                "kubernetes_max_snapshot_age must be positive"
            )

    @property
    def kubernetes_max_event_skew(
        self,
    ) -> timedelta:
        """
        Compatibility alias for the v1 pre-causal field name.
        """

        return self.kubernetes_max_snapshot_age


@dataclass(
    frozen=True,
    slots=True,
)
class HistoricalObservationMatch:
    """
    Historical observation plus trusted scope derived from StandardEvent.
    """

    observation: RealIncidentObservation

    resource: str

    namespace: str

    cluster: str | None


class HistoricalReplayEvidenceTimePolicy:
    """
    Causal time policy for Historical Replay.

    Prometheus queries are anchored to Replay Clock current_time rather than
    always to the original Alert timestamp.

    Evidence must satisfy both:

    observed_at <= Replay Clock

    and

    Replay Clock - observed_at <= prometheus_max_sample_age

    event_offset_seconds remains relative to the original Incident event so
    evaluation can measure when useful evidence became available.
    """

    def __init__(
        self,
        *,
        clock: HistoricalReplayClock,
        prometheus_max_sample_age: timedelta = timedelta(
            minutes=2
        ),
    ) -> None:

        if not isinstance(
            clock,
            HistoricalReplayClock,
        ):
            raise TypeError(
                "Historical Replay time policy requires a Replay Clock"
            )

        if (
            prometheus_max_sample_age
            <= timedelta(0)
        ):
            raise ValueError(
                "prometheus_max_sample_age must be positive"
            )

        self.clock = clock

        self.prometheus_max_sample_age = (
            prometheus_max_sample_age
        )

    def query_time(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> datetime | None:

        if not self._is_prometheus_probe(
            probe
        ):
            return None

        return self.clock.current_time

    def temporal_basis(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> str:

        if scope.event_occurred_at is not None:
            return "incident_time"

        return "historical_observation"

    def validate_observed_at(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        observed_at: datetime,
    ) -> float | None:

        if not self._is_prometheus_probe(
            probe
        ):
            return None

        normalized_observed = (
            self._aware_utc(
                observed_at,
                name="observed_at",
            )
        )

        replay_time = (
            self.clock.current_time
        )

        if normalized_observed > replay_time:
            raise InvestigationEvidenceTimeError(
                "Historical evidence is from the Replay Clock future"
            )

        sample_age = (
            replay_time
            - normalized_observed
        )

        if (
            sample_age
            > self.prometheus_max_sample_age
        ):
            raise InvestigationEvidenceTimeError(
                "Historical Prometheus evidence is stale "
                "for the Replay Clock"
            )

        event_time = (
            self._event_time(
                scope
            )
        )

        if event_time is None:
            return None

        return (
            normalized_observed
            - event_time
        ).total_seconds()

    @staticmethod
    def _is_prometheus_probe(
        probe: InvestigationProbe,
    ) -> bool:
        return probe in {
            InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
            InvestigationProbe.PROMETHEUS_MEMORY_LIMIT,
            InvestigationProbe.PROMETHEUS_RESTART_COUNT,
        }

    @classmethod
    def _event_time(
        cls,
        scope: InvestigationScope,
    ) -> datetime | None:

        value = scope.event_occurred_at

        if value is None:
            return None

        return cls._aware_utc(
            value,
            name="event_occurred_at",
        )

    @staticmethod
    def _aware_utc(
        value: datetime,
        *,
        name: str,
    ) -> datetime:

        if (
            not isinstance(
                value,
                datetime,
            )
            or value.tzinfo is None
        ):
            raise InvestigationEvidenceTimeError(
                f"{name} must be timezone-aware"
            )

        return value.astimezone(
            UTC
        )


class RealIncidentObservationStore:
    """
    Read-only causal selector over one RealIncidentReplaySource.

    The Store knows only replay-safe fields:
    - StandardEvent
    - historical observations

    It has no Ground Truth or human Timeline access.

    Causal visibility invariant:

        observation.observed_at <= replay_clock.current_time

    Future observations never participate in candidate selection.

    Among visible observations the newest applicable snapshot/sample wins.
    """

    def __init__(
        self,
        source: RealIncidentReplaySource,
        *,
        clock: HistoricalReplayClock,
        selection_policy: (
            HistoricalObservationSelectionPolicy
            | None
        ) = None,
    ) -> None:

        if not isinstance(
            source,
            RealIncidentReplaySource,
        ):
            raise TypeError(
                "Historical replay source is invalid"
            )

        if not isinstance(
            clock,
            HistoricalReplayClock,
        ):
            raise TypeError(
                "Historical replay store requires a Replay Clock"
            )

        self.source = source

        self.clock = clock

        self.selection_policy = (
            selection_policy
            if selection_policy is not None
            else HistoricalObservationSelectionPolicy()
        )

        self.event_time = self._aware_utc(
            source.event.header.occurred_at,
            name="event occurred_at",
        )

        if (
            self.clock.current_time
            < self.event_time
        ):
            raise HistoricalReplayClockError(
                "Historical Replay cannot start before the Incident event"
            )

    def select_kubernetes_pod_state(
        self,
        *,
        target: str,
        namespace: str,
    ) -> HistoricalObservationMatch:

        resource = self._resolve_event_resource(
            target=target,
            namespace=namespace,
        )

        replay_time = (
            self.clock.current_time
        )

        match = self._select_latest_visible(
            source="kubernetes",
            kind="pod_state",
            visible_at=replay_time,
            resource=resource,
        )

        snapshot_age = (
            replay_time
            - match.observation.observed_at
        )

        if (
            snapshot_age
            > self.selection_policy.kubernetes_max_snapshot_age
        ):
            raise HistoricalEvidenceNotFoundError(
                "Historical Kubernetes observation "
                "is stale for the Replay Clock"
            )

        return match

    def select_prometheus(
        self,
        *,
        kind: str,
        query: str,
        query_time: Any,
    ) -> HistoricalObservationMatch:

        if (
            not isinstance(
                query,
                str,
            )
            or not query.strip()
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query is invalid"
            )

        resource = (
            self._resolve_prometheus_resource(
                query
            )
        )

        reference_time = (
            self._parse_query_time(
                query_time
            )
        )

        if (
            reference_time
            > self.clock.current_time
        ):
            raise HistoricalReplayClockError(
                "Historical Prometheus query cannot read "
                "beyond the Replay Clock"
            )

        return self._select_latest_visible(
            source="prometheus",
            kind=kind,
            visible_at=reference_time,
            resource=resource,
        )

    def _resolve_event_resource(
        self,
        *,
        target: str,
        namespace: str,
    ):

        target_value = self._required_text(
            target,
            "target",
        )

        namespace_value = self._required_text(
            namespace,
            "namespace",
        )

        matches = []

        for resource in (
            self.source.event.resources
        ):

            resource_name = getattr(
                resource,
                "name",
                None,
            )

            resource_namespace = (
                getattr(
                    resource,
                    "namespace",
                    None,
                )
                or "default"
            )

            if (
                resource_name == target_value
                and resource_namespace
                == namespace_value
            ):
                matches.append(
                    resource
                )

        if not matches:
            raise HistoricalEvidenceNotFoundError(
                "Historical Event resource was not found"
            )

        if len(
            matches
        ) != 1:
            raise HistoricalEvidenceAmbiguousError(
                "Historical Event resource scope is ambiguous"
            )

        return matches[0]

    def _resolve_prometheus_resource(
        self,
        query: str,
    ):

        matches = []

        for resource in (
            self.source.event.resources
        ):

            resource_name = getattr(
                resource,
                "name",
                None,
            )

            if not isinstance(
                resource_name,
                str,
            ):
                continue

            namespace = (
                getattr(
                    resource,
                    "namespace",
                    None,
                )
                or "default"
            )

            cluster = getattr(
                resource,
                "cluster",
                None,
            )

            required_fragments = [
                (
                    'pod="'
                    f'{self._escape_label(resource_name)}'
                    '"'
                ),
                (
                    'namespace="'
                    f'{self._escape_label(namespace)}'
                    '"'
                ),
            ]

            if cluster:
                required_fragments.append(
                    (
                        'cluster="'
                        f'{self._escape_label(cluster)}'
                        '"'
                    )
                )

            if all(
                fragment in query
                for fragment
                in required_fragments
            ):
                matches.append(
                    resource
                )

        if not matches:
            raise HistoricalEvidenceNotFoundError(
                "Historical Prometheus query "
                "does not match an Incident resource"
            )

        if len(
            matches
        ) != 1:
            raise HistoricalEvidenceAmbiguousError(
                "Historical Prometheus resource scope is ambiguous"
            )

        return matches[0]

    def _select_latest_visible(
        self,
        *,
        source: str,
        kind: str,
        visible_at: datetime,
        resource,
    ) -> HistoricalObservationMatch:
        """
        Select newest causally-visible observation.

        Future observations are filtered out before ranking.

        This deliberately replaces the old abs(time-reference) nearest
        selection, which could expose a future sample merely because it was
        closer to the Incident timestamp.
        """

        visible_at = self._aware_utc(
            visible_at,
            name="visible_at",
        )

        if (
            visible_at
            > self.clock.current_time
        ):
            raise HistoricalReplayClockError(
                "Historical observation visibility "
                "cannot exceed the Replay Clock"
            )

        expected_resource = getattr(
            resource,
            "name",
        )

        expected_namespace = (
            getattr(
                resource,
                "namespace",
                None,
            )
            or "default"
        )

        expected_cluster = getattr(
            resource,
            "cluster",
            None,
        )

        candidates: list[
            RealIncidentObservation
        ] = []

        for observation in (
            self.source.observations
        ):

            if (
                observation.source
                .strip()
                .lower()
                != source
            ):
                continue

            if (
                observation.kind
                .strip()
                .lower()
                != kind
            ):
                continue

            if (
                observation.observed_at
                > visible_at
            ):
                continue

            if not self._observation_scope_matches(
                observation=observation,
                resource=expected_resource,
                namespace=expected_namespace,
                cluster=expected_cluster,
            ):
                continue

            candidates.append(
                observation
            )

        if not candidates:
            raise HistoricalEvidenceNotFoundError(
                "No causally-visible historical observation was found"
            )

        candidates.sort(
            key=lambda item: item.observed_at,
            reverse=True,
        )

        if (
            len(
                candidates
            ) > 1
            and candidates[0].observed_at
            == candidates[1].observed_at
        ):
            raise HistoricalEvidenceAmbiguousError(
                "Historical observations have an ambiguous latest timestamp"
            )

        return HistoricalObservationMatch(
            observation=candidates[0],
            resource=expected_resource,
            namespace=expected_namespace,
            cluster=expected_cluster,
        )

    @staticmethod
    def _observation_scope_matches(
        *,
        observation: RealIncidentObservation,
        resource: str,
        namespace: str,
        cluster: str | None,
    ) -> bool:

        metadata = observation.metadata

        if not isinstance(
            metadata,
            Mapping,
        ):
            return True

        metadata_resource = (
            metadata.get(
                "resource"
            )
            or metadata.get(
                "pod"
            )
        )

        if (
            metadata_resource is not None
            and metadata_resource
            != resource
        ):
            return False

        metadata_namespace = (
            metadata.get(
                "namespace"
            )
        )

        if (
            metadata_namespace is not None
            and metadata_namespace
            != namespace
        ):
            return False

        metadata_cluster = (
            metadata.get(
                "cluster"
            )
        )

        if (
            metadata_cluster is not None
            and metadata_cluster
            != cluster
        ):
            return False

        return True

    def _parse_query_time(
        self,
        value: Any,
    ) -> datetime:

        if value is None:
            return self.clock.current_time

        if isinstance(
            value,
            datetime,
        ):
            return self._aware_utc(
                value,
                name="query time",
            )

        if isinstance(
            value,
            bool,
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query time is invalid"
            )

        if isinstance(
            value,
            (
                int,
                float,
            ),
        ):
            try:
                return datetime.fromtimestamp(
                    float(
                        value
                    ),
                    tz=UTC,
                )
            except (
                OverflowError,
                OSError,
                ValueError,
            ) as exc:
                raise HistoricalEvidenceReplayError(
                    "Historical Prometheus query time is invalid"
                ) from exc

        if isinstance(
            value,
            str,
        ):
            text = value.strip()

            if text.endswith(
                "Z"
            ):
                text = (
                    f"{text[:-1]}+00:00"
                )

            try:
                parsed = (
                    datetime.fromisoformat(
                        text
                    )
                )
            except ValueError as exc:
                raise HistoricalEvidenceReplayError(
                    "Historical Prometheus query time is invalid"
                ) from exc

            return self._aware_utc(
                parsed,
                name="query time",
            )

        raise HistoricalEvidenceReplayError(
            "Historical Prometheus query time is invalid"
        )

    @staticmethod
    def _required_text(
        value: Any,
        name: str,
    ) -> str:

        if not isinstance(
            value,
            str,
        ):
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} is invalid"
            )

        normalized = value.strip()

        if not normalized:
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} is invalid"
            )

        return normalized

    @staticmethod
    def _aware_utc(
        value: datetime,
        *,
        name: str,
    ) -> datetime:

        if (
            not isinstance(
                value,
                datetime,
            )
            or value.tzinfo is None
        ):
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} must be timezone-aware"
            )

        return value.astimezone(
            UTC
        )

    @staticmethod
    def _escape_label(
        value: str,
    ) -> str:

        return (
            value
            .replace(
                "\\",
                "\\\\",
            )
            .replace(
                "\n",
                "\\n",
            )
            .replace(
                "\r",
                "\\r",
            )
            .replace(
                '"',
                '\\"',
            )
        )

class HistoricalKubernetesReplayTool(
    BaseTool
):
    """
    Historical replacement for the Runtime "kubernetes" Tool contract.

    It does not call Kubernetes.

    It returns a bounded Pod-state envelope reconstructed exclusively from
    RealIncidentReplaySource observations.
    """

    _READ_ONLY_ACTIONS = {
        "describe",
        "get",
    }

    _POD_RESOURCES = {
        "pod",
        "pods",
    }

    def __init__(
        self,
        store: RealIncidentObservationStore,
    ) -> None:
        self.store = store

    @property
    def name(
        self,
    ) -> str:
        return "kubernetes"

    async def execute(
        self,
        action: str,
        resource: str,
        target: str,
        namespace: str = "default",
        **kwargs: Any,
    ) -> dict[str, Any]:

        normalized_action = self._normalize_text(
            action
        ).lower()

        normalized_resource = self._normalize_text(
            resource
        ).lower()

        if (
            normalized_action
            not in self._READ_ONLY_ACTIONS
        ):
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Kubernetes operation is not read-only"
            )

        if (
            normalized_resource
            not in self._POD_RESOURCES
        ):
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Kubernetes replay supports Pods only"
            )

        match = (
            self.store.select_kubernetes_pod_state(
                target=self._normalize_text(
                    target
                ),
                namespace=self._normalize_text(
                    namespace
                ),
            )
        )

        data = self._bounded_pod_data(
            match.observation.data
        )

        return {
            "success": True,
            "source": "kubernetes",
            "mode": "read_only",
            "production_signal": (
                match.observation.production_signal
            ),
            "observed_at": (
                match.observation
                .observed_at
                .isoformat()
            ),
            "action": normalized_action,
            "resource": "pod",
            "target": match.resource,
            "namespace": match.namespace,
            "cluster": match.cluster,
            "data": data,
        }

    @classmethod
    def _bounded_pod_data(
        cls,
        value: Any,
    ) -> dict[str, Any]:

        if not isinstance(
            value,
            Mapping,
        ):
            raise HistoricalReplayObservationError(
                "Historical Kubernetes observation data is invalid"
            )

        if "phase" not in value:
            raise HistoricalReplayObservationError(
                "Historical Kubernetes phase is missing"
            )

        containers_value = value.get(
            "containers",
            [],
        )

        if not isinstance(
            containers_value,
            list,
        ):
            raise HistoricalReplayObservationError(
                "Historical Kubernetes containers are invalid"
            )

        containers = []

        for item in containers_value[:32]:

            if not isinstance(
                item,
                Mapping,
            ):
                continue

            restart_count = (
                item.get(
                    "restart_count"
                )
            )

            if (
                isinstance(
                    restart_count,
                    bool,
                )
                or not isinstance(
                    restart_count,
                    int,
                )
            ):
                restart_count = None

            containers.append(
                {
                    "restart_count": (
                        restart_count
                    ),
                    "state_reason": (
                        cls._bounded_scalar_text(
                            item.get(
                                "state_reason"
                            )
                        )
                    ),
                    "last_termination_reason": (
                        cls._bounded_scalar_text(
                            item.get(
                                "last_termination_reason"
                            )
                        )
                    ),
                }
            )

        return {
            "phase": cls._bounded_scalar_text(
                value.get(
                    "phase"
                )
            ),
            "ready": cls._optional_bool(
                value.get(
                    "ready"
                )
            ),
            "scheduled": cls._optional_bool(
                value.get(
                    "scheduled"
                )
            ),
            "oom_killed": cls._optional_bool(
                value.get(
                    "oom_killed"
                )
            ),
            "containers": containers,
        }

    @staticmethod
    def _normalize_text(
        value: Any,
    ) -> str:

        if not isinstance(
            value,
            str,
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Kubernetes argument is invalid"
            )

        normalized = value.strip()

        if not normalized:
            raise HistoricalEvidenceReplayError(
                "Historical Kubernetes argument is invalid"
            )

        return normalized

    @staticmethod
    def _bounded_scalar_text(
        value: Any,
    ) -> str | None:

        if value is None:
            return None

        if not isinstance(
            value,
            str,
        ):
            return str(
                value
            )[:256]

        return value[:256]

    @staticmethod
    def _optional_bool(
        value: Any,
    ) -> bool | None:

        if isinstance(
            value,
            bool,
        ):
            return value

        return None


class HistoricalPrometheusReplayTool(
    BaseTool
):
    """
    Historical replacement for the Runtime "prometheus" Tool contract.

    It accepts only the three PromQL templates already generated by
    ReadOnlyInvestigationProbeExecutor.

    No arbitrary metric or network query is executed.
    """

    _METRIC_TO_KIND = {
        "container_memory_working_set_bytes": (
            "memory_working_set"
        ),
        "kube_pod_container_resource_limits": (
            "memory_limit"
        ),
        "kube_pod_container_status_restarts_total": (
            "restart_count"
        ),
    }

    def __init__(
        self,
        store: RealIncidentObservationStore,
    ) -> None:
        self.store = store

    @property
    def name(
        self,
    ) -> str:
        return "prometheus"

    async def execute(
        self,
        query: str,
        time: Any = None,
        **kwargs: Any,
    ) -> dict[str, Any]:

        if (
            not isinstance(
                query,
                str,
            )
            or not query.strip()
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query is invalid"
            )

        kind = self._kind_from_query(
            query
        )

        match = self.store.select_prometheus(
            kind=kind,
            query=query,
            query_time=time,
        )

        numeric_value = (
            self._numeric_value(
                match.observation.data
            )
        )

        observed_at = (
            match.observation
            .observed_at
            .astimezone(
                UTC
            )
        )

        return {
            "success": True,
            "source": "prometheus",
            "mode": "read_only",
            "production_signal": (
                match.observation.production_signal
            ),
            "observed_at": (
                observed_at.isoformat()
            ),
            "query": query,
            "data": {
                "resultType": "vector",
                "result": [
                    {
                        "metric": {
                            "pod": (
                                match.resource
                            ),
                            "namespace": (
                                match.namespace
                            ),
                            **(
                                {
                                    "cluster": (
                                        match.cluster
                                    )
                                }
                                if match.cluster
                                else {}
                            ),
                        },
                        "value": [
                            observed_at.timestamp(),
                            str(
                                numeric_value
                            ),
                        ],
                    }
                ],
            },
        }

    @classmethod
    def _kind_from_query(
        cls,
        query: str,
    ) -> str:

        matches = [
            kind
            for metric, kind
            in cls._METRIC_TO_KIND.items()
            if metric in query
        ]

        if len(
            matches
        ) != 1:
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Prometheus query is outside "
                "the Investigation probe allowlist"
            )

        return matches[0]

    @staticmethod
    def _numeric_value(
        value: Any,
    ) -> float:

        if not isinstance(
            value,
            Mapping,
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus observation data is invalid"
            )

        raw_value = value.get(
            "value"
        )

        if isinstance(
            raw_value,
            bool,
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            )

        try:
            numeric_value = float(
                raw_value
            )
        except (
            TypeError,
            ValueError,
        ) as exc:
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            ) from exc

        if not isfinite(
            numeric_value
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            )

        return numeric_value


@dataclass(
    frozen=True,
    slots=True,
)
class HistoricalReplayEnvironment:
    """
    One causally-consistent historical Investigation environment.

    Tool backend and Probe Time Policy share the exact same Replay Clock.
    """

    clock: HistoricalReplayClock

    tools: ToolManager

    probe_executor: ReadOnlyInvestigationProbeExecutor


def create_historical_replay_tool_manager(
    source: RealIncidentReplaySource,
    *,
    clock: HistoricalReplayClock | None = None,
    selection_policy: (
        HistoricalObservationSelectionPolicy
        | None
    ) = None,
) -> ToolManager:

    resolved_clock = (
        clock
        if clock is not None
        else HistoricalReplayClock(
            source.event.header.occurred_at
        )
    )

    store = RealIncidentObservationStore(
        source,
        clock=resolved_clock,
        selection_policy=selection_policy,
    )

    registry = ToolRegistry()

    registry.register(
        HistoricalKubernetesReplayTool(
            store
        )
    )

    registry.register(
        HistoricalPrometheusReplayTool(
            store
        )
    )

    return ToolManager(
        registry
    )


def create_historical_replay_probe_executor(
    *,
    clock: HistoricalReplayClock,
    prometheus_max_sample_age: timedelta = timedelta(
        minutes=2
    ),
) -> ReadOnlyInvestigationProbeExecutor:

    return ReadOnlyInvestigationProbeExecutor(
        time_policy=(
            HistoricalReplayEvidenceTimePolicy(
                clock=clock,
                prometheus_max_sample_age=(
                    prometheus_max_sample_age
                ),
            )
        )
    )


def create_historical_replay_environment(
    source: RealIncidentReplaySource,
    *,
    start_at: datetime | None = None,
    selection_policy: (
        HistoricalObservationSelectionPolicy
        | None
    ) = None,
    prometheus_max_sample_age: timedelta = timedelta(
        minutes=2
    ),
) -> HistoricalReplayEnvironment:
    """
    Create the preferred Historical Replay composition.

    The Agent's Tool backend and Evidence Time Policy share one monotonic
    Replay Clock, preventing one component from seeing a different historical
    future than another component.

    Default start time is the trusted Incident event timestamp.
    """

    if not isinstance(
        source,
        RealIncidentReplaySource,
    ):
        raise TypeError(
            "Historical replay source is invalid"
        )

    event_time = (
        source.event.header.occurred_at
    )

    resolved_start = (
        start_at
        if start_at is not None
        else event_time
    )

    clock = HistoricalReplayClock(
        resolved_start
    )

    normalized_event_time = (
        event_time.astimezone(
            UTC
        )
    )

    if (
        clock.current_time
        < normalized_event_time
    ):
        raise HistoricalReplayClockError(
            "Historical Replay cannot start before the Incident event"
        )

    tools = (
        create_historical_replay_tool_manager(
            source,
            clock=clock,
            selection_policy=selection_policy,
        )
    )

    probe_executor = (
        create_historical_replay_probe_executor(
            clock=clock,
            prometheus_max_sample_age=(
                prometheus_max_sample_age
            ),
        )
    )

    return HistoricalReplayEnvironment(
        clock=clock,
        tools=tools,
        probe_executor=probe_executor,
    )


__all__ = [
    "HistoricalEvidenceAmbiguousError",
    "HistoricalEvidenceNotFoundError",
    "HistoricalEvidenceReplayError",
    "HistoricalKubernetesReplayTool",
    "HistoricalObservationSelectionPolicy",
    "HistoricalPrometheusReplayTool",
    "HistoricalReplayClock",
    "HistoricalReplayClockError",
    "HistoricalReplayEnvironment",
    "HistoricalReplayEvidenceTimePolicy",
    "HistoricalReplayObservationError",
    "HistoricalReplayOperationNotAllowedError",
    "RealIncidentObservationStore",
    "create_historical_replay_environment",
    "create_historical_replay_probe_executor",
    "create_historical_replay_tool_manager",
]
