SMOKE_SCENARIO_KEYS = (
    "oom_limit_pressure",
    "crashloop_not_memory",
    "conflicting_oom_signal",
)


def scenarios_for_mode(
    mode: str,
) -> list[
    BenchmarkScenario
]:
    if mode == "smoke":
        keys = set(
            SMOKE_SCENARIO_KEYS
        )

        return [
            item
            for item in SCENARIOS
            if item.key in keys
        ]

    if mode == "full":
        return list(
            SCENARIOS
        )

    raise ValueError(
        "Benchmark mode must be smoke or full"
    )


def scenario_by_key(
    key: str,
) -> BenchmarkScenario:
    for item in (
        *SCENARIOS,
        *CHANGE_SCENARIOS,
        *CHANGE_ROLLOUT_EVENT_SCENARIOS,
    ):
        if item.key == key:
            return item

    raise KeyError(
        key
    )


__all__ = [
    "CHANGE_ROLLOUT_EVENT_SCENARIOS",
    "CHANGE_ROLLOUT_EVENT_SCENARIO_KEYS",
    "CHANGE_SCENARIOS",
    "CHANGE_SCENARIO_KEYS",
    "SCENARIOS",
    "SMOKE_SCENARIO_KEYS",
    "scenario_by_key",
    "scenarios_for_mode",
]
