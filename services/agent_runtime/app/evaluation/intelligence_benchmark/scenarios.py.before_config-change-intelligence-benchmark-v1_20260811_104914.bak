def _change_rollout_event_facts(
    *,
    revision_before,
    revision_after,
    image_before,
    image_after,
    rollout_started_at,
    rollout_offset_seconds,
    recent,
    rollout_condition_summary,
    generation_observed,
    rollout_complete,
    rollout_failure_signal,
    rollout_failure_reason,
    events_status,
    events_error_code,
    recent_event_count,
    recent_warning_count,
    recent_event_reasons,
    recent_event_summary,
    replicas_ready=4,
    replicas_available=4,
    replicas_unavailable=0,
):
    """
    Change #002 v2.1 synthetic evidence.

    Keep the retained scalar fact count within the production EvidenceItem
    max_length=32 contract.
    """

    return {
        **_change_facts(
            revision_before=revision_before,
            revision_after=revision_after,
            image_before=image_before,
            image_after=image_after,
            rollout_started_at=(
                rollout_started_at
            ),
            rollout_offset_seconds=(
                rollout_offset_seconds
            ),
            recent=recent,
            replicas_ready=replicas_ready,
            replicas_available=(
                replicas_available
            ),
            replicas_unavailable=(
                replicas_unavailable
            ),
        ),
        "rollout_condition_summary": (
            rollout_condition_summary
        ),
        "generation_observed": (
            generation_observed
        ),
        "rollout_complete": (
            rollout_complete
        ),
        "rollout_failure_signal": (
            rollout_failure_signal
        ),
        "rollout_failure_reason": (
            rollout_failure_reason
        ),
        "events_status": (
            events_status
        ),
        "events_error_code": (
            events_error_code
        ),
        "recent_event_count": (
            recent_event_count
        ),
        "recent_warning_count": (
            recent_warning_count
        ),
        "recent_event_reasons": (
            recent_event_reasons
        ),
        "recent_event_summary": (
            recent_event_summary
        ),
    }


