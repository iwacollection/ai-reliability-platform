CHANGE_EVENT_TIME = datetime(
    2026,
    8,
    11,
    0,
    20,
    tzinfo=UTC,
)


def _change_facts(
    *,
    revision_before,
    revision_after,
    image_before,
    image_after,
    rollout_started_at,
    rollout_offset_seconds,
    recent,
    generation=9,
    observed_generation=9,
    replicas_desired=4,
    replicas_updated=4,
    replicas_ready=4,
    replicas_available=4,
    replicas_unavailable=0,
    history_complete=True,
):
    return {
        "temporal_basis": (
            "workload_change_history"
        ),
        "owner_chain_verified": True,
        "deployment_name": "payment-api",
        "revision_before": revision_before,
        "revision_after": revision_after,
        "revision_changed": (
            (
                revision_before
                != revision_after
            )
            if (
                revision_before is not None
                and revision_after is not None
            )
            else None
        ),
        "image_before": image_before,
        "image_after": image_after,
        "image_changed": (
            (
                image_before
                != image_after
            )
            if (
                image_before is not None
                and image_after is not None
            )
            else None
        ),
        "rollout_started_at": (
            rollout_started_at
        ),
        "rollout_offset_seconds": (
            float(
                rollout_offset_seconds
            )
        ),
        "recent_rollout_before_incident": (
            recent
        ),
        "generation": generation,
        "observed_generation": (
            observed_generation
        ),
        "replicas_desired": replicas_desired,
        "replicas_updated": replicas_updated,
        "replicas_ready": replicas_ready,
        "replicas_available": (
            replicas_available
        ),
        "replicas_unavailable": (
            replicas_unavailable
        ),
        "history_complete": (
            history_complete
        ),
    }


