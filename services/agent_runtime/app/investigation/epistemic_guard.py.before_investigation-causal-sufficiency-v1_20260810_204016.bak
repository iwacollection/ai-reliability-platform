from __future__ import annotations

from dataclasses import dataclass

from services.agent_runtime.app.investigation.models import (
    InvestigationDecision,
    InvestigationState,
    InvestigationStopReason,
)


@dataclass(
    frozen=True,
    slots=True,
)
class EpistemicGuardResult:
    """
    Result of one structural conclusion-admissibility check.

    The guard does not invent, rewrite or semantically classify a root cause.
    It only checks whether a sufficient-evidence conclusion is backed by
    positive support declared on at least one current hypothesis.
    """

    allowed: bool
    code: str | None = None


class EpistemicConclusionGuard:
    """
    Fail-safe evidence-discipline guard for terminal RCA decisions.

    This guard intentionally does NOT:
    - infer a root cause;
    - inspect domain-specific keywords;
    - decide whether an alert is a false positive;
    - replace the Investigation reasoner.

    It only enforces generic epistemic invariants for
    stop_reason=sufficient_evidence:

    1. at least one current hypothesis has positive supporting evidence;
    2. every conclusion evidence ID is positive support for one hypothesis;
    3. conclusion evidence is not conflicting evidence for that hypothesis;
    4. the supporting hypothesis has a minimum confidence;
    5. conclusion confidence may not materially exceed that hypothesis.

    If these invariants are not met, the Coordinator may safely downgrade the
    decision to insufficient_evidence instead of accepting an unsupported RCA.
    """

    def __init__(
        self,
        *,
        min_supported_confidence: float = 0.5,
        max_conclusion_confidence_delta: float = 0.05,
    ) -> None:
        if not (
            0.0
            <= min_supported_confidence
            <= 1.0
        ):
            raise ValueError(
                "min_supported_confidence must be within [0,1]"
            )

        if not (
            0.0
            <= max_conclusion_confidence_delta
            <= 1.0
        ):
            raise ValueError(
                "max_conclusion_confidence_delta must be within [0,1]"
            )

        self.min_supported_confidence = (
            min_supported_confidence
        )

        self.max_conclusion_confidence_delta = (
            max_conclusion_confidence_delta
        )

    def evaluate(
        self,
        *,
        decision: InvestigationDecision,
        state: InvestigationState,
    ) -> EpistemicGuardResult:
        if not isinstance(
            decision,
            InvestigationDecision,
        ):
            raise TypeError(
                "Epistemic guard decision is invalid"
            )

        if not isinstance(
            state,
            InvestigationState,
        ):
            raise TypeError(
                "Epistemic guard state is invalid"
            )

        if (
            not decision.stop
            or decision.stop_reason
            != InvestigationStopReason.SUFFICIENT_EVIDENCE
        ):
            return EpistemicGuardResult(
                allowed=True
            )

        conclusion = (
            decision.conclusion
        )

        if conclusion is None:
            return EpistemicGuardResult(
                allowed=False,
                code="MissingConclusion",
            )

        conclusion_ids = set(
            conclusion.evidence_ids
        )

        if not conclusion_ids:
            return EpistemicGuardResult(
                allowed=False,
                code="MissingConclusionEvidence",
            )

        positively_supported = [
            hypothesis
            for hypothesis
            in decision.hypotheses
            if hypothesis.supporting_evidence_ids
        ]

        if not positively_supported:
            return EpistemicGuardResult(
                allowed=False,
                code="NoPositiveHypothesisSupport",
            )

        support_compatible = []

        for hypothesis in positively_supported:
            supporting_ids = set(
                hypothesis.supporting_evidence_ids
            )

            conflicting_ids = set(
                hypothesis.conflicting_evidence_ids
            )

            if not conclusion_ids.issubset(
                supporting_ids
            ):
                continue

            if conclusion_ids.intersection(
                conflicting_ids
            ):
                continue

            support_compatible.append(
                hypothesis
            )

        if not support_compatible:
            return EpistemicGuardResult(
                allowed=False,
                code="ConclusionEvidenceNotPositiveSupport",
            )

        confidence_compatible = [
            hypothesis
            for hypothesis
            in support_compatible
            if (
                hypothesis.confidence
                >= self.min_supported_confidence
            )
        ]

        if not confidence_compatible:
            return EpistemicGuardResult(
                allowed=False,
                code="SupportedHypothesisConfidenceTooLow",
            )

        for hypothesis in confidence_compatible:
            permitted = min(
                1.0,
                (
                    hypothesis.confidence
                    + self.max_conclusion_confidence_delta
                ),
            )

            if (
                conclusion.confidence
                <= permitted
            ):
                return EpistemicGuardResult(
                    allowed=True
                )

        return EpistemicGuardResult(
            allowed=False,
            code="ConclusionConfidenceExceedsSupport",
        )


__all__ = [
    "EpistemicConclusionGuard",
    "EpistemicGuardResult",
]
