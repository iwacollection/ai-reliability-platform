from __future__ import annotations

from dataclasses import dataclass
import re

from services.agent_runtime.app.investigation.models import (
    InvestigationDecision,
    InvestigationProbe,
    InvestigationState,
    InvestigationStopReason,
)


@dataclass(
    frozen=True,
    slots=True,
)
class EpistemicGuardResult:
    """
    Result of one structural conclusion-admissibility check.

    The guard does not invent, rewrite or semantically classify a root cause.
    It only checks whether a sufficient-evidence conclusion is backed by
    positive support declared on at least one current hypothesis.
    """

    allowed: bool
    code: str | None = None


class EpistemicConclusionGuard:
    """
    Fail-safe evidence-discipline guard for terminal RCA decisions.

    This guard intentionally does NOT:
    - infer a root cause;
    - inspect domain-specific keywords;
    - decide whether an alert is a false positive;
    - replace the Investigation reasoner.

    It only enforces generic epistemic invariants for
    stop_reason=sufficient_evidence:

    1. at least one current hypothesis has positive supporting evidence;
    2. every conclusion evidence ID is positive support for one hypothesis;
    3. conclusion evidence is not conflicting evidence for that hypothesis;
    4. the supporting hypothesis has a minimum confidence;
    5. the positively supported hypothesis used for the conclusion has no
       unresolved root-cause-critical missing_evidence;
       optional_evidence is explicitly non-blocking corroboration;
    6. conclusion confidence may not materially exceed that hypothesis.

    If these invariants are not met, the Coordinator may safely downgrade the
    decision to insufficient_evidence instead of accepting an unsupported RCA.
    """

    def __init__(
        self,
        *,
        min_supported_confidence: float = 0.5,
        max_conclusion_confidence_delta: float = 0.05,
        min_memory_limit_pressure_ratio: float = 0.90,
    ) -> None:
        if not (
            0.0
            <= min_supported_confidence
            <= 1.0
        ):
            raise ValueError(
                "min_supported_confidence must be within [0,1]"
            )

        if not (
            0.0
            <= max_conclusion_confidence_delta
            <= 1.0
        ):
            raise ValueError(
                "max_conclusion_confidence_delta must be within [0,1]"
            )

        if not (
            0.0
            <= min_memory_limit_pressure_ratio
            <= 1.0
        ):
            raise ValueError(
                "min_memory_limit_pressure_ratio must be within [0,1]"
            )

        self.min_supported_confidence = (
            min_supported_confidence
        )

        self.max_conclusion_confidence_delta = (
            max_conclusion_confidence_delta
        )

        self.min_memory_limit_pressure_ratio = (
            min_memory_limit_pressure_ratio
        )

    def evaluate(
        self,
        *,
        decision: InvestigationDecision,
        state: InvestigationState,
    ) -> EpistemicGuardResult:
        if not isinstance(
            decision,
            InvestigationDecision,
        ):
            raise TypeError(
                "Epistemic guard decision is invalid"
            )

        if not isinstance(
            state,
            InvestigationState,
        ):
            raise TypeError(
                "Epistemic guard state is invalid"
            )

        if (
            not decision.stop
            or decision.stop_reason
            != InvestigationStopReason.SUFFICIENT_EVIDENCE
        ):
            return EpistemicGuardResult(
                allowed=True
            )

        conclusion = (
            decision.conclusion
        )

        if conclusion is None:
            return EpistemicGuardResult(
                allowed=False,
                code="MissingConclusion",
            )

        conclusion_ids = set(
            conclusion.evidence_ids
        )

        if not conclusion_ids:
            return EpistemicGuardResult(
                allowed=False,
                code="MissingConclusionEvidence",
            )

        positively_supported = [
            hypothesis
            for hypothesis
            in decision.hypotheses
            if hypothesis.supporting_evidence_ids
        ]

        if not positively_supported:
            return EpistemicGuardResult(
                allowed=False,
                code="NoPositiveHypothesisSupport",
            )

        support_compatible = []

        for hypothesis in positively_supported:
            supporting_ids = set(
                hypothesis.supporting_evidence_ids
            )

            conflicting_ids = set(
                hypothesis.conflicting_evidence_ids
            )

            if not conclusion_ids.issubset(
                supporting_ids
            ):
                continue

            if conclusion_ids.intersection(
                conflicting_ids
            ):
                continue

            support_compatible.append(
                hypothesis
            )

        if not support_compatible:
            return EpistemicGuardResult(
                allowed=False,
                code="ConclusionEvidenceNotPositiveSupport",
            )

        # Only root-cause-blocking missing_evidence prevents a terminal RCA.
        # optional_evidence is deliberately ignored here: it is corroboration,
        # not a prerequisite for accepting the supported cause.
        causally_complete = [
            hypothesis
            for hypothesis
            in support_compatible
            if not hypothesis.missing_evidence
        ]

        if not causally_complete:
            return EpistemicGuardResult(
                allowed=False,
                code="SupportedHypothesisStillMissingEvidence",
            )

        change_causally_grounded = [
            hypothesis
            for hypothesis
            in causally_complete
            if self._change_support_is_causally_grounded(
                hypothesis=hypothesis,
                conclusion=conclusion,
                state=state,
            )
        ]

        if not change_causally_grounded:
            return EpistemicGuardResult(
                allowed=False,
                code="ChangeEvidenceRequiresIndependentSupport",
            )

        quantitatively_consistent = [
            hypothesis
            for hypothesis
            in change_causally_grounded
            if self._memory_limit_support_is_consistent(
                hypothesis=hypothesis,
                conclusion=conclusion,
                state=state,
            )
        ]

        if not quantitatively_consistent:
            return EpistemicGuardResult(
                allowed=False,
                code="MemoryLimitEvidenceNotNearThreshold",
            )

        confidence_compatible = [
            hypothesis
            for hypothesis
            in quantitatively_consistent
            if (
                hypothesis.confidence
                >= self.min_supported_confidence
            )
        ]

        if not confidence_compatible:
            return EpistemicGuardResult(
                allowed=False,
                code="SupportedHypothesisConfidenceTooLow",
            )

        for hypothesis in confidence_compatible:
            permitted = min(
                1.0,
                (
                    hypothesis.confidence
                    + self.max_conclusion_confidence_delta
                ),
            )

            if (
                conclusion.confidence
                <= permitted
            ):
                return EpistemicGuardResult(
                    allowed=True
                )

        return EpistemicGuardResult(
            allowed=False,
            code="ConclusionConfidenceExceedsSupport",
        )

    @staticmethod
    def _change_support_is_causally_grounded(
        *,
        hypothesis,
        conclusion,
        state: InvestigationState,
    ) -> bool:
        """
        Change evidence is temporal/correlation evidence.

        A sufficient RCA that cites workload-change evidence must also cite at
        least one independent trusted non-change evidence item as positive
        support for the same hypothesis. This prevents "deploy happened before
        incident" from becoming causal proof by itself.
        """

        trusted_ids = {
            item.evidence_id
            for item in state.evidence
            if (
                item.success
                and item.trusted
                and item.production_signal
            )
        }

        change_ids = {
            item.evidence_id
            for item in state.evidence
            if (
                item.success
                and item.trusted
                and item.production_signal
                and item.probe
                == InvestigationProbe.KUBERNETES_WORKLOAD_CHANGE
            )
        }

        conclusion_ids = set(
            conclusion.evidence_ids
        )

        used_change_ids = (
            conclusion_ids
            .intersection(
                change_ids
            )
        )

        if not used_change_ids:
            return True

        positive_ids = (
            set(
                hypothesis.supporting_evidence_ids
            )
            .intersection(
                conclusion_ids
            )
            .intersection(
                trusted_ids
            )
        )

        independent_ids = (
            positive_ids
            - change_ids
        )

        return bool(
            independent_ids
        )

    def _memory_limit_support_is_consistent(
        self,
        *,
        hypothesis,
        conclusion,
        state: InvestigationState,
    ) -> bool:
        """
        Deterministic consistency policy for one explicit threshold mechanism.

        This does not infer a memory RCA. It only checks a model-proposed
        positive claim that a configured container memory limit was exceeded.

        The check deliberately uses ALL trusted production memory evidence
        already present in InvestigationState, not only evidence IDs the model
        chose to cite. This prevents evidence cherry-picking: a model may not
        ignore sampled working-set/limit observations and claim that pod-state
        evidence alone proves a specific memory-limit threshold mechanism.

        For this specific threshold claim:
        - working-set and limit evidence must exist when the claim is made;
        - the strongest observed sampled pressure must be near the limit;
        - both mechanism evidence IDs must be present in hypothesis positive
          support and in the final conclusion grounding.

        A far-below-limit sample does not prove that no historical spike ever
        happened. It only means the currently available sampled metrics do not
        positively establish the specific "memory limit exceeded" mechanism,
        so sufficient_evidence is not admissible yet.
        """

        claim_text = (
            hypothesis.cause
            + " "
            + conclusion.root_cause
        ).strip().lower()

        negative_patterns = (
            "not exceeded",
            "did not exceed",
            "below the limit",
            "within the limit",
        )

        if any(
            pattern in claim_text
            for pattern in negative_patterns
        ):
            return True

        claims_limit_exceeded = (
            "memory" in claim_text
            and "limit" in claim_text
            and bool(
                re.search(
                    r"\b(exceed(?:ed|s|ing)?|exhaust(?:ed|ion)?|too\s+low)\b",
                    claim_text,
                )
            )
        )

        if not claims_limit_exceeded:
            return True

        trusted_working = []
        trusted_limits = []

        for item in state.evidence:
            if not (
                item.success
                and item.trusted
                and item.production_signal
            ):
                continue

            if (
                item.probe.value
                == "prometheus_memory_working_set"
            ):
                value = self._numeric_evidence_value(
                    item.facts
                )

                if value is not None:
                    trusted_working.append(
                        (
                            item.evidence_id,
                            value,
                        )
                    )

            elif (
                item.probe.value
                == "prometheus_memory_limit"
            ):
                value = self._numeric_evidence_value(
                    item.facts
                )

                if (
                    value is not None
                    and value > 0.0
                ):
                    trusted_limits.append(
                        (
                            item.evidence_id,
                            value,
                        )
                    )

        if (
            not trusted_working
            or not trusted_limits
        ):
            # No complete comparable numeric pair exists.
            #
            # This threshold-specific policy must not replace the generic
            # Epistemic Guard for pod-only, limit-only, working-only, or
            # non-numeric placeholder evidence. In those cases there is no
            # quantitative contradiction for this policy to evaluate.
            return True

        working_id, working = max(
            trusted_working,
            key=lambda item: item[1],
        )

        limit_id, limit = min(
            trusted_limits,
            key=lambda item: item[1],
        )

        ratio = (
            working
            / limit
        )

        if (
            ratio
            < self.min_memory_limit_pressure_ratio
        ):
            return False

        support_ids = set(
            hypothesis.supporting_evidence_ids
        )

        conclusion_ids = set(
            conclusion.evidence_ids
        )

        required_ids = {
            working_id,
            limit_id,
        }

        return (
            required_ids.issubset(
                support_ids
            )
            and required_ids.issubset(
                conclusion_ids
            )
        )

    @staticmethod
    def _numeric_evidence_value(
        facts,
    ) -> float | None:
        for key in (
            "value_max",
            "value_sum",
        ):
            value = facts.get(
                key
            )

            if isinstance(
                value,
                (
                    int,
                    float,
                ),
            ) and not isinstance(
                value,
                bool,
            ):
                return float(
                    value
                )

        return None


__all__ = [
    "EpistemicConclusionGuard",
    "EpistemicGuardResult",
]
