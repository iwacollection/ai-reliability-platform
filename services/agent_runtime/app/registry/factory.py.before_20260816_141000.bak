from services.agent_runtime.app.agents.change.agent import (
    ChangeAgent,
)
from services.agent_runtime.app.agents.diagnosis.agent import (
    DiagnosisAgent,
)
from services.agent_runtime.app.agents.healing.agent import (
    HealingAgent,
)
from services.agent_runtime.app.agents.noise.agent import (
    NoiseAgent,
)
from services.agent_runtime.app.agents.rca.agent import (
    RCAAgent,
)
from services.agent_runtime.app.llm.gateway.factory import (
    create_llm_gateway,
)
from services.agent_runtime.app.llm.gateway.gateway import (
    LLMGateway,
)
from services.agent_runtime.app.observation.factory import (
    create_observation_manager,
)
from services.agent_runtime.app.registry.agent_registry import (
    AgentRegistry,
)


def create_agent_registry(
    llm_gateway: LLMGateway | None = None,
) -> AgentRegistry:
    """
    Create and initialize the Agent Registry.

    A caller may inject one Runtime-owned shared LLM Gateway. When no
    Gateway is supplied, this factory retains standalone compatibility by
    creating one through the centralized Gateway factory.

    Noise, RCA and Healing must receive the same Gateway object.
    """

    if (
        llm_gateway is not None
        and not isinstance(
            llm_gateway,
            LLMGateway,
        )
    ):
        raise TypeError(
            "Agent Registry shared LLM gateway is invalid"
        )

    resolved_llm_gateway = (
        llm_gateway
        if llm_gateway is not None
        else create_llm_gateway()
    )

    registry = AgentRegistry()

    observation_manager = (
        create_observation_manager()
    )

    registry.register(
        NoiseAgent(
            resolved_llm_gateway,
        )
    )

    registry.register(
        DiagnosisAgent(
            observation_manager,
        )
    )

    registry.register(
        RCAAgent(
            resolved_llm_gateway,
        )
    )

    registry.register(
        HealingAgent(
            resolved_llm_gateway,
        )
    )

    registry.register(
        ChangeAgent()
    )

    return registry


__all__ = [
    "create_agent_registry",
]
