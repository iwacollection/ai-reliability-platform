from services.agent_runtime.app.agents.change.agent import (
    ChangeAgent,
)
from services.agent_runtime.app.agents.diagnosis.agent import (
    DiagnosisAgent,
)
from services.agent_runtime.app.agents.healing.agent import (
    HealingAgent,
)
from services.agent_runtime.app.agents.noise.agent import (
    NoiseAgent,
)
from services.agent_runtime.app.agents.rca.agent import (
    RCAAgent,
)
from services.agent_runtime.app.llm.gateway.factory import (
    create_shared_llm_gateway,
)
from services.agent_runtime.app.llm.gateway.gateway import (
    LLMGateway,
)
from services.agent_runtime.app.observation.factory import (
    create_observation_manager,
)
from services.agent_runtime.app.registry.agent_registry import (
    AgentRegistry,
)


def create_agent_registry(
    llm_gateway: LLMGateway | None = None,
) -> AgentRegistry:
    """
    Create the Agent registry with one shared LLM Gateway.

    Direct callers remain compatible: when no Gateway is supplied the factory
    constructs one. AgentRuntime supplies its owned Gateway so Noise, RCA,
    Healing and Investigation can share routing and protection state.
    """

    resolved_llm_gateway = (
        llm_gateway
        if llm_gateway is not None
        else create_shared_llm_gateway()
    )

    if not callable(
        getattr(
            resolved_llm_gateway,
            "chat",
            None,
        )
    ):
        raise TypeError(
            "Agent registry LLM gateway is invalid"
        )

    observation_manager = (
        create_observation_manager()
    )
    registry = AgentRegistry()

    registry.register(
        NoiseAgent(
            resolved_llm_gateway,
        )
    )
    registry.register(
        DiagnosisAgent(
            observation_manager,
        )
    )
    registry.register(
        RCAAgent(
            resolved_llm_gateway,
        )
    )
    registry.register(
        HealingAgent(
            resolved_llm_gateway,
        )
    )
    registry.register(
        ChangeAgent()
    )

    return registry
