from __future__ import annotations

import asyncio
import sqlite3
from pathlib import Path
from uuid import UUID

from services.agent_runtime.app.action.preflight_artifact_models import (
    PreflightArtifactRecord,
    PreflightArtifactStatus,
)


class PreflightArtifactConflictError(RuntimeError):
    """Artifact idempotency or Approval binding conflicts with stored state."""


class PreflightArtifactStore:
    """
    SQLite-backed immutable trusted preflight artifact store.

    One row is permitted per Artifact ID and per Incident/idempotency key. The
    only update is a compare-and-set transition from PREPARED to
    APPROVAL_BOUND. The artifact JSON itself is never replaced.
    """

    def __init__(self, db_path: str | Path | None = None) -> None:
        self.db_path = Path(
            db_path or (Path("data") / "preflight_artifacts.db")
        )
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self._init_db()

    def _connect(self) -> sqlite3.Connection:
        connection = sqlite3.connect(self.db_path, timeout=10.0)
        connection.execute("PRAGMA busy_timeout = 10000")
        return connection

    def _init_db(self) -> None:
        with self._connect() as connection:
            connection.execute("PRAGMA journal_mode = WAL")
            connection.execute("PRAGMA synchronous = FULL")
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS preflight_artifacts
                (
                    artifact_id TEXT PRIMARY KEY,
                    incident_id TEXT NOT NULL,
                    idempotency_key TEXT NOT NULL,
                    status TEXT NOT NULL,
                    approval_id TEXT UNIQUE,
                    record_data TEXT NOT NULL,
                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,
                    UNIQUE (incident_id, idempotency_key)
                )
                """
            )
            connection.execute(
                """
                CREATE INDEX IF NOT EXISTS idx_preflight_artifacts_incident
                ON preflight_artifacts (incident_id, created_at, artifact_id)
                """
            )
            connection.execute(
                """
                CREATE INDEX IF NOT EXISTS idx_preflight_artifacts_status
                ON preflight_artifacts (status)
                """
            )

    async def insert_prepared(
        self,
        record: PreflightArtifactRecord,
    ) -> PreflightArtifactRecord:
        return await asyncio.to_thread(self._insert_prepared_sync, record)

    def _insert_prepared_sync(
        self,
        record: PreflightArtifactRecord,
    ) -> PreflightArtifactRecord:
        if record.status != PreflightArtifactStatus.PREPARED:
            raise ValueError("Only a PREPARED Artifact can be inserted")
        if record.approval_id is not None:
            raise ValueError("A new Artifact cannot already have an Approval")

        record_data = self._serialize(record)
        try:
            with self._connect() as connection:
                connection.execute(
                    """
                    INSERT INTO preflight_artifacts
                    (
                        artifact_id,
                        incident_id,
                        idempotency_key,
                        status,
                        approval_id,
                        record_data,
                        created_at,
                        updated_at
                    )
                    VALUES (?, ?, ?, ?, NULL, ?, ?, ?)
                    """,
                    (
                        str(record.artifact_id),
                        str(record.incident_id),
                        record.idempotency_key,
                        record.status.value,
                        record_data,
                        record.created_at.isoformat(),
                        record.updated_at.isoformat(),
                    ),
                )
        except sqlite3.IntegrityError as exc:
            raise PreflightArtifactConflictError(
                "Preflight Artifact or idempotency key already exists"
            ) from exc

        return self._deserialize(record_data)

    async def get(
        self,
        artifact_id: UUID | str,
    ) -> PreflightArtifactRecord | None:
        return await asyncio.to_thread(
            self._get_by_column_sync,
            "artifact_id",
            str(artifact_id),
        )

    async def get_by_request(
        self,
        incident_id: UUID | str,
        idempotency_key: str,
    ) -> PreflightArtifactRecord | None:
        return await asyncio.to_thread(
            self._get_by_request_sync,
            str(incident_id),
            idempotency_key,
        )

    def _get_by_request_sync(
        self,
        incident_id: str,
        idempotency_key: str,
    ) -> PreflightArtifactRecord | None:
        with self._connect() as connection:
            row = connection.execute(
                """
                SELECT record_data
                FROM preflight_artifacts
                WHERE incident_id = ? AND idempotency_key = ?
                """,
                (incident_id, idempotency_key),
            ).fetchone()
        return None if row is None else self._deserialize(row[0])

    def _get_by_column_sync(
        self,
        column: str,
        value: str,
    ) -> PreflightArtifactRecord | None:
        if column not in {"artifact_id", "approval_id"}:
            raise ValueError("Unsupported Preflight Artifact lookup")
        with self._connect() as connection:
            row = connection.execute(
                f"SELECT record_data FROM preflight_artifacts WHERE {column} = ?",
                (value,),
            ).fetchone()
        return None if row is None else self._deserialize(row[0])

    async def bind_approval(
        self,
        record: PreflightArtifactRecord,
    ) -> PreflightArtifactRecord:
        return await asyncio.to_thread(self._bind_approval_sync, record)

    def _bind_approval_sync(
        self,
        record: PreflightArtifactRecord,
    ) -> PreflightArtifactRecord:
        if record.status != PreflightArtifactStatus.APPROVAL_BOUND:
            raise ValueError("Approval binding requires APPROVAL_BOUND status")
        if record.approval_id is None:
            raise ValueError("Approval binding requires an Approval ID")

        record_data = self._serialize(record)
        connection = self._connect()
        try:
            connection.execute("BEGIN IMMEDIATE")
            current_row = connection.execute(
                """
                SELECT record_data
                FROM preflight_artifacts
                WHERE artifact_id = ?
                """,
                (str(record.artifact_id),),
            ).fetchone()
            if current_row is None:
                raise ValueError(
                    f"Preflight Artifact not found: {record.artifact_id}"
                )

            current = self._deserialize(current_row[0])
            if current.status == PreflightArtifactStatus.APPROVAL_BOUND:
                if current.approval_id == record.approval_id:
                    connection.commit()
                    return current
                raise PreflightArtifactConflictError(
                    "Preflight Artifact is bound to another Approval"
                )

            if not self._same_immutable_artifact(current, record):
                raise PreflightArtifactConflictError(
                    "Preflight Artifact content changed before Approval binding"
                )

            try:
                cursor = connection.execute(
                    """
                    UPDATE preflight_artifacts
                    SET status = ?, approval_id = ?, record_data = ?, updated_at = ?
                    WHERE artifact_id = ? AND status = ? AND approval_id IS NULL
                    """,
                    (
                        record.status.value,
                        record.approval_id,
                        record_data,
                        record.updated_at.isoformat(),
                        str(record.artifact_id),
                        PreflightArtifactStatus.PREPARED.value,
                    ),
                )
            except sqlite3.IntegrityError as exc:
                raise PreflightArtifactConflictError(
                    "Approval is already bound to another Preflight Artifact"
                ) from exc

            if cursor.rowcount != 1:
                raise PreflightArtifactConflictError(
                    "Concurrent Preflight Artifact Approval binding conflict"
                )
            connection.commit()
            return self._deserialize(record_data)
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()

    async def list_by_incident(
        self,
        incident_id: UUID | str,
    ) -> list[PreflightArtifactRecord]:
        return await asyncio.to_thread(
            self._list_by_incident_sync,
            str(incident_id),
        )

    def _list_by_incident_sync(
        self,
        incident_id: str,
    ) -> list[PreflightArtifactRecord]:
        with self._connect() as connection:
            rows = connection.execute(
                """
                SELECT record_data
                FROM preflight_artifacts
                WHERE incident_id = ?
                ORDER BY created_at ASC, artifact_id ASC
                """,
                (incident_id,),
            ).fetchall()
        return [self._deserialize(row[0]) for row in rows]

    @staticmethod
    def _same_immutable_artifact(
        left: PreflightArtifactRecord,
        right: PreflightArtifactRecord,
    ) -> bool:
        return (
            left.artifact_id == right.artifact_id
            and left.incident_id == right.incident_id
            and left.idempotency_key == right.idempotency_key
            and left.artifact == right.artifact
            and left.created_at == right.created_at
        )

    @staticmethod
    def _serialize(record: PreflightArtifactRecord) -> str:
        return record.model_dump_json()

    @staticmethod
    def _deserialize(value: str) -> PreflightArtifactRecord:
        return PreflightArtifactRecord.model_validate_json(value)


__all__ = [
    "PreflightArtifactConflictError",
    "PreflightArtifactStore",
]
