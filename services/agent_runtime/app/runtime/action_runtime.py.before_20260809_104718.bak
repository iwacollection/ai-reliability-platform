from services.agent_runtime.app.action.execution_models import (
    ActionExecutionRecord,
    ActionExecutionStatus,
)

from services.agent_runtime.app.action.execution_service import (
    ActionExecutionService,
)

from services.agent_runtime.app.action.execution_store import (
    ActionExecutionConflictError,
)

from services.agent_runtime.app.action.mock_executor import (
    MockExecutor,
)

from services.agent_runtime.app.action.models import (
    ActionPlan,
)

from services.agent_runtime.app.action.planner import (
    ActionPlanner,
)

from services.agent_runtime.app.approval.models import (
    ApprovalStatus,
)

from services.agent_runtime.app.approval.service import (
    ApprovalService,
)

from services.agent_runtime.app.incident.enums import (
    IncidentStatus,
)

from services.agent_runtime.app.incident.state import (
    IncidentState,
)

from services.agent_runtime.app.incident.store import (
    IncidentConflictError,
    IncidentStore,
)

from services.agent_runtime.app.model.result import (
    AgentResult,
)

from services.agent_runtime.app.policy.engine import (
    PolicyEngine,
)


class ActionRuntime:
    """
    Handle HealingAgent results and action execution.

    Approved resume calls can use a durable ActionExecutionService claim.
    Only the caller that creates a claim may invoke the executor. Every
    replay returns the persisted state without launching the action again.

    Direct execute() and ActionRuntime instances without an injected
    ActionExecutionService retain their legacy behavior during the staged
    migration. Once the service is injected, resume() fails closed unless an
    operator ID and a dedicated execution idempotency key are supplied.
    """

    def __init__(
        self,
        approval_service: ApprovalService | None = None,
        incident_store: IncidentStore | None = None,
        action_execution_service: (
            ActionExecutionService | None
        ) = None,
    ) -> None:
        self.planner = ActionPlanner()

        self.policy = PolicyEngine()

        self.approval = (
            approval_service
            or ApprovalService()
        )

        self.incident_store = (
            incident_store
        )

        self.action_execution_service = (
            action_execution_service
        )

        self.executor = MockExecutor()

    async def execute(
        self,
        healing_result: dict,
        incident: IncidentState | None = None,
        *,
        namespace: str | None = None,
        cluster: str | None = None,
    ):
        """
        Convert a HealingAgent result into an ActionPlan.

        When approval is required, the ApprovalRequest is linked
        to the current Incident.
        """

        plan = self.planner.create_plan(
            AgentResult(
                **healing_result
            )
        )

        self._apply_trusted_scope(
            plan=plan,
            namespace=namespace,
            cluster=cluster,
        )

        decision = self.policy.evaluate(
            plan
        )

        if decision.require_human:
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.CONFIRMED
                ),
                reason=(
                    "Remediation action is waiting "
                    "for human approval"
                ),
            )

            approval = (
                await self.approval.create_approval(
                    action=plan,
                    reason=decision.reason,
                    incident_id=(
                        incident.id
                        if incident is not None
                        else None
                    ),
                )
            )

            return plan, {
                "success": False,
                "status": "pending_approval",
                "approval_id": approval.id,
                "incident_id": (
                    str(approval.incident_id)
                    if approval.incident_id is not None
                    else None
                ),
                "action": plan.type.value,
                "target": plan.target,
                "reason": decision.reason,
                "approval": approval.model_dump(
                    mode="json"
                ),
            }

        if not decision.approved:
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.CONFIRMED
                ),
                reason=(
                    "Remediation action was blocked "
                    f"by policy: {decision.reason}"
                ),
            )

            return plan, {
                "success": False,
                "status": "blocked",
                "incident_id": (
                    str(incident.id)
                    if incident is not None
                    else None
                ),
                "policy_decision": (
                    decision.model_dump(
                        mode="json"
                    )
                ),
            }

        result = await self._execute_action(
            plan=plan,
            incident=incident,
        )

        return plan, result

    async def resume(
        self,
        approval_id: str,
        incident: IncidentState | None = None,
        *,
        operator_id: str | None = None,
        idempotency_key: str | None = None,
    ):
        """
        Resume action execution after human approval.

        With ActionExecutionService injected, operator_id and the execution
        idempotency_key are mandatory. The claim is persisted before any
        Incident transition or executor call.

        Without ActionExecutionService, calls that omit both identity fields
        retain the legacy behavior temporarily. Supplying execution identity
        without a configured service fails closed.
        """

        approval = await self.approval.get(
            approval_id
        )

        if approval is None:
            return {
                "success": False,
                "status": "approval_not_found",
            }

        if (
            approval.status
            != ApprovalStatus.APPROVED
        ):
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.CONFIRMED
                ),
                reason=(
                    "Remediation action is still "
                    "waiting for approval"
                ),
            )

            return {
                "success": False,
                "status": "approval_not_approved",
                "current_status": approval.status.value,
                "incident_id": (
                    str(approval.incident_id)
                    if approval.incident_id is not None
                    else None
                ),
            }

        if (
            approval.incident_id is not None
            and incident is None
        ):
            if self.incident_store is None:
                return {
                    "success": False,
                    "status": "incident_context_required",
                    "incident_id": str(
                        approval.incident_id
                    ),
                }

            incident = (
                await self.incident_store.get(
                    str(
                        approval.incident_id
                    )
                )
            )

            if incident is None:
                return {
                    "success": False,
                    "status": "incident_not_found",
                    "incident_id": str(
                        approval.incident_id
                    ),
                }

        if (
            approval.incident_id is not None
            and incident is not None
            and approval.incident_id
            != incident.id
        ):
            return {
                "success": False,
                "status": "incident_mismatch",
                "approval_incident_id": str(
                    approval.incident_id
                ),
                "provided_incident_id": str(
                    incident.id
                ),
            }

        if self.action_execution_service is None:
            if (
                operator_id is not None
                or idempotency_key is not None
            ):
                return {
                    "success": False,
                    "status": (
                        "action_execution_not_configured"
                    ),
                    "approval_id": approval.id,
                    "incident_id": (
                        str(approval.incident_id)
                        if approval.incident_id is not None
                        else None
                    ),
                }

            return await self._execute_action(
                plan=approval.action,
                incident=incident,
            )

        if (
            operator_id is None
            or idempotency_key is None
        ):
            return {
                "success": False,
                "status": "execution_identity_required",
                "approval_id": approval.id,
                "incident_id": (
                    str(approval.incident_id)
                    if approval.incident_id is not None
                    else None
                ),
                "required_fields": [
                    "operator_id",
                    "idempotency_key",
                ],
            }

        try:
            claim = (
                await self.action_execution_service.claim(
                    approval_id=approval.id,
                    incident_id=approval.incident_id,
                    operator_id=operator_id,
                    idempotency_key=idempotency_key,
                    action=approval.action,
                    metadata={
                        "source": "action_runtime.resume",
                    },
                )
            )

        except ActionExecutionConflictError as exc:
            return {
                "success": False,
                "status": "execution_conflict",
                "approval_id": approval.id,
                "incident_id": (
                    str(approval.incident_id)
                    if approval.incident_id is not None
                    else None
                ),
                "reason": str(exc),
            }

        except ValueError as exc:
            return {
                "success": False,
                "status": "invalid_execution_identity",
                "approval_id": approval.id,
                "incident_id": (
                    str(approval.incident_id)
                    if approval.incident_id is not None
                    else None
                ),
                "reason": str(exc),
            }

        if not claim.created:
            return self._build_execution_replay_result(
                execution=claim.execution,
                incident=incident,
            )

        return await self._execute_claimed_action(
            execution=claim.execution,
            incident=incident,
        )

    async def _execute_claimed_action(
        self,
        execution: ActionExecutionRecord,
        incident: IncidentState | None,
    ) -> dict:
        """
        Invoke the executor only for a newly persisted execution claim.
        """

        if self.action_execution_service is None:
            raise RuntimeError(
                "ActionExecutionService is required"
            )

        execution_id = str(
            execution.id
        )

        try:
            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Executing claimed remediation action: "
                    f"{execution.action.type.value}"
                ),
            )

        except Exception as exc:
            failure_result = {
                "success": False,
                "status": "incident_transition_failed",
                "action": execution.action.type.value,
                "target": execution.action.target,
                "error": str(exc),
                "error_type": type(exc).__name__,
            }

            completed = (
                await self.action_execution_service.fail(
                    execution_id,
                    failure_result,
                    error_type=type(exc).__name__,
                    error_message=str(exc),
                )
            )

            return self._decorate_execution_result(
                result=failure_result,
                execution=completed,
                incident=incident,
                idempotent_replay=False,
            )

        try:
            executor_result = await self.executor.execute(
                execution.action
            )

        except Exception as exc:
            reason = (
                "Remediation executor raised "
                f"{type(exc).__name__}: {exc}; "
                "external outcome requires reconciliation"
            )

            frozen = (
                await self.action_execution_service.mark_indeterminate(
                    execution_id,
                    reason,
                )
            )

            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Remediation action outcome is "
                    "indeterminate; reconciliation is required"
                ),
            )

            result = {
                "success": False,
                "status": "execution_indeterminate",
                "action": execution.action.type.value,
                "target": execution.action.target,
                "error": str(exc),
                "error_type": type(exc).__name__,
                "requires_reconciliation": True,
            }

            return self._decorate_execution_result(
                result=result,
                execution=frozen,
                incident=incident,
                idempotent_replay=False,
            )

        if not isinstance(
            executor_result,
            dict,
        ):
            frozen = (
                await self.action_execution_service.mark_indeterminate(
                    execution_id,
                    (
                        "Executor returned a non-dictionary result; "
                        "external outcome requires reconciliation"
                    ),
                )
            )

            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Remediation action outcome is "
                    "indeterminate; reconciliation is required"
                ),
            )

            result = {
                "success": False,
                "status": "execution_indeterminate",
                "action": execution.action.type.value,
                "target": execution.action.target,
                "error_type": "InvalidExecutorResult",
                "requires_reconciliation": True,
            }

            return self._decorate_execution_result(
                result=result,
                execution=frozen,
                incident=incident,
                idempotent_replay=False,
            )

        try:
            completed = (
                await self.action_execution_service.complete(
                    execution_id,
                    executor_result,
                )
            )

        except Exception as exc:
            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Remediation executor returned, but the "
                    "execution outcome could not be persisted; "
                    "reconciliation is required"
                ),
            )

            return {
                "success": False,
                "status": "execution_persistence_failed",
                "approval_id": execution.approval_id,
                "execution_id": execution_id,
                "execution_status": (
                    ActionExecutionStatus.RUNNING.value
                ),
                "action": execution.action.type.value,
                "target": execution.action.target,
                "error": str(exc),
                "error_type": type(exc).__name__,
                "requires_reconciliation": True,
                "automatic_replay_allowed": False,
                "incident_id": (
                    str(incident.id)
                    if incident is not None
                    else None
                ),
                "incident_status": (
                    incident.status.value
                    if incident is not None
                    else None
                ),
            }

        if (
            completed.status
            == ActionExecutionStatus.SUCCEEDED
        ):
            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Remediation action executed; "
                    "awaiting verification"
                ),
            )

        elif (
            completed.status
            == ActionExecutionStatus.FAILED
        ):
            await self._update_incident(
                incident=incident,
                status=IncidentStatus.FAILED,
                reason=(
                    "Remediation action failed: "
                    f"{executor_result.get('message', 'unknown error')}"
                ),
            )

        else:
            await self._update_incident(
                incident=incident,
                status=IncidentStatus.HEALING,
                reason=(
                    "Remediation action outcome is "
                    "indeterminate; reconciliation is required"
                ),
            )

        result = dict(
            executor_result
        )

        if (
            completed.status
            == ActionExecutionStatus.INDETERMINATE
        ):
            result["success"] = False
            result["status"] = (
                "execution_indeterminate"
            )
            result["requires_reconciliation"] = True

        return self._decorate_execution_result(
            result=result,
            execution=completed,
            incident=incident,
            idempotent_replay=False,
        )

    def _build_execution_replay_result(
        self,
        execution: ActionExecutionRecord,
        incident: IncidentState | None,
    ) -> dict:
        if (
            execution.status
            == ActionExecutionStatus.RUNNING
        ):
            result = {
                "success": False,
                "status": "execution_in_progress",
                "requires_reconciliation": True,
            }

        elif (
            execution.status
            == ActionExecutionStatus.INDETERMINATE
        ):
            result = {
                "success": False,
                "status": "execution_indeterminate",
                "requires_reconciliation": True,
                "reason": execution.error_message,
            }

        else:
            result = dict(
                execution.result
            )

            if (
                execution.status
                == ActionExecutionStatus.SUCCEEDED
            ):
                result["success"] = True

            else:
                result["success"] = False
                result.setdefault(
                    "status",
                    "execution_failed",
                )

        return self._decorate_execution_result(
            result=result,
            execution=execution,
            incident=incident,
            idempotent_replay=True,
        )

    @staticmethod
    def _decorate_execution_result(
        *,
        result: dict,
        execution: ActionExecutionRecord,
        incident: IncidentState | None,
        idempotent_replay: bool,
    ) -> dict:
        decorated = dict(
            result
        )

        decorated.update(
            {
                "approval_id": execution.approval_id,
                "execution_id": str(execution.id),
                "execution_status": execution.status.value,
                "idempotency_key": execution.idempotency_key,
                "idempotent_replay": idempotent_replay,
                "automatic_replay_allowed": False,
                "action": execution.action.type.value,
                "target": execution.action.target,
                "incident_id": (
                    str(execution.incident_id)
                    if execution.incident_id is not None
                    else None
                ),
                "incident_status": (
                    incident.status.value
                    if incident is not None
                    else None
                ),
            }
        )

        return decorated

    def _apply_trusted_scope(
        self,
        *,
        plan: ActionPlan,
        namespace: str | None,
        cluster: str | None,
    ) -> None:
        """
        Attach caller-supplied resource scope to the persisted ActionPlan.

        Scope is never inferred from HealingAgent output or free-form action
        metadata. Explicit arguments are normalized before policy evaluation
        and before a possible ApprovalRequest is written to SQLite.
        """

        plan.namespace = self._normalize_scope_value(
            namespace
        )
        plan.cluster = self._normalize_scope_value(
            cluster
        )

    @staticmethod
    def _normalize_scope_value(
        value: str | None,
    ) -> str | None:
        if value is None:
            return None

        normalized = str(
            value
        ).strip()

        return normalized or None

    async def _execute_action(
        self,
        plan: ActionPlan,
        incident: IncidentState | None,
    ) -> dict:
        """
        Execute one legacy remediation action.

        Successful execution remains HEALING until a separate
        Verification step confirms service recovery.
        """

        await self._update_incident(
            incident=incident,
            status=IncidentStatus.HEALING,
            reason=(
                "Executing remediation action: "
                f"{plan.type.value}"
            ),
        )

        try:
            result = await self.executor.execute(
                plan
            )

        except Exception as exc:
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.FAILED
                ),
                reason=(
                    "Remediation executor raised "
                    f"{type(exc).__name__}: {exc}"
                ),
            )

            return {
                "success": False,
                "status": "execution_failed",
                "action": plan.type.value,
                "target": plan.target,
                "error": str(exc),
                "error_type": type(exc).__name__,
                "incident_id": (
                    str(incident.id)
                    if incident is not None
                    else None
                ),
            }

        if result.get("success") is True:
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.HEALING
                ),
                reason=(
                    "Remediation action executed; "
                    "awaiting verification"
                ),
            )

        else:
            await self._update_incident(
                incident=incident,
                status=(
                    IncidentStatus.FAILED
                ),
                reason=(
                    "Remediation action failed: "
                    f"{result.get('message', 'unknown error')}"
                ),
            )

        if incident is not None:
            result["incident_id"] = str(
                incident.id
            )
            result["incident_status"] = (
                incident.status.value
            )

        return result

    async def _update_incident(
        self,
        incident: IncidentState | None,
        status: IncidentStatus,
        reason: str,
    ) -> IncidentState | None:
        """
        Persist one Action lifecycle transition.

        The caller's Incident object is updated only after the
        database operation succeeds.
        """

        if incident is None:
            return None

        if self.incident_store is None:
            incident.update(
                status=status,
                reason=reason,
            )

            return incident

        stored_incident = (
            await self.incident_store.get(
                str(
                    incident.id
                )
            )
        )

        if stored_incident is None:
            try:
                stored_incident = (
                    await self.incident_store.save(
                        incident
                    )
                )

            except IncidentConflictError:
                stored_incident = (
                    await self.incident_store.get(
                        str(
                            incident.id
                        )
                    )

                )

                if stored_incident is None:
                    raise

        candidate = (
            stored_incident.model_copy(
                deep=True
            )
        )

        candidate.update(
            status=status,
            reason=reason,
        )

        try:
            persisted_incident = (
                await self.incident_store.update(
                    candidate,
                    expected_status=(
                        stored_incident.status
                    ),
                )
            )

        except IncidentConflictError:
            current_incident = (
                await self.incident_store.get(
                    str(
                        incident.id
                    )
                )
            )

            if current_incident is None:
                raise

            if (
                current_incident.status
                != status
            ):
                raise

            persisted_incident = (
                current_incident
            )

        self._copy_incident_state(
            target=incident,
            source=persisted_incident,
        )

        return incident

    @staticmethod
    def _copy_incident_state(
        target: IncidentState,
        source: IncidentState,
    ) -> None:
        """
        Synchronize the caller's object without replacing its identity.
        """

        target.status = source.status
        target.created_at = source.created_at
        target.updated_at = source.updated_at
        target.reason = source.reason
