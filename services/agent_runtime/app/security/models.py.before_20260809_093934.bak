from datetime import UTC, datetime
from enum import Enum
from typing import Any, Mapping

from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
    field_validator,
    model_validator,
)


class AuthenticationMethod(str, Enum):
    """Credential source that established a trusted operator identity."""

    ANONYMOUS = "anonymous"
    API_KEY = "api_key"
    OIDC_JWT = "oidc_jwt"
    TRUSTED_PROXY = "trusted_proxy"
    INTERNAL_SERVICE = "internal_service"


class OperatorRole(str, Enum):
    """Stable business roles used by the Agent Runtime RBAC policy."""

    VIEWER = "viewer"
    ANALYST = "analyst"
    APPROVER = "approver"
    EXECUTOR = "executor"
    RECONCILER = "reconciler"
    ADMIN = "admin"
    SERVICE = "service"


class RuntimePermission(str, Enum):
    """Fine-grained permissions independent from authentication method."""

    RUNTIME_EXECUTE = "runtime:execute"
    INCIDENT_READ = "incident:read"
    WORKFLOW_READ = "workflow:read"
    APPROVAL_READ = "approval:read"
    APPROVAL_DECIDE = "approval:decide"
    ACTION_EXECUTE = "action:execute"
    ACTION_RECONCILE = "action:reconcile"
    VERIFICATION_READ = "verification:read"


class ProtectedOperation(str, Enum):
    """Security-sensitive API operations evaluated by the RBAC engine."""

    EXECUTE_RUNTIME_ANALYSIS = (
        "runtime.analysis.execute"
    )
    READ_INCIDENT = "incident.read"
    READ_INCIDENT_WORKFLOWS = (
        "incident.workflows.read"
    )
    READ_APPROVAL = "approval.read"
    READ_APPROVAL_WORKFLOW = (
        "approval.workflow.read"
    )
    DECIDE_APPROVAL = "approval.decide"
    RESUME_ACTION = "action.resume"
    RECONCILE_ACTION = "action.reconcile"
    READ_VERIFICATION = "verification.read"


_SENSITIVE_ATTRIBUTE_FRAGMENTS = (
    "authorization",
    "credential",
    "password",
    "secret",
    "token",
    "api_key",
    "apikey",
    "private_key",
)


class OperatorIdentity(BaseModel):
    """
    Authenticated identity passed to authorization and audit layers.

    Raw credentials are intentionally excluded. Attributes may contain only
    bounded, non-secret identity metadata supplied by the authentication
    provider.
    """

    model_config = ConfigDict(
        frozen=True,
        extra="forbid",
    )

    principal_id: str = Field(
        min_length=1,
        max_length=128,
    )

    authenticated: bool = True

    authentication_method: (
        AuthenticationMethod
    )

    roles: frozenset[OperatorRole] = Field(
        default_factory=frozenset,
    )

    display_name: str | None = Field(
        default=None,
        max_length=256,
    )

    session_id: str | None = Field(
        default=None,
        max_length=256,
    )

    authenticated_at: datetime = Field(
        default_factory=lambda: datetime.now(
            UTC
        )
    )

    attributes: dict[str, Any] = Field(
        default_factory=dict,
    )

    @field_validator(
        "principal_id",
        mode="before",
    )
    @classmethod
    def normalize_principal_id(
        cls,
        value: Any,
    ) -> str:
        if not isinstance(
            value,
            str,
        ):
            raise ValueError(
                "Security principal ID must be text"
            )

        normalized = value.strip()

        if not normalized:
            raise ValueError(
                "Security principal ID cannot be empty"
            )

        return normalized

    @field_validator(
        "display_name",
        "session_id",
        mode="before",
    )
    @classmethod
    def normalize_optional_text(
        cls,
        value: Any,
    ) -> str | None:
        if value is None:
            return None

        if not isinstance(
            value,
            str,
        ):
            raise ValueError(
                "Optional identity metadata must be text"
            )

        normalized = value.strip()

        return normalized or None

    @field_validator(
        "attributes",
        mode="before",
    )
    @classmethod
    def reject_secret_attributes(
        cls,
        value: Any,
    ) -> dict[str, Any]:
        if value is None:
            return {}

        if not isinstance(
            value,
            Mapping,
        ):
            raise ValueError(
                "Identity attributes must be a mapping"
            )

        attributes = dict(
            value
        )

        for key in attributes:
            normalized_key = str(
                key
            ).strip().lower().replace(
                "-",
                "_",
            )

            if any(
                fragment in normalized_key
                for fragment in (
                    _SENSITIVE_ATTRIBUTE_FRAGMENTS
                )
            ):
                raise ValueError(
                    "Identity attributes must not contain "
                    "credentials or secrets"
                )

        return attributes

    @model_validator(
        mode="after"
    )
    def validate_authentication_state(
        self,
    ) -> "OperatorIdentity":
        if self.authenticated:
            if (
                self.authentication_method
                == AuthenticationMethod.ANONYMOUS
            ):
                raise ValueError(
                    "Authenticated identity cannot use "
                    "anonymous authentication"
                )

            if not self.roles:
                raise ValueError(
                    "Authenticated identity requires at "
                    "least one role"
                )

            return self

        if (
            self.authentication_method
            != AuthenticationMethod.ANONYMOUS
        ):
            raise ValueError(
                "Unauthenticated identity must use "
                "anonymous authentication"
            )

        if self.principal_id != "anonymous":
            raise ValueError(
                "Unauthenticated principal must be anonymous"
            )

        if self.roles:
            raise ValueError(
                "Unauthenticated identity cannot have roles"
            )

        return self

    @classmethod
    def anonymous(
        cls,
    ) -> "OperatorIdentity":
        """Return the only valid unauthenticated identity representation."""

        return cls(
            principal_id="anonymous",
            authenticated=False,
            authentication_method=(
                AuthenticationMethod.ANONYMOUS
            ),
            roles=frozenset(),
        )

    def has_role(
        self,
        role: OperatorRole,
    ) -> bool:
        return role in self.roles

    def audit_context(
        self,
    ) -> dict[str, Any]:
        """Return stable, credential-free metadata safe for audit records."""

        return {
            "principal_id": self.principal_id,
            "authenticated": self.authenticated,
            "authentication_method": (
                self.authentication_method.value
            ),
            "roles": sorted(
                role.value
                for role in self.roles
            ),
            "display_name": self.display_name,
            "session_id": self.session_id,
            "authenticated_at": (
                self.authenticated_at.isoformat()
            ),
        }


class AuthorizationDecision(BaseModel):
    """Immutable, internally consistent RBAC decision suitable for audit."""

    model_config = ConfigDict(
        frozen=True,
        extra="forbid",
    )

    principal_id: str = Field(
        min_length=1,
        max_length=128,
    )

    operation: ProtectedOperation

    authenticated: bool

    allowed: bool

    required_permissions: frozenset[
        RuntimePermission
    ] = Field(
        min_length=1,
    )

    granted_permissions: frozenset[
        RuntimePermission
    ] = Field(
        default_factory=frozenset,
    )

    missing_permissions: frozenset[
        RuntimePermission
    ] = Field(
        default_factory=frozenset,
    )

    reason: str = Field(
        min_length=1,
        max_length=1000,
    )

    policy_version: str = Field(
        default="v1",
        min_length=1,
        max_length=64,
    )

    evaluated_at: datetime = Field(
        default_factory=lambda: datetime.now(
            UTC
        )
    )

    @field_validator(
        "principal_id",
        "reason",
        "policy_version",
        mode="before",
    )
    @classmethod
    def normalize_required_text(
        cls,
        value: Any,
    ) -> str:
        if not isinstance(
            value,
            str,
        ):
            raise ValueError(
                "Authorization audit text must be text"
            )

        normalized = value.strip()

        if not normalized:
            raise ValueError(
                "Authorization audit text cannot be empty"
            )

        return normalized

    @model_validator(
        mode="after"
    )
    def validate_permission_sets(
        self,
    ) -> "AuthorizationDecision":
        expected_missing = (
            self.required_permissions
            - self.granted_permissions
        )

        if (
            self.missing_permissions
            != expected_missing
        ):
            raise ValueError(
                "Authorization missing permissions do not "
                "match required minus granted permissions"
            )

        expected_allowed = (
            self.authenticated
            and not expected_missing
        )

        if self.allowed != expected_allowed:
            raise ValueError(
                "Authorization allowed flag does not match "
                "the permission sets"
            )

        return self

    @classmethod
    def evaluate(
        cls,
        *,
        identity: OperatorIdentity,
        operation: ProtectedOperation,
        required_permissions: frozenset[
            RuntimePermission
        ],
        granted_permissions: frozenset[
            RuntimePermission
        ],
        policy_version: str = "v1",
    ) -> "AuthorizationDecision":
        """Build a deterministic decision without mutating the identity."""

        missing_permissions = (
            required_permissions
            - granted_permissions
        )
        allowed = (
            identity.authenticated
            and not missing_permissions
        )

        if not identity.authenticated:
            reason = (
                "Authentication is required for the "
                "protected operation"
            )
            allowed = False
        elif missing_permissions:
            reason = (
                "Principal is missing required permissions: "
                + ", ".join(
                    sorted(
                        permission.value
                        for permission
                        in missing_permissions
                    )
                )
            )
        else:
            reason = (
                "Principal has all required permissions"
            )

        return cls(
            principal_id=(
                identity.principal_id
            ),
            operation=operation,
            authenticated=(
                identity.authenticated
            ),
            allowed=allowed,
            required_permissions=(
                required_permissions
            ),
            granted_permissions=(
                granted_permissions
            ),
            missing_permissions=(
                missing_permissions
            ),
            reason=reason,
            policy_version=policy_version,
        )


__all__ = [
    "AuthenticationMethod",
    "AuthorizationDecision",
    "OperatorIdentity",
    "OperatorRole",
    "ProtectedOperation",
    "RuntimePermission",
]
