def _contract_id(contract: RouteSecurityContract) -> str:
    return f"{contract.method}-{contract.endpoint_name}"


class EmptyProductionActionQuery:
    async def get(
        self,
        artifact_id,
    ):
        return None


@pytest.fixture
def api_environment(monkeypatch, tmp_path):
    """Create one authenticated API backed only by pytest-local stores."""

    monkeypatch.chdir(tmp_path)

    for name in (
        "PROMETHEUS_URL",
        "KUBERNETES_API_URL",
        "KUBERNETES_SERVICE_HOST",
        "KUBERNETES_SERVICE_PORT",
        "KUBERNETES_SERVICE_PORT_HTTPS",
    ):
        monkeypatch.delenv(name, raising=False)

    monkeypatch.setenv(
        "PROMETHEUS_ALLOW_MOCK_FALLBACK",
        "true",
    )
    monkeypatch.setenv(
        "KUBERNETES_ALLOW_DRY_RUN_FALLBACK",
        "true",
    )

    from services.agent_runtime.app.api import runtime as api_module

    isolated_runtime = AgentRuntime()
    isolated_runtime.production_action_query = (
        EmptyProductionActionQuery()
    )
    security = wire_api_test_security(
        monkeypatch,
        api_module,
        isolated_runtime,
    )

    app = FastAPI()
    app.include_router(api_module.router)

    return app, isolated_runtime, security, api_module


def api_client(app: FastAPI) -> httpx.AsyncClient:
    return httpx.AsyncClient(
        transport=httpx.ASGITransport(app=app),
        base_url="http://test",
    )


def request_body(contract: RouteSecurityContract) -> dict | None:
    if contract.body_kind == "execute":
        # A permitted caller must reach StandardEvent validation and receive
        # 422. A denied caller must be rejected before that validation.
        return {}

    if contract.body_kind == "approval":
        return {
            "reason": "Security matrix approval decision",
            "metadata": {
                "test": "security_matrix",
            },
        }

    if contract.body_kind == "preparation":
        return {
            "preflight": {
                "incident_id": str(TEST_RESOURCE_ID),
                "cluster": "production-tw",
                "namespace": "payments",
                "pod_name": "payment-api-0",
                "container": "payment-api",
            },
        }

    if contract.body_kind == "reconciliation":
        return {
            "outcome": "failed",
            "reason": (
                "Security matrix confirms that the Action did not apply"
            ),
            "result": {
                "success": False,
                "evidence": "security_matrix",
            },
            "error_type": "ActionNotObserved",
            "error_message": "No mutation was observed",
            "metadata": {
                "test": "security_matrix",
            },
        }

    return None


def request_headers(
    contract: RouteSecurityContract,
    *,
    security: ApiTestSecurityHarness | None = None,
    role: OperatorRole | None = None,
    authorization: str | None = None,
    spoof_operator: bool = False,
) -> dict[str, str]:
    headers: dict[str, str] = {}

    if security is not None and role is not None:
        headers.update(security.headers(role))

    if authorization is not None:
        headers["Authorization"] = authorization

    if contract.audited_operator:
        if spoof_operator:
            headers["X-Operator-ID"] = "spoofed-security-admin"
        elif security is not None and role is not None:
            headers["X-Operator-ID"] = security.principal_id(role)
        else:
            headers["X-Operator-ID"] = "untrusted-operator-claim"

        headers["Idempotency-Key"] = (
            "security-matrix-"
            f"{contract.endpoint_name}-"
            f"{role.value if role is not None else 'anonymous'}"
        )

    return headers


async def send_contract_request(
    client: httpx.AsyncClient,
    contract: RouteSecurityContract,
    headers: dict[str, str],
) -> httpx.Response:
    kwargs: dict = {
        "headers": headers,
    }
    body = request_body(contract)

    if body is not None:
        kwargs["json"] = body

    return await client.request(
        contract.method,
        contract.concrete_path(),
        **kwargs,
    )


def _api_require_operation(endpoint) -> ProtectedOperation:
    """Return the single first-statement security operation of a route."""

    source = textwrap.dedent(
        inspect.getsource(endpoint)
    )
    tree = ast.parse(source)
    function = tree.body[0]

    assert isinstance(
        function,
        (ast.AsyncFunctionDef, ast.FunctionDef),
    )

    statements = list(function.body)

    if (
        statements
        and isinstance(statements[0], ast.Expr)
        and isinstance(statements[0].value, ast.Constant)
        and isinstance(statements[0].value.value, str)
    ):
        statements.pop(0)

    require_calls = [
        node
        for node in ast.walk(function)
        if isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "require"
        and isinstance(node.func.value, ast.Name)
        and node.func.value.id == "api_security"
    ]

    assert len(require_calls) == 1, (
        f"{endpoint.__name__} must contain exactly one "
        "api_security.require call"
    )

    first_statement_calls = {
        id(node)
        for node in ast.walk(statements[0])
        if isinstance(node, ast.Call)
    }
    require_call = require_calls[0]

    assert id(require_call) in first_statement_calls, (
        f"{endpoint.__name__} must authorize before domain work"
    )
    assert len(require_call.args) >= 2

    operation_node = require_call.args[1]

    assert isinstance(operation_node, ast.Attribute)
    assert isinstance(operation_node.value, ast.Name)
    assert operation_node.value.id == "ProtectedOperation"

    return ProtectedOperation[operation_node.attr]


def block_all_domain_work(
    monkeypatch,
    runtime: AgentRuntime,
    api_module,
) -> list[str]:
    """Fail if a rejected request reaches validation, storage or execution."""

    calls: list[str] = []

    class ForbiddenStandardEvent:
        @classmethod
        def model_validate(cls, value):
            calls.append("event.validate")
            raise AssertionError(
                "Rejected request reached StandardEvent validation"
            )

    def forbidden(label: str):
        async def call(*args, **kwargs):
            calls.append(label)
            raise AssertionError(
                "Rejected request reached protected domain work: "
                f"{label}"
            )

        return call

    monkeypatch.setattr(
        api_module,
        "StandardEvent",
        ForbiddenStandardEvent,
    )

    targets = [
        (runtime.pipeline, "execute", "pipeline.execute"),
        (runtime.incident_store, "get", "incident.get"),
        (runtime.incident_store, "update", "incident.update"),
        (runtime.approval, "get", "approval.get"),
        (
            runtime.approval,
            "list_by_incident",
            "approval.list_by_incident",
        ),
        (runtime.approval, "approve", "approval.approve"),
        (runtime.approval, "reject", "approval.reject"),
        (
            runtime.action_execution_service,
            "get",
            "action_execution.get",
        ),
        (
            runtime.action_execution_service,
            "get_by_approval",
            "action_execution.get_by_approval",
        ),
        (
            runtime.action_execution_service,
            "list_by_incident",
            "action_execution.list_by_incident",
        ),
        (
            runtime.action_execution_service,
            "reconcile",
            "action_execution.reconcile",
        ),
        (runtime.action_runtime, "resume", "action_runtime.resume"),
        (runtime.verification, "get", "verification.get"),
        (
            runtime.verification,
            "get_by_action_execution",
            "verification.get_by_action_execution",
        ),
        (
            runtime.verification,
            "list_by_incident",
            "verification.list_by_incident",
        ),
        (
            runtime.verification_coordinator,
            "run",
            "verification_coordinator.run",
        ),
    ]

    preparation_service = getattr(
        runtime,
        "production_action_preparation",
        None,
    )
    if preparation_service is not None:
        targets.append(
            (
                preparation_service,
                "prepare",
                "production_action_preparation.prepare",
            )
        )

    query_service = getattr(
        runtime,
        "production_action_query",
        None,
    )
    if query_service is not None:
        targets.append(
            (
                query_service,
                "get",
                "production_action_query.get",
            )
        )

    rehearsal_service = getattr(
        runtime,
        "production_pilot_rehearsal",
        None,
    )
    if rehearsal_service is not None:
        targets.append(
            (
                rehearsal_service,
                "run",
                "production_pilot_rehearsal.run",
            )
        )

    for owner, method_name, label in targets:
        monkeypatch.setattr(
            owner,
            method_name,
            forbidden(label),
        )

    return calls


class ExplodingAuthenticationProvider(BaseAuthenticationProvider):
    @property
    def name(self) -> str:
        return "security_matrix_exploding"

    def authenticate(self, credential: str | None) -> OperatorIdentity:
        raise RuntimeError(
            "Provider failed while processing credential "
            f"{credential}"
        )


def test_security_contract_covers_every_role_operation_and_route():
    assert set(EXPECTED_OPERATION_ROLES) == set(ProtectedOperation)
    assert set(READ_ROLES) == (
        set(OperatorRole) - {OperatorRole.SERVICE}
    )
    assert len(ROUTE_CONTRACTS) == 14
    assert len(
        {
            (contract.method, contract.path_template)
            for contract in ROUTE_CONTRACTS
        }
    ) == 14


def test_router_has_exactly_the_audited_security_contract(
    api_environment,
):
    _, _, _, api_module = api_environment

    actual_routes = {
        (
            method,
            route.path,
            route.endpoint.__name__,
        ): route
        for route in api_module.router.routes
        if isinstance(route, APIRoute)
        for method in route.methods
    }
    expected_routes = {
        (
            contract.method,
            contract.path_template,
            contract.endpoint_name,
        )
        for contract in ROUTE_CONTRACTS
    }

    assert set(actual_routes) == expected_routes

    for contract in ROUTE_CONTRACTS:
        key = (
            contract.method,
            contract.path_template,
            contract.endpoint_name,
        )
        route = actual_routes[key]

        assert _api_require_operation(route.endpoint) == contract.operation


@pytest.mark.parametrize(
    ("operation", "role"),
    tuple(
        (operation, role)
        for operation in ProtectedOperation
        for role in OperatorRole
    ),
    ids=lambda value: value.value,
)
def test_authenticated_adapter_enforces_complete_role_operation_matrix(
    operation,
    role,
):
    credential = api_test_credential(role)
    adapter = ApiSecurityAdapter(
        authentication=create_api_test_authentication_service(),
        policy=SecurityPolicyEngine(),
    )
    allowed = role in EXPECTED_OPERATION_ROLES[operation]

    if allowed:
        context = adapter.require(
            credential.authorization_value,
            operation,
        )
        assert context.principal_id == credential.principal_id
        assert context.operation == operation
        assert context.authorization.allowed is True
        assert "credential" not in context.audit_context()
        assert "api_key" not in context.audit_context()
        return

    with pytest.raises(HTTPException) as error:
        adapter.require(
            credential.authorization_value,
            operation,
        )

    assert error.value.status_code == 403
    assert error.value.detail == "Authorization denied"


@pytest.mark.asyncio
@pytest.mark.parametrize(
    "contract",
    ROUTE_CONTRACTS,
    ids=_contract_id,
)
async def test_real_http_routes_enforce_complete_role_matrix(
    api_environment,
    contract,
):
    app, _, security, _ = api_environment

    async with api_client(app) as client:
        for role in OperatorRole:
            headers = request_headers(
                contract,
                security=security,
                role=role,
            )
            response = await send_contract_request(
                client,
                contract,
                headers,
            )

            if role in contract.allowed_roles:
                assert response.status_code == contract.allowed_status, (
                    f"{contract.endpoint_name} unexpectedly rejected "
                    f"allowed role {role.value}: {response.text}"
                )
                assert response.status_code not in {401, 403, 503}
            else:
                assert response.status_code == 403, (
                    f"{contract.endpoint_name} did not reject role "
                    f"{role.value}: {response.text}"
                )
                assert response.json() == {
                    "detail": "Authorization denied"
                }

            assert security.credential(role).api_key not in response.text


@pytest.mark.asyncio
@pytest.mark.parametrize(
    "authorization",
    (
        None,
        "Bearer unsupported-security-matrix-token",
        f"ApiKey {INVALID_CREDENTIAL}",
    ),
    ids=(
        "missing",
        "unsupported-scheme",
        "invalid-api-key",
    ),
)
async def test_every_route_returns_safe_401_before_all_domain_work(
    api_environment,
    monkeypatch,
    caplog,
    authorization,
):
    app, runtime, _, api_module = api_environment
    calls = block_all_domain_work(
        monkeypatch,
        runtime,
        api_module,
    )
    async with api_client(app) as client:
        for contract in ROUTE_CONTRACTS:
            headers = request_headers(
                contract,
                authorization=authorization,
            )
            response = await send_contract_request(
                client,
                contract,
                headers,
            )

            assert response.status_code == 401, (
                f"{contract.endpoint_name} did not fail with 401"
            )
            assert response.json() == {
                "detail": "Authentication failed"
            }
            assert response.headers["www-authenticate"] == "ApiKey"
            assert INVALID_CREDENTIAL not in response.text

    assert INVALID_CREDENTIAL not in caplog.text
    assert calls == []


@pytest.mark.asyncio
async def test_every_route_returns_safe_503_before_all_domain_work(
    api_environment,
    monkeypatch,
    caplog,
):
    app, runtime, _, api_module = api_environment
    calls = block_all_domain_work(
        monkeypatch,
        runtime,
        api_module,
    )
    authentication = AuthenticationService(
        AuthenticationProviderRegistry(
            [ExplodingAuthenticationProvider()]
        )
    )
    unavailable_adapter = ApiSecurityAdapter(
        authentication=authentication,
        policy=runtime.security_policy,
    )
    monkeypatch.setattr(
        api_module,
        "api_security",
        unavailable_adapter,
    )
    async with api_client(app) as client:
        for contract in ROUTE_CONTRACTS:
            headers = request_headers(
                contract,
                authorization=(
                    "ApiKey " + PROVIDER_FAILURE_CREDENTIAL
                ),
            )
            response = await send_contract_request(
                client,
                contract,
                headers,
            )

            assert response.status_code == 503, (
                f"{contract.endpoint_name} did not fail with 503"
            )
            assert response.json() == {
                "detail": "Authentication service unavailable"
            }
            assert PROVIDER_FAILURE_CREDENTIAL not in response.text
            assert "provider failed" not in response.text.lower()

    assert PROVIDER_FAILURE_CREDENTIAL not in caplog.text
    assert calls == []


WRITE_ROUTE_CASES = tuple(
    contract
    for contract in ROUTE_CONTRACTS
    if contract.audited_operator
)


@pytest.mark.asyncio
async def test_write_routes_reject_operator_spoofing_before_domain_work(
    api_environment,
    monkeypatch,
):
    app, runtime, security, api_module = api_environment
    calls = block_all_domain_work(
        monkeypatch,
        runtime,
        api_module,
    )
    async with api_client(app) as client:
        for contract in WRITE_ROUTE_CASES:
            role = {
                ProtectedOperation.DECIDE_APPROVAL: OperatorRole.APPROVER,
                ProtectedOperation.RESUME_ACTION: OperatorRole.EXECUTOR,
                ProtectedOperation.RECONCILE_ACTION: OperatorRole.RECONCILER,
            }[contract.operation]
            headers = request_headers(
                contract,
                security=security,
                role=role,
                spoof_operator=True,
            )
            response = await send_contract_request(
                client,
                contract,
                headers,
            )

            assert response.status_code == 403, (
                f"{contract.endpoint_name} accepted a spoofed operator"
            )
            assert response.json() == {
                "detail": (
                    "Authenticated operator identity does not match "
                    "X-Operator-ID"
                )
            }
            assert security.credential(role).api_key not in response.text

    assert calls == []


def test_separation_of_duties_has_no_non_admin_write_bypass():
    assert (
        EXPECTED_OPERATION_ROLES[
            ProtectedOperation.PREPARE_REMEDIATION
        ]
        & EXPECTED_OPERATION_ROLES[
            ProtectedOperation.DECIDE_APPROVAL
        ]
        & EXPECTED_OPERATION_ROLES[
            ProtectedOperation.RESUME_ACTION
        ]
        & EXPECTED_OPERATION_ROLES[
            ProtectedOperation.RECONCILE_ACTION
        ]
    ) == {OperatorRole.ADMIN}

    for role in (
        OperatorRole.ANALYST,
        OperatorRole.SERVICE,
        OperatorRole.APPROVER,
        OperatorRole.EXECUTOR,
        OperatorRole.RECONCILER,
    ):
        allowed_write_operations = {
            operation
            for operation in (
                ProtectedOperation.PREPARE_REMEDIATION,
                ProtectedOperation.DECIDE_APPROVAL,
                ProtectedOperation.RESUME_ACTION,
                ProtectedOperation.RECONCILE_ACTION,
            )
            if role in EXPECTED_OPERATION_ROLES[operation]
        }
        assert len(allowed_write_operations) == 1
