@dataclass(frozen=True)
class RouteSecurityContract:
    method: str
    path_template: str
    endpoint_name: str
    operation: ProtectedOperation
    allowed_status: int
    body_kind: str | None = None
    audited_operator: bool = False

    @property
    def allowed_roles(self) -> frozenset[OperatorRole]:
        return EXPECTED_OPERATION_ROLES[self.operation]

    def concrete_path(self) -> str:
        resource_id = str(TEST_RESOURCE_ID)
        return self.path_template.format(
            incident_id=resource_id,
            approval_id=resource_id,
            execution_id=resource_id,
            verification_id=resource_id,
            artifact_id=resource_id,
        )


