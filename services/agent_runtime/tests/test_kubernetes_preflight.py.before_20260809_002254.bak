import json
from datetime import UTC, datetime, timedelta
from hashlib import sha256
from uuid import UUID

import httpx
import pytest
from pydantic import ValidationError

from services.agent_runtime.app.action.safety_models import (
    KubernetesWorkloadScope,
)
from services.agent_runtime.app.action.kubernetes_preflight import (
    KubernetesPreflightAuthorizationError,
    KubernetesPreflightConfigurationError,
    KubernetesPreflightConflictError,
    KubernetesPreflightPolicy,
    KubernetesPreflightPolicyError,
    KubernetesPreflightRequest,
    KubernetesPreflightResolver,
    KubernetesPreflightResponseError,
)


NOW = datetime(2026, 8, 8, 12, 0, tzinfo=UTC)
INCIDENT_ID = UUID("11111111-1111-4111-8111-111111111111")
CONTRACT_ID = UUID("22222222-2222-4222-8222-222222222222")
DEPLOYMENT_UID = "33333333-3333-4333-8333-333333333333"
REPLICA_SET_UID = "44444444-4444-4444-8444-444444444444"
POD_UID = "55555555-5555-4555-8555-555555555555"
API_URL = "https://kubernetes.test"


def allowed_scope(
    *,
    name: str = "payment-api",
    container: str = "payment-api",
    namespace: str = "payment",
    cluster: str = "production-a",
) -> KubernetesWorkloadScope:
    return KubernetesWorkloadScope(
        cluster=cluster,
        namespace=namespace,
        name=name,
        container=container,
    )


def policy(
    *,
    enabled: bool = True,
    targets: tuple[KubernetesWorkloadScope, ...] | None = None,
    increase_percent: int = 25,
) -> KubernetesPreflightPolicy:
    return KubernetesPreflightPolicy(
        enabled=enabled,
        allowed_targets=(allowed_scope(),) if targets is None else targets,
        increase_percent=increase_percent,
        contract_ttl_seconds=600,
    )


def request(
    *,
    cluster: str = "production-a",
    namespace: str = "payment",
    container: str | None = "payment-api",
) -> KubernetesPreflightRequest:
    return KubernetesPreflightRequest(
        incident_id=INCIDENT_ID,
        cluster=cluster,
        namespace=namespace,
        pod_name="payment-api-7f9d8c6b5f-x1y2z",
        container=container,
    )


def pod_payload(
    *,
    owner_kind: str = "ReplicaSet",
    owner_name: str = "payment-api-7f9d8c6b5f",
    owner_uid: str = REPLICA_SET_UID,
    oom_killed: bool = True,
    containers: tuple[str, ...] = ("payment-api",),
) -> dict:
    statuses = []
    for name in containers:
        last_state = {
            "terminated": {
                "reason": "OOMKilled" if oom_killed else "Error",
            }
        }
        statuses.append(
            {
                "name": name,
                "restartCount": 4,
                "state": {"running": {}},
                "lastState": last_state,
            }
        )

    return {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
            "name": "payment-api-7f9d8c6b5f-x1y2z",
            "namespace": "payment",
            "uid": POD_UID,
            "resourceVersion": "100",
            "ownerReferences": [
                {
                    "apiVersion": "apps/v1",
                    "kind": owner_kind,
                    "name": owner_name,
                    "uid": owner_uid,
                    "controller": True,
                }
            ],
        },
        "spec": {
            "containers": [{"name": name} for name in containers],
        },
        "status": {"containerStatuses": statuses},
    }


def replica_set_payload(
    *,
    uid: str = REPLICA_SET_UID,
    owner_kind: str = "Deployment",
    owner_name: str = "payment-api",
    owner_uid: str = DEPLOYMENT_UID,
) -> dict:
    return {
        "apiVersion": "apps/v1",
        "kind": "ReplicaSet",
        "metadata": {
            "name": "payment-api-7f9d8c6b5f",
            "namespace": "payment",
            "uid": uid,
            "resourceVersion": "200",
            "ownerReferences": [
                {
                    "apiVersion": "apps/v1",
                    "kind": owner_kind,
                    "name": owner_name,
                    "uid": owner_uid,
                    "controller": True,
                }
            ],
        },
    }


def deployment_payload(
    *,
    name: str = "payment-api",
    uid: str = DEPLOYMENT_UID,
    resource_version: str = "300",
    generation: int = 7,
    memory: str = "512Mi",
    containers: tuple[str, ...] = ("payment-api",),
    annotations: dict[str, str] | None = None,
) -> dict:
    container_payloads = []
    for container_name in containers:
        container_payloads.append(
            {
                "name": container_name,
                "resources": {
                    "limits": {
                        "memory": memory,
                        "cpu": "500m",
                    }
                },
            }
        )

    return {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
            "name": name,
            "namespace": "payment",
            "uid": uid,
            "resourceVersion": resource_version,
            "generation": generation,
        },
        "spec": {
            "template": {
                "metadata": {
                    "annotations": annotations or {},
                },
                "spec": {
                    "containers": container_payloads,
                },
            }
        },
    }


def valid_handler(
    calls: list[httpx.Request],
    *,
    pod: dict | None = None,
    replica_set: dict | None = None,
    deployment: dict | None = None,
    patch_status: int = 200,
    mutate_dry_run=None,
):
    pod = pod or pod_payload()
    replica_set = replica_set or replica_set_payload()
    deployment = deployment or deployment_payload()

    def handler(http_request: httpx.Request) -> httpx.Response:
        calls.append(http_request)
        path = http_request.url.path

        if http_request.method == "GET" and "/pods/" in path:
            return httpx.Response(200, json=pod)

        if http_request.method == "GET" and "/replicasets/" in path:
            return httpx.Response(200, json=replica_set)

        if http_request.method == "GET" and "/deployments/" in path:
            return httpx.Response(200, json=deployment)

        if http_request.method == "PATCH" and "/deployments/" in path:
            if patch_status != 200:
                return httpx.Response(
                    patch_status,
                    json={
                        "apiVersion": "v1",
                        "kind": "Status",
                        "status": "Failure",
                    },
                )

            patch = json.loads(http_request.content)
            container_patch = patch["spec"]["template"]["spec"]["containers"][0]
            annotations = patch["spec"]["template"]["metadata"]["annotations"]
            dry_run = deployment_payload(
                generation=8,
                memory=container_patch["resources"]["limits"]["memory"],
                annotations=annotations,
            )
            if mutate_dry_run is not None:
                mutate_dry_run(dry_run)
            return httpx.Response(
                200,
                json=dry_run,
                headers={"Warning": '299 kubernetes "pilot warning"'},
            )

        return httpx.Response(500, json={"unexpected": path})

    return handler


async def prepare(
    handler,
    *,
    preflight_policy: KubernetesPreflightPolicy | None = None,
    preflight_request: KubernetesPreflightRequest | None = None,
):
    transport = httpx.MockTransport(handler)
    async with httpx.AsyncClient(transport=transport) as client:
        resolver = KubernetesPreflightResolver(
            api_url=API_URL,
            cluster_name="production-a",
            policy=preflight_policy or policy(),
            bearer_token="test-token",
            client=client,
            clock=lambda: NOW,
            contract_id_factory=lambda: CONTRACT_ID,
        )
        return await resolver.prepare(preflight_request or request())


@pytest.mark.asyncio
async def test_preflight_resolves_owner_chain_and_returns_bound_contract():
    calls = []
    artifact = await prepare(valid_handler(calls))

    assert [item.method for item in calls] == ["GET", "GET", "GET", "PATCH"]
    assert artifact.contract.incident_id == INCIDENT_ID
    assert artifact.contract.contract_id == CONTRACT_ID
    assert artifact.contract.scope == allowed_scope()
    assert artifact.contract.memory.current_limit == "512Mi"
    assert artifact.contract.memory.desired_limit == "640Mi"
    assert artifact.contract.memory.rollback_limit == "512Mi"
    assert artifact.contract.precondition.resource_version == "300"
    assert artifact.contract.precondition.generation == 7
    assert artifact.dry_run_generation == 8
    assert artifact.source_restart_count == 4
    assert artifact.plan.approved is False
    assert artifact.plan.metadata["safety_contract_id"] == str(CONTRACT_ID)
    assert artifact.plan.metadata["rollback_memory_limit"] == "512Mi"


@pytest.mark.asyncio
async def test_patch_is_canonical_digest_bound_and_server_dry_run_only():
    calls = []
    artifact = await prepare(valid_handler(calls))
    patch_call = calls[-1]

    assert patch_call.method == "PATCH"
    assert patch_call.url.params["dryRun"] == "All"
    assert patch_call.url.params["fieldManager"] == "ai-reliability-platform"
    assert patch_call.headers["content-type"] == (
        "application/strategic-merge-patch+json"
    )
    assert patch_call.headers["authorization"] == "Bearer test-token"
    assert artifact.patch_json == patch_call.content.decode("utf-8")
    assert artifact.patch_json == json.dumps(
        artifact.patch,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    )
    assert sha256(artifact.patch_json.encode()).hexdigest() == (
        artifact.contract.dry_run.patch_sha256
    )
    assert all(
        item.method != "PATCH" or item.url.params.get("dryRun") == "All"
        for item in calls
    )


@pytest.mark.asyncio
async def test_approved_bound_plan_satisfies_contract_before_expiry():
    artifact = await prepare(valid_handler([]))
    approved = artifact.plan.model_copy(deep=True)
    approved.approved = True

    artifact.contract.require_executable_plan(
        approved,
        at=NOW + timedelta(minutes=5),
    )


def test_resolver_requires_https():
    with pytest.raises(
        KubernetesPreflightConfigurationError,
        match="HTTPS",
    ):
        KubernetesPreflightResolver(
            api_url="http://kubernetes.test",
            cluster_name="production-a",
            policy=policy(),
            bearer_token="test-token",
        )


@pytest.mark.parametrize(
    "kwargs",
    [
        {"verify_tls": False, "bearer_token": "test-token"},
        {"verify_tls": True, "bearer_token": None},
        {"verify_tls": True, "bearer_token": "   "},
    ],
)
def test_resolver_connection_configuration_fails_closed(kwargs):
    with pytest.raises(KubernetesPreflightConfigurationError):
        KubernetesPreflightResolver(
            api_url=API_URL,
            cluster_name="production-a",
            policy=policy(),
            **kwargs,
        )


def test_enabled_policy_requires_unique_exact_targets():
    with pytest.raises(ValidationError, match="allowlist"):
        KubernetesPreflightPolicy(enabled=True)

    with pytest.raises(ValidationError, match="unique"):
        KubernetesPreflightPolicy(
            enabled=True,
            allowed_targets=(allowed_scope(), allowed_scope()),
        )


@pytest.mark.asyncio
@pytest.mark.parametrize(
    ("preflight_policy", "preflight_request", "error"),
    [
        (policy(enabled=False), request(), KubernetesPreflightConfigurationError),
        (policy(), request(cluster="production-b"), KubernetesPreflightPolicyError),
        (policy(), request(namespace="other"), KubernetesPreflightPolicyError),
        (policy(), request(container="sidecar"), KubernetesPreflightPolicyError),
    ],
)
async def test_disabled_or_unallowlisted_request_has_zero_api_calls(
    preflight_policy,
    preflight_request,
    error,
):
    calls = []
    with pytest.raises(error):
        await prepare(
            valid_handler(calls),
            preflight_policy=preflight_policy,
            preflight_request=preflight_request,
        )
    assert calls == []


@pytest.mark.asyncio
@pytest.mark.parametrize(
    "pod",
    [
        pod_payload(owner_kind="StatefulSet"),
        pod_payload(owner_uid="different-replica-uid"),
    ],
)
async def test_owner_chain_must_be_exact_and_uid_bound(pod):
    with pytest.raises(
        (KubernetesPreflightPolicyError, KubernetesPreflightConflictError)
    ):
        await prepare(valid_handler([], pod=pod))


@pytest.mark.asyncio
async def test_replica_set_must_be_controlled_by_deployment():
    replica = replica_set_payload(owner_kind="StatefulSet")
    with pytest.raises(KubernetesPreflightPolicyError, match="Deployment"):
        await prepare(valid_handler([], replica_set=replica))


@pytest.mark.asyncio
async def test_resolved_deployment_must_be_exactly_allowlisted():
    replica = replica_set_payload(
        owner_name="other-api",
        owner_uid=DEPLOYMENT_UID,
    )
    deployment = deployment_payload(name="other-api")
    with pytest.raises(KubernetesPreflightPolicyError, match="allowlist"):
        await prepare(
            valid_handler([], replica_set=replica, deployment=deployment)
        )


@pytest.mark.asyncio
async def test_unspecified_container_must_resolve_to_one_allowed_target():
    targets = (
        allowed_scope(container="payment-api"),
        allowed_scope(container="metrics"),
    )
    pod = pod_payload(containers=("payment-api", "metrics"))
    deployment = deployment_payload(containers=("payment-api", "metrics"))

    with pytest.raises(KubernetesPreflightPolicyError, match="ambiguous"):
        await prepare(
            valid_handler([], pod=pod, deployment=deployment),
            preflight_policy=policy(targets=targets),
            preflight_request=request(container=None),
        )


@pytest.mark.asyncio
async def test_source_pod_must_prove_oom_killed_for_selected_container():
    with pytest.raises(KubernetesPreflightPolicyError, match="OOMKilled"):
        await prepare(valid_handler([], pod=pod_payload(oom_killed=False)))


@pytest.mark.asyncio
@pytest.mark.parametrize("memory", ["0", "512M", "0.5Gi", "500MiB"])
async def test_memory_limit_must_use_bounded_pilot_quantity(memory):
    with pytest.raises(KubernetesPreflightPolicyError, match="Mi/Gi"):
        await prepare(
            valid_handler([], deployment=deployment_payload(memory=memory))
        )


@pytest.mark.asyncio
async def test_small_limit_that_cannot_increase_by_whole_mi_fails_closed():
    with pytest.raises(KubernetesPreflightPolicyError, match="whole Mi"):
        await prepare(
            valid_handler([], deployment=deployment_payload(memory="1Mi")),
            preflight_policy=policy(increase_percent=1),
        )


@pytest.mark.asyncio
@pytest.mark.parametrize(
    ("status", "error"),
    [
        (403, KubernetesPreflightAuthorizationError),
        (409, KubernetesPreflightConflictError),
    ],
)
async def test_dry_run_authorization_and_conflict_fail_closed(status, error):
    with pytest.raises(error):
        await prepare(valid_handler([], patch_status=status))


@pytest.mark.asyncio
@pytest.mark.parametrize(
    "mutator",
    [
        lambda value: value["metadata"].update({"uid": str(UUID(int=9))}),
        lambda value: value["metadata"].update({"resourceVersion": "changed"}),
        lambda value: value["spec"]["template"]["spec"]["containers"][0][
            "resources"
        ]["limits"].update({"memory": "999Mi"}),
        lambda value: value["spec"]["template"]["metadata"].update(
            {"annotations": {}}
        ),
    ],
)
async def test_tampered_dry_run_response_is_rejected(mutator):
    with pytest.raises(
        (KubernetesPreflightConflictError, KubernetesPreflightResponseError)
    ):
        await prepare(valid_handler([], mutate_dry_run=mutator))


@pytest.mark.asyncio
async def test_deleting_workload_fails_closed_before_dry_run():
    deployment = deployment_payload()
    deployment["metadata"]["deletionTimestamp"] = "2026-08-08T11:59:00Z"
    calls = []
    with pytest.raises(KubernetesPreflightPolicyError, match="being deleted"):
        await prepare(valid_handler(calls, deployment=deployment))
    assert all(item.method == "GET" for item in calls)
