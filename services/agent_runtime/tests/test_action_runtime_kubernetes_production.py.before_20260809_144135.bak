class StubProductionExecutor(
    KubernetesProductionExecutor
):
    def __init__(
        self,
        outcome,
        pilot_control,
        pilot_budget_service,
    ) -> None:
        super().__init__(
            api_url="https://kubernetes.test",
            cluster_name="production-a",
            policy=KubernetesProductionExecutorPolicy(
                enabled=True,
                allowed_targets=(
                    workload_scope(),
                ),
            ),
            bearer_token=(
                "production-writer-token-0001"
            ),
            pilot_control=pilot_control,
            pilot_budget_service=(
                pilot_budget_service
            ),
        )
        self.outcome = outcome
        self.calls = []

    async def execute_claimed(
        self,
        execution,
        record,
    ):
        self.calls.append(
            (
                execution.model_copy(
                    deep=True
                ),
                record,
            )
        )
        if isinstance(
            self.outcome,
            Exception,
        ):
            raise self.outcome
        return dict(
            self.outcome
        )


class RecordingMockExecutor:
    def __init__(self) -> None:
        self.calls: list[ActionPlan] = []

    async def execute(
        self,
        action: ActionPlan,
    ) -> dict:
        self.calls.append(
            action.model_copy(
                deep=True
            )
        )
        return {
            "success": True,
            "mode": "mock",
            "action": action.type.value,
            "target": action.target,
        }


def ready_pilot_control(
    clock,
) -> KubernetesProductionPilotControl:
    return KubernetesProductionPilotControl(
        config=KubernetesProductionPilotConfig(
            enabled=True,
            pilot_id="oom-action-runtime-test",
            change_ticket="CHG-3001",
            runbook_version="oom-runbook-v1",
            runbook_acknowledgement=(
                KUBERNETES_PRODUCTION_RUNBOOK_ACKNOWLEDGEMENT
            ),
            kill_switch_file="pilot-switch",
            authorized_operator_ids=(
                "executor-production-test",
            ),
            starts_at=NOW,
            expires_at=(
                NOW + timedelta(hours=1)
            ),
        ),
        preflight_config=KubernetesPreflightConfig(
            enabled=True,
            api_url="https://kubernetes.test",
            cluster_name="production-a",
            bearer_token_env="K8S_PREFLIGHT_TOKEN",
            allowed_targets=(
                KubernetesPreflightTargetConfig(
                    cluster="production-a",
                    namespace="payment",
                    deployment="payment-api",
                    container="payment-api",
                ),
            ),
        ),
        execution_config=(
            KubernetesProductionExecutionConfig(
                enabled=True,
                write_acknowledgement=(
                    KUBERNETES_PRODUCTION_WRITE_ACKNOWLEDGEMENT
                ),
                bearer_token_env=(
                    "K8S_PRODUCTION_EXECUTION_TOKEN"
                ),
            )
        ),
        clock=clock,
        switch_reader=(
            lambda _: (
                KUBERNETES_PRODUCTION_KILL_SWITCH_DISENGAGED
            )
        ),
    )


async def production_runtime(
    tmp_path: Path,
    *,
    outcome=None,
    enabled: bool = True,
):
    clock = MutableClock(
        NOW
        + timedelta(minutes=1)
    )
    (
        artifact_service,
        guard,
        approval_service,
        incident_store,
    ) = isolated_services(
        tmp_path,
        clock,
    )
    _, approval, incident = (
        await persist_prepared_workflow(
            artifact_service=artifact_service,
            approval_service=approval_service,
            incident_store=incident_store,
        )
    )
    await approval_service.approve(
        approval.id,
        operator_id="approver-production-test",
        idempotency_key="approve-production-0001",
        reason="Approve bounded production remediation",
    )
    execution_service = ActionExecutionService(
        ActionExecutionStore(
            tmp_path
            / "action_executions.db"
        )
    )
    pilot_control = (
        ready_pilot_control(
            clock
        )
        if enabled
        else None
    )
    pilot_budget_service = (
        ProductionPilotBudgetService(
            store=ProductionPilotBudgetStore(
                tmp_path
                / "production_pilot_budget.db"
            ),
            clock=clock,
        )
        if enabled
        else None
    )
    production_executor = (
        StubProductionExecutor(
            (
                outcome
                or {
                "success": True,
                "mode": "kubernetes_production",
                "action": "increase_memory_limit",
                "target": "payment-api",
                "message": (
                    "Kubernetes acknowledged bounded update"
                ),
                }
            ),
            pilot_control,
            pilot_budget_service,
        )
        if enabled
        else None
    )
    runtime = ActionRuntime(
        approval_service=approval_service,
        incident_store=incident_store,
        action_execution_service=execution_service,
        production_action_guard=guard,
        kubernetes_production_executor=(
            production_executor
        ),
        preflight_artifact_service=(
            artifact_service
            if enabled
            else None
        ),
        production_pilot_control=(
            pilot_control
        ),
        production_pilot_budget_service=(
            pilot_budget_service
        ),
    )
    mock_executor = RecordingMockExecutor()
    runtime.executor = mock_executor
    return (
        runtime,
        production_executor,
        mock_executor,
        execution_service,
        approval_service,
        incident_store,
        incident,
    )


def resume_arguments(
    incident,
) -> dict:
    return {
        "incident": incident,
        "operator_id": "executor-production-test",
        "idempotency_key": "execute-production-0001",
    }


def test_production_execution_components_must_be_shared(
    tmp_path,
):
    clock = MutableClock(
        NOW + timedelta(minutes=1)
    )
    budget_service = ProductionPilotBudgetService(
        store=ProductionPilotBudgetStore(
            tmp_path / "pilot_budget.db"
        )
    )
    executor = StubProductionExecutor(
        {
            "success": True,
        },
        ready_pilot_control(
            clock
        ),
        budget_service,
    )
    with pytest.raises(
        TypeError,
        match="components must be shared",
    ):
        ActionRuntime(
            kubernetes_production_executor=executor,
        )


@pytest.mark.asyncio
async def test_disabled_production_gate_blocks_before_claim_and_mock(
    tmp_path: Path,
):
    (
        runtime,
        production_executor,
        mock_executor,
        execution_service,
        _,
        _,
        incident,
    ) = await production_runtime(
        tmp_path,
        enabled=False,
    )

    result = await runtime.resume(
        APPROVAL_ID,
        **resume_arguments(incident),
    )

    assert result["status"] == "production_execution_disabled"
    assert result["retryable_after_enable"] is True
    assert result["executor_called"] is False
    assert result["real_write_attempted"] is False
    assert production_executor is None
    assert mock_executor.calls == []
    assert await execution_service.get_by_approval(APPROVAL_ID) is None


@pytest.mark.asyncio
async def test_existing_pilot_budget_blocks_a_second_action_before_executor(
    tmp_path: Path,
):
    (
        runtime,
        production_executor,
        mock_executor,
        execution_service,
        _,
        _,
        incident,
    ) = await production_runtime(
        tmp_path
    )
    budget_service = (
        runtime.production_pilot_budget_service
    )
    assert budget_service is not None
    await budget_service.store.reserve(
        ProductionPilotBudgetRecord(
            pilot_id="oom-action-runtime-test",
            execution_id=(
                "00000000-0000-4000-8000-000000000801"
            ),
            approval_id="approval-other-production-action",
            contract_id=(
                "00000000-0000-4000-8000-000000000802"
            ),
            operator_id="executor-production-test",
            patch_sha256="d" * 64,
            reserved_at=NOW,
            updated_at=NOW,
        )
    )

    result = await runtime.resume(
        APPROVAL_ID,
        **resume_arguments(incident),
    )

    assert result["status"] == (
        "production_pilot_budget_exhausted"
    )
    assert result["execution_status"] == "failed"
    assert production_executor.calls == []
    assert mock_executor.calls == []
    persisted = await execution_service.get_by_approval(
        APPROVAL_ID
    )
    assert persisted is not None
    assert persisted.status.value == "failed"


@pytest.mark.asyncio
async def test_engaged_kill_switch_blocks_before_claim_and_executor(
    tmp_path: Path,
):
    (
        runtime,
        production_executor,
        mock_executor,
        execution_service,
        _,
        _,
        incident,
    ) = await production_runtime(
        tmp_path
    )
    runtime.production_pilot_control._switch_reader = (
        lambda _: "ENGAGED"
    )

    result = await runtime.resume(
        APPROVAL_ID,
        **resume_arguments(incident),
    )

    assert result[
        "status"
    ] == "production_pilot_blocked"
    assert production_executor.calls == []
    assert mock_executor.calls == []
    assert await (
        execution_service.get_by_approval(
            APPROVAL_ID
        )
    ) is None


@pytest.mark.asyncio
async def test_pilot_operator_allowlist_blocks_before_claim(
