from pathlib import Path
import runpy

import pytest

from fastapi import HTTPException

from common.config.settings import (
    AuthenticationConfig,
)

import services.agent_runtime.app.runtime.runtime as runtime_module

from services.agent_runtime.app.security.api import (
    ApiSecurityAdapter,
    ApiSecurityConfigurationError,
)
from services.agent_runtime.app.security.factory import (
    create_authentication_service,
)
from services.agent_runtime.app.security.models import (
    ProtectedOperation,
)
from services.agent_runtime.app.security.policy import (
    SecurityPolicyEngine,
)
from services.agent_runtime.app.security.service import (
    AuthenticationService,
)


def api_runtime_path() -> Path:
    return (
        Path(__file__)
        .resolve()
        .parents[1]
        / "app"
        / "api"
        / "runtime.py"
    )


def disabled_authentication_service() -> AuthenticationService:
    return create_authentication_service(
        AuthenticationConfig()
    )


class FakeRuntime:
    """Minimum startup contract required by the API module wiring."""

    instances: list[
        "FakeRuntime"
    ] = []

    def __init__(
        self,
        *,
        authentication: AuthenticationService | None = None,
        security_policy: SecurityPolicyEngine | None = None,
    ) -> None:
        self.authentication = (
            authentication
            or disabled_authentication_service()
        )
        self.security_policy = (
            security_policy
            or SecurityPolicyEngine()
        )
        type(self).instances.append(
            self
        )


def execute_api_module(
    monkeypatch: pytest.MonkeyPatch,
    runtime_factory=FakeRuntime,
) -> dict:
    monkeypatch.setattr(
        runtime_module,
        "AgentRuntime",
        runtime_factory,
    )

    return runpy.run_path(
        str(
            api_runtime_path()
        ),
        run_name=(
            "api_security_wiring_test_module"
        ),
    )


def test_api_module_wires_one_shared_security_adapter(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
):
    monkeypatch.chdir(
        tmp_path
    )
    FakeRuntime.instances.clear()

    module = execute_api_module(
        monkeypatch
    )

    runtime = module[
        "runtime"
    ]
    adapter = module[
        "api_security"
    ]

    assert len(
        FakeRuntime.instances
    ) == 1
    assert runtime is FakeRuntime.instances[0]
    assert isinstance(
        adapter,
        ApiSecurityAdapter,
    )
    assert (
        adapter.authentication
        is runtime.authentication
    )
    assert (
        adapter.policy
        is runtime.security_policy
    )
    assert adapter.authorization_scheme == (
        "ApiKey"
    )


