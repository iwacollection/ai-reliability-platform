            frozenset(
                {
                    "POST",
                }
            ),
        ),
        (
            "/production-actions/{approval_id}/pilot-pre-enable-evidence",
            frozenset(
                {
                    "GET",
                }
            ),
        ),
        (
            "/production-actions/{approval_id}/pilot-pre-enable-sign-off",
            frozenset(
                {
                    "POST",
                }
            ),
        ),
        (
            "/production-actions/{approval_id}/pilot-final-handoff-rehearsal",
            frozenset(
                {
                    "POST",
                }
            ),
        ),
        (
            "/production-actions/{approval_id}/pilot-activation-checklist",
            frozenset(
                {
                    "POST",
                }
            ),
        ),
        (
            "/production-actions/pilot-readiness",
            frozenset(
                {
                    "GET",
                }
            ),
        ),
        (
            "/production-actions/preflight-artifacts/{artifact_id}",
            frozenset(
                {
                    "GET",
                }
            ),
        ),
        (
            "/incidents/{incident_id}",
            frozenset(
                {
                    "GET",
                }
            ),
        ),
        (
            "/incidents/{incident_id}/workflows",
            frozenset(
                {
                    "GET",
