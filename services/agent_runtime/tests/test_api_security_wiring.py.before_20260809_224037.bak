    assert actual_routes == expected_routes


def test_api_module_startup_does_not_authenticate_credentials(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
):
    class CountingAuthenticationService(
        AuthenticationService
    ):
        def __init__(
            self,
        ) -> None:
            base = disabled_authentication_service()
            super().__init__(
                base.registry
            )
            self.authenticate_calls = 0

        def authenticate(
            self,
            credential,
            *,
            provider_name=None,
        ):
            self.authenticate_calls += 1
            return super().authenticate(
                credential,
                provider_name=provider_name,
            )

    authentication = (
        CountingAuthenticationService()
    )

    class CountingRuntime(
        FakeRuntime
    ):
        def __init__(
            self,
        ) -> None:
            super().__init__(
                authentication=authentication
            )

    monkeypatch.chdir(
        tmp_path
    )
    module = execute_api_module(
        monkeypatch,
        CountingRuntime,
    )

    assert module[
        "api_security"
    ].authentication is authentication
    assert authentication.authenticate_calls == 0


def test_default_disabled_authentication_remains_fail_closed(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
):
    monkeypatch.chdir(
        tmp_path
    )
    module = execute_api_module(
        monkeypatch
    )
    adapter = module[
        "api_security"
    ]

    with pytest.raises(
        HTTPException
    ) as captured:
        adapter.require(
            None,
            ProtectedOperation.READ_INCIDENT,
        )

    assert captured.value.status_code == 401
    assert captured.value.detail == (
        "Authentication failed"
    )


@pytest.mark.parametrize(
    (
        "authentication",
        "security_policy",
        "expected_message",
    ),
    [
        (
            object(),
            SecurityPolicyEngine(),
            "AuthenticationService",
        ),
        (
            disabled_authentication_service(),
            object(),
            "SecurityPolicyEngine",
        ),
    ],
)
def test_invalid_runtime_security_contract_fails_api_startup(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
    authentication,
    security_policy,
    expected_message: str,
):
    class InvalidRuntime:
        def __init__(
            self,
        ) -> None:
            self.authentication = authentication
            self.security_policy = security_policy

    monkeypatch.chdir(
        tmp_path
    )

    with pytest.raises(
        ApiSecurityConfigurationError,
        match=expected_message,
    ):
        execute_api_module(
            monkeypatch,
            InvalidRuntime,
        )


def test_separate_api_module_executions_do_not_share_runtime_state(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
):
    monkeypatch.chdir(
        tmp_path
    )

    first = execute_api_module(
        monkeypatch
    )
    second = execute_api_module(
        monkeypatch
    )

    assert first[
        "runtime"
    ] is not second[
        "runtime"
    ]
    assert first[
        "api_security"
    ] is not second[
        "api_security"
    ]
    assert (
        first[
            "api_security"
        ].authentication
        is first[
            "runtime"
        ].authentication
    )
    assert (
        second[
            "api_security"
        ].authentication
        is second[
            "runtime"
        ].authentication
    )


def test_wiring_test_creates_no_database_files(
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
):
    monkeypatch.chdir(
        tmp_path
    )

    execute_api_module(
        monkeypatch
    )

    assert list(
        tmp_path.rglob(
            "*.db"
        )
    ) == []
