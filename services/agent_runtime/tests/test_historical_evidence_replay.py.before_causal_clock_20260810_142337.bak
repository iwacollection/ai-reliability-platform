from copy import deepcopy
from datetime import UTC, datetime, timedelta
from types import SimpleNamespace

import pytest

from services.agent_runtime.app.evaluation.real_incident.historical_replay import (
    HistoricalEvidenceNotFoundError,
    HistoricalReplayOperationNotAllowedError,
    create_historical_replay_probe_executor,
    create_historical_replay_tool_manager,
)
from services.agent_runtime.app.evaluation.real_incident.models import (
    RealIncidentReplaySource,
)
from services.agent_runtime.app.investigation.models import (
    InvestigationProbe,
    InvestigationScope,
)
from services.agent_runtime.app.investigation.probes import (
    InvestigationProbeResponseError,
)


INCIDENT_TIME = datetime(
    2026,
    7,
    18,
    6,
    1,
    0,
    tzinfo=UTC,
)


def replay_source(
    *,
    kubernetes_offset_seconds=30,
    prometheus_production_signal=True,
):
    return RealIncidentReplaySource.model_validate(
        {
            "schema_version": "v1",
            "incident_id": (
                "incident-history-001"
            ),
            "event": {
                "header": {
                    "event_id": (
                        "11111111-1111-4111-8111-111111111111"
                    ),
                    "trace_id": (
                        "22222222-2222-4222-8222-222222222222"
                    ),
                    "source": (
                        "alertmanager"
                    ),
                    "occurred_at": (
                        INCIDENT_TIME.isoformat()
                    ),
                },
                "signal": {
                    "type": "alert",
                    "name": (
                        "PodOOMKilled"
                    ),
                    "severity": (
                        "critical"
                    ),
                    "message": (
                        "payment-api restarted"
                    ),
                    "labels": {},
                },
                "resources": [
                    {
                        "kind": "pod",
                        "name": (
                            "payment-api"
                        ),
                        "namespace": (
                            "payment"
                        ),
                        "cluster": (
                            "production-a"
                        ),
                    }
                ],
            },
            "observations": [
                {
                    "observation_id": (
                        "obs-k8s-1"
                    ),
                    "source": (
                        "kubernetes"
                    ),
                    "kind": (
                        "pod_state"
                    ),
                    "observed_at": (
                        INCIDENT_TIME
                        + timedelta(
                            seconds=(
                                kubernetes_offset_seconds
                            )
                        )
                    ).isoformat(),
                    "production_signal": True,
                    "data": {
                        "phase": "Running",
                        "ready": False,
                        "scheduled": True,
                        "oom_killed": True,
                        "uid": (
                            "must-not-leak"
                        ),
                        "containers": [
                            {
                                "restart_count": 7,
                                "state_reason": (
                                    "CrashLoopBackOff"
                                ),
                                "last_termination_reason": (
                                    "OOMKilled"
                                ),
                                "image": (
                                    "must-not-leak"
                                ),
                            }
                        ],
                    },
                    "metadata": {
                        "resource": (
                            "payment-api"
                        ),
                        "namespace": (
                            "payment"
                        ),
                        "cluster": (
                            "production-a"
                        ),
                    },
                },
                {
                    "observation_id": (
                        "obs-memory-working-set"
                    ),
                    "source": (
                        "prometheus"
                    ),
                    "kind": (
                        "memory_working_set"
                    ),
                    "observed_at": (
                        INCIDENT_TIME
                        + timedelta(
                            seconds=20
                        )
                    ).isoformat(),
                    "production_signal": (
                        prometheus_production_signal
                    ),
                    "data": {
                        "value": (
                            520000000.0
                        ),
                    },
                    "metadata": {
                        "resource": (
                            "payment-api"
                        ),
                        "namespace": (
                            "payment"
                        ),
                        "cluster": (
                            "production-a"
                        ),
                    },
                },
                {
                    "observation_id": (
                        "obs-memory-limit"
                    ),
                    "source": (
                        "prometheus"
                    ),
                    "kind": (
                        "memory_limit"
                    ),
                    "observed_at": (
                        INCIDENT_TIME
                        + timedelta(
                            seconds=25
                        )
                    ).isoformat(),
                    "production_signal": True,
                    "data": {
                        "value": (
                            536870912.0
                        ),
                    },
                    "metadata": {
                        "resource": (
                            "payment-api"
                        ),
                        "namespace": (
                            "payment"
                        ),
                        "cluster": (
                            "production-a"
                        ),
                    },
                },
                {
                    "observation_id": (
                        "obs-restart-count"
                    ),
                    "source": (
                        "prometheus"
                    ),
                    "kind": (
                        "restart_count"
                    ),
                    "observed_at": (
                        INCIDENT_TIME
                        - timedelta(
                            seconds=15
                        )
                    ).isoformat(),
                    "production_signal": True,
                    "data": {
                        "value": 7,
                    },
                    "metadata": {
                        "resource": (
                            "payment-api"
                        ),
                        "namespace": (
                            "payment"
                        ),
                        "cluster": (
                            "production-a"
                        ),
                    },
                },
            ],
        }
    )


def scope():
    return InvestigationScope(
        alert_name=(
            "PodOOMKilled"
        ),
        alert_message=(
            "payment-api restarted"
        ),
        event_occurred_at=(
            INCIDENT_TIME
        ),
        resource="payment-api",
        namespace="payment",
        cluster="production-a",
    )


def context(
    source,
):
    return SimpleNamespace(
        tools=(
            create_historical_replay_tool_manager(
                source
            )
        ),
        trace=None,
    )


@pytest.mark.asyncio
async def test_existing_investigation_executor_reads_historical_kubernetes():
    source = replay_source()

    executor = (
        create_historical_replay_probe_executor()
    )

    evidence = await executor.collect(
        context(
            source
        ),
        scope(),
        InvestigationProbe.KUBERNETES_POD_STATE,
    )

    assert evidence.source == (
        "kubernetes"
    )

    assert evidence.success is True
    assert evidence.trusted is True

    assert (
        evidence.production_signal
        is True
    )

    assert (
        evidence.observed_at
        == INCIDENT_TIME
        + timedelta(
            seconds=30
        )
    )

    assert (
        evidence.facts[
            "temporal_basis"
        ]
        == "incident_time"
    )

    assert (
        evidence.facts[
            "oom_killed"
        ]
        is True
    )

    assert (
        evidence.facts[
            "max_restart_count"
        ]
        == 7
    )

    serialized = str(
        evidence.model_dump(
            mode="json"
        )
    )

    assert (
        "must-not-leak"
        not in serialized
    )


@pytest.mark.asyncio
@pytest.mark.parametrize(
    (
        "probe",
        "expected_value",
        "expected_offset",
    ),
    [
        (
            InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
            520000000.0,
            20.0,
        ),
        (
            InvestigationProbe.PROMETHEUS_MEMORY_LIMIT,
            536870912.0,
            25.0,
        ),
        (
            InvestigationProbe.PROMETHEUS_RESTART_COUNT,
            7.0,
            -15.0,
        ),
    ],
)
async def test_existing_investigation_executor_reads_historical_prometheus(
    probe,
    expected_value,
    expected_offset,
):
    source = replay_source()

    executor = (
        create_historical_replay_probe_executor()
    )

    evidence = await executor.collect(
        context(
            source
        ),
        scope(),
        probe,
    )

    assert evidence.source == (
        "prometheus"
    )

    assert evidence.trusted is True

    assert (
        evidence.facts[
            "temporal_basis"
        ]
        == "incident_time"
    )

    assert (
        evidence.facts[
            "event_offset_seconds"
        ]
        == expected_offset
    )

    assert (
        evidence.facts[
            "value_sum"
        ]
        == expected_value
    )


@pytest.mark.asyncio
async def test_historical_kubernetes_replay_rejects_mutation():
    source = replay_source()

    manager = (
        create_historical_replay_tool_manager(
            source
        )
    )

    kubernetes = (
        manager.registry.get(
            "kubernetes"
        )
    )

    with pytest.raises(
        HistoricalReplayOperationNotAllowedError,
        match="not read-only",
    ):
        await kubernetes.execute(
            action="delete",
            resource="pod",
            target="payment-api",
            namespace="payment",
        )


@pytest.mark.asyncio
async def test_historical_prometheus_replay_rejects_arbitrary_query():
    source = replay_source()

    manager = (
        create_historical_replay_tool_manager(
            source
        )
    )

    prometheus = (
        manager.registry.get(
            "prometheus"
        )
    )

    with pytest.raises(
        HistoricalReplayOperationNotAllowedError,
        match="allowlist",
    ):
        await prometheus.execute(
            query=(
                "sum(rate("
                "http_requests_total[5m]"
                "))"
            ),
            time=INCIDENT_TIME,
        )


@pytest.mark.asyncio
async def test_prometheus_non_production_observation_fails_existing_trust_boundary():
    source = replay_source(
        prometheus_production_signal=False
    )

    executor = (
        create_historical_replay_probe_executor()
    )

    with pytest.raises(
        InvestigationProbeResponseError,
        match="not a production signal",
    ):
        await executor.collect(
            context(
                source
            ),
            scope(),
            InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
        )


@pytest.mark.asyncio
async def test_prometheus_observation_outside_incident_window_fails_existing_time_policy():
    payload = (
        replay_source()
        .model_dump(
            mode="json"
        )
    )

    for observation in (
        payload[
            "observations"
        ]
    ):
        if (
            observation[
                "kind"
            ]
            == "memory_working_set"
        ):
            observation[
                "observed_at"
            ] = (
                INCIDENT_TIME
                + timedelta(
                    minutes=5
                )
            ).isoformat()

    source = (
        RealIncidentReplaySource
        .model_validate(
            payload
        )
    )

    executor = (
        create_historical_replay_probe_executor()
    )

    with pytest.raises(
        InvestigationProbeResponseError,
        match="temporally relevant",
    ):
        await executor.collect(
            context(
                source
            ),
            scope(),
            InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
        )


@pytest.mark.asyncio
async def test_kubernetes_historical_snapshot_outside_window_fails_closed():
    source = replay_source(
        kubernetes_offset_seconds=(
            20 * 60
        )
    )

    executor = (
        create_historical_replay_probe_executor()
    )

    with pytest.raises(
        HistoricalEvidenceNotFoundError,
        match="outside the Incident-time window",
    ):
        await executor.collect(
            context(
                source
            ),
            scope(),
            InvestigationProbe.KUBERNETES_POD_STATE,
        )


@pytest.mark.asyncio
async def test_nearest_prometheus_observation_is_selected():
    payload = (
        replay_source()
        .model_dump(
            mode="json"
        )
    )

    second = deepcopy(
        next(
            item
            for item
            in payload[
                "observations"
            ]
            if item[
                "kind"
            ]
            == "memory_working_set"
        )
    )

    second[
        "observation_id"
    ] = (
        "obs-memory-working-set-later"
    )

    second[
        "observed_at"
    ] = (
        INCIDENT_TIME
        + timedelta(
            seconds=90
        )
    ).isoformat()

    second[
        "data"
    ][
        "value"
    ] = 999999999.0

    payload[
        "observations"
    ].append(
        second
    )

    source = (
        RealIncidentReplaySource
        .model_validate(
            payload
        )
    )

    executor = (
        create_historical_replay_probe_executor()
    )

    evidence = await executor.collect(
        context(
            source
        ),
        scope(),
        InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
    )

    assert (
        evidence.facts[
            "value_sum"
        ]
        == 520000000.0
    )

    assert (
        evidence.facts[
            "event_offset_seconds"
        ]
        == 20.0
    )


def test_historical_tool_manager_reuses_live_tool_names():
    manager = (
        create_historical_replay_tool_manager(
            replay_source()
        )
    )

    names = {
        tool.name
        for tool
        in manager.registry.list_tools()
    }

    assert names == {
        "kubernetes",
        "prometheus",
    }
