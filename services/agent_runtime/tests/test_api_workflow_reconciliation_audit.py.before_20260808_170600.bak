from datetime import UTC, datetime, timedelta
from typing import Any

import httpx
import pytest
from fastapi import FastAPI

from services.agent_runtime.app.action.models import (
    ActionPlan,
    ActionRisk,
    ActionType,
)
from services.agent_runtime.app.incident.enums import (
    IncidentStatus,
)
from services.agent_runtime.app.incident.state import (
    IncidentState,
)
from services.agent_runtime.app.runtime.runtime import (
    AgentRuntime,
)
from services.agent_runtime.app.verification.models import (
    VerificationCheck,
)


class CountingCollector:
    """Return deterministic evidence and count real probe collection."""

    def __init__(self) -> None:
        self.calls = 0

    async def collect(
        self,
        probes,
        context=None,
    ) -> list[VerificationCheck]:
        self.calls += 1

        return [
            VerificationCheck(
                name=probe.name,
                source=probe.source,
                passed=True,
                required=probe.required,
                observed_value=(
                    "reconciliation-audit-evidence"
                ),
                expected_value=(
                    "verification-profile-rule"
                ),
                message=(
                    "Deterministic reconciliation audit evidence"
                ),
            )
            for probe in probes
        ]


@pytest.fixture
def api_environment(
    monkeypatch,
    tmp_path,
):
    """Create an isolated API with temporary SQLite persistence."""

    monkeypatch.chdir(
        tmp_path
    )

    for name in (
        "PROMETHEUS_URL",
        "KUBERNETES_API_URL",
        "KUBERNETES_SERVICE_HOST",
        "KUBERNETES_SERVICE_PORT",
        "KUBERNETES_SERVICE_PORT_HTTPS",
    ):
        monkeypatch.delenv(
            name,
            raising=False,
        )

    monkeypatch.setenv(
        "PROMETHEUS_ALLOW_MOCK_FALLBACK",
        "true",
    )
    monkeypatch.setenv(
        "KUBERNETES_ALLOW_DRY_RUN_FALLBACK",
        "true",
    )

    from services.agent_runtime.app.api import (
        runtime as api_module,
    )

    isolated_runtime = AgentRuntime()
    monkeypatch.setattr(
        api_module,
        "runtime",
        isolated_runtime,
    )

    app = FastAPI()
    app.include_router(
        api_module.router
    )

    return (
        app,
        isolated_runtime,
    )


def api_client(
    app: FastAPI,
) -> httpx.AsyncClient:
    return httpx.AsyncClient(
        transport=httpx.ASGITransport(
            app=app
        ),
        base_url="http://test",
    )


def workflow_path(
    incident_id,
) -> str:
    return (
        f"/incidents/{incident_id}/workflows"
    )


def reconciliation_path(
    execution_id,
) -> str:
    return (
        "/action-executions/"
        f"{execution_id}"
        "/reconcile"
    )


def reconciliation_headers(
    *,
    idempotency_key: str,
) -> dict[str, str]:
    return {
        "X-Operator-ID": "sre-auditor",
        "Idempotency-Key": idempotency_key,
    }


def success_decision() -> dict[str, Any]:
    return {
        "outcome": "succeeded",
        "reason": (
            "Kubernetes audit confirms the Action succeeded"
        ),
        "result": {
            "success": True,
            "evidence": "kubernetes_audit",
        },
        "metadata": {
            "ticket": "INC-2026-AUDIT-1",
        },
    }


def failure_decision() -> dict[str, Any]:
    return {
        "outcome": "failed",
        "reason": (
            "Kubernetes audit confirms the Action failed"
        ),
        "result": {
            "success": False,
            "evidence": "kubernetes_audit",
        },
        "error_type": "MutationNotObserved",
        "error_message": (
            "Deployment generation and Pod UID were unchanged"
        ),
        "metadata": {
            "ticket": "INC-2026-AUDIT-2",
        },
    }


def action_plan() -> ActionPlan:
    return ActionPlan(
        type=(
            ActionType.INCREASE_MEMORY_LIMIT
        ),
        target="payment-api",
        namespace="payment",
        cluster="production-tw",
        risk=ActionRisk.MEDIUM,
        approved=False,
        metadata={
            "memory_limit": "1Gi",
        },
    )


async def create_indeterminate_workflow(
    runtime: AgentRuntime,
    *,
    label: str,
    created_at: datetime | None = None,
    incident: IncidentState | None = None,
):
    if incident is None:
        incident = IncidentState(
            status=IncidentStatus.HEALING,
        )
        incident = await runtime.incident_store.save(
            incident
        )

    approval = await runtime.approval.create_approval(
        action=action_plan(),
        reason=(
            f"Reconciliation audit workflow {label}"
        ),
        incident_id=incident.id,
    )

    if created_at is not None:
        approval.created_at = created_at
        approval.updated_at = created_at
        approval = await (
            runtime.approval.manager.store.update(
                approval
            )
        )

    approval = await runtime.approval.approve(
        approval.id,
        operator_id="approval-operator",
        idempotency_key=(
            f"approve:{label}:{approval.id}"
        ),
        reason=(
            f"Approved reconciliation audit workflow {label}"
        ),
    )
    claim = await (
        runtime.action_execution_service.claim(
            approval_id=approval.id,
            incident_id=incident.id,
            operator_id="executor-operator",
            idempotency_key=(
                f"execute:{label}:{approval.id}"
            ),
            action=approval.action,
            metadata={
                "source": (
                    "workflow-reconciliation-audit-test"
                ),
                "label": label,
            },
        )
    )
    execution = await (
        runtime.action_execution_service
        .mark_indeterminate(
            str(
                claim.execution.id
            ),
            "Executor connection closed before returning an outcome",
        )
    )

    return (
        incident,
        approval,
        execution,
    )


async def get_workflows(
    app: FastAPI,
    incident_id,
) -> dict[str, Any]:
    async with api_client(
        app
    ) as client:
        response = await client.get(
            workflow_path(
                incident_id
            )
        )

    assert response.status_code == 200

    return response.json()


@pytest.mark.asyncio
async def test_indeterminate_execution_exposes_required_audit(
    api_environment,
):
    app, runtime = api_environment
    incident, approval, execution = (
        await create_indeterminate_workflow(
            runtime,
            label="required",
        )
    )

    body = await get_workflows(
        app,
        incident.id,
    )

    assert body["workflow_status"] == (
        "action_indeterminate"
    )
    assert body[
        "manual_reconciliation_required"
    ] is True
    assert body["consistency"] == {
        "passed": True,
        "issues": [],
    }

    workflow = body["workflows"][0]
    audit = workflow["reconciliation"]
    assert workflow["approval_id"] == (
        approval.id
    )
    assert workflow["links"][
        "execution_id"
    ] == str(
        execution.id
    )
    assert audit == {
        "required": True,
        "performed": False,
        "outcome": None,
        "operator_id": None,
        "idempotency_key": None,
        "reason": None,
        "reconciled_at": None,
        "result": None,
        "error_type": None,
        "error_message": None,
        "metadata": {},
        "verification_expected": False,
        "verification_present": False,
        "verification_rule_satisfied": True,
    }
    assert body["reconciliation_summary"] == {
        "required": 1,
        "performed": 0,
        "succeeded": 0,
        "failed": 0,
        "verification_follow_up_required": 0,
        "current": audit,
    }


@pytest.mark.asyncio
async def test_successful_reconciliation_audit_links_verification(
    api_environment,
):
    app, runtime = api_environment
    incident, _, execution = (
        await create_indeterminate_workflow(
            runtime,
            label="success",
        )
    )
    collector = CountingCollector()
    runtime.verification_coordinator.collector = (
        collector
    )
    key = "reconciliation-audit-success-key"

    async with api_client(
        app
    ) as client:
        reconcile_response = await client.post(
            reconciliation_path(
                execution.id
            ),
            json=success_decision(),
            headers=reconciliation_headers(
                idempotency_key=key
            ),
        )

    assert reconcile_response.status_code == 200
    assert collector.calls == 1

    body = await get_workflows(
        app,
        incident.id,
    )
    workflow = body["workflows"][0]
    audit = workflow["reconciliation"]

    assert body["workflow_status"] == "resolved"
    assert body["workflow_success"] is True
    assert body["consistency"] == {
        "passed": True,
        "issues": [],
    }
    assert audit["required"] is False
    assert audit["performed"] is True
    assert audit["outcome"] == "succeeded"
    assert audit["operator_id"] == "sre-auditor"
    assert audit["idempotency_key"] == key
    assert audit["reason"] == (
        success_decision()["reason"]
    )
    assert audit["reconciled_at"] is not None
    assert audit["result"] == (
        success_decision()["result"]
    )
    assert audit["metadata"]["ticket"] == (
        "INC-2026-AUDIT-1"
    )
    assert audit["metadata"]["source"] == "api"
    assert audit["metadata"]["trigger"] == (
        "manual_action_reconciliation"
    )
    assert audit[
        "verification_expected"
    ] is True
    assert audit["verification_present"] is True
    assert audit[
        "verification_rule_satisfied"
    ] is True
    assert workflow["verification"] is not None
    assert body["reconciliation_summary"] == {
        "required": 0,
        "performed": 1,
        "succeeded": 1,
        "failed": 0,
        "verification_follow_up_required": 0,
        "current": audit,
    }


@pytest.mark.asyncio
async def test_failed_reconciliation_audit_forbids_verification(
    api_environment,
):
    app, runtime = api_environment
    incident, _, execution = (
        await create_indeterminate_workflow(
            runtime,
            label="failure",
        )
    )
    collector = CountingCollector()
    runtime.verification_coordinator.collector = (
        collector
    )
    key = "reconciliation-audit-failure-key"

    async with api_client(
        app
    ) as client:
        reconcile_response = await client.post(
            reconciliation_path(
                execution.id
            ),
            json=failure_decision(),
            headers=reconciliation_headers(
                idempotency_key=key
            ),
        )

    assert reconcile_response.status_code == 200
    assert collector.calls == 0

    body = await get_workflows(
        app,
        incident.id,
    )
    workflow = body["workflows"][0]
    audit = workflow["reconciliation"]

    assert body["workflow_status"] == (
        "action_failed"
    )
    assert body["workflow_success"] is False
    assert body["terminal"] is True
    assert body["consistency"] == {
        "passed": True,
        "issues": [],
    }
    assert audit["performed"] is True
    assert audit["outcome"] == "failed"
    assert audit["operator_id"] == "sre-auditor"
    assert audit["idempotency_key"] == key
    assert audit["error_type"] == (
        "MutationNotObserved"
    )
    assert audit["error_message"] == (
        failure_decision()["error_message"]
    )
    assert audit[
        "verification_expected"
    ] is False
    assert audit["verification_present"] is False
    assert audit[
        "verification_rule_satisfied"
    ] is True
    assert workflow["verification"] is None
    assert body["reconciliation_summary"] == {
        "required": 0,
        "performed": 1,
        "succeeded": 0,
        "failed": 1,
        "verification_follow_up_required": 0,
        "current": audit,
    }


@pytest.mark.asyncio
async def test_reconciled_success_without_verification_requires_follow_up(
    api_environment,
):
    app, runtime = api_environment
    incident, _, execution = (
        await create_indeterminate_workflow(
            runtime,
            label="verification-follow-up",
        )
    )

    result = await (
        runtime.action_execution_service.reconcile(
            execution.id,
            outcome="succeeded",
            operator_id="recovery-operator",
            idempotency_key=(
                "reconciliation-before-verification"
            ),
            reason=(
                "External audit confirms success before probes run"
            ),
            result={
                "success": True,
                "evidence": "external-audit",
            },
            metadata={
                "source": "recovery-test",
            },
        )
    )
    assert result.applied is True

    body = await get_workflows(
        app,
        incident.id,
    )
    audit = body["workflows"][0][
        "reconciliation"
    ]

    assert body["workflow_status"] == (
        "awaiting_verification"
    )
    assert body["workflow_success"] is False
    assert body["follow_up_required"] is True
    assert body["consistency"] == {
        "passed": True,
        "issues": [],
    }
    assert audit["performed"] is True
    assert audit["outcome"] == "succeeded"
    assert audit[
        "verification_expected"
    ] is True
    assert audit["verification_present"] is False
    assert audit[
        "verification_rule_satisfied"
    ] is False
    assert body["reconciliation_summary"][
        "verification_follow_up_required"
    ] == 1


@pytest.mark.asyncio
async def test_failed_reconciliation_with_verification_is_inconsistent(
    api_environment,
):
    app, runtime = api_environment
    incident, _, execution = (
        await create_indeterminate_workflow(
            runtime,
            label="invalid-verification",
        )
    )
    result = await (
        runtime.action_execution_service.reconcile(
            execution.id,
            outcome="failed",
            operator_id="recovery-operator",
            idempotency_key=(
                "failed-with-verification"
            ),
            reason=(
                "External audit confirms failure"
            ),
            result={
                "success": False,
                "evidence": "external-audit",
            },
            error_type="MutationNotObserved",
        )
    )
    assert result.applied is True

    incident.update(
        IncidentStatus.FAILED,
        reason="Action reconciliation confirmed failure",
    )
    await runtime.incident_store.update(
        incident
    )
    await runtime.verification.create_verification(
        incident_id=incident.id,
        action_execution_id=execution.id,
        action=execution.action.type.value,
        target=execution.action.target,
        metadata={
            "injected_inconsistency": True,
        },
    )

    body = await get_workflows(
        app,
        incident.id,
    )
    audit = body["workflows"][0][
        "reconciliation"
    ]

    assert body["workflow_status"] == (
        "inconsistent"
    )
    assert body[
        "manual_reconciliation_required"
    ] is True
    assert body["consistency"]["passed"] is False
    assert any(
        issue.endswith(
            "verification_exists_after_failed_reconciliation"
        )
        for issue in body["consistency"][
            "issues"
        ]
    )
    assert audit["outcome"] == "failed"
    assert audit["verification_present"] is True
    assert audit[
        "verification_rule_satisfied"
    ] is False


@pytest.mark.asyncio
async def test_multiple_workflows_aggregate_reconciliation_counts(
    api_environment,
):
    app, runtime = api_environment
    incident = IncidentState(
        status=IncidentStatus.HEALING,
    )
    incident = await runtime.incident_store.save(
        incident
    )
    started_at = datetime.now(
        UTC
    )

    _, _, first_execution = (
        await create_indeterminate_workflow(
            runtime,
            label="historical-failed",
            created_at=started_at,
            incident=incident,
        )
    )
    first_result = await (
        runtime.action_execution_service.reconcile(
            first_execution.id,
            outcome="failed",
            operator_id="historical-operator",
            idempotency_key=(
                "historical-failed-reconciliation"
            ),
            reason="Historical remediation attempt failed",
            result={
                "success": False,
            },
        )
    )
    assert first_result.applied is True

    _, second_approval, _ = (
        await create_indeterminate_workflow(
            runtime,
            label="current-pending",
            created_at=(
                started_at
                + timedelta(
                    seconds=1
                )
            ),
            incident=incident,
        )
    )

    body = await get_workflows(
        app,
        incident.id,
    )

    assert body["consistency"] == {
        "passed": True,
        "issues": [],
    }
    assert body["workflow_status"] == (
        "action_indeterminate"
    )
    assert body[
        "current_workflow_approval_id"
    ] == second_approval.id
    assert body["reconciliation_summary"][
        "required"
    ] == 1
    assert body["reconciliation_summary"][
        "performed"
    ] == 1
    assert body["reconciliation_summary"][
        "succeeded"
    ] == 0
    assert body["reconciliation_summary"][
        "failed"
    ] == 1
    assert body["reconciliation_summary"][
        "current"
    ]["required"] is True


@pytest.mark.asyncio
async def test_reconciliation_audit_query_is_strictly_read_only(
    api_environment,
    monkeypatch,
):
    app, runtime = api_environment
    incident, _, _ = (
        await create_indeterminate_workflow(
            runtime,
            label="read-only",
        )
    )

    async def forbidden_mutation(
        *args,
        **kwargs,
    ):
        pytest.fail(
            "Workflow reconciliation audit query attempted a mutation"
        )

    mutation_targets: list[tuple[Any, str]] = [
        (
            runtime.action_runtime,
            "execute",
        ),
        (
            runtime.action_runtime,
            "resume",
        ),
        (
            runtime.action_runtime.executor,
            "execute",
        ),
        (
            runtime.approval,
            "approve",
        ),
        (
            runtime.approval,
            "reject",
        ),
        (
            runtime.action_execution_service,
            "claim",
        ),
        (
            runtime.action_execution_service,
            "complete",
        ),
        (
            runtime.action_execution_service,
            "reconcile",
        ),
        (
            runtime.verification,
            "claim_verification",
        ),
        (
            runtime.verification,
            "start",
        ),
        (
            runtime.verification,
            "complete",
        ),
        (
            runtime.verification_coordinator,
            "run",
        ),
        (
            runtime.verification_coordinator.collector,
            "collect",
        ),
        (
            runtime.incident_store,
            "save",
        ),
        (
            runtime.incident_store,
            "update",
        ),
    ]

    for target, attribute in mutation_targets:
        monkeypatch.setattr(
            target,
            attribute,
            forbidden_mutation,
        )

    async with api_client(
        app
    ) as client:
        first_response = await client.get(
            workflow_path(
                incident.id
            )
        )
        replay_response = await client.get(
            workflow_path(
                incident.id
            )
        )

    assert first_response.status_code == 200
    assert replay_response.status_code == 200
    assert first_response.json() == (
        replay_response.json()
    )
    assert first_response.json()[
        "reconciliation_summary"
    ]["required"] == 1
