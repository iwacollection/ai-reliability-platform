from types import MappingProxyType

import pytest

from services.agent_runtime.app.security.models import (
    AuthenticationMethod,
    OperatorIdentity,
    OperatorRole,
    ProtectedOperation,
    RuntimePermission,
)
from services.agent_runtime.app.security.policy import (
    AuthorizationDeniedError,
    DEFAULT_OPERATION_PERMISSIONS,
    DEFAULT_ROLE_PERMISSIONS,
    SecurityPolicyConfigurationError,
    SecurityPolicyEngine,
)


READ_OPERATIONS = frozenset(
    {
        ProtectedOperation.READ_INCIDENT,
        ProtectedOperation.READ_INCIDENT_WORKFLOWS,
        ProtectedOperation.READ_APPROVAL,
        ProtectedOperation.READ_APPROVAL_WORKFLOW,
        ProtectedOperation.READ_VERIFICATION,
    }
)


WRITE_OPERATIONS = frozenset(
    {
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS,
        ProtectedOperation.PREPARE_REMEDIATION,
        ProtectedOperation.DECIDE_APPROVAL,
        ProtectedOperation.RESUME_ACTION,
        ProtectedOperation.RECONCILE_ACTION,
    }
)


def identity(
    *roles: OperatorRole,
) -> OperatorIdentity:
    return OperatorIdentity(
        principal_id=(
            "operator-"
            + "-".join(
                role.value
                for role in roles
            )
        ),
        authentication_method=(
            AuthenticationMethod.TRUSTED_PROXY
        ),
        roles=frozenset(
            roles
        ),
    )


def test_default_policy_is_complete_and_immutable():
    engine = SecurityPolicyEngine()

    assert isinstance(
        engine.role_permissions,
        MappingProxyType,
    )
    assert isinstance(
        engine.operation_permissions,
        MappingProxyType,
    )
    assert set(
        engine.role_permissions
    ) == set(
        OperatorRole
    )
    assert set(
        engine.operation_permissions
    ) == set(
        ProtectedOperation
    )

    with pytest.raises(
        TypeError
    ):
        engine.role_permissions[
            OperatorRole.VIEWER
        ] = frozenset()

    with pytest.raises(
        AttributeError
    ):
        engine.role_permissions[
            OperatorRole.VIEWER
        ].add(
            RuntimePermission.ACTION_EXECUTE
        )


def test_default_role_permissions_are_least_privilege():
    read_permissions = frozenset(
        {
            RuntimePermission.INCIDENT_READ,
            RuntimePermission.WORKFLOW_READ,
            RuntimePermission.APPROVAL_READ,
            RuntimePermission.VERIFICATION_READ,
        }
    )

    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.VIEWER
    ] == read_permissions
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.ANALYST
    ] == (
        read_permissions
        | {
            RuntimePermission.RUNTIME_EXECUTE,
            RuntimePermission.REMEDIATION_PREPARE,
        }
    )
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.APPROVER
    ] == (
        read_permissions
        | {
            RuntimePermission.APPROVAL_DECIDE,
        }
    )
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.EXECUTOR
    ] == (
        read_permissions
        | {
            RuntimePermission.ACTION_EXECUTE,
        }
    )
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.RECONCILER
    ] == (
        read_permissions
        | {
            RuntimePermission.ACTION_RECONCILE,
        }
    )
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.SERVICE
    ] == frozenset(
        {
            RuntimePermission.RUNTIME_EXECUTE,
            RuntimePermission.REMEDIATION_PREPARE,
        }
    )
    assert DEFAULT_ROLE_PERMISSIONS[
        OperatorRole.ADMIN
    ] == frozenset(
        RuntimePermission
    )


def test_operation_permissions_match_route_boundaries():
    assert DEFAULT_OPERATION_PERMISSIONS == {
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS: (
            frozenset(
                {
                    RuntimePermission.RUNTIME_EXECUTE,
                }
            )
        ),
        ProtectedOperation.PREPARE_REMEDIATION: (
            frozenset(
                {
                    RuntimePermission.REMEDIATION_PREPARE,
                }
            )
        ),
        ProtectedOperation.READ_INCIDENT: (
            frozenset(
                {
                    RuntimePermission.INCIDENT_READ,
                }
            )
        ),
        ProtectedOperation.READ_INCIDENT_WORKFLOWS: (
            frozenset(
                {
                    RuntimePermission.INCIDENT_READ,
                    RuntimePermission.WORKFLOW_READ,
                }
            )
        ),
        ProtectedOperation.READ_APPROVAL: (
            frozenset(
                {
                    RuntimePermission.APPROVAL_READ,
                }
            )
        ),
        ProtectedOperation.READ_APPROVAL_WORKFLOW: (
            frozenset(
                {
                    RuntimePermission.APPROVAL_READ,
                    RuntimePermission.WORKFLOW_READ,
                }
            )
        ),
        ProtectedOperation.DECIDE_APPROVAL: (
            frozenset(
                {
                    RuntimePermission.APPROVAL_DECIDE,
                }
            )
        ),
        ProtectedOperation.RESUME_ACTION: (
            frozenset(
                {
                    RuntimePermission.ACTION_EXECUTE,
                }
            )
        ),
        ProtectedOperation.RECONCILE_ACTION: (
            frozenset(
                {
                    RuntimePermission.ACTION_RECONCILE,
                }
            )
        ),
        ProtectedOperation.READ_VERIFICATION: (
            frozenset(
                {
                    RuntimePermission.VERIFICATION_READ,
                }
            )
        ),
    }


def test_viewer_can_read_but_cannot_mutate():
    engine = SecurityPolicyEngine()
    viewer = identity(
        OperatorRole.VIEWER
    )

    assert all(
        engine.authorize(
            viewer,
            operation,
        ).allowed
        for operation in READ_OPERATIONS
    )
    assert all(
        not engine.authorize(
            viewer,
            operation,
        ).allowed
        for operation in WRITE_OPERATIONS
    )


@pytest.mark.parametrize(
    (
        "role",
        "allowed_operation",
        "denied_operations",
    ),
    [
        (
            OperatorRole.APPROVER,
            ProtectedOperation.DECIDE_APPROVAL,
            {
                ProtectedOperation.PREPARE_REMEDIATION,
                ProtectedOperation.RESUME_ACTION,
                ProtectedOperation.RECONCILE_ACTION,
            },
        ),
        (
            OperatorRole.EXECUTOR,
            ProtectedOperation.RESUME_ACTION,
            {
                ProtectedOperation.PREPARE_REMEDIATION,
                ProtectedOperation.DECIDE_APPROVAL,
                ProtectedOperation.RECONCILE_ACTION,
            },
        ),
        (
            OperatorRole.RECONCILER,
            ProtectedOperation.RECONCILE_ACTION,
            {
                ProtectedOperation.PREPARE_REMEDIATION,
                ProtectedOperation.DECIDE_APPROVAL,
                ProtectedOperation.RESUME_ACTION,
            },
        ),
    ],
)
def test_sensitive_roles_preserve_separation_of_duties(
    role: OperatorRole,
    allowed_operation: ProtectedOperation,
    denied_operations: set[
        ProtectedOperation
    ],
):
    engine = SecurityPolicyEngine()
    operator = identity(
        role
    )

    assert engine.authorize(
        operator,
        allowed_operation,
    ).allowed is True

    for operation in denied_operations:
        decision = engine.authorize(
            operator,
            operation,
        )
        assert decision.allowed is False
        assert decision.missing_permissions


def test_analyst_and_service_have_bounded_runtime_access():
    engine = SecurityPolicyEngine()
    analyst = identity(
        OperatorRole.ANALYST
    )
    service = identity(
        OperatorRole.SERVICE
    )

    assert engine.authorize(
        analyst,
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS,
    ).allowed is True
    assert engine.authorize(
        analyst,
        ProtectedOperation.READ_INCIDENT,
    ).allowed is True
    assert engine.authorize(
        analyst,
        ProtectedOperation.PREPARE_REMEDIATION,
    ).allowed is True
    assert engine.authorize(
        analyst,
        ProtectedOperation.RESUME_ACTION,
    ).allowed is False

    assert engine.authorize(
        service,
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS,
    ).allowed is True
    assert engine.authorize(
        service,
        ProtectedOperation.PREPARE_REMEDIATION,
    ).allowed is True
    assert engine.authorize(
        service,
        ProtectedOperation.READ_INCIDENT,
    ).allowed is False
    assert engine.authorize(
        service,
        ProtectedOperation.DECIDE_APPROVAL,
    ).allowed is False


def test_multiple_roles_union_permissions_without_changing_policy():
    engine = SecurityPolicyEngine()
    operator = identity(
        OperatorRole.APPROVER,
        OperatorRole.EXECUTOR,
    )
    permissions_before = (
        engine.role_permissions
    )

    assert engine.authorize(
        operator,
        ProtectedOperation.DECIDE_APPROVAL,
    ).allowed is True
    assert engine.authorize(
        operator,
        ProtectedOperation.RESUME_ACTION,
    ).allowed is True
    assert engine.authorize(
        operator,
        ProtectedOperation.RECONCILE_ACTION,
    ).allowed is False
    assert engine.role_permissions is (
        permissions_before
    )


def test_admin_has_explicit_permissions_for_every_operation():
    engine = SecurityPolicyEngine()
    admin = identity(
        OperatorRole.ADMIN
    )

    decisions = [
        engine.authorize(
            admin,
            operation,
        )
        for operation in ProtectedOperation
    ]

    assert decisions
    assert all(
        decision.allowed
        for decision in decisions
    )
    assert engine.permissions_for(
        admin
    ) == frozenset(
        RuntimePermission
    )


def test_anonymous_identity_is_denied_for_every_operation():
    engine = SecurityPolicyEngine()
    anonymous = OperatorIdentity.anonymous()

    decisions = [
        engine.authorize(
            anonymous,
            operation,
        )
        for operation in ProtectedOperation
    ]

    assert decisions
    assert all(
        not decision.allowed
        for decision in decisions
    )
    assert all(
        decision.reason
        == (
            "Authentication is required for the "
            "protected operation"
        )
        for decision in decisions
    )


def test_require_returns_allowed_decision_and_raises_auditable_denial():
    engine = SecurityPolicyEngine()
    approver = identity(
        OperatorRole.APPROVER
    )

    allowed = engine.require(
        approver,
        ProtectedOperation.DECIDE_APPROVAL,
    )
    assert allowed.allowed is True

    with pytest.raises(
        AuthorizationDeniedError
    ) as captured:
        engine.require(
            approver,
            ProtectedOperation.RESUME_ACTION,
        )

    error = captured.value
    assert error.decision.allowed is False
    assert error.decision.principal_id == (
        approver.principal_id
    )
    assert error.decision.operation == (
        ProtectedOperation.RESUME_ACTION
    )
    assert (
        RuntimePermission.ACTION_EXECUTE
        in error.decision.missing_permissions
    )


@pytest.mark.parametrize(
    (
        "role_permissions",
        "operation_permissions",
        "message",
    ),
    [
        (
            {},
            None,
            "missing roles",
        ),
        (
            None,
            {},
            "missing operations",
        ),
        (
            None,
            {
                **dict(
                    DEFAULT_OPERATION_PERMISSIONS
                ),
                ProtectedOperation.READ_INCIDENT: (
                    frozenset()
                ),
            },
            "must require at least one permission",
        ),
    ],
)
def test_incomplete_policy_configuration_fails_at_startup(
    role_permissions,
    operation_permissions,
    message: str,
):
    with pytest.raises(
        SecurityPolicyConfigurationError,
        match=message,
    ):
        SecurityPolicyEngine(
            role_permissions=(
                role_permissions
            ),
            operation_permissions=(
                operation_permissions
            ),
        )


@pytest.mark.parametrize(
    (
        "role_permissions",
        "operation_permissions",
    ),
    [
        (
            {
                **dict(
                    DEFAULT_ROLE_PERMISSIONS
                ),
                "unknown-role": {
                    RuntimePermission.INCIDENT_READ,
                },
            },
            None,
        ),
        (
            {
                **dict(
                    DEFAULT_ROLE_PERMISSIONS
                ),
                OperatorRole.VIEWER: {
                    "unsupported:permission",
                },
            },
            None,
        ),
        (
            None,
            {
                **dict(
                    DEFAULT_OPERATION_PERMISSIONS
                ),
                "unknown.operation": {
                    RuntimePermission.INCIDENT_READ,
                },
            },
        ),
    ],
)
def test_unknown_policy_values_are_rejected(
    role_permissions,
    operation_permissions,
):
    with pytest.raises(
        SecurityPolicyConfigurationError
    ):
        SecurityPolicyEngine(
            role_permissions=(
                role_permissions
            ),
            operation_permissions=(
                operation_permissions
            ),
        )


def test_custom_policy_is_copied_frozen_and_versioned():
    role_permissions = dict(
        DEFAULT_ROLE_PERMISSIONS
    )
    operation_permissions = dict(
        DEFAULT_OPERATION_PERMISSIONS
    )
    role_permissions[
        OperatorRole.VIEWER
    ] = frozenset(
        {
            RuntimePermission.INCIDENT_READ,
        }
    )

    engine = SecurityPolicyEngine(
        role_permissions=role_permissions,
        operation_permissions=(
            operation_permissions
        ),
        policy_version="  security-v2  ",
    )

    role_permissions[
        OperatorRole.VIEWER
    ] = frozenset(
        RuntimePermission
    )

    assert engine.policy_version == "security-v2"
    assert engine.permissions_for(
        identity(
            OperatorRole.VIEWER
        )
    ) == frozenset(
        {
            RuntimePermission.INCIDENT_READ,
        }
    )

    decision = engine.authorize(
        identity(
            OperatorRole.VIEWER
        ),
        ProtectedOperation.READ_APPROVAL,
    )
    assert decision.allowed is False
    assert decision.policy_version == (
        "security-v2"
    )


def test_policy_description_is_stable_and_contains_no_identity_data():
    engine = SecurityPolicyEngine(
        policy_version="audit-v1"
    )
    description = engine.describe()

    assert description["policy_version"] == (
        "audit-v1"
    )
    assert set(
        description["roles"]
    ) == {
        role.value
        for role in OperatorRole
    }
    assert set(
        description["operations"]
    ) == {
        operation.value
        for operation in ProtectedOperation
    }
    assert "principal_id" not in description
    assert "attributes" not in description
