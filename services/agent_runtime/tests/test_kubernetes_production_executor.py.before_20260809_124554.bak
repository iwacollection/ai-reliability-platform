import json
from datetime import timedelta
from hashlib import sha256

import httpx
import pytest

from services.agent_runtime.app.action.kubernetes_production_executor import (
    KubernetesProductionExecutor,
    KubernetesProductionExecutorBindingError,
    KubernetesProductionExecutorConflictError,
    KubernetesProductionExecutorPolicy,
    KubernetesProductionExecutorResponseError,
    KubernetesProductionOutcomeIndeterminateError,
)
from services.agent_runtime.tests.kubernetes_production_executor_support import (
    API_URL,
    NOW,
    SequenceClock,
    canonical_patch,
    deployment_payload,
    desired_annotations,
    execution_record,
    preflight_record,
    scope,
)


def policy() -> KubernetesProductionExecutorPolicy:
    return KubernetesProductionExecutorPolicy(
        enabled=True,
        allowed_targets=(scope(),),
        request_timeout_seconds=2,
        minimum_remaining_seconds=5,
    )


def valid_handler(calls: list[httpx.Request]):
    def handler(request: httpx.Request) -> httpx.Response:
        calls.append(request)
        if request.method == "GET":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="512Mi",
                    resource_version="500",
                    generation=9,
                ),
            )

        assert request.method == "PATCH"
        assert request.content.decode("utf-8") == canonical_patch()
        if request.url.params.get("dryRun") == "All":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="640Mi",
                    resource_version="500",
                    generation=10,
                    annotations=desired_annotations(),
                ),
            )

        return httpx.Response(
            200,
            json=deployment_payload(
                memory="640Mi",
                resource_version="501",
                generation=10,
                annotations=desired_annotations(),
            ),
        )

    return handler


async def run_with_handler(handler, *, clock=None):
    transport = httpx.MockTransport(handler)
    async with httpx.AsyncClient(transport=transport) as client:
        executor = KubernetesProductionExecutor(
            api_url=API_URL,
            cluster_name="production-a",
            policy=policy(),
            bearer_token="dedicated-production-token-0001",
            client=client,
            clock=clock or SequenceClock(),
        )
        return await executor.execute_claimed(
            execution_record(),
            preflight_record(),
        )


@pytest.mark.asyncio
async def test_exactly_one_real_patch_after_get_and_repeated_dry_run():
    calls = []
    result = await run_with_handler(valid_handler(calls))

    assert [item.method for item in calls] == ["GET", "PATCH", "PATCH"]
    assert calls[1].url.params["dryRun"] == "All"
    assert "dryRun" not in calls[2].url.params
    assert calls[1].content == calls[2].content
    assert calls[1].headers["authorization"] == (
        "Bearer dedicated-production-token-0001"
    )
    assert result["success"] is True
    assert result["mode"] == "kubernetes_production"
    assert result["resource_version"] == "501"
    serialized = json.dumps(result)
    assert "patch" not in serialized.lower()
    assert "token" not in serialized.lower()


@pytest.mark.asyncio
async def test_current_state_drift_stops_before_dry_run_and_write():
    calls = []

    def handler(request: httpx.Request) -> httpx.Response:
        calls.append(request)
        return httpx.Response(
            200,
            json=deployment_payload(
                memory="768Mi",
                resource_version="777",
                generation=12,
            ),
        )

    with pytest.raises(KubernetesProductionExecutorConflictError):
        await run_with_handler(handler)
    assert len(calls) == 1
    assert calls[0].method == "GET"


@pytest.mark.asyncio
async def test_repeated_dry_run_mismatch_stops_before_real_write():
    calls = []

    def handler(request: httpx.Request) -> httpx.Response:
        calls.append(request)
        if request.method == "GET":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="512Mi",
                    resource_version="500",
                    generation=9,
                ),
            )
        return httpx.Response(
            200,
            json=deployment_payload(
                memory="700Mi",
                resource_version="500",
                generation=10,
                annotations=desired_annotations(),
            ),
        )

    with pytest.raises(KubernetesProductionExecutorResponseError):
        await run_with_handler(handler)
    assert [item.method for item in calls] == ["GET", "PATCH"]
    assert calls[-1].url.params["dryRun"] == "All"


@pytest.mark.asyncio
async def test_expiry_after_dry_run_stops_before_real_write():
    calls = []
    clock = SequenceClock(
        NOW + timedelta(minutes=1),
        NOW + timedelta(minutes=9, seconds=58),
    )

    with pytest.raises(KubernetesProductionExecutorBindingError):
        await run_with_handler(valid_handler(calls), clock=clock)
    assert [item.method for item in calls] == ["GET", "PATCH"]


@pytest.mark.asyncio
async def test_real_patch_timeout_is_indeterminate_and_not_retried():
    calls = []

    def handler(request: httpx.Request) -> httpx.Response:
        calls.append(request)
        if request.method == "GET":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="512Mi",
                    resource_version="500",
                    generation=9,
                ),
            )
        if request.url.params.get("dryRun") == "All":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="640Mi",
                    resource_version="500",
                    generation=10,
                    annotations=desired_annotations(),
                ),
            )
        raise httpx.ReadTimeout(
            "write acknowledgement timed out",
            request=request,
        )

    with pytest.raises(KubernetesProductionOutcomeIndeterminateError):
        await run_with_handler(handler)
    assert [item.method for item in calls] == ["GET", "PATCH", "PATCH"]
    assert sum(
        item.method == "PATCH" and "dryRun" not in item.url.params
        for item in calls
    ) == 1


@pytest.mark.asyncio
@pytest.mark.parametrize("mode", ["server_error", "invalid_json"])
async def test_ambiguous_real_write_response_is_indeterminate(mode):
    calls = []

    def handler(request: httpx.Request) -> httpx.Response:
        calls.append(request)
        if request.method == "GET":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="512Mi",
                    resource_version="500",
                    generation=9,
                ),
            )
        if request.url.params.get("dryRun") == "All":
            return httpx.Response(
                200,
                json=deployment_payload(
                    memory="640Mi",
                    resource_version="500",
                    generation=10,
                    annotations=desired_annotations(),
                ),
            )
        if mode == "server_error":
            return httpx.Response(503, json={"kind": "Status"})
        return httpx.Response(200, content=b"not-json")

    with pytest.raises(KubernetesProductionOutcomeIndeterminateError):
        await run_with_handler(handler)
    assert len(calls) == 3


@pytest.mark.asyncio
async def test_non_running_execution_is_rejected_without_network_access():
    calls = []
    record = preflight_record()
    execution = execution_record(record)
    execution.fail(
        {"success": False},
        error_type="TestFailure",
    )
    transport = httpx.MockTransport(
        lambda request: calls.append(request)
    )
    async with httpx.AsyncClient(transport=transport) as client:
        executor = KubernetesProductionExecutor(
            api_url=API_URL,
            cluster_name="production-a",
            policy=policy(),
            bearer_token="dedicated-production-token-0001",
            client=client,
            clock=SequenceClock(),
        )
        with pytest.raises(KubernetesProductionExecutorBindingError):
            await executor.execute_claimed(execution, record)
    assert calls == []


@pytest.mark.asyncio
async def test_digest_valid_but_expanded_patch_is_rejected_without_network():
    calls = []
    record = preflight_record()
    expanded = json.loads(record.artifact.patch_json)
    expanded["spec"]["replicas"] = 0
    expanded_json = json.dumps(
        expanded,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    )
    expanded_digest = sha256(expanded_json.encode("utf-8")).hexdigest()
    proof = record.artifact.contract.dry_run.model_copy(
        update={"patch_sha256": expanded_digest}
    )
    contract = record.artifact.contract.model_copy(
        update={"dry_run": proof}
    )
    artifact = record.artifact.model_copy(
        update={
            "contract": contract,
            "patch_json": expanded_json,
        }
    )
    expanded_record = record.model_copy(update={"artifact": artifact})
    execution = execution_record(expanded_record)
    transport = httpx.MockTransport(
        lambda request: calls.append(request)
    )
    async with httpx.AsyncClient(transport=transport) as client:
        executor = KubernetesProductionExecutor(
            api_url=API_URL,
            cluster_name="production-a",
            policy=policy(),
            bearer_token="dedicated-production-token-0001",
            client=client,
            clock=SequenceClock(),
        )
        with pytest.raises(KubernetesProductionExecutorBindingError):
            await executor.execute_claimed(execution, expanded_record)
    assert calls == []
