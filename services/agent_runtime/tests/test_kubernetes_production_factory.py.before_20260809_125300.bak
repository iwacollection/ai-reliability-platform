import pytest
from datetime import UTC, datetime, timedelta

from common.config.settings import (
    KUBERNETES_PRODUCTION_WRITE_ACKNOWLEDGEMENT,
    KubernetesPreflightConfig,
    KubernetesPreflightTargetConfig,
    KubernetesProductionExecutionConfig,
)
from services.agent_runtime.app.action.kubernetes_production_executor import (
    KubernetesProductionExecutor,
)
from services.agent_runtime.app.action.kubernetes_production_factory import (
    KubernetesProductionFactoryConfigurationError,
    create_kubernetes_production_executor,
)
from services.agent_runtime.app.action.production_pilot import (
    KUBERNETES_PRODUCTION_KILL_SWITCH_ENGAGED,
    KUBERNETES_PRODUCTION_RUNBOOK_ACKNOWLEDGEMENT,
    KubernetesProductionPilotConfig,
    KubernetesProductionPilotControl,
)


NOW = datetime(
    2026,
    8,
    9,
    12,
    0,
    tzinfo=UTC,
)


def preflight_config() -> KubernetesPreflightConfig:
    return KubernetesPreflightConfig(
        enabled=True,
        api_url="https://kubernetes.test",
        cluster_name="production-a",
        bearer_token_env="K8S_PREFLIGHT_TOKEN",
        allowed_targets=(
            KubernetesPreflightTargetConfig(
                cluster="production-a",
                namespace="payment",
                deployment="payment-api",
                container="payment-api",
            ),
        ),
    )


def execution_config(
    *,
    enabled: bool = True,
) -> KubernetesProductionExecutionConfig:
    if not enabled:
        return KubernetesProductionExecutionConfig()
    return KubernetesProductionExecutionConfig(
        enabled=True,
        write_acknowledgement=(
            KUBERNETES_PRODUCTION_WRITE_ACKNOWLEDGEMENT
        ),
        bearer_token_env="K8S_PRODUCTION_EXECUTION_TOKEN",
    )


def pilot_control() -> KubernetesProductionPilotControl:
    return KubernetesProductionPilotControl(
        config=KubernetesProductionPilotConfig(
            enabled=True,
            pilot_id="oom-pilot-factory",
            change_ticket="CHG-2001",
            runbook_version="oom-runbook-v1",
            runbook_acknowledgement=(
                KUBERNETES_PRODUCTION_RUNBOOK_ACKNOWLEDGEMENT
            ),
            kill_switch_file="pilot-switch",
            authorized_operator_ids=(
                "factory-executor",
            ),
            starts_at=NOW,
            expires_at=(
                NOW + timedelta(hours=1)
            ),
        ),
        preflight_config=preflight_config(),
        execution_config=execution_config(),
        clock=lambda: (
            NOW + timedelta(minutes=1)
        ),
        switch_reader=(
            lambda _: (
                KUBERNETES_PRODUCTION_KILL_SWITCH_ENGAGED
            )
        ),
    )


class ExplodingEnvironment(dict):
    def get(self, key, default=None):
        raise AssertionError("disabled factory accessed environment")


def test_disabled_factory_reads_no_credentials_or_files():
    executor = create_kubernetes_production_executor(
        KubernetesPreflightConfig(),
        execution_config(enabled=False),
        environment=ExplodingEnvironment(),
        production_token_file_reader=lambda _: (_ for _ in ()).throw(
            AssertionError("disabled factory read token file")
        ),
    )
    assert executor is None


def test_enabled_factory_uses_dedicated_production_identity():
    executor = create_kubernetes_production_executor(
        preflight_config(),
        execution_config(),
        environment={
            "K8S_PREFLIGHT_TOKEN": "preflight-service-token-0001",
            "K8S_PRODUCTION_EXECUTION_TOKEN": (
                "production-writer-token-0001"
            ),
        },
        pilot_control=pilot_control(),
    )
    assert isinstance(executor, KubernetesProductionExecutor)
    assert executor.policy.enabled is True
    assert executor.policy.allowed_targets[0].name == "payment-api"


def test_enabled_factory_requires_ready_pilot_manifest():
    with pytest.raises(
        KubernetesProductionFactoryConfigurationError,
        match="pilot manifest",
    ):
        create_kubernetes_production_executor(
            preflight_config(),
            execution_config(),
            environment={
                "K8S_PREFLIGHT_TOKEN": (
                    "preflight-service-token-0001"
                ),
                "K8S_PRODUCTION_EXECUTION_TOKEN": (
                    "production-writer-token-0001"
                ),
            },
        )


def test_factory_rejects_same_resolved_credential_value():
    with pytest.raises(KubernetesProductionFactoryConfigurationError):
        create_kubernetes_production_executor(
            preflight_config(),
            execution_config(),
            environment={
                "K8S_PREFLIGHT_TOKEN": "same-service-token-00000001",
                "K8S_PRODUCTION_EXECUTION_TOKEN": (
                    "same-service-token-00000001"
                ),
            },
            pilot_control=pilot_control(),
        )


def test_factory_error_does_not_include_secret_value():
    secret = "production-secret-value-0001"
    with pytest.raises(KubernetesProductionFactoryConfigurationError) as info:
        create_kubernetes_production_executor(
            preflight_config(),
            execution_config(),
            environment={
                "K8S_PREFLIGHT_TOKEN": "preflight-service-token-0001",
                "K8S_PRODUCTION_EXECUTION_TOKEN": secret + " ",
            },
            pilot_control=pilot_control(),
        )
    assert secret not in str(info.value)
