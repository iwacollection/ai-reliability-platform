from services.agent_runtime.app.llm.gateway.factory import (
    create_shared_llm_gateway,
)
from services.agent_runtime.app.llm.gateway.gateway import (
    LLMGateway,
)
from services.agent_runtime.app.llm.gateway.models import (
    LLMInvocationContext,
)
from services.agent_runtime.app.registry.factory import (
    create_agent_registry,
)

import services.agent_runtime.app.llm.gateway.factory as gateway_factory_module
import services.agent_runtime.app.registry.factory as registry_factory_module


class FakeProvider:
    name = "mock"

    async def chat(self, request):
        raise AssertionError(
            "Gateway factory test must not call the provider"
        )


class FakeGateway:
    def __init__(self):
        self.requests = []

    async def chat(self, request):
        self.requests.append(request)
        raise AssertionError(
            "Registry wiring must not call the gateway"
        )


def test_shared_gateway_factory_builds_investigation_route(
    monkeypatch,
):
    monkeypatch.setattr(
        gateway_factory_module,
        "create_llm_provider",
        lambda: FakeProvider(),
    )

    gateway = create_shared_llm_gateway()

    assert isinstance(
        gateway,
        LLMGateway,
    )
    route = gateway.router.route(
        LLMInvocationContext(
            agent="investigation"
        )
    )
    assert route.provider == "openai"
    assert gateway.provider_manager.exists(
        "openai"
    ) is True


def test_agent_registry_uses_explicit_shared_gateway():
    gateway = FakeGateway()

    registry = create_agent_registry(
        llm_gateway=gateway,
    )

    assert registry.get(
        "noise"
    ).llm_gateway is gateway
    assert registry.get(
        "rca"
    ).llm_gateway is gateway
    assert registry.get(
        "healing"
    ).llm_gateway is gateway
    assert gateway.requests == []


def test_agent_registry_preserves_default_factory(
    monkeypatch,
):
    gateway = FakeGateway()
    calls = 0

    def create_gateway():
        nonlocal calls
        calls += 1
        return gateway

    monkeypatch.setattr(
        registry_factory_module,
        "create_shared_llm_gateway",
        create_gateway,
    )

    registry = create_agent_registry()

    assert calls == 1
    assert registry.get(
        "noise"
    ).llm_gateway is gateway


def test_agent_registry_rejects_invalid_gateway():
    try:
        create_agent_registry(
            llm_gateway=object(),
        )
    except TypeError as exc:
        assert "gateway is invalid" in str(exc)
    else:
        raise AssertionError(
            "Invalid Agent registry gateway was accepted"
        )
