from __future__ import annotations

from dataclasses import dataclass
from datetime import datetime
from time import perf_counter
from typing import Any, Literal
from uuid import UUID

from pydantic import BaseModel, ConfigDict, Field

from services.agent_runtime.app.investigation.engine import (
    BaseInvestigationEngine,
)
from services.agent_runtime.app.investigation.models import (
    EvidenceItem,
    IncidentHypothesis,
    InvestigationConclusion,
    InvestigationDecision,
    InvestigationState,
    InvestigationStatus,
    InvestigationStopReason,
)
from services.agent_runtime.app.investigation.session_loop import (
    InvestigationSessionLoopOutcome,
    InvestigationSessionLoopStopReason,
)
from services.agent_runtime.app.investigation.session_models import (
    InvestigationSessionRecord,
    InvestigationSessionStatus,
    InvestigationStepKind,
    canonical_digest,
    investigation_session_input_digest,
)


class InvestigationEngineBenchmarkError(RuntimeError):
    """A controlled dual-engine comparison could not complete safely."""


class InvestigationEngineBenchmarkInvocation(BaseModel):
    """One bounded API-equivalent Engine advance."""

    model_config = ConfigDict(
        frozen=True,
        extra="forbid",
    )

    ordinal: int = Field(ge=1, le=32)
    expected_version: int = Field(ge=0)
    resulting_version: int = Field(ge=0)
    outcome: InvestigationSessionLoopOutcome
    stop_reason: InvestigationSessionLoopStopReason
    external_calls_made: int = Field(ge=0, le=32)


class InvestigationEngineBenchmarkResult(BaseModel):
    """Bounded result for one orchestration backend."""

    model_config = ConfigDict(
        frozen=True,
        extra="forbid",
    )

    backend: Literal["custom", "langgraph"]
    session_status: InvestigationSessionStatus
    investigation_status: InvestigationStatus
    investigation_stop_reason: InvestigationStopReason | None
    conclusion_available: bool
    outcome: InvestigationSessionLoopOutcome
    stop_reason: InvestigationSessionLoopStopReason
    version: int = Field(ge=0)
    durable_steps: int = Field(ge=0, le=32)
    reasoner_steps: int = Field(ge=0, le=32)
    probe_steps: int = Field(ge=0, le=32)
    external_calls_made: int = Field(ge=0, le=32)
    replay_external_calls_made: int = Field(ge=0, le=32)
    invocation_count: int = Field(ge=1, le=32)
    elapsed_ms: float = Field(ge=0.0)
    replay_safe: bool
    semantic_digest: str = Field(
        pattern=r"^[0-9a-f]{64}$",
    )
    protocol_digest: str = Field(
        pattern=r"^[0-9a-f]{64}$",
    )
    invocations: tuple[
        InvestigationEngineBenchmarkInvocation,
        ...,
    ]


class InvestigationEngineBenchmarkReport(BaseModel):
    """Custom-versus-LangGraph controlled replay comparison."""

    model_config = ConfigDict(
        frozen=True,
        extra="forbid",
    )

    schema_version: Literal["v1"] = "v1"
    controlled_replay: Literal[True] = True
    read_only: Literal[True] = True
    custom: InvestigationEngineBenchmarkResult
    langgraph: InvestigationEngineBenchmarkResult
    semantic_equivalent: bool
    protocol_equivalent: bool
    external_call_budget_equal: bool
    replay_safe: bool
    passed: bool


@dataclass(frozen=True, slots=True)
class InvestigationEngineBenchmarkCase:
    """Trusted inputs and isolated durable Engine for one benchmark arm."""

    engine: BaseInvestigationEngine
    incident_id: UUID
    run_key: str
    initial_state: InvestigationState
    context: Any
    claimant: str
    created_at: datetime | None = None


class InvestigationEngineBenchmarkRunner:
    """
    Compare Custom and LangGraph through the same durable Session contract.

    Every invocation advances at most one external read-only step. The Runner
    never calls an LLM, Probe, Incident, Approval, Action, Verification,
    budget, or Kubernetes capability directly. Callers supply isolated
    Engines and deterministic dependencies for a controlled replay.
    """

    def __init__(
        self,
        *,
        max_invocations: int = 32,
    ) -> None:
        if (
            not isinstance(max_invocations, int)
            or isinstance(max_invocations, bool)
            or not 1 <= max_invocations <= 32
        ):
            raise ValueError(
                "Investigation Engine Benchmark invocation limit is invalid"
            )
        self.max_invocations = max_invocations

    async def compare(
        self,
        *,
        custom: InvestigationEngineBenchmarkCase,
        langgraph: InvestigationEngineBenchmarkCase,
    ) -> InvestigationEngineBenchmarkReport:
        self._validate_cases(
            custom=custom,
            langgraph=langgraph,
        )
        custom_result = await self._run_case(
            custom
        )
        langgraph_result = await self._run_case(
            langgraph
        )

        semantic_equivalent = (
            custom_result.semantic_digest
            == langgraph_result.semantic_digest
        )
        protocol_equivalent = (
            custom_result.protocol_digest
            == langgraph_result.protocol_digest
            and custom_result.outcome
            == langgraph_result.outcome
            and custom_result.stop_reason
            == langgraph_result.stop_reason
            and custom_result.session_status
            == langgraph_result.session_status
            and custom_result.investigation_status
            == langgraph_result.investigation_status
            and custom_result.investigation_stop_reason
            == langgraph_result.investigation_stop_reason
        )
        external_call_budget_equal = (
            custom_result.external_calls_made
            == langgraph_result.external_calls_made
            == custom_result.durable_steps
            == langgraph_result.durable_steps
        )
        replay_safe = (
            custom_result.replay_safe
            and langgraph_result.replay_safe
        )
        completed = (
            custom_result.outcome
            == InvestigationSessionLoopOutcome.COMPLETED
            and langgraph_result.outcome
            == InvestigationSessionLoopOutcome.COMPLETED
            and custom_result.session_status
            == InvestigationSessionStatus.COMPLETED
            and langgraph_result.session_status
            == InvestigationSessionStatus.COMPLETED
        )

        return InvestigationEngineBenchmarkReport(
            custom=custom_result,
            langgraph=langgraph_result,
            semantic_equivalent=semantic_equivalent,
            protocol_equivalent=protocol_equivalent,
            external_call_budget_equal=external_call_budget_equal,
            replay_safe=replay_safe,
            passed=(
                completed
                and semantic_equivalent
                and protocol_equivalent
                and external_call_budget_equal
                and replay_safe
            ),
        )

    async def _run_case(
        self,
        case: InvestigationEngineBenchmarkCase,
    ) -> InvestigationEngineBenchmarkResult:
        started = perf_counter()
        created = await case.engine.create_or_get(
            incident_id=case.incident_id,
            run_key=case.run_key,
            initial_state=case.initial_state.model_copy(
                deep=True
            ),
            created_by="investigation_engine_benchmark",
            now=case.created_at,
        )
        if not created.created:
            raise InvestigationEngineBenchmarkError(
                "Investigation Engine Benchmark requires a fresh Session"
            )

        session = created.session
        external_calls_made = 0
        invocations: list[
            InvestigationEngineBenchmarkInvocation
        ] = []
        outcome = InvestigationSessionLoopOutcome.PAUSED
        stop_reason = InvestigationSessionLoopStopReason.STEP_LIMIT

        for ordinal in range(
            1,
            self.max_invocations + 1,
        ):
            expected_version = session.version
            result = await case.engine.advance(
                session.session_id,
                context=case.context,
                claimant=case.claimant,
                max_external_steps=1,
                expected_version=expected_version,
            )
            session = result.session
            outcome = result.outcome
            stop_reason = result.stop_reason
            external_calls_made += result.external_calls_made
            invocations.append(
                InvestigationEngineBenchmarkInvocation(
                    ordinal=ordinal,
                    expected_version=expected_version,
                    resulting_version=session.version,
                    outcome=outcome,
                    stop_reason=stop_reason,
                    external_calls_made=(
                        result.external_calls_made
                    ),
                )
            )

            if outcome in {
                InvestigationSessionLoopOutcome.COMPLETED,
                InvestigationSessionLoopOutcome.FAILED,
                InvestigationSessionLoopOutcome.BLOCKED,
            }:
                break
            if (
                session.version == expected_version
                and result.external_calls_made == 0
            ):
                raise InvestigationEngineBenchmarkError(
                    "Investigation Engine Benchmark made no durable progress"
                )
        else:
            raise InvestigationEngineBenchmarkError(
                "Investigation Engine Benchmark invocation limit was exhausted"
            )

        replay = await case.engine.advance(
            session.session_id,
            context=case.context,
            claimant=case.claimant,
            max_external_steps=1,
        )
        replay_safe = (
            replay.external_calls_made == 0
            and replay.session == session
            and replay.outcome == outcome
            and replay.stop_reason == stop_reason
        )
        elapsed_ms = round(
            (perf_counter() - started) * 1000,
            4,
        )
        semantic_payload = self._semantic_payload(
            session
        )
        protocol_payload = self._protocol_payload(
            session
        )
        reasoner_steps = sum(
            step.kind == InvestigationStepKind.REASONER
            for step in session.steps
        )
        probe_steps = sum(
            step.kind == InvestigationStepKind.PROBE
            for step in session.steps
        )

        return InvestigationEngineBenchmarkResult(
            backend=case.engine.name,
            session_status=session.status,
            investigation_status=session.state.status,
            investigation_stop_reason=(
                session.state.stop_reason
            ),
            conclusion_available=(
                session.state.conclusion is not None
            ),
            outcome=outcome,
            stop_reason=stop_reason,
            version=session.version,
            durable_steps=len(session.steps),
            reasoner_steps=reasoner_steps,
            probe_steps=probe_steps,
            external_calls_made=external_calls_made,
            replay_external_calls_made=(
                replay.external_calls_made
            ),
            invocation_count=len(invocations),
            elapsed_ms=elapsed_ms,
            replay_safe=replay_safe,
            semantic_digest=canonical_digest(
                semantic_payload
            ),
            protocol_digest=canonical_digest(
                protocol_payload
            ),
            invocations=tuple(invocations),
        )

    @staticmethod
    def _validate_cases(
        *,
        custom: InvestigationEngineBenchmarkCase,
        langgraph: InvestigationEngineBenchmarkCase,
    ) -> None:
        for case in (
            custom,
            langgraph,
        ):
            if not isinstance(
                case,
                InvestigationEngineBenchmarkCase,
            ):
                raise TypeError(
                    "Investigation Engine Benchmark case is invalid"
                )
            if not isinstance(
                case.engine,
                BaseInvestigationEngine,
            ):
                raise TypeError(
                    "Investigation Engine Benchmark Engine is invalid"
                )
            if not isinstance(
                case.initial_state,
                InvestigationState,
            ):
                raise TypeError(
                    "Investigation Engine Benchmark state is invalid"
                )

        if custom.engine.name != "custom":
            raise ValueError(
                "Investigation Engine Benchmark Custom backend is invalid"
            )
        if langgraph.engine.name != "langgraph":
            raise ValueError(
                "Investigation Engine Benchmark LangGraph backend is invalid"
            )
        if (
            custom.engine.session_service
            is langgraph.engine.session_service
        ):
            raise ValueError(
                "Investigation Engine Benchmark Stores must be isolated"
            )
        if custom.incident_id != langgraph.incident_id:
            raise ValueError(
                "Investigation Engine Benchmark Incident inputs differ"
            )
        if custom.run_key != langgraph.run_key:
            raise ValueError(
                "Investigation Engine Benchmark run keys differ"
            )
        if investigation_session_input_digest(
            custom.initial_state
        ) != investigation_session_input_digest(
            langgraph.initial_state
        ):
            raise ValueError(
                "Investigation Engine Benchmark immutable inputs differ"
            )

    @classmethod
    def _semantic_payload(
        cls,
        session: InvestigationSessionRecord,
    ) -> dict[str, Any]:
        evidence_ids = {
            evidence.evidence_id: f"evidence-{index}"
            for index, evidence in enumerate(
                session.state.evidence,
                start=1,
            )
        }
        state = session.state
        return {
            "scope": state.scope.model_dump(
                mode="json"
            ),
            "limits": state.limits.model_dump(
                mode="json"
            ),
            "status": state.status,
            "iteration_count": state.iteration_count,
            "tool_call_count": state.tool_call_count,
            "available_probes": state.available_probes,
            "attempted_probes": state.attempted_probes,
            "hypotheses": [
                cls._hypothesis_payload(
                    item,
                    evidence_ids=evidence_ids,
                )
                for item in state.hypotheses
            ],
            "evidence": [
                cls._evidence_payload(item)
                for item in state.evidence
            ],
            "decision_summaries": state.decision_summaries,
            "stop_reason": state.stop_reason,
            "failure_code": state.failure_code,
            "epistemic_guard_code": state.epistemic_guard_code,
            "conclusion": cls._conclusion_payload(
                state.conclusion,
                evidence_ids=evidence_ids,
            ),
            "steps": [
                {
                    "kind": step.kind,
                    "status": step.status,
                    "probe": step.probe,
                    "decision": cls._decision_payload(
                        step.decision,
                        evidence_ids=evidence_ids,
                    ),
                    "evidence": (
                        cls._evidence_payload(
                            step.evidence
                        )
                        if step.evidence is not None
                        else None
                    ),
                    "failure_code": step.failure_code,
                }
                for step in session.steps
            ],
        }

    @staticmethod
    def _protocol_payload(
        session: InvestigationSessionRecord,
    ) -> dict[str, Any]:
        return {
            "session_status": session.status,
            "investigation_status": session.state.status,
            "version": session.version,
            "steps": [
                {
                    "sequence": step.sequence,
                    "kind": step.kind,
                    "status": step.status,
                    "probe": step.probe,
                }
                for step in session.steps
            ],
        }

    @staticmethod
    def _evidence_payload(
        evidence: EvidenceItem,
    ) -> dict[str, Any]:
        return {
            "probe": evidence.probe,
            "source": evidence.source,
            "success": evidence.success,
            "trusted": evidence.trusted,
            "production_signal": evidence.production_signal,
            "reliability": evidence.reliability,
            "cluster": evidence.cluster,
            "cluster_verified": evidence.cluster_verified,
            "facts": evidence.facts,
            "error_code": evidence.error_code,
        }

    @classmethod
    def _hypothesis_payload(
        cls,
        hypothesis: IncidentHypothesis,
        *,
        evidence_ids: dict[str, str],
    ) -> dict[str, Any]:
        return {
            "hypothesis_id": hypothesis.hypothesis_id,
            "cause": hypothesis.cause,
            "confidence": hypothesis.confidence,
            "supporting_evidence_ids": cls._normalize_evidence_ids(
                hypothesis.supporting_evidence_ids,
                evidence_ids=evidence_ids,
            ),
            "conflicting_evidence_ids": cls._normalize_evidence_ids(
                hypothesis.conflicting_evidence_ids,
                evidence_ids=evidence_ids,
            ),
            "missing_evidence": hypothesis.missing_evidence,
            "optional_evidence": hypothesis.optional_evidence,
        }

    @classmethod
    def _decision_payload(
        cls,
        decision: InvestigationDecision | None,
        *,
        evidence_ids: dict[str, str],
    ) -> dict[str, Any] | None:
        if decision is None:
            return None
        return {
            "hypotheses": [
                cls._hypothesis_payload(
                    item,
                    evidence_ids=evidence_ids,
                )
                for item in decision.hypotheses
            ],
            "rationale_summary": decision.rationale_summary,
            "stop": decision.stop,
            "stop_reason": decision.stop_reason,
            "next_probe": decision.next_probe,
            "conclusion": cls._conclusion_payload(
                decision.conclusion,
                evidence_ids=evidence_ids,
            ),
        }

    @classmethod
    def _conclusion_payload(
        cls,
        conclusion: InvestigationConclusion | None,
        *,
        evidence_ids: dict[str, str],
    ) -> dict[str, Any] | None:
        if conclusion is None:
            return None
        return {
            "root_cause": conclusion.root_cause,
            "confidence": conclusion.confidence,
            "evidence_ids": cls._normalize_evidence_ids(
                conclusion.evidence_ids,
                evidence_ids=evidence_ids,
            ),
            "remaining_uncertainties": (
                conclusion.remaining_uncertainties
            ),
        }

    @staticmethod
    def _normalize_evidence_ids(
        values: list[str],
        *,
        evidence_ids: dict[str, str],
    ) -> list[str]:
        return [
            evidence_ids.get(
                value,
                f"unknown:{value}",
            )
            for value in values
        ]


__all__ = [
    "InvestigationEngineBenchmarkCase",
    "InvestigationEngineBenchmarkError",
    "InvestigationEngineBenchmarkInvocation",
    "InvestigationEngineBenchmarkReport",
    "InvestigationEngineBenchmarkResult",
    "InvestigationEngineBenchmarkRunner",
]
