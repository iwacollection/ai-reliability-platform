)
from services.agent_runtime.app.action.execution_store import (
    ActionExecutionStore,
)
from services.agent_runtime.app.action.kubernetes_preflight import (
    KubernetesPreflightResolver,
)
from services.agent_runtime.app.action.kubernetes_preflight_factory import (
    create_kubernetes_preflight_resolver,
)
from services.agent_runtime.app.action.kubernetes_production_executor import (
    KubernetesProductionExecutor,
)
from services.agent_runtime.app.action.kubernetes_production_factory import (
    create_kubernetes_production_executor,
)
from services.agent_runtime.app.action.preflight_artifact_service import (
    PreflightArtifactService,
)
from services.agent_runtime.app.action.preflight_artifact_store import (
    PreflightArtifactStore,
)
from services.agent_runtime.app.action.production_action_preparation import (
    ProductionActionPreparationService,
)
from services.agent_runtime.app.action.production_action_query import (
    ProductionActionQueryService,
)
from services.agent_runtime.app.action.production_action_guard import (
    ProductionActionExpiryGuard,
)
from services.agent_runtime.app.verification.collector import (
    VerificationEvidenceCollector,
)
from services.agent_runtime.app.verification.coordinator import (
    VerificationCoordinator,
)
from services.agent_runtime.app.verification.profiles import (
    VerificationProfileFactory,
)
from services.agent_runtime.app.verification.service import (
    VerificationService,
)
from services.agent_runtime.app.verification.store import (
    VerificationStore,
)
from services.agent_runtime.app.runtime.action_runtime import (
    ActionRuntime,
)
from services.agent_runtime.app.runtime.verification_runtime import (
    VerificationRuntime,
)
from services.agent_runtime.app.security.factory import (
    create_authentication_service,
)
from services.agent_runtime.app.security.policy import (
    SecurityPolicyEngine,
)
from services.agent_runtime.app.security.service import (
    AuthenticationService,
)
from services.sandbox.executor.local import (
    LocalSandboxExecutor,
)
from services.sandbox.policy.validator import (
    SandboxPolicyValidator,
)


class AgentRuntime:
    """
    Runtime container.

    Owns and shares security and runtime infrastructure
    across Pipeline, Action and Verification.

    security_policy is the RBAC authorization policy. The existing policy
    attribute remains the remediation business policy engine.
    """

    def __init__(
        self,
        authentication_service: (
            AuthenticationService | None
        ) = None,
        security_policy: (
            SecurityPolicyEngine | None
        ) = None,
        kubernetes_preflight: (
            KubernetesPreflightResolver | None
        ) = None,
        kubernetes_production_executor: (
            KubernetesProductionExecutor | None
        ) = None,
    ) -> None:
        # Validate every injected security component before factories, stores
        # or other runtime components can produce side effects.
        if (
            authentication_service is not None
            and not isinstance(
                authentication_service,
                AuthenticationService,
            )
        ):
            raise TypeError(
                "AgentRuntime authentication service is invalid"
            )

        if (
            security_policy is not None
            and not isinstance(
                security_policy,
                SecurityPolicyEngine,
            )
        ):
            raise TypeError(
                "AgentRuntime security policy is invalid"
            )

        if (
            kubernetes_preflight is not None
            and not isinstance(
                kubernetes_preflight,
                KubernetesPreflightResolver,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes preflight resolver is invalid"
            )

        if (
            kubernetes_production_executor is not None
            and not isinstance(
                kubernetes_production_executor,
                KubernetesProductionExecutor,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor is invalid"
            )

        self.authentication = (
            authentication_service
            if authentication_service is not None
            else create_authentication_service()
        )

        self.security_policy = (
            security_policy
            if security_policy is not None
            else SecurityPolicyEngine()
        )

        self.kubernetes_preflight = (
            kubernetes_preflight
            if kubernetes_preflight is not None
            else create_kubernetes_preflight_resolver()
        )

        self.kubernetes_production_executor = (
            kubernetes_production_executor
            if kubernetes_production_executor is not None
            else create_kubernetes_production_executor()
        )

        if (
            self.kubernetes_production_executor is not None
            and self.kubernetes_preflight is None
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor requires "
                "trusted preflight"
            )

        self.memory = MemoryStore()
        self.tools = create_tool_manager()
        self.skills = create_skill_registry()
        self.mcp = create_mcp_registry()
        self.tracer = TraceCollector()
        self.evaluators = create_evaluation_registry()

        # Remediation business policy. This is intentionally separate from
        # security_policy, which authorizes operator-facing operations.
        self.policy = create_policy_engine()

        self.preflight_artifact_store = None
        self.preflight_artifact_service = None
        self.production_action_guard = None
        self.production_action_preparation = None
        self.production_action_query = None

        if self.kubernetes_preflight is not None:
            self.preflight_artifact_store = PreflightArtifactStore()
            self.preflight_artifact_service = PreflightArtifactService(
                store=self.preflight_artifact_store
            )
            self.production_action_guard = (
                ProductionActionExpiryGuard(
                    artifact_service=(
                        self.preflight_artifact_service
                    )
                )
            )

        self.approval = ApprovalService()

        if self.production_action_guard is not None:
            self.approval.manager.set_transition_guard(
                self.production_action_guard
            )

        if self.preflight_artifact_service is not None:
            self.production_action_preparation = (
                ProductionActionPreparationService(
                    resolver=self.kubernetes_preflight,
                    artifact_service=self.preflight_artifact_service,
                    approval_service=self.approval,
                )
            )

        self.incident_store = IncidentStore()

        if self.preflight_artifact_service is not None:
            self.production_action_query = (
                ProductionActionQueryService(
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                    approval_service=self.approval,
                    incident_store=self.incident_store,
                )
            )

        self.incident_service = IncidentService(
            store=self.incident_store
        )

        self.workflow_service = WorkflowService(
            incident_service=self.incident_service
        )

        self.action_execution_store = ActionExecutionStore()

        self.action_execution_service = ActionExecutionService(
            store=self.action_execution_store
        )

        self.action_runtime = ActionRuntime(
            approval_service=self.approval,
            incident_store=self.incident_store,
            action_execution_service=self.action_execution_service,
            production_action_guard=(
                self.production_action_guard
            ),
            kubernetes_production_executor=(
                self.kubernetes_production_executor
            ),
            preflight_artifact_service=(
                self.preflight_artifact_service
                if self.kubernetes_production_executor is not None
                else None
            ),
        )

        self.verification_store = VerificationStore()

        self.verification = VerificationService(
            store=self.verification_store
        )

        self.verification_runtime = VerificationRuntime(
            verification_service=self.verification,
            incident_store=self.incident_store,
        )

        self.verification_profile_factory = VerificationProfileFactory()

        self.verification_collector = VerificationEvidenceCollector(
            tools=self.tools
        )

        self.verification_coordinator = VerificationCoordinator(
            profile_factory=self.verification_profile_factory,
            collector=self.verification_collector,
            verification_runtime=self.verification_runtime,
        )

        self.sandbox = LocalSandboxExecutor()

        self.sandbox_policy = SandboxPolicyValidator()

        self.registry = create_agent_registry()

        self.planner = AgentPlanner()

        self.pipeline = PlannerPipeline(
            self.registry,
            self.planner,
            self.tracer,
            self.evaluators,
            incident_store=self.incident_store,
            incident_service=self.incident_service,
            workflow_service=self.workflow_service,
        )
