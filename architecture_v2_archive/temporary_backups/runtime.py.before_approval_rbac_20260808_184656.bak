    ApprovalConflictError,
)
from services.agent_runtime.app.runtime.runtime import (
    AgentRuntime,
)


router = APIRouter()


# One shared Runtime is required so API requests reuse the same configured
# stores, tools and workflow services. SQLite remains the source of truth for
# recovery after a process restart.
runtime = AgentRuntime()


# Authentication and RBAC must use the exact shared services owned by the
# Runtime. Read-only routes and runtime analysis enforce authentication and
# RBAC; remediation write-route enforcement remains a separate rollout phase.
api_security = ApiSecurityAdapter(
    authentication=runtime.authentication,
    policy=runtime.security_policy,
)


class ApprovalDecisionBody(BaseModel):
    """Optional human explanation and bounded audit metadata."""

    model_config = ConfigDict(
        extra="forbid"
    )

    reason: str = Field(
        default="",
        max_length=2000,
    )

    metadata: dict[str, Any] = Field(
        default_factory=dict
    )


class ActionExecutionReconciliationBody(BaseModel):
    """Operator-confirmed outcome for one INDETERMINATE execution."""

    model_config = ConfigDict(
        extra="forbid"
    )

    outcome: (
        ActionExecutionReconciliationOutcome
    )

    reason: str = Field(
        min_length=1,
        max_length=2000,
    )

    result: dict[str, Any]

    error_type: str | None = Field(
        default=None,
        max_length=256,
    )

    error_message: str | None = Field(
        default=None,
        max_length=4000,
    )

    metadata: dict[str, Any] = Field(
        default_factory=dict
    )


def _normalize_request_id(
    value: str | None,
) -> str:
    normalized = (
        value.strip()
        if value is not None
        else ""
    )
    return normalized or str(
        uuid4()
    )


def _normalize_required_header(
    value: str,
    header_name: str,
) -> str:
    """Reject whitespace-only identity and idempotency headers."""

    normalized = value.strip()

    if not normalized:
        raise HTTPException(
            status_code=422,
            detail=(
                f"{header_name} must not "
                "be blank"
            ),
        )

    return normalized


def _trace_matches_incident(
    trace,
    incident_id: str,
) -> bool:
    """Prevent traces from another API request leaking into the response."""

    for field_name in (
        "input_data",
        "output_data",
    ):
        data = getattr(
            trace,
            field_name,
            None,
        )

        if not isinstance(
            data,
            dict,
        ):
            continue

        if str(
            data.get(
                "incident_id",
                "",
            )
        ) == incident_id:
            return True

    return False


def _trace_summary(
    trace,
) -> dict[str, Any]:
    """
    Return bounded trace metadata.

    Raw spans and prompt input are intentionally excluded from the public API
    response. Full traces remain available through the observability store.
    """

    return {
        "trace_id": str(
            trace.trace_id
        ),
        "agent": trace.agent,
        "duration_ms": trace.duration_ms,
        "success": trace.success,
        "score": trace.score,
        "message": trace.message,
    }


def _current_trace_summaries(
    incident_id: UUID,
) -> list[dict[str, Any]]:
    normalized_id = str(
        incident_id
    )

    return [
        _trace_summary(
            trace
        )
        for trace in runtime.tracer.list()
        if _trace_matches_incident(
            trace,
            normalized_id,
        )
    ]


def _action_execution_status(
    execution: dict[str, Any],
) -> str:
    """Read the persisted execution status from either response shape."""

    value = (
        execution.get(
            "execution_status"
        )
        or execution.get(
            "status"
        )
        or ""
    )

    return str(
        value
    ).strip().lower()


def _action_execution_http_status(
    execution: dict[str, Any],
) -> int:
    """Map Action Execution state without treating uncertainty as success."""

    status = _action_execution_status(
        execution
    )

    if status == "succeeded":
        return 200

    if status == "running":
        return 202

    if status == "failed":
        return 502

    if status == "indeterminate":
        return 503

    if (
        execution.get("success")
        is True
        and execution.get(
            "execution_id"
        )
    ):
        return 200

    return 409


def _verification_status(
    verification,
) -> str | None:
    """Normalize a persisted Verification status for the API response."""

    if verification is None:
        return None

    value = getattr(
        verification,
        "status",
        None,
    )

    if value is None:
        return None

    return str(
        getattr(
            value,
            "value",
            value,
        )
    ).strip().lower()


def _workflow_status(
    *,
    execution_status: str,
    verification_status: str | None,
    verification_error: dict[str, Any] | None,
) -> str:
    """Expose the whole remediation outcome without hiding partial states."""

    if execution_status != "succeeded":
        return (
            f"action_{execution_status}"
            if execution_status
            else "action_unknown"
        )

    if verification_error is not None:
        return "verification_reconciliation_required"

    if verification_status is None:
        return "verification_not_started"

    return {
        "pending": "verification_pending",
        "running": "verification_running",
        "passed": "resolved",
        "failed": "verification_failed",
        "inconclusive": (
            "verification_inconclusive"
        ),
        "timed_out": "verification_timed_out",
    }.get(
        verification_status,
        "verification_unknown",
    )


def _enum_text(
    value: Any,
) -> str | None:
    """Normalize Enum-backed persisted fields without mutating the models."""

    if value is None:
        return None

    return str(
        getattr(
            value,
            "value",
            value,
        )
    ).strip().lower()


def _workflow_reconciliation_snapshot(
    *,
    execution,
    verification,
) -> dict[str, Any]:
    """Expose bounded manual reconciliation audit and follow-up state."""

    if execution is None:
        return {
            "required": False,
            "performed": False,
            "outcome": None,
            "operator_id": None,
            "idempotency_key": None,
            "reason": None,
            "reconciled_at": None,
            "result": None,
            "error_type": None,
            "error_message": None,
            "metadata": {},
            "verification_expected": False,
            "verification_present": False,
            "verification_rule_satisfied": True,
        }

    execution_status = _enum_text(
        execution.status
    )
    decision = getattr(
        execution,
        "reconciliation",
        None,
    )

    if decision is None:
        return {
            "required": (
                execution_status
                == "indeterminate"
            ),
            "performed": False,
            "outcome": None,
            "operator_id": None,
            "idempotency_key": None,
            "reason": None,
            "reconciled_at": None,
            "result": None,
            "error_type": None,
            "error_message": None,
            "metadata": {},
            "verification_expected": False,
            "verification_present": (
                verification is not None
            ),
            "verification_rule_satisfied": True,
        }

    outcome = _enum_text(
        decision.outcome
    )
    verification_expected = (
        outcome == "succeeded"
    )
    verification_present = (
        verification is not None
    )

    return {
        "required": False,
        "performed": True,
        "outcome": outcome,
        "operator_id": decision.operator_id,
        "idempotency_key": (
            decision.idempotency_key
        ),
        "reason": decision.reason,
        "reconciled_at": (
            decision.reconciled_at
        ),
        "result": dict(
            decision.result
        ),
        "error_type": decision.error_type,
        "error_message": (
            decision.error_message
        ),
        "metadata": dict(
            decision.metadata
        ),
        "verification_expected": (
            verification_expected
        ),
        "verification_present": (
            verification_present
        ),
        "verification_rule_satisfied": (
            verification_present
            if verification_expected
            else not verification_present
        ),
    }


def _workflow_consistency_issues(
    *,
    approval,
    execution,
    verification,
    incident,
    validate_incident_status: bool = True,
) -> list[str]:
    """Validate links and terminal state synchronization across stores."""

    issues: list[str] = []
    approval_status = _enum_text(
        approval.status
    )
    approval_incident_id = (
        str(approval.incident_id)
        if approval.incident_id is not None
        else None
    )

    if approval_incident_id is None:
        issues.append(
            "approval_missing_incident_link"
        )
    elif incident is None:
        issues.append(
            "linked_incident_not_found"
        )
    elif str(
        incident.id
    ) != approval_incident_id:
        issues.append(
            "linked_incident_id_mismatch"
        )

    if (
        approval_status == "approved"
    ) != (
        approval.action.approved is True
    ):
        issues.append(
            "approval_action_flag_mismatch"
        )

    if execution is not None:
        if execution.approval_id != approval.id:
            issues.append(
                "execution_approval_link_mismatch"
            )

        execution_incident_id = (
            str(execution.incident_id)
            if execution.incident_id is not None
            else None
        )

        if (
            execution_incident_id
            != approval_incident_id
        ):
            issues.append(
                "execution_incident_link_mismatch"
            )

        if approval_status != "approved":
            issues.append(
                "execution_exists_without_approved_request"
            )

        scope_fields = (
            "type",
            "target",
            "namespace",
            "cluster",
        )

        if any(
            getattr(
                execution.action,
                field_name,
            )
            != getattr(
                approval.action,
                field_name,
            )
            for field_name in scope_fields
        ):
            issues.append(
                "execution_action_scope_mismatch"
            )

    if verification is not None:
        if execution is None:
            issues.append(
                "verification_missing_action_execution"
            )
        elif str(
            verification.action_execution_id
        ) != str(
            execution.id
        ):
            issues.append(
                "verification_execution_link_mismatch"
            )

        verification_incident_id = str(
            verification.incident_id
        )

        if (
            verification_incident_id
            != approval_incident_id
        ):
            issues.append(
                "verification_incident_link_mismatch"
            )

        if (
            execution is not None
            and _enum_text(
                execution.status
            ) != "succeeded"
        ):
            issues.append(
                "verification_exists_before_action_success"
            )

    if execution is not None:
        reconciliation = getattr(
            execution,
            "reconciliation",
            None,
        )

        if reconciliation is not None:
            reconciliation_outcome = (
                _enum_text(
                    reconciliation.outcome
                )
            )
            execution_status = _enum_text(
                execution.status
            )

            if (
                reconciliation_outcome
                != execution_status
            ):
                issues.append(
                    "reconciliation_execution_status_mismatch"
                )

            if (
                reconciliation_outcome
                == "failed"
                and verification is not None
            ):
                issues.append(
                    "verification_exists_after_failed_reconciliation"
                )

    if (
        incident is not None
        and validate_incident_status
    ):
        incident_status = _enum_text(
            incident.status
        )
        verification_status = (
            _verification_status(
                verification
            )
        )

        expected_incident_status = {
            "passed": "resolved",
            "failed": "failed",
            "timed_out": "failed",
            "inconclusive": "healing",
            "pending": "healing",
            "running": "healing",
        }.get(
            verification_status
        )

        if (
            expected_incident_status is not None
            and incident_status
            != expected_incident_status
        ):
            issues.append(
                "verification_incident_status_mismatch"
            )

        if (
            verification is None
            and execution is not None
        ):
            expected_action_incident_status = {
                "succeeded": "healing",
                "failed": "failed",
                "indeterminate": "healing",
            }.get(
                _enum_text(
                    execution.status
                )
            )

            if (
                expected_action_incident_status
                is not None
                and incident_status
                != expected_action_incident_status
            ):
                issues.append(
                    "action_incident_status_mismatch"
                )

    return issues


def _persisted_workflow_status(
    *,
    approval,
    execution,
    verification,
    consistency_issues: list[str],
) -> str:
    """Derive one stable public status from the persisted workflow graph."""

    if consistency_issues:
        return "inconsistent"

    approval_status = _enum_text(
        approval.status
    )

    if approval_status == "pending":
        return "pending_approval"

    if approval_status in {
        "rejected",
        "expired",
    }:
        return approval_status

    if approval_status != "approved":
        return "approval_unknown"

    if execution is None:
        return "approved_awaiting_execution"

    execution_status = _enum_text(
        execution.status
    )

    if execution_status == "running":
        return "action_running"

    if execution_status == "failed":
        return "action_failed"

    if execution_status == "indeterminate":
        return "action_indeterminate"

    if execution_status != "succeeded":
        return "action_unknown"

    if verification is None:
        return "awaiting_verification"

    return {
        "pending": "verification_pending",
        "running": "verification_running",
        "passed": "resolved",
        "failed": "verification_failed",
        "inconclusive": (
            "verification_inconclusive"
        ),
        "timed_out": "verification_timed_out",
    }.get(
        _verification_status(
            verification
        ),
        "verification_unknown",
    )


def _workflow_flags(
    workflow_status: str,
) -> dict[str, bool]:
    """Separate terminality, success and operator follow-up semantics."""

    terminal = workflow_status in {
        "resolved",
        "rejected",
        "expired",
        "action_failed",
        "verification_failed",
        "verification_timed_out",
    }

    manual_reconciliation_required = (
        workflow_status
        in {
            "inconsistent",
            "action_indeterminate",
            "verification_timed_out",
        }
    )

    follow_up_required = (
        workflow_status
        not in {
            "resolved",
            "rejected",
            "expired",
        }
    )

    return {
        "workflow_success": (
            workflow_status == "resolved"
        ),
        "terminal": terminal,
        "follow_up_required": (
            follow_up_required
        ),
        "manual_reconciliation_required": (
            manual_reconciliation_required
        ),
    }


def _workflow_snapshot(
    *,
    approval,
    execution,
    verification,
    incident,
    validate_incident_status: bool = True,
) -> dict[str, Any]:
    """Build one read-only Approval-centered Workflow snapshot."""

    consistency_issues = (
        _workflow_consistency_issues(
            approval=approval,
            execution=execution,
            verification=verification,
            incident=incident,
            validate_incident_status=(
                validate_incident_status
            ),
        )
    )
    workflow_status = (
        _persisted_workflow_status(
            approval=approval,
            execution=execution,
            verification=verification,
            consistency_issues=(
                consistency_issues
            ),
        )
    )
    reconciliation_snapshot = (
        _workflow_reconciliation_snapshot(
            execution=execution,
            verification=verification,
        )
    )

    return {
        "success": True,
        "approval_id": approval.id,
        "workflow_status": workflow_status,
        **_workflow_flags(
            workflow_status
        ),
        "consistency": {
            "passed": not consistency_issues,
            "issues": consistency_issues,
        },
        "reconciliation": (
            reconciliation_snapshot
        ),
        "links": {
            "approval_incident_id": (
                str(approval.incident_id)
                if approval.incident_id
                is not None
                else None
            ),
            "execution_id": (
                str(execution.id)
                if execution is not None
                else None
            ),
            "execution_incident_id": (
                str(execution.incident_id)
                if execution is not None
                and execution.incident_id
                is not None
                else None
            ),
            "verification_id": (
                str(verification.id)
                if verification is not None
                else None
            ),
            "verification_incident_id": (
                str(verification.incident_id)
                if verification is not None
                else None
            ),
            "verification_action_execution_id": (
                str(
                    verification
                    .action_execution_id
                )
                if verification is not None
                and verification
                .action_execution_id
                is not None
                else None
            ),
        },
        "approval": approval.model_dump(
            mode="json"
        ),
        "action_execution": (
            execution.model_dump(
                mode="json"
            )
            if execution is not None
            else None
        ),
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "incident": (
            incident.model_dump(
                mode="json"
            )
            if incident is not None
            else None
        ),
    }


async def _synchronize_reconciled_failure_incident(
    *,
    incident,
    execution,
):
    """Persist the Incident failure caused by a reconciled Action failure."""

    if (
        incident.status
        == IncidentStatus.FAILED
    ):
        return incident

    if (
        incident.status
        != IncidentStatus.HEALING
    ):
        raise ValueError(
            "Reconciled Action failure cannot change "
            "Incident from "
            f"{_enum_text(incident.status)}"
        )

    updated = incident.model_copy(
        deep=True
    )
    reconciliation = execution.reconciliation
    decision_reason = (
        reconciliation.reason
        if reconciliation is not None
        else "Operator confirmed Action failure"
    )
    updated.update(
        IncidentStatus.FAILED,
        reason=(
            "Action Execution was reconciled as failed: "
            f"{decision_reason}"
        ),
    )

    try:
        return await runtime.incident_store.update(
            updated
        )

    except Exception:
        refreshed = await runtime.incident_store.get(
            str(
                incident.id
            )
        )

        if (
            refreshed is not None
            and refreshed.status
            == IncidentStatus.FAILED
        ):
            return refreshed

        raise


@router.post(
    "/execute",
    summary="Execute Agent Runtime",
)
async def execute_runtime(
    payload: dict = Body(...),
    x_request_id: str | None = Header(
        default=None,
        max_length=128,
    ),
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Validate one StandardEvent and execute the shared Agent Runtime pipeline.

    This endpoint performs analysis only. It does not approve or execute a
    remediation action automatically.
    """

    api_security.require(
        authorization,
        ProtectedOperation.EXECUTE_RUNTIME_ANALYSIS,
    )

    try:
        event = StandardEvent.model_validate(
            payload
        )
    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    request_id = _normalize_request_id(
        x_request_id
    )

    context = AgentContext(
        request_id=request_id,
        event=event,
        memory=runtime.memory,
        tools=runtime.tools,
        skills=runtime.skills,
        mcp=runtime.mcp,
        approval=runtime.approval,
    )

    results = await runtime.pipeline.execute(
        context
    )

    incident = context.incident
    trace_summaries = (
        _current_trace_summaries(
            incident.id
        )
    )

    response = {
        "success": True,
        "request_id": request_id,
        "incident": incident.model_dump(
            mode="json"
        ),
        "results": [
            result.model_dump(
                mode="json"
            )
            for result in results
        ],
        "executions": [
            execution.model_dump(
                mode="json"
            )
            for execution in context.executions
        ],
        "evaluations": [
            evaluation.model_dump(
                mode="json"
            )
            for evaluation in context.evaluations
        ],
        "traces": trace_summaries,
        "trace_count": len(
            trace_summaries
        ),
    }

    return jsonable_encoder(
        response
    )


@router.get(
    "/incidents/{incident_id}",
    summary="Get Incident State",
)
async def get_incident(
    incident_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """Read one persisted Incident without changing workflow state."""

    api_security.require(
        authorization,
        ProtectedOperation.READ_INCIDENT,
    )

    incident = await runtime.incident_store.get(
        str(
            incident_id
        )
    )

    if incident is None:
        raise HTTPException(
            status_code=404,
            detail="Incident not found",
        )

    return jsonable_encoder(
        {
            "success": True,
            "incident": incident.model_dump(
                mode="json"
            ),
        }
    )


@router.get(
    "/incidents/{incident_id}/workflows",
    summary="Get Incident Remediation Workflows",
)
async def get_incident_workflows(
    incident_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Read every persisted remediation attempt linked to one Incident.

    The endpoint performs indexed reads only. It includes bounded manual
    reconciliation audit and Verification follow-up state, but never approves
    or resumes an Action, claims or runs Verification, invokes a Collector, or
    synchronizes Incident state.
    """

    api_security.require(
        authorization,
        ProtectedOperation.READ_INCIDENT_WORKFLOWS,
    )

    normalized_incident_id = str(
        incident_id
    )
    incident = await runtime.incident_store.get(
        normalized_incident_id
    )

    if incident is None:
        raise HTTPException(
            status_code=404,
            detail="Incident not found",
        )

    (
        approvals,
        executions,
        verifications,
    ) = await asyncio.gather(
        runtime.approval.list_by_incident(
            incident_id
        ),
        runtime.action_execution_service.list_by_incident(
            incident_id
        ),
        runtime.verification.list_by_incident(
            incident_id
        ),
    )

    aggregate_issues: list[str] = []
    approval_ids = {
        approval.id
        for approval in approvals
    }
    execution_by_approval: dict[str, Any] = {}
    execution_by_id: dict[str, Any] = {}
    orphan_executions: list[Any] = []

    for execution in executions:
        execution_id = str(
            execution.id
        )
        execution_by_id[
            execution_id
        ] = execution

        if execution.approval_id not in approval_ids:
            orphan_executions.append(
                execution
            )
            aggregate_issues.append(
                "orphan_action_execution:"
                f"{execution_id}"
            )
            continue

        if (
            execution.approval_id
            in execution_by_approval
        ):
            orphan_executions.append(
                execution
            )
            aggregate_issues.append(
                "duplicate_execution_for_approval:"
                f"{execution.approval_id}"
            )
            continue

        execution_by_approval[
            execution.approval_id
        ] = execution

    verification_by_execution: dict[
        str,
        Any,
    ] = {}
    manual_verifications: list[Any] = []
    orphan_verifications: list[Any] = []

    for verification in verifications:
        linked_execution_id = (
            str(
                verification
                .action_execution_id
            )
            if verification
            .action_execution_id
            is not None
            else None
        )

        if linked_execution_id is None:
            manual_verifications.append(
                verification
            )
            continue

        linked_execution = (
            execution_by_id.get(
                linked_execution_id
            )
        )

        if linked_execution is None:
            orphan_verifications.append(
                verification
            )
            aggregate_issues.append(
                "orphan_verification:"
                f"{verification.id}"
            )
            continue

        if (
            linked_execution.approval_id
            not in approval_ids
        ):
            orphan_verifications.append(
                verification
            )
            continue

        if (
            linked_execution_id
            in verification_by_execution
        ):
            orphan_verifications.append(
                verification
            )
            aggregate_issues.append(
                "duplicate_verification_for_execution:"
                f"{linked_execution_id}"
            )
            continue

        verification_by_execution[
            linked_execution_id
        ] = verification

    latest_approval_id = (
        approvals[-1].id
        if approvals
        else None
    )
    workflows: list[dict[str, Any]] = []

    for approval in approvals:
        execution = execution_by_approval.get(
            approval.id
        )
        verification = (
            verification_by_execution.get(
                str(
                    execution.id
                )
            )
            if execution is not None
            else None
        )
        snapshot = _workflow_snapshot(
            approval=approval,
            execution=execution,
            verification=verification,
            incident=incident,
            validate_incident_status=(
                approval.id
                == latest_approval_id
            ),
        )
        workflows.append(
            snapshot
        )

        aggregate_issues.extend(
            "approval:"
            f"{approval.id}:"
            f"{issue}"
            for issue in snapshot[
                "consistency"
            ]["issues"]
        )

    consistency_passed = (
        not aggregate_issues
    )
    current_workflow = (
        workflows[-1]
        if workflows
        else None
    )
    reconciliation_snapshots = [
        workflow[
            "reconciliation"
        ]
        for workflow in workflows
    ]
    reconciliation_summary = {
        "required": sum(
            1
            for snapshot
            in reconciliation_snapshots
            if snapshot["required"]
        ),
        "performed": sum(
            1
            for snapshot
            in reconciliation_snapshots
            if snapshot["performed"]
        ),
        "succeeded": sum(
            1
            for snapshot
            in reconciliation_snapshots
            if snapshot["outcome"]
            == "succeeded"
        ),
        "failed": sum(
            1
            for snapshot
            in reconciliation_snapshots
            if snapshot["outcome"]
            == "failed"
        ),
        "verification_follow_up_required": sum(
            1
            for snapshot
            in reconciliation_snapshots
            if snapshot[
                "verification_expected"
            ]
            and not snapshot[
                "verification_rule_satisfied"
            ]
        ),
        "current": (
            current_workflow[
                "reconciliation"
            ]
            if current_workflow
            is not None
            else None
        ),
    }

    if not consistency_passed:
        workflow_status = "inconsistent"
        flags = _workflow_flags(
            workflow_status
        )
    elif current_workflow is not None:
        workflow_status = current_workflow[
            "workflow_status"
        ]
        flags = {
            "workflow_success": (
                current_workflow[
                    "workflow_success"
                ]
            ),
            "terminal": current_workflow[
                "terminal"
            ],
            "follow_up_required": (
                current_workflow[
                    "follow_up_required"
                ]
            ),
            "manual_reconciliation_required": (
                current_workflow[
                    "manual_reconciliation_required"
                ]
            ),
        }
    else:
        workflow_status = "no_workflow"
        incident_terminal = (
            _enum_text(
                incident.status
            )
            in {
                "resolved",
                "failed",
            }
        )
        flags = {
            "workflow_success": False,
            "terminal": incident_terminal,
            "follow_up_required": (
                not incident_terminal
            ),
            "manual_reconciliation_required": False,
        }

    response = {
        "success": True,
        "incident_id": normalized_incident_id,
        "workflow_status": workflow_status,
        **flags,
        "current_workflow_approval_id": (
            current_workflow[
                "approval_id"
            ]
            if current_workflow is not None
            else None
        ),
        "counts": {
            "workflows": len(
                workflows
            ),
            "approvals": len(
                approvals
            ),
            "action_executions": len(
                executions
            ),
            "verifications": len(
                verifications
            ),
            "manual_verifications": len(
                manual_verifications
            ),
            "orphan_action_executions": len(
                orphan_executions
            ),
            "orphan_verifications": len(
                orphan_verifications
            ),
        },
        "reconciliation_summary": (
            reconciliation_summary
        ),
        "consistency": {
            "passed": consistency_passed,
            "issues": aggregate_issues,
        },
        "incident": incident.model_dump(
            mode="json"
        ),
        "workflows": workflows,
        "unlinked_records": {
            "action_executions": [
                execution.model_dump(
                    mode="json"
                )
                for execution
                in orphan_executions
            ],
            "verifications": [
                verification.model_dump(
                    mode="json"
                )
                for verification
                in orphan_verifications
            ],
            "manual_verifications": [
                verification.model_dump(
                    mode="json"
                )
                for verification
                in manual_verifications
            ],
        },
    }

    return jsonable_encoder(
        response
    )


@router.get(
    "/approvals/{approval_id}",
    summary="Get Approval Request",
)
async def get_approval(
    approval_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """Read one persisted ApprovalRequest without making a decision."""

    api_security.require(
        authorization,
        ProtectedOperation.READ_APPROVAL,
    )

    approval = await runtime.approval.get(
        str(
            approval_id
        )
    )

    if approval is None:
        raise HTTPException(
            status_code=404,
            detail="Approval request not found",
        )

    return jsonable_encoder(
        {
            "success": True,
            "approval": approval.model_dump(
                mode="json"
            ),
        }
    )


@router.get(
    "/workflows/approvals/{approval_id}",
    summary="Get Complete Remediation Workflow",
)
async def get_approval_workflow(
    approval_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """
    Read a complete persisted workflow snapshot without advancing it.

    This endpoint never resumes an Action, claims a Verification, invokes a
    Collector, or synchronizes an Incident. Any broken link is reported as an
    inconsistent snapshot that requires operator reconciliation.
    """

    api_security.require(
        authorization,
        ProtectedOperation.READ_APPROVAL_WORKFLOW,
    )

    request_id = str(
        approval_id
    )
    approval = await runtime.approval.get(
        request_id
    )

    if approval is None:
        raise HTTPException(
            status_code=404,
            detail="Approval request not found",
        )

    execution = await (
        runtime.action_execution_service
        .get_by_approval(
            request_id
        )
    )

    verification = None

    if execution is not None:
        verification = await (
            runtime.verification
            .get_by_action_execution(
                execution.id
            )
        )

    incident = None
    validate_incident_status = True

    if approval.incident_id is not None:
        incident = await (
            runtime.incident_store.get(
                str(
                    approval.incident_id
                )
            )
        )

        related_approvals = await (
            runtime.approval.list_by_incident(
                approval.incident_id
            )
        )

        if related_approvals:
            validate_incident_status = (
                related_approvals[-1].id
                == approval.id
            )

    response = _workflow_snapshot(
        approval=approval,
        execution=execution,
        verification=verification,
        incident=incident,
        validate_incident_status=(
            validate_incident_status
        ),
    )

    return jsonable_encoder(
        response
    )


async def _apply_approval_decision(
    *,
    approval_id: UUID,
    operation: Literal[
        "approve",
        "reject",
    ],
    decision: ApprovalDecisionBody,
    operator_id: str,
    idempotency_key: str,
):
    """Apply one audited decision and map lifecycle failures to HTTP status."""

    request_id = str(
        approval_id
    )

    existing = await runtime.approval.get(
        request_id
    )

    if existing is None:
        raise HTTPException(
            status_code=404,
            detail="Approval request not found",
        )

    decision_metadata = dict(
        decision.metadata
    )
    decision_metadata[
        "source"
    ] = "api"

    try:
        if operation == "approve":
            approval = await runtime.approval.approve(
                request_id,
                operator_id=operator_id,
                idempotency_key=idempotency_key,
                reason=decision.reason,
                metadata=decision_metadata,
            )
        else:
            approval = await runtime.approval.reject(
                request_id,
                operator_id=operator_id,
                idempotency_key=idempotency_key,
                reason=decision.reason,
                metadata=decision_metadata,
            )

    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    except ApprovalConflictError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    except ValueError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    return jsonable_encoder(
        {
            "success": True,
            "approval": approval.model_dump(
                mode="json"
            ),
        }
    )


@router.post(
    "/approvals/{approval_id}/approve",
    summary="Approve Remediation Action",
)
async def approve_approval(
    approval_id: UUID,
    decision: ApprovalDecisionBody = Body(...),
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
):
    """
    Persist an audited approval decision.

    X-Operator-ID must be injected by a trusted authentication layer in a
    production deployment. This endpoint records identity; it does not
    authenticate the caller by itself.
    """

    return await _apply_approval_decision(
        approval_id=approval_id,
        operation="approve",
        decision=decision,
        operator_id=x_operator_id,
        idempotency_key=idempotency_key,
    )


@router.post(
    "/approvals/{approval_id}/reject",
    summary="Reject Remediation Action",
)
async def reject_approval(
    approval_id: UUID,
    decision: ApprovalDecisionBody = Body(...),
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
):
    """Persist an audited rejection without executing the Action."""

    return await _apply_approval_decision(
        approval_id=approval_id,
        operation="reject",
        decision=decision,
        operator_id=x_operator_id,
        idempotency_key=idempotency_key,
    )


@router.post(
    "/approvals/{approval_id}/resume",
    summary="Resume Approved Remediation Action",
)
async def resume_approved_action(
    approval_id: UUID,
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
):
    """
    Resume one approved Action through the persistent execution boundary.

    The execution Idempotency-Key is independent from the key used to record
    the approval decision. Replaying the same key returns the persisted result
    without invoking the executor again.
    """

    request_id = str(
        approval_id
    )
    operator_id = _normalize_required_header(
        x_operator_id,
        "X-Operator-ID",
    )
    execution_key = _normalize_required_header(
        idempotency_key,
        "Idempotency-Key",
    )

    approval = await runtime.approval.get(
        request_id
    )

    if approval is None:
        raise HTTPException(
            status_code=404,
            detail="Approval request not found",
        )

    if (
        approval.status.value
        != "approved"
        or approval.action.approved
        is not True
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "Approval request is not "
                "approved for execution"
            ),
        )

    if approval.incident_id is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Approval request is not "
                "linked to an Incident"
            ),
        )

    incident_id = str(
        approval.incident_id
    )
    incident = await runtime.incident_store.get(
        incident_id
    )

    if incident is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Linked Incident was not "
                "found"
            ),
        )

    try:
        execution = await (
            runtime.action_runtime.resume(
                request_id,
                incident=incident,
                operator_id=operator_id,
                idempotency_key=(
                    execution_key
                ),
            )
        )

    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    except ActionExecutionConflictError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    except ValueError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    persisted_incident = (
        await runtime.incident_store.get(
            incident_id
        )
    )

    if persisted_incident is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Action execution completed but "
                "the Incident state could not "
                "be reloaded"
            ),
        )

    execution_status = (
        _action_execution_status(
            execution
        )
    )
    response_status = (
        _action_execution_http_status(
            execution
        )
    )

    verification = None
    verification_error: (
        dict[str, Any] | None
    ) = None

    if (
        execution_status == "succeeded"
        and response_status == 200
    ):
        execution_id = str(
            execution.get(
                "execution_id",
                "",
            )
        ).strip()

        if not execution_id:
            verification_error = {
                "type": (
                    "MissingActionExecutionId"
                ),
                "message": (
                    "Successful Action Execution "
                    "did not return execution_id"
                ),
            }
            response_status = 503

        else:
            try:
                (
                    verification,
                    persisted_incident,
                ) = await (
                    runtime.verification_coordinator.run(
                        incident_id=incident_id,
                        plan=approval.action,
                        namespace=(
                            approval.action.namespace
                        ),
                        cluster=(
                            approval.action.cluster
                        ),
                        action_execution_id=(
                            execution_id
                        ),
                        metadata={
                            "source": "api",
                            "trigger": (
                                "post_action_execution"
                            ),
                            "approval_id": request_id,
                        },
                    )
                )

            except VerificationIncidentSyncError as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                reloaded_incident = await (
                    runtime.incident_store.get(
                        incident_id
                    )
                )

                if reloaded_incident is not None:
                    persisted_incident = (
                        reloaded_incident
                    )

                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                    "verification_id": str(
                        exc.verification_id
                    ),
                }
                response_status = 503

            except VerificationConflictError as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 409

            except (
                VerificationProfileError,
                ValueError,
            ) as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 503

            except Exception as exc:
                verification = await (
                    runtime.verification
                    .get_by_action_execution(
                        execution_id
                    )
                )
                verification_error = {
                    "type": type(exc).__name__,
                    "message": str(exc),
                }
                response_status = 503

    verification_status = (
        _verification_status(
            verification
        )
    )

    if (
        verification_status
        in {
            "pending",
            "running",
        }
        and response_status == 200
    ):
        response_status = 202

    workflow_status = _workflow_status(
        execution_status=execution_status,
        verification_status=(
            verification_status
        ),
        verification_error=(
            verification_error
        ),
    )

    response = {
        "success": (
            response_status == 200
        ),
        "workflow_success": (
            response_status == 200
            and verification_error is None
            and verification_status == "passed"
            and persisted_incident.status.value
            == "resolved"
        ),
        "workflow_status": workflow_status,
        "approval_id": request_id,
        "incident": (
            persisted_incident.model_dump(
                mode="json"
            )
        ),
        "execution": execution,
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "verification_required": (
            execution_status == "succeeded"
        ),
        "verification_follow_up_required": (
            execution_status == "succeeded"
            and (
                verification_status != "passed"
                or verification_error is not None
            )
        ),
        "verification_error": (
            verification_error
        ),
        "manual_reconciliation_required": (
            execution_status
            == "indeterminate"
            or verification_error is not None
        ),
    }

    return JSONResponse(
        status_code=response_status,
        content=jsonable_encoder(
            response
        ),
    )


@router.post(
    "/action-executions/{execution_id}/reconcile",
    summary="Reconcile Indeterminate Action Execution",
)
async def reconcile_action_execution(
    execution_id: UUID,
    decision: (
        ActionExecutionReconciliationBody
    ) = Body(...),
    x_operator_id: str = Header(
        ...,
        alias="X-Operator-ID",
        min_length=1,
        max_length=128,
    ),
    idempotency_key: str = Header(
        ...,
        alias="Idempotency-Key",
        min_length=1,
        max_length=128,
    ),
):
    """
    Record the externally observed outcome of an INDETERMINATE Action.

    The endpoint never launches the Action again. A reconciled success enters
    the existing exactly-once VerificationCoordinator. A reconciled failure
    synchronizes the linked Incident to FAILED without running probes.

    X-Operator-ID must be supplied by a trusted authentication layer in a
    production deployment. This endpoint records identity; it does not
    authenticate the caller by itself.
    """

    normalized_execution_id = str(
        execution_id
    )
    operator_id = _normalize_required_header(
        x_operator_id,
        "X-Operator-ID",
    )
    reconciliation_key = (
        _normalize_required_header(
            idempotency_key,
            "Idempotency-Key",
        )
    )
    existing = await (
        runtime.action_execution_service.get(
            normalized_execution_id
        )
    )

    if existing is None:
        raise HTTPException(
            status_code=404,
            detail="Action execution not found",
        )

    if existing.incident_id is None:
        raise HTTPException(
            status_code=409,
            detail=(
                "Action execution is not linked "
                "to an Incident"
            ),
        )

    incident_id = str(
        existing.incident_id
    )
    incident = await runtime.incident_store.get(
        incident_id
    )

    if incident is None:
        raise HTTPException(
            status_code=409,
            detail="Linked Incident was not found",
        )

    if (
        existing.reconciliation is None
        and incident.status
        != IncidentStatus.HEALING
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "A new Action reconciliation requires "
                "the Incident to be healing"
            ),
        )

    reconciliation_metadata = dict(
        decision.metadata
    )
    reconciliation_metadata.update(
        {
            "source": "api",
            "trigger": (
                "manual_action_reconciliation"
            ),
            "action_execution_id": (
                normalized_execution_id
            ),
        }
    )

    try:
        reconciliation_result = await (
            runtime.action_execution_service
            .reconcile(
                normalized_execution_id,
                outcome=decision.outcome,
                operator_id=operator_id,
                idempotency_key=(
                    reconciliation_key
                ),
                reason=decision.reason,
                result=decision.result,
                error_type=decision.error_type,
                error_message=(
                    decision.error_message
                ),
                metadata=(
                    reconciliation_metadata
                ),
            )
        )

    except ValidationError as exc:
        raise HTTPException(
            status_code=422,
            detail=jsonable_encoder(
                exc.errors()
            ),
        ) from exc

    except ActionExecutionConflictError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    except ValueError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(
                exc
            ),
        ) from exc

    execution = reconciliation_result.execution
    execution_status = (
        _enum_text(
            execution.status
        )
        or ""
    )
    persisted_incident = await (
        runtime.incident_store.get(
            incident_id
        )
    )

    if persisted_incident is None:
        raise HTTPException(
            status_code=503,
            detail=(
                "Action reconciliation completed but "
                "the Incident state could not be reloaded"
            ),
        )

    response_status = 200
    verification = None
    verification_error: (
        dict[str, Any] | None
    ) = None
    incident_sync_error: (
        dict[str, Any] | None
    ) = None

    if execution_status == "failed":
        try:
            persisted_incident = await (
                _synchronize_reconciled_failure_incident(
                    incident=(
                        persisted_incident
                    ),
                    execution=execution,
                )
            )

        except Exception as exc:
            reloaded_incident = await (
                runtime.incident_store.get(
                    incident_id
                )
            )

            if reloaded_incident is not None:
                persisted_incident = (
                    reloaded_incident
                )

            incident_sync_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

    elif execution_status == "succeeded":
        try:
            (
                verification,
                persisted_incident,
            ) = await (
                runtime.verification_coordinator.run(
                    incident_id=incident_id,
                    plan=execution.action,
                    namespace=(
                        execution.action.namespace
                    ),
                    cluster=(
                        execution.action.cluster
                    ),
                    action_execution_id=(
                        normalized_execution_id
                    ),
                    metadata={
                        "source": "api",
                        "trigger": (
                            "post_action_reconciliation"
                        ),
                        "approval_id": (
                            execution.approval_id
                        ),
                        "reconciliation_idempotency_key": (
                            reconciliation_key
                        ),
                    },
                )
            )

        except VerificationIncidentSyncError as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            reloaded_incident = await (
                runtime.incident_store.get(
                    incident_id
                )
            )

            if reloaded_incident is not None:
                persisted_incident = (
                    reloaded_incident
                )

            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
                "verification_id": str(
                    exc.verification_id
                ),
            }
            response_status = 503

        except VerificationConflictError as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 409

        except (
            VerificationProfileError,
            ValueError,
        ) as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

        except Exception as exc:
            verification = await (
                runtime.verification
                .get_by_action_execution(
                    normalized_execution_id
                )
            )
            verification_error = {
                "type": type(exc).__name__,
                "message": str(exc),
            }
            response_status = 503

    else:
        incident_sync_error = {
            "type": (
                "UnexpectedReconciliationStatus"
            ),
            "message": (
                "Reconciliation did not produce a "
                "terminal Action Execution status"
            ),
        }
        response_status = 503

    verification_status = (
        _verification_status(
            verification
        )
    )

    if (
        verification_status
        in {
            "pending",
            "running",
        }
        and response_status == 200
    ):
        response_status = 202

    if incident_sync_error is not None:
        workflow_status = (
            "incident_reconciliation_required"
        )
    else:
        workflow_status = _workflow_status(
            execution_status=execution_status,
            verification_status=(
                verification_status
            ),
            verification_error=(
                verification_error
            ),
        )

    response = {
        "success": (
            response_status == 200
        ),
        "workflow_success": (
            response_status == 200
            and execution_status == "succeeded"
            and verification_error is None
            and verification_status == "passed"
            and persisted_incident.status.value
            == "resolved"
        ),
        "workflow_status": workflow_status,
        "action_execution_id": (
            normalized_execution_id
        ),
        "approval_id": execution.approval_id,
        "incident": (
            persisted_incident.model_dump(
                mode="json"
            )
        ),
        "execution": execution.model_dump(
            mode="json"
        ),
        "reconciliation": (
            execution.reconciliation.model_dump(
                mode="json"
            )
            if execution.reconciliation
            is not None
            else None
        ),
        "reconciliation_applied": (
            reconciliation_result.applied
        ),
        "idempotent_replay": (
            reconciliation_result.is_replay
        ),
        "verification": (
            verification.model_dump(
                mode="json"
            )
            if verification is not None
            else None
        ),
        "verification_required": (
            execution_status == "succeeded"
        ),
        "verification_follow_up_required": (
            execution_status == "succeeded"
            and (
                verification_status != "passed"
                or verification_error is not None
            )
        ),
        "verification_error": verification_error,
        "incident_sync_error": (
            incident_sync_error
        ),
        "manual_reconciliation_required": (
            incident_sync_error is not None
            or verification_error is not None
        ),
    }

    return JSONResponse(
        status_code=response_status,
        content=jsonable_encoder(
            response
        ),
    )


@router.get(
    "/verifications/{verification_id}",
    summary="Get Verification Result",
)
async def get_verification(
    verification_id: UUID,
    authorization: str | None = Header(
        default=None,
        alias="Authorization",
        max_length=8192,
    ),
):
    """Read one persisted VerificationResult without running new probes."""

    api_security.require(
        authorization,
        ProtectedOperation.READ_VERIFICATION,
    )

    verification = await runtime.verification.get(
        verification_id
    )

    if verification is None:
        raise HTTPException(
            status_code=404,
            detail="Verification result not found",
        )

    return jsonable_encoder(
        {
            "success": True,
            "verification": (
                verification.model_dump(
                    mode="json"
                )
            ),
        }
    )
