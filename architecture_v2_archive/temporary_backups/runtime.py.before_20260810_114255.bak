    create_authentication_service,
)
from services.agent_runtime.app.security.policy import (
    SecurityPolicyEngine,
)
from services.agent_runtime.app.security.service import (
    AuthenticationService,
)
from services.sandbox.executor.local import (
    LocalSandboxExecutor,
)
from services.sandbox.policy.validator import (
    SandboxPolicyValidator,
)


class AgentRuntime:
    """
    Runtime container.

    Owns and shares security and runtime infrastructure
    across Pipeline, Action and Verification.

    security_policy is the RBAC authorization policy. The existing policy
    attribute remains the remediation business policy engine.
    """

    def __init__(
        self,
        authentication_service: (
            AuthenticationService | None
        ) = None,
        security_policy: (
            SecurityPolicyEngine | None
        ) = None,
        kubernetes_preflight: (
            KubernetesPreflightResolver | None
        ) = None,
        kubernetes_production_executor: (
            KubernetesProductionExecutor | None
        ) = None,
        production_pilot_control: (
            KubernetesProductionPilotControl | None
        ) = None,
        production_pilot_budget_service: (
            ProductionPilotBudgetService | None
        ) = None,
        production_pilot_live_probe: (
            ProductionPilotLiveReadinessProbe | None
        ) = None,
        investigation_reasoner: (
            BaseInvestigationReasoner | None
        ) = None,
        investigation_settings: (
            InvestigationSettings | None
        ) = None,
    ) -> None:
        # Validate every injected security component before factories, stores
        # or other runtime components can produce side effects.
        if (
            authentication_service is not None
            and not isinstance(
                authentication_service,
                AuthenticationService,
            )
        ):
            raise TypeError(
                "AgentRuntime authentication service is invalid"
            )

        if (
            security_policy is not None
            and not isinstance(
                security_policy,
                SecurityPolicyEngine,
            )
        ):
            raise TypeError(
                "AgentRuntime security policy is invalid"
            )

        if (
            kubernetes_preflight is not None
            and not isinstance(
                kubernetes_preflight,
                KubernetesPreflightResolver,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes preflight resolver is invalid"
            )

        if (
            kubernetes_production_executor is not None
            and not isinstance(
                kubernetes_production_executor,
                KubernetesProductionExecutor,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor is invalid"
            )

        if (
            production_pilot_control is not None
            and not isinstance(
                production_pilot_control,
                KubernetesProductionPilotControl,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production pilot control is invalid"
            )

        if (
            production_pilot_budget_service is not None
            and not isinstance(
                production_pilot_budget_service,
                ProductionPilotBudgetService,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production pilot budget service is invalid"
            )

        if (
            production_pilot_live_probe is not None
            and not isinstance(
                production_pilot_live_probe,
                ProductionPilotLiveReadinessProbe,
            )
        ):
            raise TypeError(
                "AgentRuntime Production Pilot live probe is invalid"
            )

        if (
            investigation_reasoner is not None
            and not isinstance(
                investigation_reasoner,
                BaseInvestigationReasoner,
            )
        ):
            raise TypeError(
                "AgentRuntime Investigation reasoner is invalid"
            )

        if (
            investigation_settings is not None
            and not isinstance(
                investigation_settings,
                InvestigationSettings,
            )
        ):
            raise TypeError(
                "AgentRuntime Investigation settings are invalid"
            )

        # Resolve the disabled-default read-only Investigation assembly before
        # any Runtime store, tool, credential or network component is created.
        # The coordinator remains detached from PlannerPipeline in this stage.
        self.investigation_settings = (
            investigation_settings
            if investigation_settings is not None
            else InvestigationSettings.from_environment()
        )
        self.investigation_coordinator = (
            create_investigation_coordinator(
                reasoner=investigation_reasoner,
                settings=self.investigation_settings,
            )
        )

        self.authentication = (
            authentication_service
            if authentication_service is not None
            else create_authentication_service()
        )

        self.security_policy = (
            security_policy
            if security_policy is not None
            else SecurityPolicyEngine()
        )

        self.kubernetes_preflight = (
            kubernetes_preflight
            if kubernetes_preflight is not None
            else create_kubernetes_preflight_resolver()
        )

        self.production_pilot_control = (
            production_pilot_control
            if production_pilot_control is not None
            else create_kubernetes_production_pilot_control()
        )

        # This independent gate may read both credential values at startup,
        # but can construct only a two-GET probe. Disabled mode returns before
        # any credential or CA access.
        self.production_pilot_live_probe = (
            production_pilot_live_probe
            if production_pilot_live_probe is not None
            else create_production_pilot_live_readiness_probe()
        )

        self.production_pilot_budget_store = None
        self.production_pilot_budget_service = (
            production_pilot_budget_service
        )
        if (
            self.production_pilot_budget_service is None
            and self.production_pilot_control.config.enabled
        ):
            self.production_pilot_budget_store = (
                ProductionPilotBudgetStore()
            )
            self.production_pilot_budget_service = (
                ProductionPilotBudgetService(
                    store=(
                        self.production_pilot_budget_store
                    )
                )
            )

        self.kubernetes_production_executor = (
            kubernetes_production_executor
            if kubernetes_production_executor is not None
            else create_kubernetes_production_executor(
                pilot_control=(
                    self.production_pilot_control
                ),
                pilot_budget_service=(
                    self.production_pilot_budget_service
                ),
            )
        )

        if self.kubernetes_production_executor is not None:
            executor_control = getattr(
                self.kubernetes_production_executor,
                "pilot_control",
                None,
            )
            if executor_control is None:
                self.kubernetes_production_executor.pilot_control = (
                    self.production_pilot_control
                )
            elif executor_control is not self.production_pilot_control:
                raise TypeError(
                    "AgentRuntime Kubernetes production pilot control must be shared"
                )
            executor_budget = getattr(
                self.kubernetes_production_executor,
                "pilot_budget_service",
                None,
            )
            if executor_budget is None:
                if self.production_pilot_budget_service is None:
                    raise TypeError(
                        "AgentRuntime Kubernetes production pilot budget is unavailable"
                    )
                self.kubernetes_production_executor.pilot_budget_service = (
                    self.production_pilot_budget_service
                )
            elif executor_budget is not self.production_pilot_budget_service:
                raise TypeError(
                    "AgentRuntime Kubernetes production pilot budget must be shared"
                )

        if (
            self.kubernetes_production_executor is not None
            and self.kubernetes_preflight is None
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor requires "
                "trusted preflight"
            )

        self.production_pilot_readiness = (
            ProductionPilotReadinessService(
                control=(
                    self.production_pilot_control
                ),
                production_executor_configured=(
                    self.kubernetes_production_executor
                    is not None
                ),
            )
        )
        self.production_pilot_rehearsal = (
            ProductionPilotRehearsalService(
                control=(
                    self.production_pilot_control
                ),
                budget_service=(
                    self.production_pilot_budget_service
                ),
                production_executor_configured=(
                    self.kubernetes_production_executor
                    is not None
                ),
            )
        )
        # Pure recovery-policy proof. It owns no store, credential, network
        # client or executor and is available while the production gate is
        # disabled so operators can rehearse recovery before enablement.
        self.production_pilot_crash_recovery_rehearsal = (
            ProductionPilotCrashRecoveryRehearsalService()
        )

        self.memory = MemoryStore()
        self.tools = create_tool_manager()
        self.skills = create_skill_registry()
        self.mcp = create_mcp_registry()
        self.tracer = TraceCollector()
        self.evaluators = create_evaluation_registry()

        # Remediation business policy. This is intentionally separate from
        # security_policy, which authorizes operator-facing operations.
        self.policy = create_policy_engine()

        self.preflight_artifact_store = None
        self.preflight_artifact_service = None
        self.production_action_guard = None
        self.production_action_preparation = None
        self.production_action_query = None

        if self.kubernetes_preflight is not None:
            self.preflight_artifact_store = PreflightArtifactStore()
            self.preflight_artifact_service = PreflightArtifactService(
                store=self.preflight_artifact_store
            )
            self.production_action_guard = (
                ProductionActionExpiryGuard(
                    artifact_service=(
                        self.preflight_artifact_service
                    )
                )
            )

        self.approval = ApprovalService()

        if self.production_action_guard is not None:
            self.approval.manager.set_transition_guard(
                self.production_action_guard
            )

        if self.preflight_artifact_service is not None:
            self.production_action_preparation = (
                ProductionActionPreparationService(
                    resolver=self.kubernetes_preflight,
                    artifact_service=self.preflight_artifact_service,
                    approval_service=self.approval,
                )
            )

        self.production_pilot_ceremony_store = None
        self.production_pilot_ceremony = None
        if (
            self.production_pilot_control.config.enabled
            and self.production_pilot_budget_service is not None
            and self.preflight_artifact_service is not None
        ):
            self.production_pilot_ceremony_store = (
                ProductionPilotCeremonyStore()
            )
            self.production_pilot_ceremony = (
                ProductionPilotCeremonyService(
                    store=(
                        self.production_pilot_ceremony_store
                    ),
                    control=(
                        self.production_pilot_control
                    ),
                    rehearsal=(
                        self.production_pilot_rehearsal
                    ),
                    budget_service=(
                        self.production_pilot_budget_service
                    ),
                    approval_service=self.approval,
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                )
            )

        self.incident_store = IncidentStore()

        if self.preflight_artifact_service is not None:
            self.production_action_query = (
                ProductionActionQueryService(
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                    approval_service=self.approval,
                    incident_store=self.incident_store,
                )
            )

        self.incident_service = IncidentService(
            store=self.incident_store
        )

        self.workflow_service = WorkflowService(
            incident_service=self.incident_service
        )

        self.action_execution_store = ActionExecutionStore()

        self.action_execution_service = ActionExecutionService(
            store=self.action_execution_store
        )

        self.action_runtime = ActionRuntime(
            approval_service=self.approval,
            incident_store=self.incident_store,
            action_execution_service=self.action_execution_service,
            production_action_guard=(
                self.production_action_guard
            ),
            kubernetes_production_executor=(
                self.kubernetes_production_executor
            ),
            preflight_artifact_service=(
                self.preflight_artifact_service
                if self.kubernetes_production_executor is not None
                else None
            ),
            production_pilot_control=(
                self.production_pilot_control
            ),
            production_pilot_budget_service=(
                self.production_pilot_budget_service
            ),
            production_pilot_ceremony_service=(
                self.production_pilot_ceremony
                if self.kubernetes_production_executor is not None
                else None
            ),
        )

        self.verification_store = VerificationStore()

        self.verification = VerificationService(
            store=self.verification_store
        )

        self.verification_runtime = VerificationRuntime(
            verification_service=self.verification,
            incident_store=self.incident_store,
        )

        self.verification_profile_factory = VerificationProfileFactory()

        self.verification_collector = VerificationEvidenceCollector(
            tools=self.tools
        )

        self.verification_coordinator = VerificationCoordinator(
            profile_factory=self.verification_profile_factory,
            collector=self.verification_collector,
            verification_runtime=self.verification_runtime,
        )

        # Final pre-enable evidence is assembled only when every production
        # preparation component is available. The service is read-only and
        # deliberately owns no executor or mutable workflow operation.
        self.production_pilot_pre_enable_evidence = None
        if all(
            component is not None
            for component in (
                self.production_pilot_ceremony,
                self.production_pilot_budget_service,
                self.preflight_artifact_service,
            )
        ):
            self.production_pilot_pre_enable_evidence = (
                ProductionPilotPreEnableEvidenceService(
                    readiness_service=(
                        self.production_pilot_readiness
                    ),
                    rehearsal_service=(
                        self.production_pilot_rehearsal
                    ),
                    crash_rehearsal_service=(
                        self.production_pilot_crash_recovery_rehearsal
                    ),
                    ceremony_service=(
                        self.production_pilot_ceremony
                    ),
                    budget_service=(
                        self.production_pilot_budget_service
                    ),
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                    approval_service=self.approval,
                    incident_store=self.incident_store,
                    action_execution_service=(
                        self.action_execution_service
                    ),
                    verification_service=self.verification,
                )
            )

        # The final handoff rehearsal is also strictly read-only. It is
        # available only with the full prepared Pilot chain and explicitly
        # records whether production executors remain absent while the gate
        # is disabled.
        self.production_pilot_final_handoff_rehearsal = None
        if self.production_pilot_pre_enable_evidence is not None:
            self.production_pilot_final_handoff_rehearsal = (
                ProductionPilotFinalHandoffRehearsalService(
                    pilot_control=self.production_pilot_control,
                    pre_enable_evidence_service=(
                        self.production_pilot_pre_enable_evidence
                    ),
                    preflight_resolver=self.kubernetes_preflight,
                    production_executor_configured=(
                        self.kubernetes_production_executor is not None
                    ),
                    action_runtime_production_executor_configured=(
                        getattr(
                            self.action_runtime,
                            "kubernetes_production_executor",
                            None,
                        )
                        is not None
                    ),
                )
            )

        # A dedicated database is created only when the separately gated live
        # probe exists and the full zero-write handoff chain is available.
        self.production_pilot_go_no_go_store = None
        self.production_pilot_go_no_go = None
        if (
            self.production_pilot_live_probe is not None
            and self.production_pilot_final_handoff_rehearsal is not None
            and self.preflight_artifact_service is not None
        ):
            self.production_pilot_go_no_go_store = (
                ProductionPilotGoNoGoStore()
            )
            self.production_pilot_go_no_go = (
                ProductionPilotGoNoGoService(
                    store=self.production_pilot_go_no_go_store,
                    live_probe=self.production_pilot_live_probe,
                    final_handoff_service=(
                        self.production_pilot_final_handoff_rehearsal
                    ),
                    artifact_service=self.preflight_artifact_service,
                    pilot_control=self.production_pilot_control,
                )
            )

        self.sandbox = LocalSandboxExecutor()

        self.sandbox_policy = SandboxPolicyValidator()

        self.registry = create_agent_registry()

        self.planner = AgentPlanner()

        self.pipeline = PlannerPipeline(
            self.registry,
            self.planner,
            self.tracer,
            self.evaluators,
            incident_store=self.incident_store,
            incident_service=self.incident_service,
            workflow_service=self.workflow_service,
        )
