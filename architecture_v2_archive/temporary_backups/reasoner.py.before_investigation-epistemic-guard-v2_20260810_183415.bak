import json
from abc import ABC, abstractmethod

from pydantic import ValidationError

from services.agent_runtime.app.investigation.llm_gateway_adapter import (
    BaseInvestigationLLM,
)
from services.agent_runtime.app.investigation.models import (
    InvestigationDecision,
    InvestigationProbe,
    InvestigationScope,
    InvestigationState,
)


class InvestigationReasonerError(RuntimeError):
    """
    Sanitized reasoner failure.
    """


class BaseInvestigationReasoner(ABC):
    """
    Select the next symbolic read-only probe or stop with a conclusion.
    """

    @abstractmethod
    async def decide(
        self,
        scope: InvestigationScope,
        state: InvestigationState,
    ) -> InvestigationDecision:
        ...


class LLMInvestigationReasoner(
    BaseInvestigationReasoner
):
    """
    Structured LLM reasoner for the bounded InvestigationCoordinator.

    The reasoner depends only on the Investigation-owned LLM abstraction.
    Gateway routing, provider selection, fallback, rate limiting and circuit
    breaking remain outside this class.

    It can select only an InvestigationProbe enum value. It cannot construct
    tool calls, resource scope, PromQL, URLs or credentials.
    """

    _SYSTEM_PROMPT = (
        "You are a bounded SRE investigation reasoner. "
        "Maintain competing hypotheses, use only supplied "
        "evidence, and select only one allowed symbolic "
        "read-only probe. Never propose or execute a write."
    )

    def __init__(
        self,
        investigation_llm: BaseInvestigationLLM,
    ) -> None:
        if not isinstance(
            investigation_llm,
            BaseInvestigationLLM,
        ):
            raise TypeError(
                "Investigation LLM adapter is invalid"
            )

        self.investigation_llm = (
            investigation_llm
        )

    async def decide(
        self,
        scope: InvestigationScope,
        state: InvestigationState,
    ) -> InvestigationDecision:
        content = await self.investigation_llm.complete(
            system_prompt=self._SYSTEM_PROMPT,
            prompt=self._build_prompt(
                scope=scope,
                state=state,
            ),
        )

        if not isinstance(
            content,
            str,
        ):
            raise InvestigationReasonerError(
                "Investigation reasoner returned no JSON"
            )

        try:
            payload = json.loads(
                content
            )

            return InvestigationDecision.model_validate(
                payload
            )

        except (
            json.JSONDecodeError,
            ValidationError,
            TypeError,
            ValueError,
        ) as exc:
            raise InvestigationReasonerError(
                "Investigation reasoner returned an invalid decision"
            ) from exc

    @staticmethod
    def _build_prompt(
        scope: InvestigationScope,
        state: InvestigationState,
    ) -> str:
        trusted_evidence_ids = [
            item.evidence_id
            for item in state.evidence
            if (
                item.success
                and item.trusted
                and item.production_signal
            )
        ]

        state_payload = {
            "scope": scope.model_dump(
                mode="json"
            ),
            "iteration_count": state.iteration_count,
            "tool_call_count": state.tool_call_count,
            "attempted_probes": [
                probe.value
                for probe in state.attempted_probes
            ],
            "hypotheses": [
                item.model_dump(mode="json")
                for item in state.hypotheses
            ],
            "evidence": [
                item.model_dump(mode="json")
                for item in state.evidence
            ],
            "trusted_evidence_ids": trusted_evidence_ids,
            "allowed_probes": [
                probe.value
                for probe in InvestigationProbe
            ],
        }

        return (
            "Investigate the incident using the bounded state below.\n"
            "Return exactly one JSON object only. Do not return markdown.\n"
            "Maintain competing hypotheses and update confidence from evidence.\n"
            "Never repeat a probe already listed in attempted_probes.\n"
            "Never cite an evidence ID that is absent from State.evidence.\n"
            "For a conclusion, evidence_ids must be non-empty and copied "
            "exactly from trusted_evidence_ids.\n"
            "Allowed model terminal stop_reason values are exactly: "
            "sufficient_evidence, insufficient_evidence, no_safe_probe.\n"
            "Do not emit internal coordinator reasons such as timeout, "
            "max_iterations, max_tool_calls, duplicate_probe or reasoner_error.\n"
            "\n"
            "Continuing shape:\n"
            "{\n"
            '  "hypotheses": [{"hypothesis_id": "h1", "cause": "candidate", '
            '"confidence": 0.5, "supporting_evidence_ids": [], '
            '"conflicting_evidence_ids": [], "missing_evidence": ["needed evidence"]}],\n'
            '  "rationale_summary": "why this probe is most discriminative",\n'
            '  "stop": false,\n'
            '  "stop_reason": null,\n'
            '  "next_probe": "one unattempted value from allowed_probes",\n'
            '  "conclusion": null\n'
            "}\n"
            "\n"
            "Terminal sufficient-evidence shape:\n"
            "{\n"
            '  "hypotheses": [{"hypothesis_id": "h1", "cause": "supported cause", '
            '"confidence": 0.9, "supporting_evidence_ids": ["copy exact trusted id"], '
            '"conflicting_evidence_ids": [], "missing_evidence": []}],\n'
            '  "rationale_summary": "why trusted evidence is sufficient",\n'
            '  "stop": true,\n'
            '  "stop_reason": "sufficient_evidence",\n'
            '  "next_probe": null,\n'
            '  "conclusion": {"root_cause": "bounded root cause", '
            '"confidence": 0.9, "evidence_ids": ["copy exact trusted id"], '
            '"remaining_uncertainties": []}\n'
            "}\n"
            "\n"
            "Terminal insufficient/no-safe-probe shape:\n"
            "{\n"
            '  "hypotheses": [{"hypothesis_id": "h1", "cause": "candidate", '
            '"confidence": 0.3, "supporting_evidence_ids": [], '
            '"conflicting_evidence_ids": [], "missing_evidence": ["what is still missing"]}],\n'
            '  "rationale_summary": "why current bounded evidence cannot support an RCA",\n'
            '  "stop": true,\n'
            '  "stop_reason": "insufficient_evidence",\n'
            '  "next_probe": null,\n'
            '  "conclusion": null\n'
            "}\n"
            "\n"
            "If no useful unattempted allowed probe can resolve the remaining "
            "uncertainty, stop with insufficient_evidence or no_safe_probe.\n"
            "State:\n"
            f"{json.dumps(state_payload, ensure_ascii=True, sort_keys=True)}"
        )


__all__ = [
    "BaseInvestigationReasoner",
    "InvestigationReasonerError",
    "LLMInvestigationReasoner",
]
