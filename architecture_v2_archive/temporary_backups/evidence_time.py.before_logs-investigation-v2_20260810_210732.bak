from dataclasses import dataclass
from datetime import UTC, datetime, timedelta

from services.agent_runtime.app.investigation.models import (
    InvestigationProbe,
    InvestigationScope,
)


class InvestigationEvidenceTimeError(
    RuntimeError
):
    """
    Evidence timestamp is not temporally relevant to the incident.
    """


@dataclass(
    frozen=True,
    slots=True,
)
class InvestigationEvidenceTimePolicy:
    """
    Temporal relevance policy for Investigation evidence.

    Prometheus probes are incident-time probes when the trusted event
    occurred_at timestamp is available.

    Kubernetes Pod state remains current-state evidence because the Core API
    does not provide historical Pod snapshots.

    The policy deliberately does not impose one global evidence TTL.
    Different evidence sources have different temporal semantics.
    """

    prometheus_max_event_skew: timedelta = timedelta(
        minutes=2
    )

    def __post_init__(
        self,
    ) -> None:
        if (
            self.prometheus_max_event_skew
            <= timedelta(0)
        ):
            raise ValueError(
                "prometheus_max_event_skew must be positive"
            )

    def query_time(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> datetime | None:
        if not self._is_prometheus_probe(
            probe
        ):
            return None

        return self._event_time(
            scope
        )

    def temporal_basis(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> str:
        if (
            self._is_prometheus_probe(
                probe
            )
            and scope.event_occurred_at
            is not None
        ):
            return "incident_time"

        return "current_state"

    def validate_observed_at(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        observed_at: datetime,
    ) -> float | None:
        """
        Return signed seconds between the evidence sample and incident time.

        Positive means the sample is after the incident event.
        Negative means it is before the incident event.
        """

        if not self._is_prometheus_probe(
            probe
        ):
            return None

        event_time = self._event_time(
            scope
        )

        if event_time is None:
            return None

        normalized_observed = (
            self._timezone_aware_utc(
                observed_at,
                name="observed_at",
            )
        )

        offset = (
            normalized_observed
            - event_time
        )

        if abs(
            offset
        ) > self.prometheus_max_event_skew:
            raise InvestigationEvidenceTimeError(
                "Prometheus evidence is outside "
                "the incident-time window"
            )

        return offset.total_seconds()

    @staticmethod
    def _is_prometheus_probe(
        probe: InvestigationProbe,
    ) -> bool:
        return probe in {
            InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET,
            InvestigationProbe.PROMETHEUS_MEMORY_LIMIT,
            InvestigationProbe.PROMETHEUS_RESTART_COUNT,
        }

    @classmethod
    def _event_time(
        cls,
        scope: InvestigationScope,
    ) -> datetime | None:
        value = scope.event_occurred_at

        if value is None:
            return None

        return cls._timezone_aware_utc(
            value,
            name="event_occurred_at",
        )

    @staticmethod
    def _timezone_aware_utc(
        value: datetime,
        *,
        name: str,
    ) -> datetime:
        if (
            not isinstance(
                value,
                datetime,
            )
            or value.tzinfo is None
        ):
            raise InvestigationEvidenceTimeError(
                f"{name} must be timezone-aware"
            )

        return value.astimezone(
            UTC
        )


__all__ = [
    "InvestigationEvidenceTimeError",
    "InvestigationEvidenceTimePolicy",
]
