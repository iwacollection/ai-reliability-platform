from collections.abc import Mapping
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from math import isfinite
from typing import Any

from services.agent_runtime.app.evaluation.real_incident.models import (
    RealIncidentObservation,
    RealIncidentReplaySource,
)
from services.agent_runtime.app.investigation.evidence_time import (
    InvestigationEvidenceTimePolicy,
)
from services.agent_runtime.app.investigation.models import (
    InvestigationProbe,
    InvestigationScope,
)
from services.agent_runtime.app.investigation.probes import (
    ReadOnlyInvestigationProbeExecutor,
)
from services.agent_runtime.app.tools.base import (
    BaseTool,
)
from services.agent_runtime.app.tools.manager import (
    ToolManager,
)
from services.agent_runtime.app.tools.registry import (
    ToolRegistry,
)


class HistoricalEvidenceReplayError(
    RuntimeError
):
    """
    Base error for historical Incident evidence replay.
    """


class HistoricalEvidenceNotFoundError(
    HistoricalEvidenceReplayError
):
    """
    No historical observation satisfies the requested evidence contract.
    """


class HistoricalEvidenceAmbiguousError(
    HistoricalEvidenceReplayError
):
    """
    Multiple historical observations are equally valid and replay cannot
    choose safely.
    """


class HistoricalReplayOperationNotAllowedError(
    HistoricalEvidenceReplayError
):
    """
    Historical replay received an operation outside its read-only contract.
    """


class HistoricalReplayObservationError(
    HistoricalEvidenceReplayError
):
    """
    Historical observation content cannot safely satisfy a Tool contract.
    """


@dataclass(
    frozen=True,
    slots=True,
)
class HistoricalObservationSelectionPolicy:
    """
    Bounded selection policy for historical observations.

    Prometheus temporal validity remains enforced by the existing
    InvestigationEvidenceTimePolicy after the Tool response crosses the
    Investigation trust boundary.

    Kubernetes does not have that validation in the production executor,
    because production Kubernetes represents current state. Historical
    replay therefore enforces its own bounded incident-time window.
    """

    kubernetes_max_event_skew: timedelta = timedelta(
        minutes=10
    )

    def __post_init__(
        self,
    ) -> None:
        if (
            self.kubernetes_max_event_skew
            <= timedelta(0)
        ):
            raise ValueError(
                "kubernetes_max_event_skew must be positive"
            )


@dataclass(
    frozen=True,
    slots=True,
)
class HistoricalObservationMatch:
    """
    Historical observation plus trusted scope derived from StandardEvent.
    """

    observation: RealIncidentObservation

    resource: str

    namespace: str

    cluster: str | None


class HistoricalReplayEvidenceTimePolicy(
    InvestigationEvidenceTimePolicy
):
    """
    Historical replay uses Incident-time evidence for every current v1 probe.

    Prometheus query_time and skew validation remain inherited from the
    production Investigation policy.

    Kubernetes snapshot selection is bounded by
    HistoricalObservationSelectionPolicy before the result reaches the
    Investigation probe normalizer.
    """

    def temporal_basis(
        self,
        *,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> str:
        if scope.event_occurred_at is not None:
            return "incident_time"

        return "historical_observation"


class RealIncidentObservationStore:
    """
    Read-only selector over one RealIncidentReplaySource.

    The Store knows only replay-safe fields:
    - StandardEvent
    - historical observations

    It has no access to human postmortem or evaluation answers.

    Selection is deterministic and fails closed on:
    - missing evidence;
    - ambiguous Event resource scope;
    - equally-near historical observations;
    - stale Kubernetes snapshots.
    """

    def __init__(
        self,
        source: RealIncidentReplaySource,
        selection_policy: (
            HistoricalObservationSelectionPolicy
            | None
        ) = None,
    ) -> None:

        if not isinstance(
            source,
            RealIncidentReplaySource,
        ):
            raise TypeError(
                "Historical replay source is invalid"
            )

        self.source = source

        self.selection_policy = (
            selection_policy
            if selection_policy is not None
            else HistoricalObservationSelectionPolicy()
        )

        self.event_time = self._aware_utc(
            source.event.header.occurred_at,
            name="event occurred_at",
        )

    def select_kubernetes_pod_state(
        self,
        *,
        target: str,
        namespace: str,
    ) -> HistoricalObservationMatch:

        resource = self._resolve_event_resource(
            target=target,
            namespace=namespace,
        )

        match = self._select_nearest(
            source="kubernetes",
            kind="pod_state",
            reference_time=self.event_time,
            resource=resource,
        )

        offset = abs(
            match.observation.observed_at
            - self.event_time
        )

        if (
            offset
            > self.selection_policy.kubernetes_max_event_skew
        ):
            raise HistoricalEvidenceNotFoundError(
                "Historical Kubernetes observation "
                "is outside the Incident-time window"
            )

        return match

    def select_prometheus(
        self,
        *,
        kind: str,
        query: str,
        query_time: Any,
    ) -> HistoricalObservationMatch:

        if (
            not isinstance(
                query,
                str,
            )
            or not query.strip()
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query is invalid"
            )

        resource = (
            self._resolve_prometheus_resource(
                query
            )
        )

        reference_time = (
            self._parse_query_time(
                query_time
            )
        )

        return self._select_nearest(
            source="prometheus",
            kind=kind,
            reference_time=reference_time,
            resource=resource,
        )

    def _resolve_event_resource(
        self,
        *,
        target: str,
        namespace: str,
    ):
        target_value = self._required_text(
            target,
            "target",
        )

        namespace_value = self._required_text(
            namespace,
            "namespace",
        )

        matches = []

        for resource in (
            self.source.event.resources
        ):

            resource_name = getattr(
                resource,
                "name",
                None,
            )

            resource_namespace = (
                getattr(
                    resource,
                    "namespace",
                    None,
                )
                or "default"
            )

            if (
                resource_name == target_value
                and resource_namespace
                == namespace_value
            ):
                matches.append(
                    resource
                )

        if not matches:
            raise HistoricalEvidenceNotFoundError(
                "Historical Event resource was not found"
            )

        if len(
            matches
        ) != 1:
            raise HistoricalEvidenceAmbiguousError(
                "Historical Event resource scope is ambiguous"
            )

        return matches[0]

    def _resolve_prometheus_resource(
        self,
        query: str,
    ):
        matches = []

        for resource in (
            self.source.event.resources
        ):

            resource_name = getattr(
                resource,
                "name",
                None,
            )

            if not isinstance(
                resource_name,
                str,
            ):
                continue

            namespace = (
                getattr(
                    resource,
                    "namespace",
                    None,
                )
                or "default"
            )

            cluster = getattr(
                resource,
                "cluster",
                None,
            )

            required_fragments = [
                (
                    'pod="'
                    f'{self._escape_label(resource_name)}'
                    '"'
                ),
                (
                    'namespace="'
                    f'{self._escape_label(namespace)}'
                    '"'
                ),
            ]

            if cluster:
                required_fragments.append(
                    (
                        'cluster="'
                        f'{self._escape_label(cluster)}'
                        '"'
                    )
                )

            if all(
                fragment in query
                for fragment
                in required_fragments
            ):
                matches.append(
                    resource
                )

        if not matches:
            raise HistoricalEvidenceNotFoundError(
                "Historical Prometheus query "
                "does not match an Incident resource"
            )

        if len(
            matches
        ) != 1:
            raise HistoricalEvidenceAmbiguousError(
                "Historical Prometheus resource scope is ambiguous"
            )

        return matches[0]

    def _select_nearest(
        self,
        *,
        source: str,
        kind: str,
        reference_time: datetime,
        resource,
    ) -> HistoricalObservationMatch:

        expected_resource = getattr(
            resource,
            "name",
        )

        expected_namespace = (
            getattr(
                resource,
                "namespace",
                None,
            )
            or "default"
        )

        expected_cluster = getattr(
            resource,
            "cluster",
            None,
        )

        candidates: list[
            RealIncidentObservation
        ] = []

        for observation in (
            self.source.observations
        ):

            if (
                observation.source
                .strip()
                .lower()
                != source
            ):
                continue

            if (
                observation.kind
                .strip()
                .lower()
                != kind
            ):
                continue

            if not self._observation_scope_matches(
                observation=observation,
                resource=expected_resource,
                namespace=expected_namespace,
                cluster=expected_cluster,
            ):
                continue

            candidates.append(
                observation
            )

        if not candidates:
            raise HistoricalEvidenceNotFoundError(
                "Historical observation was not found"
            )

        candidates.sort(
            key=lambda item: abs(
                (
                    item.observed_at
                    - reference_time
                ).total_seconds()
            )
        )

        if len(
            candidates
        ) > 1:

            first_distance = abs(
                (
                    candidates[0].observed_at
                    - reference_time
                ).total_seconds()
            )

            second_distance = abs(
                (
                    candidates[1].observed_at
                    - reference_time
                ).total_seconds()
            )

            if (
                first_distance
                == second_distance
            ):
                raise HistoricalEvidenceAmbiguousError(
                    "Historical observations are equally near "
                    "the requested Incident time"
                )

        return HistoricalObservationMatch(
            observation=candidates[0],
            resource=expected_resource,
            namespace=expected_namespace,
            cluster=expected_cluster,
        )

    @staticmethod
    def _observation_scope_matches(
        *,
        observation: RealIncidentObservation,
        resource: str,
        namespace: str,
        cluster: str | None,
    ) -> bool:

        metadata = observation.metadata

        if not isinstance(
            metadata,
            Mapping,
        ):
            return True

        metadata_resource = (
            metadata.get(
                "resource"
            )
            or metadata.get(
                "pod"
            )
        )

        if (
            metadata_resource is not None
            and metadata_resource != resource
        ):
            return False

        metadata_namespace = (
            metadata.get(
                "namespace"
            )
        )

        if (
            metadata_namespace is not None
            and metadata_namespace
            != namespace
        ):
            return False

        metadata_cluster = (
            metadata.get(
                "cluster"
            )
        )

        if (
            metadata_cluster is not None
            and metadata_cluster
            != cluster
        ):
            return False

        return True

    def _parse_query_time(
        self,
        value: Any,
    ) -> datetime:

        if value is None:
            return self.event_time

        if isinstance(
            value,
            datetime,
        ):
            return self._aware_utc(
                value,
                name="query time",
            )

        if (
            isinstance(
                value,
                bool,
            )
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query time is invalid"
            )

        if isinstance(
            value,
            (
                int,
                float,
            ),
        ):
            try:
                return datetime.fromtimestamp(
                    float(
                        value
                    ),
                    tz=UTC,
                )
            except (
                OverflowError,
                OSError,
                ValueError,
            ) as exc:
                raise HistoricalEvidenceReplayError(
                    "Historical Prometheus query time is invalid"
                ) from exc

        if isinstance(
            value,
            str,
        ):
            text = value.strip()

            if text.endswith(
                "Z"
            ):
                text = (
                    f"{text[:-1]}+00:00"
                )

            try:
                parsed = (
                    datetime.fromisoformat(
                        text
                    )
                )
            except ValueError as exc:
                raise HistoricalEvidenceReplayError(
                    "Historical Prometheus query time is invalid"
                ) from exc

            return self._aware_utc(
                parsed,
                name="query time",
            )

        raise HistoricalEvidenceReplayError(
            "Historical Prometheus query time is invalid"
        )

    @staticmethod
    def _required_text(
        value: Any,
        name: str,
    ) -> str:

        if not isinstance(
            value,
            str,
        ):
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} is invalid"
            )

        normalized = value.strip()

        if not normalized:
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} is invalid"
            )

        return normalized

    @staticmethod
    def _aware_utc(
        value: datetime,
        *,
        name: str,
    ) -> datetime:

        if (
            not isinstance(
                value,
                datetime,
            )
            or value.tzinfo is None
        ):
            raise HistoricalEvidenceReplayError(
                f"Historical replay {name} must be timezone-aware"
            )

        return value.astimezone(
            UTC
        )

    @staticmethod
    def _escape_label(
        value: str,
    ) -> str:
        return (
            value
            .replace(
                "\\",
                "\\\\",
            )
            .replace(
                "\n",
                "\\n",
            )
            .replace(
                "\r",
                "\\r",
            )
            .replace(
                '"',
                '\\"',
            )
        )


class HistoricalKubernetesReplayTool(
    BaseTool
):
    """
    Historical replacement for the Runtime "kubernetes" Tool contract.

    It does not call Kubernetes.

    It returns a bounded Pod-state envelope reconstructed exclusively from
    RealIncidentReplaySource observations.
    """

    _READ_ONLY_ACTIONS = {
        "describe",
        "get",
    }

    _POD_RESOURCES = {
        "pod",
        "pods",
    }

    def __init__(
        self,
        store: RealIncidentObservationStore,
    ) -> None:
        self.store = store

    @property
    def name(
        self,
    ) -> str:
        return "kubernetes"

    async def execute(
        self,
        action: str,
        resource: str,
        target: str,
        namespace: str = "default",
        **kwargs: Any,
    ) -> dict[str, Any]:

        normalized_action = self._normalize_text(
            action
        ).lower()

        normalized_resource = self._normalize_text(
            resource
        ).lower()

        if (
            normalized_action
            not in self._READ_ONLY_ACTIONS
        ):
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Kubernetes operation is not read-only"
            )

        if (
            normalized_resource
            not in self._POD_RESOURCES
        ):
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Kubernetes replay supports Pods only"
            )

        match = (
            self.store.select_kubernetes_pod_state(
                target=self._normalize_text(
                    target
                ),
                namespace=self._normalize_text(
                    namespace
                ),
            )
        )

        data = self._bounded_pod_data(
            match.observation.data
        )

        return {
            "success": True,
            "source": "kubernetes",
            "mode": "read_only",
            "production_signal": (
                match.observation.production_signal
            ),
            "observed_at": (
                match.observation
                .observed_at
                .isoformat()
            ),
            "action": normalized_action,
            "resource": "pod",
            "target": match.resource,
            "namespace": match.namespace,
            "cluster": match.cluster,
            "data": data,
        }

    @classmethod
    def _bounded_pod_data(
        cls,
        value: Any,
    ) -> dict[str, Any]:

        if not isinstance(
            value,
            Mapping,
        ):
            raise HistoricalReplayObservationError(
                "Historical Kubernetes observation data is invalid"
            )

        if "phase" not in value:
            raise HistoricalReplayObservationError(
                "Historical Kubernetes phase is missing"
            )

        containers_value = value.get(
            "containers",
            [],
        )

        if not isinstance(
            containers_value,
            list,
        ):
            raise HistoricalReplayObservationError(
                "Historical Kubernetes containers are invalid"
            )

        containers = []

        for item in containers_value[:32]:

            if not isinstance(
                item,
                Mapping,
            ):
                continue

            restart_count = (
                item.get(
                    "restart_count"
                )
            )

            if (
                isinstance(
                    restart_count,
                    bool,
                )
                or not isinstance(
                    restart_count,
                    int,
                )
            ):
                restart_count = None

            containers.append(
                {
                    "restart_count": (
                        restart_count
                    ),
                    "state_reason": (
                        cls._bounded_scalar_text(
                            item.get(
                                "state_reason"
                            )
                        )
                    ),
                    "last_termination_reason": (
                        cls._bounded_scalar_text(
                            item.get(
                                "last_termination_reason"
                            )
                        )
                    ),
                }
            )

        return {
            "phase": cls._bounded_scalar_text(
                value.get(
                    "phase"
                )
            ),
            "ready": cls._optional_bool(
                value.get(
                    "ready"
                )
            ),
            "scheduled": cls._optional_bool(
                value.get(
                    "scheduled"
                )
            ),
            "oom_killed": cls._optional_bool(
                value.get(
                    "oom_killed"
                )
            ),
            "containers": containers,
        }

    @staticmethod
    def _normalize_text(
        value: Any,
    ) -> str:

        if not isinstance(
            value,
            str,
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Kubernetes argument is invalid"
            )

        normalized = value.strip()

        if not normalized:
            raise HistoricalEvidenceReplayError(
                "Historical Kubernetes argument is invalid"
            )

        return normalized

    @staticmethod
    def _bounded_scalar_text(
        value: Any,
    ) -> str | None:

        if value is None:
            return None

        if not isinstance(
            value,
            str,
        ):
            return str(
                value
            )[:256]

        return value[:256]

    @staticmethod
    def _optional_bool(
        value: Any,
    ) -> bool | None:

        if isinstance(
            value,
            bool,
        ):
            return value

        return None


class HistoricalPrometheusReplayTool(
    BaseTool
):
    """
    Historical replacement for the Runtime "prometheus" Tool contract.

    It accepts only the three PromQL templates already generated by
    ReadOnlyInvestigationProbeExecutor.

    No arbitrary metric or network query is executed.
    """

    _METRIC_TO_KIND = {
        "container_memory_working_set_bytes": (
            "memory_working_set"
        ),
        "kube_pod_container_resource_limits": (
            "memory_limit"
        ),
        "kube_pod_container_status_restarts_total": (
            "restart_count"
        ),
    }

    def __init__(
        self,
        store: RealIncidentObservationStore,
    ) -> None:
        self.store = store

    @property
    def name(
        self,
    ) -> str:
        return "prometheus"

    async def execute(
        self,
        query: str,
        time: Any = None,
        **kwargs: Any,
    ) -> dict[str, Any]:

        if (
            not isinstance(
                query,
                str,
            )
            or not query.strip()
        ):
            raise HistoricalEvidenceReplayError(
                "Historical Prometheus query is invalid"
            )

        kind = self._kind_from_query(
            query
        )

        match = self.store.select_prometheus(
            kind=kind,
            query=query,
            query_time=time,
        )

        numeric_value = (
            self._numeric_value(
                match.observation.data
            )
        )

        observed_at = (
            match.observation
            .observed_at
            .astimezone(
                UTC
            )
        )

        return {
            "success": True,
            "source": "prometheus",
            "mode": "read_only",
            "production_signal": (
                match.observation.production_signal
            ),
            "observed_at": (
                observed_at.isoformat()
            ),
            "query": query,
            "data": {
                "resultType": "vector",
                "result": [
                    {
                        "metric": {
                            "pod": (
                                match.resource
                            ),
                            "namespace": (
                                match.namespace
                            ),
                            **(
                                {
                                    "cluster": (
                                        match.cluster
                                    )
                                }
                                if match.cluster
                                else {}
                            ),
                        },
                        "value": [
                            observed_at.timestamp(),
                            str(
                                numeric_value
                            ),
                        ],
                    }
                ],
            },
        }

    @classmethod
    def _kind_from_query(
        cls,
        query: str,
    ) -> str:

        matches = [
            kind
            for metric, kind
            in cls._METRIC_TO_KIND.items()
            if metric in query
        ]

        if len(
            matches
        ) != 1:
            raise HistoricalReplayOperationNotAllowedError(
                "Historical Prometheus query is outside "
                "the Investigation probe allowlist"
            )

        return matches[0]

    @staticmethod
    def _numeric_value(
        value: Any,
    ) -> float:

        if not isinstance(
            value,
            Mapping,
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus observation data is invalid"
            )

        raw_value = value.get(
            "value"
        )

        if isinstance(
            raw_value,
            bool,
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            )

        try:
            numeric_value = float(
                raw_value
            )
        except (
            TypeError,
            ValueError,
        ) as exc:
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            ) from exc

        if not isfinite(
            numeric_value
        ):
            raise HistoricalReplayObservationError(
                "Historical Prometheus value is invalid"
            )

        return numeric_value


def create_historical_replay_tool_manager(
    source: RealIncidentReplaySource,
    *,
    selection_policy: (
        HistoricalObservationSelectionPolicy
        | None
    ) = None,
) -> ToolManager:
    """
    Create a ToolManager that satisfies the same Tool names consumed by
    ReadOnlyInvestigationProbeExecutor.

    "kubernetes" -> historical observation adapter
    "prometheus" -> historical observation adapter
    """

    store = RealIncidentObservationStore(
        source,
        selection_policy=selection_policy,
    )

    registry = ToolRegistry()

    registry.register(
        HistoricalKubernetesReplayTool(
            store
        )
    )

    registry.register(
        HistoricalPrometheusReplayTool(
            store
        )
    )

    return ToolManager(
        registry
    )


def create_historical_replay_probe_executor(
) -> ReadOnlyInvestigationProbeExecutor:
    """
    Use the existing Investigation probe executor unchanged, with only its
    temporal semantics changed from live-current-state to historical
    Incident-time evidence.
    """

    return ReadOnlyInvestigationProbeExecutor(
        time_policy=(
            HistoricalReplayEvidenceTimePolicy()
        )
    )


__all__ = [
    "HistoricalEvidenceAmbiguousError",
    "HistoricalEvidenceNotFoundError",
    "HistoricalEvidenceReplayError",
    "HistoricalKubernetesReplayTool",
    "HistoricalObservationSelectionPolicy",
    "HistoricalPrometheusReplayTool",
    "HistoricalReplayEvidenceTimePolicy",
    "HistoricalReplayObservationError",
    "HistoricalReplayOperationNotAllowedError",
    "RealIncidentObservationStore",
    "create_historical_replay_probe_executor",
    "create_historical_replay_tool_manager",
]
