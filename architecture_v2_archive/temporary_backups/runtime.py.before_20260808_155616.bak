from services.agent_runtime.app.registry.factory import (
    create_agent_registry,
)
from services.agent_runtime.app.planner.agent_planner import (
    AgentPlanner,
)
from services.agent_runtime.app.pipeline.planner_pipeline import (
    PlannerPipeline,
)
from services.agent_runtime.app.memory.store import (
    MemoryStore,
)
from services.agent_runtime.app.tools.factory import (
    create_tool_manager,
)
from services.agent_runtime.app.skills.factory import (
    create_skill_registry,
)
from services.agent_runtime.app.mcp.factory import (
    create_mcp_registry,
)
from services.agent_runtime.app.observability.collector import (
    TraceCollector,
)
from services.agent_runtime.app.evaluation.factory import (
    create_evaluation_registry,
)
from services.agent_runtime.app.policy.factory import (
    create_policy_engine,
)
from services.agent_runtime.app.approval.service import (
    ApprovalService,
)
from services.agent_runtime.app.incident.store import (
    IncidentStore,
)
from services.agent_runtime.app.incident.service import (
    IncidentService,
)

from services.agent_runtime.app.workflow.service import (
    WorkflowService,
)
from services.agent_runtime.app.action.execution_service import (
    ActionExecutionService,
)
from services.agent_runtime.app.action.execution_store import (
    ActionExecutionStore,
)
from services.agent_runtime.app.verification.collector import (
    VerificationEvidenceCollector,
)
from services.agent_runtime.app.verification.coordinator import (
    VerificationCoordinator,
)
from services.agent_runtime.app.verification.profiles import (
    VerificationProfileFactory,
)
from services.agent_runtime.app.verification.service import (
    VerificationService,
)
from services.agent_runtime.app.verification.store import (
    VerificationStore,
)
from services.agent_runtime.app.runtime.action_runtime import (
    ActionRuntime,
)
from services.agent_runtime.app.runtime.verification_runtime import (
    VerificationRuntime,
)
from services.sandbox.executor.local import (
    LocalSandboxExecutor,
)
from services.sandbox.policy.validator import (
    SandboxPolicyValidator,
)


class AgentRuntime:
    """
    Runtime container.

    Owns and shares runtime infrastructure
    across Pipeline, Action and Verification.
    """

    def __init__(self) -> None:
        self.memory = MemoryStore()
        self.tools = create_tool_manager()
        self.skills = create_skill_registry()
        self.mcp = create_mcp_registry()
        self.tracer = TraceCollector()
        self.evaluators = create_evaluation_registry()
        self.policy = create_policy_engine()
        self.approval = ApprovalService()

        self.incident_store = IncidentStore()

        self.incident_service = IncidentService(
            store=self.incident_store
        )

        self.workflow_service = WorkflowService(
            incident_service=self.incident_service
        )

        self.action_execution_store = ActionExecutionStore()

        self.action_execution_service = ActionExecutionService(
            store=self.action_execution_store
        )

        self.action_runtime = ActionRuntime(
            approval_service=self.approval,
            incident_store=self.incident_store,
            action_execution_service=self.action_execution_service,
        )

        self.verification_store = VerificationStore()

        self.verification = VerificationService(
            store=self.verification_store
        )

        self.verification_runtime = VerificationRuntime(
            verification_service=self.verification,
            incident_store=self.incident_store,
        )

        self.verification_profile_factory = VerificationProfileFactory()

        self.verification_collector = VerificationEvidenceCollector(
            tools=self.tools
        )

        self.verification_coordinator = VerificationCoordinator(
            profile_factory=self.verification_profile_factory,
            collector=self.verification_collector,
            verification_runtime=self.verification_runtime,
        )

        self.sandbox = LocalSandboxExecutor()

        self.sandbox_policy = SandboxPolicyValidator()

        self.registry = create_agent_registry()

        self.planner = AgentPlanner()

        self.pipeline = PlannerPipeline(
            self.registry,
            self.planner,
            self.tracer,
            self.evaluators,
            incident_store=self.incident_store,
            incident_service=self.incident_service,
            workflow_service=self.workflow_service,
        )

