from __future__ import annotations

import asyncio
import sqlite3

from dataclasses import dataclass
from pathlib import Path
from uuid import UUID

from services.agent_runtime.app.action.execution_models import (
    ActionExecutionReconciliationDecision,
    ActionExecutionRecord,
    ActionExecutionStatus,
)


class ActionExecutionConflictError(RuntimeError):
    """
    Raised when an execution claim or lifecycle update conflicts.
    """


@dataclass(frozen=True, slots=True)
class ActionExecutionClaimResult:
    """
    Result of atomically claiming an approved action for execution.

    created=True means the caller owns the only automatic launch permitted
    for this approval. created=False is an idempotent replay and the caller
    must return the persisted record without invoking the executor again.
    """

    execution: ActionExecutionRecord
    created: bool

    @property
    def is_replay(
        self,
    ) -> bool:
        return not self.created


@dataclass(frozen=True, slots=True)
class ActionExecutionReconciliationResult:
    """
    Result of atomically reconciling an INDETERMINATE execution.

    applied=True means this caller persisted the only reconciliation
    transition. applied=False means the same idempotent request was already
    persisted and the caller received that existing record.
    """

    execution: ActionExecutionRecord
    applied: bool

    @property
    def is_replay(
        self,
    ) -> bool:
        return not self.applied


class ActionExecutionStore:
    """
    SQLite-backed action execution claim and outcome store.

    Safety guarantees provided by this store:

    - approval_id is unique;
    - idempotency_key is unique and independent from approval decisions;
    - BEGIN IMMEDIATE serializes competing claims across store instances;
    - an exact claim replay returns the existing record;
    - a conflicting replay fails closed;
    - lifecycle updates use compare-and-set status protection;
    - INDETERMINATE reconciliation uses compare-and-set protection;
    - exact reconciliation retries return the persisted audit record;
    - a persisted RUNNING or INDETERMINATE record never grants a new launch.

    These guarantees prevent duplicate automatic launches by this runtime.
    Exactly-once external side effects still require the executor or target
    system to honor the same execution idempotency key.
    """

    def __init__(
        self,
        db_path: str | Path | None = None,
    ) -> None:
        self.db_path = Path(
            db_path
            or (
                Path("data")
                / "action_executions.db"
            )
        )

        self.db_path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        self._init_db()

    def _connect(
        self,
    ) -> sqlite3.Connection:
        connection = sqlite3.connect(
            self.db_path,
            timeout=10.0,
        )

        connection.execute(
            "PRAGMA busy_timeout = 10000"
        )

        return connection

    def _init_db(
        self,
    ) -> None:
        with self._connect() as connection:
            connection.execute(
                "PRAGMA journal_mode = WAL"
            )

            connection.execute(
                "PRAGMA synchronous = FULL"
            )

            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS action_executions
                (
                    id TEXT PRIMARY KEY,

                    approval_id TEXT NOT NULL UNIQUE,

                    incident_id TEXT,

                    idempotency_key TEXT NOT NULL UNIQUE,

                    status TEXT NOT NULL,

                    execution_data TEXT NOT NULL,

                    created_at TEXT NOT NULL,

                    started_at TEXT NOT NULL,

                    updated_at TEXT NOT NULL,

                    completed_at TEXT
                )
                """
            )

            connection.execute(
                """
                CREATE INDEX IF NOT EXISTS
                    idx_action_executions_incident_id

                ON action_executions
                (
                    incident_id
                )
                """
            )

            connection.execute(
                """
                CREATE INDEX IF NOT EXISTS
                    idx_action_executions_status

                ON action_executions
                (
                    status
                )
                """
            )

    async def claim(
        self,
        execution: ActionExecutionRecord,
    ) -> ActionExecutionClaimResult:
        """
        Atomically claim the only automatic launch for an approval.

        An exact replay returns created=False. Every other collision raises
        ActionExecutionConflictError.
        """

        return await asyncio.to_thread(
            self._claim_sync,
            execution,
        )

    def _claim_sync(
        self,
        execution: ActionExecutionRecord,
    ) -> ActionExecutionClaimResult:
        self._validate_new_claim(
            execution
        )

        connection = self._connect()

        try:
            connection.execute(
                "BEGIN IMMEDIATE"
            )

            approval_row = connection.execute(
                """
                SELECT id, execution_data

                FROM action_executions

                WHERE approval_id = ?
                """,
                (
                    execution.approval_id,
                ),
            ).fetchone()

            key_row = connection.execute(
                """
                SELECT id, execution_data

                FROM action_executions

                WHERE idempotency_key = ?
                """,
                (
                    execution.idempotency_key,
                ),
            ).fetchone()

            if approval_row is None and key_row is None:
                execution_data = self._serialize(
                    execution
                )

                try:
                    connection.execute(
                        """
                        INSERT INTO action_executions
                        (
                            id,
                            approval_id,
                            incident_id,
                            idempotency_key,
                            status,
                            execution_data,
                            created_at,
                            started_at,
                            updated_at,
                            completed_at
                        )

                        VALUES
                        (
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?,
                            ?
                        )
                        """,
                        (
                            str(execution.id),
                            execution.approval_id,
                            self._incident_id_value(
                                execution
                            ),
                            execution.idempotency_key,
                            self._status_value(
                                execution.status
                            ),
                            execution_data,
                            execution.created_at.isoformat(),
                            execution.started_at.isoformat(),
                            execution.updated_at.isoformat(),
                            self._completed_at_value(
                                execution
                            ),
                        ),
                    )

                except sqlite3.IntegrityError as exc:
                    raise ActionExecutionConflictError(
                        "Action execution claim conflicts with "
                        "an existing execution"
                    ) from exc

                connection.commit()

                return ActionExecutionClaimResult(
                    execution=self._deserialize(
                        execution_data
                    ),
                    created=True,
                )

            existing = self._resolve_existing_claim(
                approval_row=approval_row,
                key_row=key_row,
            )

            if not self._same_claim(
                existing,
                execution,
            ):
                raise ActionExecutionConflictError(
                    "Action execution idempotency conflict: "
                    "the approval or idempotency key is already "
                    "bound to a different execution request"
                )

            connection.commit()

            return ActionExecutionClaimResult(
                execution=existing,
                created=False,
            )

        except Exception:
            connection.rollback()
            raise

        finally:
            connection.close()

    async def get(
        self,
        execution_id: str,
    ) -> ActionExecutionRecord | None:
        return await asyncio.to_thread(
            self._get_by_column_sync,
            "id",
            execution_id,
        )

    async def get_by_approval(
        self,
        approval_id: str,
    ) -> ActionExecutionRecord | None:
        return await asyncio.to_thread(
            self._get_by_column_sync,
            "approval_id",
            approval_id,
        )

    async def get_by_idempotency_key(
        self,
        idempotency_key: str,
    ) -> ActionExecutionRecord | None:
        return await asyncio.to_thread(
            self._get_by_column_sync,
            "idempotency_key",
            idempotency_key,
        )

    def _get_by_column_sync(
        self,
        column: str,
        value: str,
    ) -> ActionExecutionRecord | None:
        allowed_columns = {
            "id",
            "approval_id",
            "idempotency_key",
        }

        if column not in allowed_columns:
            raise ValueError(
                "Unsupported action execution lookup column"
            )

        with self._connect() as connection:
            row = connection.execute(
                f"""
                SELECT execution_data

                FROM action_executions

                WHERE {column} = ?
                """,
                (
                    value,
                ),
            ).fetchone()

        if row is None:
            return None

        return self._deserialize(
            row[0]
        )

    async def update(
        self,
        execution: ActionExecutionRecord,
        expected_status: ActionExecutionStatus,
    ) -> ActionExecutionRecord:
        """
        Persist one valid lifecycle transition using status CAS.

        Replaying the exact already-persisted record is idempotent. A stale
        or different update fails closed.
        """

        return await asyncio.to_thread(
            self._update_sync,
            execution,
            expected_status,
        )

    def _update_sync(
        self,
        execution: ActionExecutionRecord,
        expected_status: ActionExecutionStatus,
    ) -> ActionExecutionRecord:
        connection = self._connect()

        try:
            connection.execute(
                "BEGIN IMMEDIATE"
            )

            row = connection.execute(
                """
                SELECT execution_data

                FROM action_executions

                WHERE id = ?
                """,
                (
                    str(execution.id),
                ),
            ).fetchone()

            if row is None:
                raise ValueError(
                    "Action execution not found: "
                    f"{execution.id}"
                )

            current = self._deserialize(
                row[0]
            )

            if current == execution:
                connection.commit()
                return current

            self._validate_immutable_fields(
                current=current,
                updated=execution,
            )

            if current.status != expected_status:
                raise ActionExecutionConflictError(
                    "Action execution status conflict for "
                    f"{execution.id}: expected "
                    f"{self._status_value(expected_status)}, "
                    "found "
                    f"{self._status_value(current.status)}"
                )

            self._validate_transition(
                current=current.status,
                updated=execution.status,
            )

            execution_data = self._serialize(
                execution
            )

            cursor = connection.execute(
                """
                UPDATE action_executions

                SET
                    incident_id = ?,
                    status = ?,
                    execution_data = ?,
                    updated_at = ?,
                    completed_at = ?

                WHERE id = ?
                    AND status = ?
                """,
                (
                    self._incident_id_value(
                        execution
                    ),
                    self._status_value(
                        execution.status
                    ),
                    execution_data,
                    execution.updated_at.isoformat(),
                    self._completed_at_value(
                        execution
                    ),
                    str(execution.id),
                    self._status_value(
                        expected_status
                    ),
                ),
            )

            if cursor.rowcount != 1:
                raise ActionExecutionConflictError(
                    "Action execution compare-and-set failed: "
                    f"{execution.id}"
                )

            connection.commit()

            return self._deserialize(
                execution_data
            )

        except Exception:
            connection.rollback()
            raise

        finally:
            connection.close()

    async def mark_indeterminate(
        self,
        execution_id: str,
        reason: str,
    ) -> ActionExecutionRecord:
        """
        Explicitly freeze a RUNNING claim for reconciliation.

        This method is intentionally explicit. A new process must not mark all
        RUNNING rows indeterminate automatically because another runtime
        instance may still own an active executor call.
        """

        current = await self.get(
            execution_id
        )

        if current is None:
            raise ValueError(
                "Action execution not found: "
                f"{execution_id}"
            )

        if (
            current.status
            == ActionExecutionStatus.INDETERMINATE
        ):
            return current

        if (
            current.status
            != ActionExecutionStatus.RUNNING
        ):
            raise ActionExecutionConflictError(
                "Only a running action execution can be "
                "marked indeterminate"
            )

        current.mark_indeterminate(
            reason
        )

        try:
            return await self.update(
                current,
                expected_status=(
                    ActionExecutionStatus.RUNNING
                ),
            )

        except ActionExecutionConflictError:
            refreshed = await self.get(
                execution_id
            )

            if (
                refreshed is not None
                and refreshed.status
                == ActionExecutionStatus.INDETERMINATE
            ):
                return refreshed

            raise

    async def reconcile(
        self,
        execution_id: UUID | str,
        decision: (
            ActionExecutionReconciliationDecision
        ),
    ) -> ActionExecutionReconciliationResult:
        """
        Atomically resolve one INDETERMINATE execution.

        This method never invokes the external Action executor. It only
        persists an operator-confirmed outcome using an
        INDETERMINATE-status compare-and-set transition.

        A retry with the same idempotency key and immutable decision payload
        returns the persisted record with applied=False. A reused key with a
        different payload, a second decision key, or a non-INDETERMINATE
        execution fails closed.
        """

        current = await self.get(
            str(
                execution_id
            )
        )

        if current is None:
            raise ValueError(
                "Action execution not found: "
                f"{execution_id}"
            )

        if current.reconciliation is not None:
            return self._resolve_reconciliation_replay(
                current=current,
                incoming=decision,
            )

        if (
            current.status
            != ActionExecutionStatus.INDETERMINATE
        ):
            raise ActionExecutionConflictError(
                "Only an indeterminate action execution "
                "can be reconciled"
            )

        updated = current.model_copy(
            deep=True
        )
        updated.reconcile(
            decision
        )

        try:
            persisted = await self.update(
                updated,
                expected_status=(
                    ActionExecutionStatus.INDETERMINATE
                ),
            )

            return ActionExecutionReconciliationResult(
                execution=persisted,
                applied=True,
            )

        except ActionExecutionConflictError:
            refreshed = await self.get(
                str(
                    execution_id
                )
            )

            if (
                refreshed is not None
                and refreshed.reconciliation
                is not None
            ):
                return self._resolve_reconciliation_replay(
                    current=refreshed,
                    incoming=decision,
                )

            raise

    async def list_by_status(
        self,
        status: ActionExecutionStatus,
    ) -> list[ActionExecutionRecord]:
        return await asyncio.to_thread(
            self._list_by_status_sync,
            status,
        )

    def _list_by_status_sync(
        self,
        status: ActionExecutionStatus,
    ) -> list[ActionExecutionRecord]:
        with self._connect() as connection:
            rows = connection.execute(
                """
                SELECT execution_data

                FROM action_executions

                WHERE status = ?

                ORDER BY created_at ASC
                """,
                (
                    self._status_value(
                        status
                    ),
                ),
            ).fetchall()

        return [
            self._deserialize(
                row[0]
            )
            for row in rows
        ]

    async def list_by_incident(
        self,
        incident_id: UUID | str,
    ) -> list[ActionExecutionRecord]:
        """
        Return every Action Execution linked to one Incident.

        An Incident may contain several remediation attempts. The stable
        chronological order preserves the full history for higher-level
        Workflow aggregation.
        """

        return await asyncio.to_thread(
            self._list_by_incident_sync,
            incident_id,
        )

    def _list_by_incident_sync(
        self,
        incident_id: UUID | str,
    ) -> list[ActionExecutionRecord]:
        with self._connect() as connection:
            rows = connection.execute(
                """
                SELECT execution_data

                FROM action_executions

                WHERE incident_id = ?

                ORDER BY created_at ASC, id ASC
                """,
                (
                    str(
                        incident_id
                    ),
                ),
            ).fetchall()

        return [
            self._deserialize(
                row[0]
            )
            for row in rows
        ]

    async def list_all(
        self,
    ) -> list[ActionExecutionRecord]:
        return await asyncio.to_thread(
            self._list_all_sync
        )

    def _list_all_sync(
        self,
    ) -> list[ActionExecutionRecord]:
        with self._connect() as connection:
            rows = connection.execute(
                """
                SELECT execution_data

                FROM action_executions

                ORDER BY created_at ASC
                """
            ).fetchall()

        return [
            self._deserialize(
                row[0]
            )
            for row in rows
        ]

    @staticmethod
    def _resolve_existing_claim(
        approval_row: tuple[str, str] | None,
        key_row: tuple[str, str] | None,
    ) -> ActionExecutionRecord:
        if approval_row is None or key_row is None:
            raise ActionExecutionConflictError(
                "The approval or idempotency key is already "
                "bound to a different execution"
            )

        if approval_row[0] != key_row[0]:
            raise ActionExecutionConflictError(
                "The approval and idempotency key belong to "
                "different executions"
            )

        return ActionExecutionStore._deserialize(
            approval_row[1]
        )

    @staticmethod
    def _validate_new_claim(
        execution: ActionExecutionRecord,
    ) -> None:
        if (
            execution.status
            != ActionExecutionStatus.RUNNING
        ):
            raise ValueError(
                "New action execution claim must be running"
            )

        if execution.completed_at is not None:
            raise ValueError(
                "New action execution claim cannot be completed"
            )

        if execution.result:
            raise ValueError(
                "New action execution claim cannot contain a result"
            )

        if (
            execution.error_type is not None
            or execution.error_message is not None
        ):
            raise ValueError(
                "New action execution claim cannot contain an error"
            )

        if execution.action.approved is not True:
            raise ValueError(
                "Action execution requires an approved ActionPlan"
            )

    @staticmethod
    def _same_claim(
        existing: ActionExecutionRecord,
        incoming: ActionExecutionRecord,
    ) -> bool:
        return (
            existing.approval_id
            == incoming.approval_id
            and existing.incident_id
            == incoming.incident_id
            and existing.operator_id
            == incoming.operator_id
            and existing.idempotency_key
            == incoming.idempotency_key
            and existing.action
            == incoming.action
            and existing.metadata
            == incoming.metadata
        )

    @staticmethod
    def _same_reconciliation_request(
        existing: (
            ActionExecutionReconciliationDecision
        ),
        incoming: (
            ActionExecutionReconciliationDecision
        ),
    ) -> bool:
        """
        Compare the immutable request while ignoring server decision time.

        A client retry naturally constructs a new reconciled_at timestamp.
        The persisted timestamp remains authoritative when every request
        field and the reconciliation idempotency key are unchanged.
        """

        return (
            existing.outcome
            == incoming.outcome
            and existing.operator_id
            == incoming.operator_id
            and existing.idempotency_key
            == incoming.idempotency_key
            and existing.reason
            == incoming.reason
            and existing.result
            == incoming.result
            and existing.error_type
            == incoming.error_type
            and existing.error_message
            == incoming.error_message
            and existing.metadata
            == incoming.metadata
        )

    @classmethod
    def _resolve_reconciliation_replay(
        cls,
        *,
        current: ActionExecutionRecord,
        incoming: (
            ActionExecutionReconciliationDecision
        ),
    ) -> ActionExecutionReconciliationResult:
        existing = current.reconciliation

        if existing is None:
            raise ActionExecutionConflictError(
                "Action execution reconciliation state "
                "changed concurrently"
            )

        if cls._same_reconciliation_request(
            existing,
            incoming,
        ):
            return ActionExecutionReconciliationResult(
                execution=current,
                applied=False,
            )

        if (
            existing.idempotency_key
            == incoming.idempotency_key
        ):
            raise ActionExecutionConflictError(
                "Reconciliation idempotency key was reused "
                "with a different decision"
            )

        raise ActionExecutionConflictError(
            "Action execution was already reconciled "
            "by another decision"
        )

    @staticmethod
    def _validate_immutable_fields(
        current: ActionExecutionRecord,
        updated: ActionExecutionRecord,
    ) -> None:
        immutable_fields = (
            "id",
            "approval_id",
            "incident_id",
            "operator_id",
            "idempotency_key",
            "action",
            "created_at",
            "started_at",
        )

        changed_fields = [
            field_name
            for field_name in immutable_fields
            if getattr(current, field_name)
            != getattr(updated, field_name)
        ]

        if changed_fields:
            raise ActionExecutionConflictError(
                "Immutable action execution fields changed: "
                + ", ".join(changed_fields)
            )

    @staticmethod
    def _validate_transition(
        current: ActionExecutionStatus,
        updated: ActionExecutionStatus,
    ) -> None:
        allowed_transitions = {
            ActionExecutionStatus.RUNNING: {
                ActionExecutionStatus.SUCCEEDED,
                ActionExecutionStatus.FAILED,
                ActionExecutionStatus.INDETERMINATE,
            },
            ActionExecutionStatus.INDETERMINATE: {
                ActionExecutionStatus.SUCCEEDED,
                ActionExecutionStatus.FAILED,
            },
        }

        allowed = allowed_transitions.get(
            current,
            set(),
        )

        if updated not in allowed:
            raise ActionExecutionConflictError(
                "Invalid action execution transition: "
                f"{ActionExecutionStore._status_value(current)} "
                "-> "
                f"{ActionExecutionStore._status_value(updated)}"
            )

    @staticmethod
    def _serialize(
        execution: ActionExecutionRecord,
    ) -> str:
        return execution.model_dump_json()

    @staticmethod
    def _deserialize(
        execution_data: str,
    ) -> ActionExecutionRecord:
        return ActionExecutionRecord.model_validate_json(
            execution_data
        )

    @staticmethod
    def _status_value(
        status: ActionExecutionStatus | str,
    ) -> str:
        if isinstance(
            status,
            ActionExecutionStatus,
        ):
            return status.value

        return str(
            status
        )

    @staticmethod
    def _incident_id_value(
        execution: ActionExecutionRecord,
    ) -> str | None:
        if execution.incident_id is None:
            return None

        return str(
            execution.incident_id
        )

    @staticmethod
    def _completed_at_value(
        execution: ActionExecutionRecord,
    ) -> str | None:
        if execution.completed_at is None:
            return None

        return execution.completed_at.isoformat()
