from services.agent_runtime.app.llm.gateway.models import (
    LLMGatewayRequest,
    LLMGatewayResponse,
    LLMPriority,
    LLMTaskType,
)


MAX_INVESTIGATION_PROMPT_CHARS = 65_536
MAX_INVESTIGATION_SYSTEM_PROMPT_CHARS = 4_096
MAX_INVESTIGATION_RESPONSE_CHARS = 32_768


class InvestigationLLMAdapterError(RuntimeError):
    """
    Sanitized Investigation LLM adapter failure.
    """


class InvestigationLLMPolicyError(
    InvestigationLLMAdapterError
):
    """
    The request violated the bounded Investigation LLM contract.
    """


class InvestigationLLMUnavailableError(
    InvestigationLLMAdapterError
):
    """
    The shared LLM Gateway could not return a bounded response.
    """


class InvestigationLLMGatewayAdapter:
    """
    Narrow read-only adapter over the shared Runtime LLM Gateway.

    It accepts only Investigation analysis requests with deterministic JSON
    output. Provider overrides, model overrides and unbounded prompts are
    rejected before the shared Gateway is called.
    """

    def __init__(self, llm_gateway) -> None:
        if llm_gateway is None or not callable(
            getattr(llm_gateway, "chat", None)
        ):
            raise TypeError(
                "Shared Investigation LLM gateway is invalid"
            )

        self.llm_gateway = llm_gateway

    async def chat(
        self,
        request: LLMGatewayRequest,
    ) -> LLMGatewayResponse:
        self._validate_request(request)

        try:
            response = await self.llm_gateway.chat(
                request
            )
        except Exception:
            raise InvestigationLLMUnavailableError(
                "Shared Investigation LLM gateway is unavailable"
            ) from None

        if not isinstance(
            response,
            LLMGatewayResponse,
        ):
            raise InvestigationLLMUnavailableError(
                "Shared Investigation LLM gateway returned an invalid response"
            )

        if len(response.content) > (
            MAX_INVESTIGATION_RESPONSE_CHARS
        ):
            raise InvestigationLLMUnavailableError(
                "Shared Investigation LLM gateway response exceeded the limit"
            )

        return response

    @staticmethod
    def _validate_request(
        request: LLMGatewayRequest,
    ) -> None:
        if not isinstance(
            request,
            LLMGatewayRequest,
        ):
            raise InvestigationLLMPolicyError(
                "Investigation LLM request is invalid"
            )

        context = request.context

        if context.agent != "investigation":
            raise InvestigationLLMPolicyError(
                "Investigation LLM caller is invalid"
            )

        if context.task != LLMTaskType.ANALYSIS:
            raise InvestigationLLMPolicyError(
                "Investigation LLM task is invalid"
            )

        if context.priority != LLMPriority.HIGH:
            raise InvestigationLLMPolicyError(
                "Investigation LLM priority is invalid"
            )

        if context.require_json is not True:
            raise InvestigationLLMPolicyError(
                "Investigation LLM requires JSON"
            )

        if (
            context.preferred_provider is not None
            or context.preferred_model is not None
        ):
            raise InvestigationLLMPolicyError(
                "Investigation LLM overrides are forbidden"
            )

        if request.temperature != 0.0:
            raise InvestigationLLMPolicyError(
                "Investigation LLM must be deterministic"
            )

        if len(request.prompt) > (
            MAX_INVESTIGATION_PROMPT_CHARS
        ):
            raise InvestigationLLMPolicyError(
                "Investigation LLM prompt exceeded the limit"
            )

        if len(request.system_prompt) > (
            MAX_INVESTIGATION_SYSTEM_PROMPT_CHARS
        ):
            raise InvestigationLLMPolicyError(
                "Investigation LLM system prompt exceeded the limit"
            )
