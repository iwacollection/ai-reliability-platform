from time import perf_counter

import asyncio


from services.agent_runtime.app.llm.client import (
    LLMClient,
)

from services.agent_runtime.app.llm.models import (
    ChatRequest,
    ChatResponse,
)



class LLMExecutionError(
    Exception
):
    """
    LLM execution failed.
    """



class LLMExecutor:
    """
    Reliable LLM execution layer.

    Responsibilities:

    - timeout control
    - retry execution
    - latency measurement
    - exception normalization


    Not responsible:

    - provider routing
    - provider selection
    - fallback decision

    """



    def __init__(
        self,
        retry_attempts: int = 3,
        timeout: int = 30,
    ) -> None:


        self.retry_attempts = (
            retry_attempts
        )


        self.timeout = (
            timeout
        )



    async def execute(
        self,
        client: LLMClient,
        request: ChatRequest,
    ) -> ChatResponse:
        """
        Execute LLM request safely.
        """


        last_error = None



        for attempt in range(
            self.retry_attempts
        ):


            start = perf_counter()


            try:


                response = await asyncio.wait_for(

                    client.chat(
                        request
                    ),

                    timeout=self.timeout,

                )


                duration_ms = round(

                    (
                        perf_counter()
                        -
                        start
                    )
                    *
                    1000,

                    4,

                )


                return response



            except Exception as exc:


                last_error = exc


                print(
                    "LLM execution failed",
                    {
                        "attempt": attempt + 1,
                        "error": str(exc),
                    }
                )


                if attempt < (
                    self.retry_attempts - 1
                ):


                    await asyncio.sleep(
                        0.5
                    )



        raise LLMExecutionError(

            f"LLM failed after "
            f"{self.retry_attempts} attempts: "
            f"{last_error}"

        )