import re
from collections.abc import Mapping
from datetime import UTC, datetime
from math import isfinite
from typing import Any

from services.agent_runtime.app.investigation.evidence_time import (
    InvestigationEvidenceTimeError,
    InvestigationEvidenceTimePolicy,
)
from services.agent_runtime.app.investigation.models import (
    EvidenceItem,
    InvestigationProbe,
    InvestigationScope,
    default_investigation_probes,
)


class InvestigationProbeError(RuntimeError):
    """
    Base error for the bounded read-only probe adapter.
    """


class InvestigationToolUnavailableError(
    InvestigationProbeError
):
    """
    Runtime ToolManager is unavailable.
    """


class InvestigationProbeResponseError(
    InvestigationProbeError
):
    """
    A read-only tool returned evidence that cannot cross the
    Investigation trust boundary.
    """


class ReadOnlyInvestigationProbeExecutor:
    """
    Translate symbolic Investigation probes into exact read-only tool calls.

    The reasoner selects only an InvestigationProbe enum value.

    This adapter owns:

    - fixed Kubernetes read-only actions;
    - fixed bounded previous-container log collection;
    - fixed Prometheus query templates;
    - provider/source validation;
    - read-only mode validation;
    - production-signal validation;
    - observed-at validation;
    - bounded evidence normalization.

    The reasoner cannot provide Kubernetes verbs, resource kinds, PromQL,
    URLs, credentials or raw tool arguments.
    """

    _TRUSTED_MODE = "read_only"
    _MAX_LOG_TOOL_CHARS = 4000
    _MAX_LOG_EVIDENCE_CHARS = 1800
    _MAX_LOG_LINES = 80

    def __init__(
        self,
        time_policy: (
            InvestigationEvidenceTimePolicy
            | None
        ) = None,
    ) -> None:
        self.time_policy = (
            time_policy
            if time_policy is not None
            else InvestigationEvidenceTimePolicy()
        )

    @staticmethod
    def available_probes(
        context,
    ) -> list[InvestigationProbe]:
        probes = default_investigation_probes()

        tools = getattr(
            context,
            "tools",
            None,
        )

        registry = getattr(
            tools,
            "registry",
            None,
        )

        getter = getattr(
            registry,
            "get",
            None,
        )

        if not callable(
            getter
        ):
            return probes

        try:
            change_tool = getter(
                "kubernetes_change"
            )
        except KeyError:
            return probes

        if (
            getattr(
                change_tool,
                "is_available",
                True,
            )
            is not True
        ):
            return probes

        probes.append(
            InvestigationProbe.KUBERNETES_WORKLOAD_CHANGE
        )

        probes.append(
            InvestigationProbe.KUBERNETES_CONFIG_CHANGE
        )

        return probes

    async def collect(
        self,
        context,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> EvidenceItem:
        tools = getattr(
            context,
            "tools",
            None,
        )

        if tools is None:
            raise InvestigationToolUnavailableError(
                "Runtime tools are unavailable"
            )

        if (
            probe
            == InvestigationProbe.KUBERNETES_POD_STATE
        ):
            result = await tools.call(
                "kubernetes",
                context=context,
                action="describe",
                resource="pod",
                target=scope.resource,
                namespace=scope.namespace,
                cluster=scope.cluster,
            )

            return self._normalize_kubernetes(
                scope=scope,
                probe=probe,
                result=result,
            )

        if (
            probe
            == InvestigationProbe.KUBERNETES_PREVIOUS_CONTAINER_LOGS
        ):
            result = await tools.call(
                "kubernetes",
                context=context,
                action="previous_logs",
                resource="pod",
                target=scope.resource,
                namespace=scope.namespace,
                cluster=scope.cluster,
            )

            return self._normalize_kubernetes_logs(
                scope=scope,
                probe=probe,
                result=result,
            )

        if (
            probe
            == InvestigationProbe.KUBERNETES_WORKLOAD_CHANGE
        ):
            result = await tools.call(
                "kubernetes_change",
                context=context,
                target=scope.resource,
                namespace=scope.namespace,
                cluster=scope.cluster,
                incident_time=(
                    scope.event_occurred_at.isoformat()
                    if scope.event_occurred_at
                    is not None
                    else None
                ),
                view="workload",
            )

            return self._normalize_kubernetes_change(
                scope=scope,
                probe=probe,
                result=result,
            )

        if (
            probe
            == InvestigationProbe.KUBERNETES_CONFIG_CHANGE
        ):
            result = await tools.call(
                "kubernetes_change",
                context=context,
                target=scope.resource,
                namespace=scope.namespace,
                cluster=scope.cluster,
                incident_time=(
                    scope.event_occurred_at.isoformat()
                    if scope.event_occurred_at
                    is not None
                    else None
                ),
                view="config",
            )

            return self._normalize_kubernetes_config_change(
                scope=scope,
                probe=probe,
                result=result,
            )

        query = self._prometheus_query(
            scope=scope,
            probe=probe,
        )

        query_time = self.time_policy.query_time(
            scope=scope,
            probe=probe,
        )

        call_arguments = {
            "query": query,
        }

        if query_time is not None:
            call_arguments["time"] = (
                query_time
            )

        result = await tools.call(
            "prometheus",
            context=context,
            **call_arguments,
        )

        return self._normalize_prometheus(
            scope=scope,
            probe=probe,
            result=result,
        )

    @classmethod
    def _prometheus_query(
        cls,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> str:
        labels = [
            (
                'pod="'
                f'{cls._escape_label(scope.resource)}'
                '"'
            ),
            (
                'namespace="'
                f'{cls._escape_label(scope.namespace)}'
                '"'
            ),
        ]

        if scope.cluster:
            labels.append(
                'cluster="'
                f'{cls._escape_label(scope.cluster)}'
                '"'
            )

        selector = ",".join(
            labels
        )

        if (
            probe
            == InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET
        ):
            return (
                "sum(container_memory_working_set_bytes{"
                f'{selector},container!="POD",container!="",image!=""'
                "})"
            )

        if (
            probe
            == InvestigationProbe.PROMETHEUS_MEMORY_LIMIT
        ):
            return (
                "sum(kube_pod_container_resource_limits{"
                f'{selector},resource="memory",unit="byte"'
                "})"
            )

        if (
            probe
            == InvestigationProbe.PROMETHEUS_RESTART_COUNT
        ):
            return (
                "sum(kube_pod_container_status_restarts_total{"
                f"{selector}"
                "})"
            )

        raise InvestigationProbeError(
            "Unsupported investigation probe"
        )

    def _normalize_kubernetes(
        self,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        data, observed_at = (
            self._validate_tool_evidence(
                result=result,
                expected_source="kubernetes",
            )
        )

        if "phase" not in data:
            raise InvestigationProbeResponseError(
                "Kubernetes evidence phase is missing"
            )

        containers = data.get(
            "containers"
        )

        if not isinstance(
            containers,
            list,
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes evidence containers are invalid"
            )

        restart_counts: list[int] = []
        state_reasons: set[str] = set()
        termination_reasons: set[str] = set()

        for container in containers[:32]:
            if not isinstance(
                container,
                Mapping,
            ):
                continue

            restart_count = container.get(
                "restart_count"
            )

            if isinstance(
                restart_count,
                int,
            ):
                restart_counts.append(
                    restart_count
                )

            state_reason = container.get(
                "state_reason"
            )

            if (
                isinstance(
                    state_reason,
                    str,
                )
                and state_reason
            ):
                state_reasons.add(
                    state_reason[:128]
                )

            termination_reason = container.get(
                "last_termination_reason"
            )

            if (
                isinstance(
                    termination_reason,
                    str,
                )
                and termination_reason
            ):
                termination_reasons.add(
                    termination_reason[:128]
                )

        facts = {
            "temporal_basis": (
                self.time_policy.temporal_basis(
                    scope=scope,
                    probe=probe,
                )
            ),
            "phase": cls_scalar(
                data.get("phase")
            ),
            "ready": cls_scalar(
                data.get("ready")
            ),
            "scheduled": cls_scalar(
                data.get("scheduled")
            ),
            "oom_killed": cls_scalar(
                data.get("oom_killed")
            ),
            "max_restart_count": (
                max(restart_counts)
                if restart_counts
                else None
            ),
            "state_reasons": (
                ",".join(
                    sorted(
                        state_reasons
                    )
                )
                if state_reasons
                else None
            ),
            "last_termination_reasons": (
                ",".join(
                    sorted(
                        termination_reasons
                    )
                )
                if termination_reasons
                else None
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="kubernetes",
            success=True,
            trusted=True,
            production_signal=True,
            reliability=1.0,
            observed_at=observed_at,
            facts=facts,
        )

    def _normalize_kubernetes_logs(
        self,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        data, observed_at = (
            self._validate_tool_evidence(
                result=result,
                expected_source="kubernetes",
            )
        )

        if (
            data.get(
                "previous"
            )
            is not True
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence is not previous-container output"
            )

        container_value = data.get(
            "container_name"
        )

        if not isinstance(
            container_value,
            str,
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence container is invalid"
            )

        container_name = (
            container_value
            .strip()
        )

        if (
            not container_name
            or len(
                container_name
            )
            > 128
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence container is invalid"
            )

        line_count = data.get(
            "line_count"
        )

        if (
            not isinstance(
                line_count,
                int,
            )
            or isinstance(
                line_count,
                bool,
            )
            or line_count < 0
            or line_count > self._MAX_LOG_LINES
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence line count is invalid"
            )

        truncated = data.get(
            "truncated"
        )

        if not isinstance(
            truncated,
            bool,
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence truncation flag is invalid"
            )

        redaction_count = data.get(
            "redaction_count"
        )

        if (
            not isinstance(
                redaction_count,
                int,
            )
            or isinstance(
                redaction_count,
                bool,
            )
            or redaction_count < 0
            or redaction_count > 10000
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence redaction count is invalid"
            )

        excerpt_value = data.get(
            "excerpt"
        )

        if not isinstance(
            excerpt_value,
            str,
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence excerpt is invalid"
            )

        if len(
            excerpt_value
        ) > self._MAX_LOG_TOOL_CHARS:
            raise InvestigationProbeResponseError(
                "Kubernetes log evidence excerpt is too large"
            )

        excerpt, local_redactions = (
            redact_log_excerpt(
                excerpt_value
            )
        )

        redaction_count = (
            redaction_count
            + local_redactions
        )

        evidence_truncated = (
            len(
                excerpt
            )
            > self._MAX_LOG_EVIDENCE_CHARS
        )

        if evidence_truncated:
            excerpt = excerpt[
                -self._MAX_LOG_EVIDENCE_CHARS:
            ]

        facts = {
            "temporal_basis": (
                self.time_policy.temporal_basis(
                    scope=scope,
                    probe=probe,
                )
            ),
            "container_name": container_name,
            "previous": True,
            "log_line_count": line_count,
            "tool_truncated": truncated,
            "evidence_truncated": (
                evidence_truncated
            ),
            "redaction_count": (
                redaction_count
            ),
            "log_excerpt": (
                excerpt
                if excerpt
                else None
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="kubernetes",
            success=True,
            trusted=True,
            production_signal=True,
            reliability=1.0,
            observed_at=observed_at,
            facts=facts,
        )

    def _normalize_kubernetes_config_change(
        self,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        data, observed_at = (
            self._validate_tool_evidence(
                result=result,
                expected_source="kubernetes_change",
            )
        )

        if (
            data.get(
                "owner_chain_verified"
            )
            is not True
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes config change owner chain is untrusted"
            )

        if (
            data.get(
                "workload_kind"
            )
            != "Deployment"
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes config change workload kind is unsupported"
            )

        if (
            data.get(
                "secret_content_queried"
            )
            is not False
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes config change must not query Secret content"
            )

        if (
            data.get(
                "configmap_content_exposed"
            )
            is not False
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes config change must not expose ConfigMap content"
            )

        metadata_status = data.get(
            "current_configmap_metadata_status"
        )

        if metadata_status not in {
            "complete",
            "partial",
            "unavailable",
            "not_applicable",
        }:
            raise InvestigationProbeResponseError(
                "Kubernetes config metadata status is invalid"
            )

        facts = {
            "temporal_basis": (
                "workload_template_config_change"
            ),
            "owner_chain_verified": True,
            "deployment_name": bounded_change_text(
                data.get(
                    "deployment_name"
                ),
                required=True,
            ),
            "revision_before": bounded_change_int(
                data.get(
                    "revision_before"
                )
            ),
            "revision_after": bounded_change_int(
                data.get(
                    "revision_after"
                )
            ),
            "configmap_refs_before": bounded_change_text(
                data.get(
                    "configmap_refs_before"
                ),
                required=False,
                max_length=1024,
            ),
            "configmap_refs_after": bounded_change_text(
                data.get(
                    "configmap_refs_after"
                ),
                required=False,
                max_length=1024,
            ),
            "configmap_refs_changed": bounded_change_bool(
                data.get(
                    "configmap_refs_changed"
                )
            ),
            "configmap_refs_added": bounded_change_text(
                data.get(
                    "configmap_refs_added"
                ),
                required=False,
                max_length=1024,
            ),
            "configmap_refs_removed": bounded_change_text(
                data.get(
                    "configmap_refs_removed"
                ),
                required=False,
                max_length=1024,
            ),
            "secret_refs_before": bounded_change_text(
                data.get(
                    "secret_refs_before"
                ),
                required=False,
                max_length=1024,
            ),
            "secret_refs_after": bounded_change_text(
                data.get(
                    "secret_refs_after"
                ),
                required=False,
                max_length=1024,
            ),
            "secret_refs_changed": bounded_change_bool(
                data.get(
                    "secret_refs_changed"
                )
            ),
            "secret_refs_added": bounded_change_text(
                data.get(
                    "secret_refs_added"
                ),
                required=False,
                max_length=1024,
            ),
            "secret_refs_removed": bounded_change_text(
                data.get(
                    "secret_refs_removed"
                ),
                required=False,
                max_length=1024,
            ),
            "config_annotation_keys_before": bounded_change_text(
                data.get(
                    "config_annotation_keys_before"
                ),
                required=False,
                max_length=1024,
            ),
            "config_annotation_keys_after": bounded_change_text(
                data.get(
                    "config_annotation_keys_after"
                ),
                required=False,
                max_length=1024,
            ),
            "config_annotation_fingerprint_before": bounded_change_text(
                data.get(
                    "config_annotation_fingerprint_before"
                ),
                required=False,
                max_length=128,
            ),
            "config_annotation_fingerprint_after": bounded_change_text(
                data.get(
                    "config_annotation_fingerprint_after"
                ),
                required=False,
                max_length=128,
            ),
            "config_annotation_changed": bounded_change_bool(
                data.get(
                    "config_annotation_changed"
                )
            ),
            "current_configmap_metadata_status": (
                metadata_status
            ),
            "current_configmap_metadata_summary": bounded_change_text(
                data.get(
                    "current_configmap_metadata_summary"
                ),
                required=False,
                max_length=1536,
            ),
            "current_configmap_metadata_error": bounded_change_text(
                data.get(
                    "current_configmap_metadata_error"
                ),
                required=False,
                max_length=512,
            ),
            "secret_content_queried": False,
            "configmap_content_exposed": False,
        }

        return EvidenceItem(
            probe=probe,
            source="kubernetes_change",
            success=True,
            trusted=True,
            production_signal=True,
            reliability=1.0,
            observed_at=observed_at,
            facts=facts,
        )

    def _normalize_kubernetes_change(
        self,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        data, observed_at = (
            self._validate_tool_evidence(
                result=result,
                expected_source="kubernetes_change",
            )
        )

        if (
            data.get(
                "owner_chain_verified"
            )
            is not True
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes change owner chain is untrusted"
            )

        if (
            data.get(
                "workload_kind"
            )
            != "Deployment"
        ):
            raise InvestigationProbeResponseError(
                "Kubernetes change workload kind is unsupported"
            )

        deployment_name = bounded_change_text(
            data.get(
                "deployment_name"
            ),
            required=True,
        )

        rollout_started_at = bounded_change_text(
            data.get(
                "rollout_started_at"
            ),
            required=False,
        )

        rollout_offset_seconds = None
        recent_rollout_before_incident = None

        if (
            rollout_started_at is not None
            and scope.event_occurred_at
            is not None
        ):
            rollout_time = parse_observed_at(
                rollout_started_at
            )

            rollout_offset_seconds = (
                scope.event_occurred_at
                .astimezone(
                    UTC
                )
                - rollout_time
            ).total_seconds()

            recent_rollout_before_incident = (
                0.0
                <= rollout_offset_seconds
                <= 1800.0
            )

        facts = {
            "temporal_basis": (
                "workload_change_history"
            ),
            "owner_chain_verified": True,
            "deployment_name": (
                deployment_name
            ),
            "revision_before": bounded_change_int(
                data.get(
                    "revision_before"
                )
            ),
            "revision_after": bounded_change_int(
                data.get(
                    "revision_after"
                )
            ),
            "revision_changed": bounded_change_bool(
                data.get(
                    "revision_changed"
                )
            ),
            "image_before": bounded_change_text(
                data.get(
                    "image_before"
                ),
                required=False,
            ),
            "image_after": bounded_change_text(
                data.get(
                    "image_after"
                ),
                required=False,
            ),
            "image_changed": bounded_change_bool(
                data.get(
                    "image_changed"
                )
            ),
            "rollout_started_at": (
                rollout_started_at
            ),
            "rollout_offset_seconds": (
                rollout_offset_seconds
            ),
            "recent_rollout_before_incident": (
                recent_rollout_before_incident
            ),
            "generation": bounded_change_int(
                data.get(
                    "generation"
                )
            ),
            "observed_generation": bounded_change_int(
                data.get(
                    "observed_generation"
                )
            ),
            "replicas_desired": bounded_change_int(
                data.get(
                    "replicas_desired"
                )
            ),
            "replicas_updated": bounded_change_int(
                data.get(
                    "replicas_updated"
                )
            ),
            "replicas_ready": bounded_change_int(
                data.get(
                    "replicas_ready"
                )
            ),
            "replicas_available": bounded_change_int(
                data.get(
                    "replicas_available"
                )
            ),
            "replicas_unavailable": bounded_change_int(
                data.get(
                    "replicas_unavailable"
                )
            ),
            "history_complete": bounded_change_bool(
                data.get(
                    "history_complete"
                )
            ),
            "rollout_condition_summary": bounded_change_text(
                data.get(
                    "rollout_condition_summary"
                ),
                required=False,
                max_length=512,
            ),
            "generation_observed": bounded_change_bool(
                data.get(
                    "generation_observed"
                )
            ),
            "rollout_complete": bounded_change_bool(
                data.get(
                    "rollout_complete"
                )
            ),
            "rollout_failure_signal": bounded_change_bool(
                data.get(
                    "rollout_failure_signal"
                )
            ),
            "rollout_failure_reason": bounded_change_text(
                data.get(
                    "rollout_failure_reason"
                ),
                required=False,
            ),
            "events_status": bounded_change_events_status(
                data.get(
                    "events_status"
                )
            ),
            "events_error_code": bounded_change_text(
                data.get(
                    "events_error_code"
                ),
                required=False,
            ),
            "recent_event_count": bounded_change_int(
                data.get(
                    "recent_event_count"
                )
            ),
            "recent_warning_count": bounded_change_int(
                data.get(
                    "recent_warning_count"
                )
            ),
            "recent_event_reasons": bounded_change_text(
                data.get(
                    "recent_event_reasons"
                ),
                required=False,
                max_length=512,
            ),
            "recent_event_summary": bounded_change_text(
                data.get(
                    "recent_event_summary"
                ),
                required=False,
                max_length=1536,
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="kubernetes_change",
            success=True,
            trusted=True,
            production_signal=True,
            reliability=1.0,
            observed_at=observed_at,
            facts=facts,
        )

    def _normalize_prometheus(
        self,
        scope: InvestigationScope,
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        data, observed_at = (
            self._validate_tool_evidence(
                result=result,
                expected_source="prometheus",
            )
        )

        result_type_value = data.get(
            "resultType"
        )

        if (
            not isinstance(
                result_type_value,
                str,
            )
            or result_type_value
            not in {
                "vector",
                "matrix",
                "scalar",
                "string",
            }
        ):
            raise InvestigationProbeResponseError(
                "Prometheus evidence result type is invalid"
            )

        result_type = (
            result_type_value[:64]
        )

        samples = extract_numeric_samples(
            result_type=result_type,
            value=data.get(
                "result"
            ),
        )

        if not samples:
            raise InvestigationProbeResponseError(
                "Prometheus evidence contains no numeric samples"
            )

        try:
            event_offset_seconds = (
                self.time_policy.validate_observed_at(
                    scope=scope,
                    probe=probe,
                    observed_at=observed_at,
                )
            )
        except InvestigationEvidenceTimeError as exc:
            raise InvestigationProbeResponseError(
                "Prometheus evidence is not "
                "temporally relevant"
            ) from exc

        facts = {
            "temporal_basis": (
                self.time_policy.temporal_basis(
                    scope=scope,
                    probe=probe,
                )
            ),
            "event_offset_seconds": (
                event_offset_seconds
            ),
            "result_type": result_type,
            "sample_count": len(
                samples
            ),
            "value_sum": sum(
                samples
            ),
            "value_min": min(
                samples
            ),
            "value_max": max(
                samples
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="prometheus",
            success=True,
            trusted=True,
            production_signal=True,
            reliability=1.0,
            observed_at=observed_at,
            facts=facts,
        )

    @classmethod
    def _validate_tool_evidence(
        cls,
        *,
        result: Any,
        expected_source: str,
    ) -> tuple[
        Mapping[str, Any],
        datetime,
    ]:
        if not isinstance(
            result,
            Mapping,
        ):
            raise InvestigationProbeResponseError(
                "Investigation tool result is invalid"
            )

        if (
            result.get(
                "success"
            )
            is not True
        ):
            raise InvestigationProbeResponseError(
                "Investigation tool result was unsuccessful"
            )

        source_value = result.get(
            "source"
        )

        if not isinstance(
            source_value,
            str,
        ):
            raise InvestigationProbeResponseError(
                "Investigation evidence source is invalid"
            )

        source = (
            source_value
            .strip()
            .lower()
        )

        if source != expected_source:
            raise InvestigationProbeResponseError(
                "Investigation evidence source is untrusted"
            )

        mode_value = result.get(
            "mode"
        )

        if not isinstance(
            mode_value,
            str,
        ):
            raise InvestigationProbeResponseError(
                "Investigation evidence mode is invalid"
            )

        mode = (
            mode_value
            .strip()
            .lower()
        )

        if mode != cls._TRUSTED_MODE:
            raise InvestigationProbeResponseError(
                "Investigation evidence mode is not read-only"
            )

        if (
            result.get(
                "production_signal"
            )
            is not True
        ):
            raise InvestigationProbeResponseError(
                "Investigation evidence is not a production signal"
            )

        observed_at = parse_observed_at(
            result.get(
                "observed_at"
            )
        )

        data = result.get(
            "data"
        )

        if not isinstance(
            data,
            Mapping,
        ):
            raise InvestigationProbeResponseError(
                "Investigation evidence data is invalid"
            )

        return (
            data,
            observed_at,
        )

    @staticmethod
    def _escape_label(
        value: str,
    ) -> str:
        return (
            value
            .replace(
                "\\",
                "\\\\",
            )
            .replace(
                "\n",
                "\\n",
            )
            .replace(
                "\r",
                "\\r",
            )
            .replace(
                '"',
                '\\"',
            )
        )


def redact_log_excerpt(
    value: str,
) -> tuple[str, int]:
    """
    Defense-in-depth redaction at the Investigation trust boundary.

    KubernetesTool redacts before ToolManager tracing. This second pass keeps
    injected or forged ToolManager responses from placing obvious credentials
    into bounded InvestigationState.
    """

    text = value
    total = 0

    patterns = [
        (
            re.compile(
                (
                    r"\beyJ[A-Za-z0-9_-]{10,}"
                    r"\.[A-Za-z0-9_-]{10,}"
                    r"\.[A-Za-z0-9_-]{10,}\b"
                )
            ),
            "[REDACTED_JWT]",
        ),
        (
            re.compile(
                (
                    r"(?i)\b("
                    r"bearer|basic"
                    r")\s+"
                    r"[A-Za-z0-9._~+/=-]{8,}"
                )
            ),
            None,
        ),
        (
            re.compile(
                (
                    r"(?i)\b("
                    r"password|passwd|pwd|secret|token|"
                    r"api[_-]?key|access[_-]?key|"
                    r"client[_-]?secret"
                    r")\b"
                    r"(\s*[:=]\s*)"
                    r"([\"']?)"
                    r"([^\s,;\"']{4,})"
                    r"([\"']?)"
                )
            ),
            None,
        ),
    ]

    text, count = patterns[0][0].subn(
        patterns[0][1],
        text,
    )

    total += count

    text, count = patterns[1][0].subn(
        lambda match: (
            match.group(1)
            + " [REDACTED]"
        ),
        text,
    )

    total += count

    text, count = patterns[2][0].subn(
        lambda match: (
            match.group(1)
            + match.group(2)
            + "[REDACTED]"
        ),
        text,
    )

    total += count

    return (
        text,
        total,
    )


def bounded_change_text(
    value: Any,
    *,
    required: bool,
    max_length: int = 512,
) -> str | None:
    if value is None:
        if required:
            raise InvestigationProbeResponseError(
                "Kubernetes change text fact is missing"
            )
        return None

    if not isinstance(
        value,
        str,
    ):
        raise InvestigationProbeResponseError(
            "Kubernetes change text fact is invalid"
        )

    normalized = value.strip()

    if not normalized:
        if required:
            raise InvestigationProbeResponseError(
                "Kubernetes change text fact is missing"
            )
        return None

    if len(
        normalized
    ) > max_length:
        raise InvestigationProbeResponseError(
            "Kubernetes change text fact is too large"
        )

    return normalized


def bounded_change_int(
    value: Any,
) -> int | None:
    if value is None:
        return None

    if (
        isinstance(
            value,
            bool,
        )
        or not isinstance(
            value,
            int,
        )
        or value < 0
        or value > 1_000_000_000
    ):
        raise InvestigationProbeResponseError(
            "Kubernetes change integer fact is invalid"
        )

    return value


def bounded_change_events_status(
    value: Any,
) -> str | None:
    if value is None:
        return None

    if value not in {
        "complete",
        "partial",
        "unavailable",
    }:
        raise InvestigationProbeResponseError(
            "Kubernetes event evidence status is invalid"
        )

    return value


def bounded_change_bool(
    value: Any,
) -> bool | None:
    if value is None:
        return None

    if not isinstance(
        value,
        bool,
    ):
        raise InvestigationProbeResponseError(
            "Kubernetes change boolean fact is invalid"
        )

    return value


def cls_scalar(
    value: Any,
):
    if (
        value is None
        or isinstance(
            value,
            (
                bool,
                int,
                float,
                str,
            ),
        )
    ):
        return value

    return str(
        value
    )[:256]


def parse_observed_at(
    value: Any,
) -> datetime:
    if isinstance(
        value,
        datetime,
    ):
        parsed = value

    elif isinstance(
        value,
        str,
    ):
        text = value.strip()

        if not text:
            raise InvestigationProbeResponseError(
                "Investigation evidence observed_at is invalid"
            )

        if text.endswith(
            "Z"
        ):
            text = (
                f"{text[:-1]}+00:00"
            )

        try:
            parsed = datetime.fromisoformat(
                text
            )
        except ValueError as exc:
            raise InvestigationProbeResponseError(
                "Investigation evidence observed_at is invalid"
            ) from exc

    else:
        raise InvestigationProbeResponseError(
            "Investigation evidence observed_at is invalid"
        )

    if parsed.tzinfo is None:
        raise InvestigationProbeResponseError(
            "Investigation evidence observed_at must be timezone-aware"
        )

    return parsed.astimezone(
        UTC
    )


def extract_numeric_samples(
    result_type: str | None,
    value: Any,
) -> list[float]:
    samples: list[float] = []

    def add_sample(
        sample: Any,
    ) -> None:
        if (
            not isinstance(
                sample,
                list,
            )
            or len(sample) < 2
            or len(samples) >= 32
        ):
            return

        try:
            numeric_value = float(
                sample[1]
            )
        except (
            TypeError,
            ValueError,
        ):
            return

        if not isfinite(
            numeric_value
        ):
            return

        samples.append(
            numeric_value
        )

    if result_type in {
        "scalar",
        "string",
    }:
        add_sample(
            value
        )

    elif (
        result_type == "vector"
        and isinstance(
            value,
            list,
        )
    ):
        for item in value[:32]:
            if isinstance(
                item,
                Mapping,
            ):
                add_sample(
                    item.get(
                        "value"
                    )
                )

    elif (
        result_type == "matrix"
        and isinstance(
            value,
            list,
        )
    ):
        for item in value[:32]:
            if not isinstance(
                item,
                Mapping,
            ):
                continue

            values = item.get(
                "values"
            )

            if (
                isinstance(
                    values,
                    list,
                )
                and values
            ):
                add_sample(
                    values[-1]
                )

    return samples


__all__ = [
    "InvestigationProbeError",
    "InvestigationProbeResponseError",
    "InvestigationToolUnavailableError",
    "ReadOnlyInvestigationProbeExecutor",
    "extract_numeric_samples",
    "parse_observed_at",
]
