from collections.abc import Mapping
from datetime import UTC, datetime
from typing import Any

from services.agent_runtime.app.investigation.models import (
    EvidenceItem,
    InvestigationProbe,
    InvestigationScope,
)


class InvestigationProbeError(RuntimeError):
    """
    Base error for the bounded read-only probe adapter.
    """


class InvestigationToolUnavailableError(
    InvestigationProbeError
):
    """
    Runtime ToolManager is unavailable.
    """


class InvestigationProbeResponseError(
    InvestigationProbeError
):
    """
    A read-only tool returned an invalid response shape.
    """


class ReadOnlyInvestigationProbeExecutor:
    """
    Translate symbolic investigation probes into exact read-only tool calls.

    Scope, Kubernetes verb, resource kind and PromQL are constructed here.
    The reasoner cannot provide any of them.
    """

    async def collect(
        self,
        context,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> EvidenceItem:
        tools = getattr(
            context,
            "tools",
            None,
        )

        if tools is None:
            raise InvestigationToolUnavailableError(
                "Runtime tools are unavailable"
            )

        if probe == InvestigationProbe.KUBERNETES_POD_STATE:
            result = await tools.call(
                "kubernetes",
                context=context,
                action="describe",
                resource="pod",
                target=scope.resource,
                namespace=scope.namespace,
            )
            return self._normalize_kubernetes(
                probe=probe,
                result=result,
            )

        query = self._prometheus_query(
            scope=scope,
            probe=probe,
        )
        result = await tools.call(
            "prometheus",
            context=context,
            query=query,
        )
        return self._normalize_prometheus(
            probe=probe,
            result=result,
        )

    @classmethod
    def _prometheus_query(
        cls,
        scope: InvestigationScope,
        probe: InvestigationProbe,
    ) -> str:
        labels = [
            f'pod="{cls._escape_label(scope.resource)}"',
            (
                'namespace="'
                f'{cls._escape_label(scope.namespace)}'
                '"'
            ),
        ]

        if scope.cluster:
            labels.append(
                'cluster="'
                f'{cls._escape_label(scope.cluster)}'
                '"'
            )

        selector = ",".join(labels)

        if (
            probe
            == InvestigationProbe.PROMETHEUS_MEMORY_WORKING_SET
        ):
            return (
                "sum(container_memory_working_set_bytes{"
                f'{selector},container!="POD",container!="",image!=""'
                "})"
            )

        if probe == InvestigationProbe.PROMETHEUS_MEMORY_LIMIT:
            return (
                "sum(kube_pod_container_resource_limits{"
                f'{selector},resource="memory",unit="byte"'
                "})"
            )

        if probe == InvestigationProbe.PROMETHEUS_RESTART_COUNT:
            return (
                "sum(kube_pod_container_status_restarts_total{"
                f"{selector}"
                "})"
            )

        raise InvestigationProbeError(
            "Unsupported investigation probe"
        )

    @staticmethod
    def _normalize_kubernetes(
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        if not isinstance(result, Mapping):
            raise InvestigationProbeResponseError(
                "Kubernetes result is invalid"
            )

        data = result.get("data")
        if not isinstance(data, Mapping):
            data = {}

        containers = data.get("containers")
        if not isinstance(containers, list):
            containers = []

        restart_counts: list[int] = []
        state_reasons: set[str] = set()
        termination_reasons: set[str] = set()

        for container in containers[:32]:
            if not isinstance(container, Mapping):
                continue

            restart_count = container.get(
                "restart_count"
            )
            if isinstance(restart_count, int):
                restart_counts.append(
                    restart_count
                )

            state_reason = container.get(
                "state_reason"
            )
            if isinstance(state_reason, str) and state_reason:
                state_reasons.add(state_reason[:128])

            termination_reason = container.get(
                "last_termination_reason"
            )
            if (
                isinstance(termination_reason, str)
                and termination_reason
            ):
                termination_reasons.add(
                    termination_reason[:128]
                )

        success = result.get("success") is True
        production_signal = (
            result.get("production_signal") is True
        )

        facts = {
            "phase": cls_scalar(data.get("phase")),
            "ready": cls_scalar(data.get("ready")),
            "scheduled": cls_scalar(data.get("scheduled")),
            "oom_killed": cls_scalar(data.get("oom_killed")),
            "max_restart_count": (
                max(restart_counts)
                if restart_counts
                else None
            ),
            "state_reasons": (
                ",".join(sorted(state_reasons))
                if state_reasons
                else None
            ),
            "last_termination_reasons": (
                ",".join(sorted(termination_reasons))
                if termination_reasons
                else None
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="kubernetes",
            success=success,
            trusted=(success and production_signal),
            production_signal=production_signal,
            reliability=(
                1.0
                if success and production_signal
                else 0.0
            ),
            observed_at=parse_observed_at(
                result.get("observed_at")
            ),
            facts=facts,
            error_code=(
                None
                if success
                else "KubernetesProbeFailed"
            ),
        )

    @staticmethod
    def _normalize_prometheus(
        probe: InvestigationProbe,
        result: Any,
    ) -> EvidenceItem:
        if not isinstance(result, Mapping):
            raise InvestigationProbeResponseError(
                "Prometheus result is invalid"
            )

        success = result.get("success") is True
        production_signal = (
            result.get("production_signal") is True
        )
        data = result.get("data")
        result_type = None
        samples: list[float] = []

        if isinstance(data, Mapping):
            result_type_value = data.get(
                "resultType"
            )
            if isinstance(result_type_value, str):
                result_type = result_type_value[:64]
            samples = extract_numeric_samples(
                result_type=result_type,
                value=data.get("result"),
            )

        facts = {
            "result_type": result_type,
            "sample_count": len(samples),
            "value_sum": (
                sum(samples)
                if samples
                else None
            ),
            "value_min": (
                min(samples)
                if samples
                else None
            ),
            "value_max": (
                max(samples)
                if samples
                else None
            ),
        }

        return EvidenceItem(
            probe=probe,
            source="prometheus",
            success=success,
            trusted=(success and production_signal),
            production_signal=production_signal,
            reliability=(
                1.0
                if success and production_signal
                else 0.0
            ),
            observed_at=parse_observed_at(
                result.get("observed_at")
            ),
            facts=facts,
            error_code=(
                None
                if success
                else "PrometheusProbeFailed"
            ),
        )

    @staticmethod
    def _escape_label(value: str) -> str:
        return (
            value
            .replace("\\", "\\\\")
            .replace("\n", "\\n")
            .replace("\r", "\\r")
            .replace('"', '\\"')
        )


def cls_scalar(value: Any):
    if value is None or isinstance(
        value,
        (bool, int, float, str),
    ):
        return value
    return str(value)[:256]


def parse_observed_at(value: Any) -> datetime:
    if isinstance(value, datetime):
        parsed = value
    elif isinstance(value, str):
        try:
            parsed = datetime.fromisoformat(
                value.replace("Z", "+00:00")
            )
        except ValueError:
            parsed = datetime.now(UTC)
    else:
        parsed = datetime.now(UTC)

    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=UTC)

    return parsed.astimezone(UTC)


def extract_numeric_samples(
    result_type: str | None,
    value: Any,
) -> list[float]:
    samples: list[float] = []

    def add_sample(sample: Any) -> None:
        if (
            not isinstance(sample, list)
            or len(sample) < 2
            or len(samples) >= 32
        ):
            return

        try:
            samples.append(float(sample[1]))
        except (TypeError, ValueError):
            return

    if result_type in {"scalar", "string"}:
        add_sample(value)

    elif result_type == "vector" and isinstance(value, list):
        for item in value[:32]:
            if isinstance(item, Mapping):
                add_sample(item.get("value"))

    elif result_type == "matrix" and isinstance(value, list):
        for item in value[:32]:
            if not isinstance(item, Mapping):
                continue
            values = item.get("values")
            if isinstance(values, list) and values:
                add_sample(values[-1])

    return samples

