)

class AgentRuntime:
    """
    Runtime container.

    Owns and shares security and runtime infrastructure
    across Pipeline, Action and Verification.

    security_policy is the RBAC authorization policy. The existing policy
    attribute remains the remediation business policy engine.
    """

    def __init__(
        self,
        authentication_service: (
            AuthenticationService | None
        ) = None,
        security_policy: (
            SecurityPolicyEngine | None
        ) = None,
        kubernetes_preflight: (
            KubernetesPreflightResolver | None
        ) = None,
        kubernetes_production_executor: (
            KubernetesProductionExecutor | None
        ) = None,
        production_pilot_control: (
            KubernetesProductionPilotControl | None
        ) = None,
        production_pilot_budget_service: (
            ProductionPilotBudgetService | None
        ) = None,
        production_pilot_live_probe: (
            ProductionPilotLiveReadinessProbe | None
        ) = None,
        kubernetes_cluster_registry: (
            KubernetesClusterRegistry | None
        ) = None,
        prometheus_cluster_registry: (
            PrometheusClusterRegistry | None
        ) = None,
        llm_gateway: (
            LLMGateway | None
        ) = None,
        investigation_reasoner: (
            BaseInvestigationReasoner | None
        ) = None,
        investigation_settings: (
            InvestigationSettings | None
        ) = None,
    ) -> None:
        # Validate every injected security component before factories, stores
        # or other runtime components can produce side effects.
        if (
            authentication_service is not None
            and not isinstance(
                authentication_service,
                AuthenticationService,
            )
        ):
            raise TypeError(
                "AgentRuntime authentication service is invalid"
            )

        if (
            security_policy is not None
            and not isinstance(
                security_policy,
                SecurityPolicyEngine,
            )
        ):
            raise TypeError(
                "AgentRuntime security policy is invalid"
            )

        if (
            kubernetes_preflight is not None
            and not isinstance(
                kubernetes_preflight,
                KubernetesPreflightResolver,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes preflight resolver is invalid"
            )

        if (
            kubernetes_production_executor is not None
            and not isinstance(
                kubernetes_production_executor,
                KubernetesProductionExecutor,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor is invalid"
            )

        if (
            production_pilot_control is not None
            and not isinstance(
                production_pilot_control,
                KubernetesProductionPilotControl,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production pilot control is invalid"
            )

        if (
            production_pilot_budget_service is not None
            and not isinstance(
                production_pilot_budget_service,
                ProductionPilotBudgetService,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production pilot budget service is invalid"
            )

        if (
            production_pilot_live_probe is not None
            and not isinstance(
                production_pilot_live_probe,
                ProductionPilotLiveReadinessProbe,
            )
        ):
            raise TypeError(
                "AgentRuntime Production Pilot live probe is invalid"
            )

        if (
            kubernetes_cluster_registry is not None
            and not isinstance(
                kubernetes_cluster_registry,
                KubernetesClusterRegistry,
            )
        ):
            raise TypeError(
                "AgentRuntime Kubernetes cluster registry is invalid"
            )

        if (
            prometheus_cluster_registry is not None
            and not isinstance(
                prometheus_cluster_registry,
                PrometheusClusterRegistry,
            )
        ):
            raise TypeError(
                "AgentRuntime Prometheus cluster registry is invalid"
            )

        if (
            llm_gateway is not None
            and not isinstance(
                llm_gateway,
                LLMGateway,
            )
        ):
            raise TypeError(
                "AgentRuntime shared LLM gateway is invalid"
            )

        if (
            investigation_reasoner is not None
            and not isinstance(
                investigation_reasoner,
                BaseInvestigationReasoner,
            )
        ):
            raise TypeError(
                "AgentRuntime Investigation reasoner is invalid"
            )

        if (
            investigation_settings is not None
            and not isinstance(
                investigation_settings,
                InvestigationSettings,
            )
        ):
            raise TypeError(
                "AgentRuntime Investigation settings are invalid"
            )

        # Resolve disabled-default Investigation configuration before any
        # Runtime store, tool, credential, network or LLM component is created.
        self.investigation_settings = (
            investigation_settings
            if investigation_settings is not None
            else InvestigationSettings.from_environment()
        )

        investigation_shared_gateway = None

        # An enabled LLM-backed Investigation must use the exact shared
        # LLMGateway instance that AgentRuntime will provide to its Agents.
        #
        # Disabled Investigation deliberately does not inspect or touch the
        # supplied reasoner's LLM adapter.
        if (
            self.investigation_settings.enabled
            and isinstance(
                investigation_reasoner,
                LLMInvestigationReasoner,
            )
        ):
            investigation_llm = (
                investigation_reasoner.investigation_llm
            )

            if not isinstance(
                investigation_llm,
                InvestigationLLMGatewayAdapter,
            ):
                raise TypeError(
                    "AgentRuntime LLM Investigation requires "
                    "InvestigationLLMGatewayAdapter"
                )

            investigation_shared_gateway = (
                investigation_llm.llm_gateway
            )

            if not isinstance(
                investigation_shared_gateway,
                LLMGateway,
            ):
                raise TypeError(
                    "AgentRuntime Investigation shared LLM gateway is invalid"
                )

            if (
                llm_gateway is not None
                and investigation_shared_gateway
                is not llm_gateway
            ):
                raise TypeError(
                    "AgentRuntime Investigation LLM gateway must be shared"
                )

        # Preserve the existing fail-closed Investigation assembly boundary.
        # Enabled mode without an explicit reasoner still fails here before
        # any Runtime or LLM infrastructure is constructed.
        self.investigation_coordinator = (
            create_investigation_coordinator(
                reasoner=investigation_reasoner,
                settings=self.investigation_settings,
            )
        )

        # Do not construct a default Gateway yet. Keeping this unresolved
        # preserves the previous initialization order. If Investigation
        # already carries the approved Gateway Adapter, Runtime adopts that
        # exact Gateway object as its shared instance.
        self.llm_gateway = (
            llm_gateway
            if llm_gateway is not None
            else investigation_shared_gateway
        )

        self.authentication = (
            authentication_service
            if authentication_service is not None
            else create_authentication_service()
        )

        self.security_policy = (
            security_policy
            if security_policy is not None
            else SecurityPolicyEngine()
        )

        self.kubernetes_preflight = (
            kubernetes_preflight
            if kubernetes_preflight is not None
            else create_kubernetes_preflight_resolver()
        )

        self.production_pilot_control = (
            production_pilot_control
            if production_pilot_control is not None
            else create_kubernetes_production_pilot_control()
        )

        # This independent gate may read both credential values at startup,
        # but can construct only a two-GET probe. Disabled mode returns before
        # any credential or CA access.
        self.production_pilot_live_probe = (
            production_pilot_live_probe
            if production_pilot_live_probe is not None
            else create_production_pilot_live_readiness_probe()
        )

        self.production_pilot_budget_store = None
        self.production_pilot_budget_service = (
            production_pilot_budget_service
        )
        if (
            self.production_pilot_budget_service is None
            and self.production_pilot_control.config.enabled
        ):
            self.production_pilot_budget_store = (
                ProductionPilotBudgetStore()
            )
            self.production_pilot_budget_service = (
                ProductionPilotBudgetService(
                    store=(
                        self.production_pilot_budget_store
                    )
                )
            )

        self.kubernetes_production_executor = (
            kubernetes_production_executor
            if kubernetes_production_executor is not None
            else create_kubernetes_production_executor(
                pilot_control=(
                    self.production_pilot_control
                ),
                pilot_budget_service=(
                    self.production_pilot_budget_service
                ),
            )
        )

        if self.kubernetes_production_executor is not None:
            executor_control = getattr(
                self.kubernetes_production_executor,
                "pilot_control",
                None,
            )
            if executor_control is None:
                self.kubernetes_production_executor.pilot_control = (
                    self.production_pilot_control
                )
            elif executor_control is not self.production_pilot_control:
                raise TypeError(
                    "AgentRuntime Kubernetes production pilot control must be shared"
                )
            executor_budget = getattr(
                self.kubernetes_production_executor,
                "pilot_budget_service",
                None,
            )
            if executor_budget is None:
                if self.production_pilot_budget_service is None:
                    raise TypeError(
                        "AgentRuntime Kubernetes production pilot budget is unavailable"
                    )
                self.kubernetes_production_executor.pilot_budget_service = (
                    self.production_pilot_budget_service
                )
            elif executor_budget is not self.production_pilot_budget_service:
                raise TypeError(
                    "AgentRuntime Kubernetes production pilot budget must be shared"
                )

        if (
            self.kubernetes_production_executor is not None
            and self.kubernetes_preflight is None
        ):
            raise TypeError(
                "AgentRuntime Kubernetes production executor requires "
                "trusted preflight"
            )

        self.production_pilot_readiness = (
            ProductionPilotReadinessService(
                control=(
                    self.production_pilot_control
                ),
                production_executor_configured=(
                    self.kubernetes_production_executor
                    is not None
                ),
            )
        )
        self.production_pilot_rehearsal = (
            ProductionPilotRehearsalService(
                control=(
                    self.production_pilot_control
                ),
                budget_service=(
                    self.production_pilot_budget_service
                ),
                production_executor_configured=(
                    self.kubernetes_production_executor
                    is not None
                ),
            )
        )
        # Pure recovery-policy proof. It owns no store, credential, network
        # client or executor and is available while the production gate is
        # disabled so operators can rehearse recovery before enablement.
        self.production_pilot_crash_recovery_rehearsal = (
            ProductionPilotCrashRecoveryRehearsalService()
        )

        self.memory = MemoryStore()

        if (
            kubernetes_cluster_registry
            is None
        ):
            self.kubernetes_cluster_registry = (
                create_kubernetes_cluster_registry()
            )
        else:
            self.kubernetes_cluster_registry = (
                kubernetes_cluster_registry
            )

        if (
            prometheus_cluster_registry
            is None
        ):
            self.prometheus_cluster_registry = (
                create_prometheus_cluster_registry()
            )
        else:
            self.prometheus_cluster_registry = (
                prometheus_cluster_registry
            )

        self.cluster_verified_evidence_required = (
            self.kubernetes_cluster_registry
            is not None
            or self.prometheus_cluster_registry
            is not None
        )

        if (
            self.investigation_coordinator
            is not None
        ):
            self.investigation_coordinator.require_cluster_verified_evidence = (
                self.cluster_verified_evidence_required
            )

        tool_manager_kwargs = {}

        if (
            self.kubernetes_cluster_registry
            is not None
        ):
            tool_manager_kwargs[
                "kubernetes_cluster_registry"
            ] = self.kubernetes_cluster_registry

        if (
            self.prometheus_cluster_registry
            is not None
        ):
            tool_manager_kwargs[
                "prometheus_cluster_registry"
            ] = self.prometheus_cluster_registry

        if tool_manager_kwargs:
            self.tools = create_tool_manager(
                **tool_manager_kwargs
            )
        else:
            self.tools = create_tool_manager()

        readiness_registry_types_valid = (
            (
                self.kubernetes_cluster_registry
                is None
                or isinstance(
                    self.kubernetes_cluster_registry,
                    KubernetesClusterRegistry,
                )
            )
            and (
                self.prometheus_cluster_registry
                is None
                or isinstance(
                    self.prometheus_cluster_registry,
                    PrometheusClusterRegistry,
                )
            )
        )

        self.production_multi_cluster_readiness = None
        self.production_multi_cluster_coverage = None

        self.production_multi_cluster_live_readiness = None

        if readiness_registry_types_valid:
            self.production_multi_cluster_readiness = (
                ProductionMultiClusterReadinessGate(
                    kubernetes_cluster_registry=(
                        self.kubernetes_cluster_registry
                    ),
                    prometheus_cluster_registry=(
                        self.prometheus_cluster_registry
                    ),
                    tools=self.tools,
                    strict_evidence_required=(
                        self.cluster_verified_evidence_required
                    ),
                )
            )

            self.production_multi_cluster_coverage = (
                self.production_multi_cluster_readiness
                .evaluate_all()
            )

            if (
                self.production_multi_cluster_readiness
                .applicable
            ):
                self.production_multi_cluster_live_readiness = (
                    ProductionReadinessLiveProbe(
                        readiness_gate=(
                            self.production_multi_cluster_readiness
                        ),
                        tools=self.tools,
                    )
                )

        self.skills = create_skill_registry()
        self.mcp = create_mcp_registry()
        self.tracer = TraceCollector()
        self.evaluators = create_evaluation_registry()

        # Remediation business policy. This is intentionally separate from
        # security_policy, which authorizes operator-facing operations.
        self.policy = create_policy_engine()

        self.preflight_artifact_store = None
        self.preflight_artifact_service = None
        self.production_action_guard = None
        self.production_action_preparation = None
        self.production_action_query = None

        if self.kubernetes_preflight is not None:
            self.preflight_artifact_store = PreflightArtifactStore()
            self.preflight_artifact_service = PreflightArtifactService(
                store=self.preflight_artifact_store
            )
            self.production_action_guard = (
                ProductionActionExpiryGuard(
                    artifact_service=(
                        self.preflight_artifact_service
                    )
                )
            )

        self.approval = ApprovalService()

        if self.production_action_guard is not None:
            self.approval.manager.set_transition_guard(
                self.production_action_guard
            )

        if self.preflight_artifact_service is not None:
            self.production_action_preparation = (
                ProductionActionPreparationService(
                    resolver=self.kubernetes_preflight,
                    artifact_service=self.preflight_artifact_service,
                    approval_service=self.approval,
                )
            )

        self.production_pilot_ceremony_store = None
        self.production_pilot_ceremony = None
        if (
            self.production_pilot_control.config.enabled
            and self.production_pilot_budget_service is not None
            and self.preflight_artifact_service is not None
        ):
            self.production_pilot_ceremony_store = (
                ProductionPilotCeremonyStore()
            )
            self.production_pilot_ceremony = (
                ProductionPilotCeremonyService(
                    store=(
                        self.production_pilot_ceremony_store
                    ),
                    control=(
                        self.production_pilot_control
                    ),
                    rehearsal=(
                        self.production_pilot_rehearsal
                    ),
                    budget_service=(
                        self.production_pilot_budget_service
                    ),
                    approval_service=self.approval,
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                )
            )

        self.incident_store = IncidentStore()

        if self.preflight_artifact_service is not None:
            self.production_action_query = (
                ProductionActionQueryService(
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                    approval_service=self.approval,
                    incident_store=self.incident_store,
                )
            )

        self.incident_service = IncidentService(
            store=self.incident_store
        )

        self.workflow_service = WorkflowService(
            incident_service=self.incident_service
        )

        self.action_execution_store = ActionExecutionStore()

        self.action_execution_service = ActionExecutionService(
            store=self.action_execution_store
        )

        self.action_runtime = ActionRuntime(
            approval_service=self.approval,
            incident_store=self.incident_store,
            action_execution_service=self.action_execution_service,
            production_action_guard=(
                self.production_action_guard
            ),
            kubernetes_production_executor=(
                self.kubernetes_production_executor
            ),
            preflight_artifact_service=(
                self.preflight_artifact_service
                if self.kubernetes_production_executor is not None
                else None
            ),
            production_pilot_control=(
                self.production_pilot_control
            ),
            production_pilot_budget_service=(
                self.production_pilot_budget_service
            ),
            production_pilot_ceremony_service=(
                self.production_pilot_ceremony
                if self.kubernetes_production_executor is not None
                else None
            ),
        )

        self.verification_store = VerificationStore()

        self.verification = VerificationService(
            store=self.verification_store
        )

        self.verification_runtime = VerificationRuntime(
            verification_service=self.verification,
            incident_store=self.incident_store,
        )

        self.verification_profile_factory = VerificationProfileFactory()

        self.verification_collector = VerificationEvidenceCollector(
            tools=self.tools,
            require_cluster_verified_evidence=(
                self.cluster_verified_evidence_required
            ),
        )

        self.verification_coordinator = VerificationCoordinator(
            profile_factory=self.verification_profile_factory,
            collector=self.verification_collector,
            verification_runtime=self.verification_runtime,
        )

        self.incident_analysis_store = (
            IncidentAnalysisStore()
        )

        self.conversation_context_provider = (
            RuntimeConversationIncidentContextProvider(
                incident_store=self.incident_store,
                analysis_store=(
                    self.incident_analysis_store
                ),
                approval_service=self.approval,
                action_execution_service=(
                    self.action_execution_service
                ),
                verification_service=(
                    self.verification
                ),
            )
        )

        self.conversation_sessions = (
            SQLiteConversationSessionStore()
        )

        self.conversation = ConversationOrchestrator(
            provider=(
                self.conversation_context_provider
            ),
            sessions=(
                self.conversation_sessions
            ),
        )

        self.chatops = ChatOpsConversationGateway(
            orchestrator=self.conversation
        )

        # Final pre-enable evidence is assembled only when every production
        # preparation component is available. The service is read-only and
        # deliberately owns no executor or mutable workflow operation.
        self.production_pilot_pre_enable_evidence = None
        if all(
            component is not None
            for component in (
                self.production_pilot_ceremony,
                self.production_pilot_budget_service,
                self.preflight_artifact_service,
            )
        ):
            self.production_pilot_pre_enable_evidence = (
                ProductionPilotPreEnableEvidenceService(
                    readiness_service=(
                        self.production_pilot_readiness
                    ),
                    rehearsal_service=(
                        self.production_pilot_rehearsal
                    ),
                    crash_rehearsal_service=(
                        self.production_pilot_crash_recovery_rehearsal
                    ),
                    ceremony_service=(
                        self.production_pilot_ceremony
                    ),
                    budget_service=(
                        self.production_pilot_budget_service
                    ),
                    artifact_service=(
                        self.preflight_artifact_service
                    ),
                    approval_service=self.approval,
                    incident_store=self.incident_store,
                    action_execution_service=(
                        self.action_execution_service
                    ),
                    verification_service=self.verification,
                )
            )

        # The final handoff rehearsal is also strictly read-only. It is
        # available only with the full prepared Pilot chain and explicitly
        # records whether production executors remain absent while the gate
        # is disabled.
        self.production_pilot_final_handoff_rehearsal = None
        if self.production_pilot_pre_enable_evidence is not None:
            self.production_pilot_final_handoff_rehearsal = (
                ProductionPilotFinalHandoffRehearsalService(
                    pilot_control=self.production_pilot_control,
                    pre_enable_evidence_service=(
                        self.production_pilot_pre_enable_evidence
                    ),
                    preflight_resolver=self.kubernetes_preflight,
                    production_executor_configured=(
                        self.kubernetes_production_executor is not None
                    ),
                    action_runtime_production_executor_configured=(
                        getattr(
                            self.action_runtime,
                            "kubernetes_production_executor",
                            None,
                        )
                        is not None
                    ),
                )
            )

        # A dedicated database is created only when the separately gated live
        # probe exists and the full zero-write handoff chain is available.
        self.production_pilot_go_no_go_store = None
        self.production_pilot_go_no_go = None
        if (
            self.production_pilot_live_probe is not None
            and self.production_pilot_final_handoff_rehearsal is not None
            and self.preflight_artifact_service is not None
        ):
            self.production_pilot_go_no_go_store = (
                ProductionPilotGoNoGoStore()
            )
            self.production_pilot_go_no_go = (
                ProductionPilotGoNoGoService(
                    store=self.production_pilot_go_no_go_store,
                    live_probe=self.production_pilot_live_probe,
                    final_handoff_service=(
                        self.production_pilot_final_handoff_rehearsal
                    ),
                    artifact_service=self.preflight_artifact_service,
                    pilot_control=self.production_pilot_control,
                )
            )

        self.sandbox = LocalSandboxExecutor()

        self.sandbox_policy = SandboxPolicyValidator()

        if self.llm_gateway is None:
            self.llm_gateway = create_llm_gateway()

        self.registry = create_agent_registry(
            llm_gateway=self.llm_gateway,
        )

        self.planner = AgentPlanner()

        self.pipeline = PlannerPipeline(
            self.registry,
            self.planner,
            self.tracer,
            self.evaluators,
            incident_store=self.incident_store,
            incident_service=self.incident_service,
            workflow_service=self.workflow_service,
        )

    def create_chatops_authenticated_write_bridge(
        self,
        *,
        actor_verifier: BaseChatOpsActorVerifier,
        identity_bindings: ChatOpsIdentityBindingRegistry,
    ) -> ChatOpsAuthenticatedWriteBridge:
        """
        Explicitly assemble the authenticated ChatOps write capability.

        Runtime does not create this bridge automatically because a concrete
        channel actor verifier and operator-managed identity bindings are
        required. Merely constructing AgentRuntime therefore adds no ChatOps
        write authority.

        The bridge reuses:
        - self.authentication for trusted OperatorIdentity,
        - self.security_policy for RBAC,
        - existing Approval / Action / Verification durable services.
        """

        if not isinstance(
            actor_verifier,
            BaseChatOpsActorVerifier,
        ):
            raise TypeError(
                "ChatOps actor verifier is invalid"
            )

        if not isinstance(
            identity_bindings,
            ChatOpsIdentityBindingRegistry,
        ):
            raise TypeError(
                "ChatOps identity bindings are invalid"
            )

        authenticator = (
            ChatOpsIdentityAuthenticator(
                authentication=(
                    self.authentication
                ),
                bindings=(
                    identity_bindings
                ),
            )
        )

        security = ChatOpsSecurityAdapter(
            verifier=actor_verifier,
            authenticator=authenticator,
            policy=self.security_policy,
        )

        return ChatOpsAuthenticatedWriteBridge(
            orchestrator=self.conversation,
            security=security,
            approval_service=self.approval,
            incident_store=self.incident_store,
            action_runtime=self.action_runtime,
            action_execution_service=(
                self.action_execution_service
            ),
            verification_service=(
                self.verification
            ),
            verification_coordinator=(
                self.verification_coordinator
            ),
        )

    async def execute(
        self,
        context: AgentContext,
    ):
        """
        Execute the primary PlannerPipeline and, when explicitly enabled,
        run Investigation automatically as a best-effort Shadow.

        Ordering is deliberate:

        1. PlannerPipeline completes first.
        2. Investigation receives an isolated AgentContext.
        3. Only the bounded investigation_shadow snapshot is copied back.

        Investigation can never change the Pipeline result, Incident,
        variables, results, trace, Approval, executions or evaluations.

        Investigation orchestration failure is sanitized and recorded in
        metadata without failing an otherwise successful Pipeline execution.
        """

        if not isinstance(
            context,
            AgentContext,
        ):
            raise TypeError(
                "AgentRuntime execution context is invalid"
            )

        # Reserved Shadow metadata from a previous execution must never be
        # visible to the primary Pipeline, even when this Runtime currently
        # has Investigation disabled.
        for reserved_key in (
            "investigation_shadow",
            "investigation_shadow_orchestration",
            "investigation_rca_comparison",
            "production_multi_cluster_readiness",
            "production_multi_cluster_live_readiness",
            "incident_analysis_persistence",
        ):
            context.metadata.pop(
                reserved_key,
                None,
            )

        # Primary workflow semantics remain authoritative. Pipeline failure
        # propagates normally and Investigation is not attempted afterward.
        context.metadata.pop(
            "incident_evidence_recorder",
            None,
        )

        results = await self.pipeline.execute(
            context
        )

        # Persist the authoritative Planner RCA immediately after the primary
        # workflow. This remains weaker than the Pipeline itself: persistence
        # failure is sanitized in metadata and cannot change Incident state.
        await self._persist_incident_analysis(
            context
        )

        # Evidence Recorder is evaluation-only and best-effort.
        await self._record_incident_evidence_shadow(
            context
        )

        if self.investigation_coordinator is None:
            return results

        shadow_context = (
            self._create_investigation_shadow_context(
                context
            )
        )

        try:
            await self.run_investigation_shadow(
                shadow_context
            )

            readiness_snapshot = (
                shadow_context.metadata.get(
                    "production_multi_cluster_readiness"
                )
            )

            if isinstance(
                readiness_snapshot,
                dict,
            ):
                context.metadata[
                    "production_multi_cluster_readiness"
                ] = deepcopy(
                    readiness_snapshot
                )

            snapshot = shadow_context.metadata.get(
                "investigation_shadow"
            )

            if (
                not isinstance(
                    snapshot,
                    dict,
                )
                or snapshot.get(
                    "shadow_mode"
                )
                is not True
                or snapshot.get(
                    "read_only"
                )
                is not True
            ):
                raise RuntimeError(
                    "Investigation Shadow snapshot is invalid"
                )

            context.metadata[
                "investigation_shadow"
            ] = deepcopy(
                snapshot
            )

        except Exception as exc:
            # Shadow means Shadow: an Investigation orchestration fault must
            # never convert a successful PlannerPipeline execution to failed.
            #
            # Raw exception text is deliberately excluded because provider,
            # URL, credential or tool details may be present in it.
            readiness_snapshot = (
                shadow_context.metadata.get(
                    "production_multi_cluster_readiness"
                )
            )

            if isinstance(
                readiness_snapshot,
                dict,
            ):
                context.metadata[
                    "production_multi_cluster_readiness"
                ] = deepcopy(
                    readiness_snapshot
                )

            context.metadata[
                "investigation_shadow_orchestration"
            ] = {
                "shadow_mode": True,
                "read_only": True,
                "automatic": True,
                "status": "failed",
                "failure_code": (
                    type(exc).__name__[:256]
                ),
            }

        # Comparison is evaluation-only. It cannot change the authoritative
        # RCA stored in context.variables["rca"] and has no Healing authority.
        try:
            context.metadata[
                "investigation_rca_comparison"
            ] = build_rca_investigation_comparison(
                rca=context.variables.get(
                    "rca"
                ),
                investigation_snapshot=(
                    context.metadata.get(
                        "investigation_shadow"
                    )
                ),
                orchestration_snapshot=(
                    context.metadata.get(
                        "investigation_shadow_orchestration"
                    )
                ),
            )
        except Exception as exc:
            # A comparison bug must remain weaker than Shadow itself and must
            # never fail a successful primary Pipeline.
            context.metadata[
                "investigation_rca_comparison"
            ] = {
                "schema_version": "v1",
                "shadow_mode": True,
                "read_only": True,
                "decision_influence": False,
                "available": False,
                "comparison_status": (
                    "comparison_failed"
                ),
                "failure_code": (
                    type(exc).__name__[:256]
                ),
            }

        # Merge the bounded Investigation snapshot into the same per-Incident
        # analysis record. Historical Memory remains independent.
        await self._persist_incident_analysis(
            context
        )

        return results

    async def _persist_incident_analysis(
        self,
        context: AgentContext,
    ) -> None:
        """
        Best-effort durable analysis projection for ChatOps follow-up.

        This method never mutates Incident, Approval, Action or Verification.
        A persistence fault is recorded as a bounded failure code and remains
        weaker than the authoritative PlannerPipeline.
        """

        store = getattr(
            self,
            "incident_analysis_store",
            None,
        )

        if not isinstance(
            store,
            IncidentAnalysisStore,
        ):
            return

        metadata = getattr(
            context,
            "metadata",
            None,
        )

        if not isinstance(
            metadata,
            dict,
        ):
            return

        incident = getattr(
            context,
            "incident",
            None,
        )

        incident_id = getattr(
            incident,
            "id",
            None,
        )

        if incident_id is None:
            metadata[
                "incident_analysis_persistence"
            ] = {
                "schema_version": "v1",
                "status": "skipped",
                "reason": "incident_identity_missing",
            }

            return

        try:
            existing = await store.get(
                incident_id
            )

            record = build_incident_analysis_record(
                incident_id=incident_id,
                event=context.event,
                request_id=context.request_id,
                primary_rca=(
                    context.variables.get(
                        "rca"
                    )
                    if isinstance(
                        context.variables,
                        dict,
                    )
                    else None
                ),
                investigation_snapshot=(
                    metadata.get(
                        "investigation_shadow"
                    )
                ),
                existing=existing,
            )

            persisted = await store.upsert(
                record
            )

            metadata[
                "incident_analysis_persistence"
            ] = {
                "schema_version": "v1",
                "status": "persisted",
                "incident_id": str(
                    persisted.incident_id
                ),
                "primary_rca": (
                    persisted.primary_rca
                    is not None
                ),
                "investigation": (
                    persisted.investigation
                    is not None
                ),
            }

        except Exception as exc:
            metadata[
                "incident_analysis_persistence"
            ] = {
                "schema_version": "v1",
                "status": "failed",
                "failure_code": (
                    type(exc).__name__[
                        :256
                    ]
                ),
            }

    def _create_investigation_shadow_context(
        self,
        context: AgentContext,
    ) -> AgentContext:
        """
        Build the minimum-privilege context for automatic Investigation.

        Copied:
        - event input
        - request correlation ID

        Shared:
        - exact Runtime-owned ToolManager

        Deliberately not shared:
        - Incident
        - variables
        - results
        - metadata
        - trace
        - memory
        - skills
        - MCP
        - sandbox
        - Approval
        - executions
        - evaluations
        """

        return AgentContext(
            request_id=context.request_id,
            event=deepcopy(
                context.event
            ),
            tools=self.tools,
            metadata={},
        )

    async def run_production_multi_cluster_live_readiness(
        self,
        context: AgentContext,
        *,
        acknowledgement: str,
        reason: str,
    ) -> dict[str, Any]:
        """
        Explicit bounded live-read production readiness proof.

        This method is never called automatically by execute() or Runtime
        startup. It records only a sanitized readiness snapshot.
        """

        if not isinstance(context, AgentContext):
            raise TypeError(
                "AgentRuntime live readiness requires AgentContext"
            )

        if context.tools is not self.tools:
            raise TypeError(
                "AgentRuntime live readiness requires shared Runtime tools"
            )

        probe = getattr(
            self,
            "production_multi_cluster_live_readiness",
            None,
        )

        if probe is None:
            raise ProductionReadinessLiveProbeError(
                "AgentRuntime production live readiness is unavailable"
            )

        report = await probe.probe_event(
            context.event,
            acknowledgement=acknowledgement,
            reason=reason,
        )

        snapshot = report.snapshot()

        context.metadata[
            "production_multi_cluster_live_readiness"
        ] = deepcopy(snapshot)

        return snapshot

    async def run_investigation_shadow(
        self,
        context: AgentContext,
    ) -> InvestigationState:
        """
        Explicitly execute the enabled read-only Investigation Shadow.

        This method is intentionally separate from PlannerPipeline.

        PlannerPipeline itself never invokes Investigation. AgentRuntime
        may call this lower-level entry point after a successful Pipeline
        execution when automatic Shadow Investigation is enabled.

        The supplied AgentContext must use the exact Runtime ToolManager so
        Investigation probes cannot bypass Runtime-owned tool boundaries.
        """

        if not isinstance(
            context,
            AgentContext,
        ):
            raise TypeError(
                "AgentRuntime Investigation Shadow context is invalid"
            )

        if self.investigation_coordinator is None:
            raise RuntimeError(
                "AgentRuntime Investigation Shadow is disabled"
            )

        if context.tools is not self.tools:
            raise TypeError(
                "AgentRuntime Investigation Shadow requires shared Runtime tools"
            )

        if getattr(
            self,
            "cluster_verified_evidence_required",
            False,
        ):
            if (
                self.production_multi_cluster_readiness
                is None
            ):
                raise ProductionMultiClusterReadinessError(
                    "AgentRuntime Production Shadow readiness proof is unavailable"
                )

            readiness = (
                self.production_multi_cluster_readiness
                .evaluate_event(
                    context.event
                )
            )

            context.metadata[
                "production_multi_cluster_readiness"
            ] = readiness.snapshot()

            if not readiness.ready:
                raise ProductionMultiClusterReadinessError(
                    "AgentRuntime Production Shadow read coverage is not ready"
                )

        return await (
            self.investigation_coordinator.investigate(
                context
            )
        )

    async def _record_incident_evidence_shadow(
        self,
        context: AgentContext,
    ) -> None:
        """
        Best-effort, decision-isolated production evidence preservation.

        Runs only after the authoritative PlannerPipeline succeeds.
        Disabled mode constructs no Recorder and issues no production Probe.
        """

        try:
            settings = (
                IncidentEvidenceRecorderSettings
                .from_environment()
            )
        except Exception as exc:
            context.metadata[
                "incident_evidence_recorder"
            ] = {
                "schema_version": "v1",
                "shadow_mode": True,
                "read_only": True,
                "decision_influence": False,
                "automatic": True,
                "status": "failed",
                "failure_code": (
                    type(exc).__name__[:256]
                ),
            }
            return

        if not settings.enabled:
            return

        recorder_context = AgentContext(
            request_id=context.request_id,
            event=deepcopy(
                context.event
            ),
            tools=self.tools,
            metadata={},
        )

        try:
            recorder = ProductionIncidentEvidenceRecorder(
                settings.resolve_output_dir()
            )

            result = await recorder.record(
                recorder_context
            )

            context.metadata[
                "incident_evidence_recorder"
            ] = {
                "schema_version": "v1",
                "shadow_mode": True,
                "read_only": True,
                "decision_influence": False,
                "automatic": True,
                "status": "captured",
                "created": result.created,
                "incident_id": result.incident_id,
                "observation_count": (
                    result.observation_count
                ),
                "capture_file": result.path.name,
            }

        except Exception as exc:
            context.metadata[
                "incident_evidence_recorder"
            ] = {
                "schema_version": "v1",
                "shadow_mode": True,
                "read_only": True,
                "decision_influence": False,
                "automatic": True,
                "status": "failed",
                "failure_code": (
                    type(exc).__name__[:256]
                ),
            }
